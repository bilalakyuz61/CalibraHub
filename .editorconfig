root = true

# CalibraHub - kaynak dosya encoding standardi (2026-07-18).
# Turkce karakter mojibake'sinin kok nedeni: editor dosyayi UTF-8 disi bir codepage
# (Windows-1254 / Latin-1) ile kaydedince Turkce karakterler bozulur (replacement char'a doner)
# ve commit'lenir. Asagisi editorleri UTF-8'e zorlar.
# Ek savunma: .githooks/pre-commit, U+FFFD iceren commit'i bloklar. Detay: memory feedback_turkish_encoding.

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false

[*.{cs,cshtml,jsx,js,ts,tsx,css,json,kt,kts,razor}]
charset = utf-8
indent_style = space

# ── Yutulan exception = DERLEME HATASI (2026-08-27) ────────────────────────
# CS0168: "degisken tanimlandi ama hic kullanilmadi". Bu projede neredeyse her
# zaman tek bir seyi gosterir:
#
#     catch (Exception ex) { return Json(new { error = "Bir hata olustu." }); }
#
# Gercek hata (Invalid column name, timeout, null referans) o noktada yok olur:
# kullanici jenerik mesaj gorur, sunucu logunda hicbir iz kalmaz, teshis imkansizlasir.
# CLAUDE.md'nin 2. kurali bunu yasakliyor — burasi o kurali DERLEYICIYE baglar.
#
# 2026-08-27'de 205 ihlal temizlendi (hepsine _logger.LogError eklendi); bu satir
# yenilerinin eklenmesini engeller. Exception'i gercekten kullanmayacaksan
# degiskeni yazma: `catch (Exception)` uyari uretmez.
[*.cs]
dotnet_diagnostic.CS0168.severity = error
