@*
    ConvertToOrders — "Tekliflerden Sipariş Oluştur" TAM EKRAN sayfası (2026-08-22).

    Önceden bu ekran Satış Siparişi listesindeki bir toolbar aksiyonunun açtığı
    MODAL'dı (960px, dar). Kullanıcı isteği: "tam ekran ve Yükleme Planlama ekranı
    gibi olsun". Bileşen aynı kaldı (ConvertToOrdersModal) — `variant="page"` ile
    perde/genişlik tavanı olmadan, yüksekliği viewport'a oturarak render ediliyor.
    Modal yolu (window.CalibraHub.openConvertToOrdersModal) kaldırılmadı.

    Veri tamamen client-side: GET /Sales/GetConvertibleQuotes,
    POST /Sales/CreateOrdersFromQuotes (bkz. services/salesService.js).
*@
@{
    ViewData["Title"]     = "Tekliflerden Sipariş Oluştur";
    ViewData["BodyClass"] = "page-cto";
}
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider

@section Styles {
<style>
    /* Sayfa kabı — ShipmentPlanningCenter (.page-sp) ile aynı iskelet: dashboard
       sarmalayıcısının padding/max-width kısıtları sıfırlanır ki içerik tam ekran olsun. */
    .page-cto .integrator-dashboard {
        padding: 0 !important; background: transparent !important;
        box-shadow: none !important; border: none !important; max-width: none !important;
    }
    .page-cto .integrator-dashboard__content { width: 100% !important; max-width: none !important; padding: 0 !important; }
    .cto-host { display: flex; flex-direction: column; min-height: 0; }
    .cto-fallback {
        display: flex; align-items: center; justify-content: center;
        height: calc(100vh - 160px);
        font-size: .9rem; color: var(--app-text-muted, #64748b);
    }
</style>
}

<div id="ctoHost" class="cto-host">
    <div class="cto-fallback" id="ctoFallback">Yükleniyor…</div>
</div>

@section Scripts {
<link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")" />
<script>
(function () {
    'use strict';
    var BUNDLE = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var host = document.getElementById('ctoHost');

    function fail(msg) {
        var f = document.getElementById('ctoFallback');
        if (f) f.textContent = msg;
    }

    function doMount() {
        if (!window.CalibraHub || typeof window.CalibraHub.mountConvertToOrdersPage !== 'function') {
            fail('Ekran bileşeni yüklenemedi.');
            return;
        }
        host.innerHTML = '';
        window.CalibraHub.mountConvertToOrdersPage(host, { backUrl: '/Sales/Orders' });
    }

    if (window.CalibraHub && typeof window.CalibraHub.mountConvertToOrdersPage === 'function') {
        doMount();
        return;
    }
    // Bundle sayfada yoksa dinamik yükle (Machines/MaterialCards deseni).
    var s = document.createElement('script');
    s.src = BUNDLE;
    s.onload = doMount;
    s.onerror = function () { fail('Bileşen paketi yüklenemedi.'); };
    document.head.appendChild(s);
})();
</script>
}
