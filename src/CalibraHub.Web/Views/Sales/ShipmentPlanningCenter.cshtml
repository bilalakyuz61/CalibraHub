    .sp-modal--resv .sp-modal-body { flex:1 1 auto; min-height:0; overflow-y:auto; }
    .sp-resv-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:40px 16px; color:#64748b; font-size:.82rem; text-align:center; }
    .sp-resv-badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:999px; font-size:.68rem; font-weight:700; white-space:nowrap; }
    .sp-resv-badge--active { background:rgba(99,102,241,.14); color:#a5b4fc; }
    .sp-resv-badge--shipped { background:rgba(16,185,129,.14); color:#6ee7b7; }
    .sp-resv-badge--cancelled { background:rgba(239,68,68,.12); color:#fca5a5; }
    .sp-resv-actions { display:flex; gap:6px; justify-content:flex-end; }
    .sp-resv-abtn {
        padding:4px 10px; border-radius:6px; font-size:.72rem; font-weight:600; cursor:pointer; border:1px solid transparent;
