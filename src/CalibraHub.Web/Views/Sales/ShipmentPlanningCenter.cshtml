        background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.07); white-space:nowrap;
    }
    .sp-modal-tbl tbody td { padding:6px 8px; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:middle; }
