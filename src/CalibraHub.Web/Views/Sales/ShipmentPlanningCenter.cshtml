    .sp-res--err { background:rgba(239,68,68,.1);   border:1px solid rgba(239,68,68,.3);  color:#fca5a5; }
    .sp-res--info { background:rgba(99,102,241,.1); border:1px solid rgba(99,102,241,.3); color:#a5b4fc; }
    .sp-modal-ft-btns { display:flex; gap:8px; flex-shrink:0; margin-left:auto; }

