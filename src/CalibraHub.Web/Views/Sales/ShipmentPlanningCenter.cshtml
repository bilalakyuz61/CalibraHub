@*
    ShipmentPlanningCenter — Yükleme Planlama Merkezi (Faz 1, 2026-07-28 · Faz 2, 2026-07-31).
    İhtiyaç Karşılama Merkezi'nin (Views/Purchase/FulfillmentCenter.cshtml, prefix fc3-) satış-tarafı
    analoğu. Prefix: sp- (shipment planning). Kapsam:
      1) Açık satış sipariş kalemlerini listele + "Depodan Rezerve Et" (mantıksal rezervasyon) — Faz 1.
      2) Mevcut rezervasyonları (satır detayında) göster + iptal et — Faz 1.
      3) Rezervasyonu irsaliyeye çevir ("Yükle") — Faz 2. Tekil (satır bazlı Yükle butonu) veya
         rezervasyon detay panelinde checkbox ile çoklu seçim + "Seçilenleri Yükle". Destrüktif/geri
         alınamaz işlem olduğu için ekran-ortası onay modalı zorunlu (showConfirm).
    Sunucu tarafı render etmez; tüm veri client-side fetch ile GET /Sales/OpenOrderLinesForReservation,
    GET /Sales/OrderReservations, POST /Sales/CreateReservation, POST /Sales/CancelReservation,
    POST /Sales/ShipReservations üzerinden gelir (kesin sözleşme — bkz. SalesController.cs ilgili action'lar).
*@
@{
    ViewData["Title"]     = "Yükleme Planlama";
    ViewData["BodyClass"] = "page-sp";
}

@section Styles {
<style>
    /* ── Sayfa kap (FulfillmentCenter fc3-outer ile aynı iskelet) ── */
    .page-sp .integrator-dashboard {
        padding:0!important; background:transparent!important;
        box-shadow:none!important; border:none!important; max-width:none!important;
    }
    .page-sp .integrator-dashboard__content { width:100%!important; max-width:none!important; padding:0!important; }

    .sp-outer {
        display:flex; flex-direction:column;
        height: calc(100vh - 56px);
        padding: 16px 20px 0;
        overflow:hidden;
    }

    /* ── Başlık ── */
    .sp-hd { display:flex; align-items:center; gap:12px; margin-bottom:14px; flex-shrink:0; }
    .sp-back {
        display:inline-flex; align-items:center; gap:5px;
        padding:5px 11px; border-radius:7px;
        background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.09);
        color:#94a3b8; font-size:.79rem; text-decoration:none; transition:all .13s;
    }
    .sp-back:hover { background:rgba(255,255,255,.08); color:#e2e8f0; }
    .sp-title-icon {
        width:34px; height:34px; border-radius:8px; flex-shrink:0;
        background:linear-gradient(135deg,#6366f1,#8b5cf6);
        display:flex; align-items:center; justify-content:center;
    }
    .sp-title-tx  { font-size:1rem; font-weight:700; color:#e2e8f0; }
    .sp-title-sub { font-size:.75rem; color:#475569; }

    .sp-qs-wrap { width:280px; flex-shrink:0; position:relative; display:flex; align-items:center; }
    .sp-qs-icon { position:absolute; left:9px; color:#475569; pointer-events:none; flex-shrink:0; }
    .sp-qs-input {
        width:100%; height:32px; padding:0 8px 0 30px;
        border:1px solid rgba(255,255,255,.09); border-radius:8px;
        background:rgba(255,255,255,.04); font-size:.8rem;
        color:#e2e8f0; outline:none; transition:border-color .13s;
    }
    .sp-qs-input::placeholder { color:#334155; }
    .sp-qs-input:focus { border-color:rgba(99,102,241,.45); }
    .sp-qs-input::-webkit-search-cancel-button { cursor:pointer; }

    .sp-hd-icon-btn {
        display:inline-flex; align-items:center; justify-content:center;
        width:32px; height:32px; border-radius:8px; padding:0; flex-shrink:0;
        background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.09);
        color:#94a3b8; cursor:pointer; transition:all .13s;
    }
    .sp-hd-icon-btn:hover { background:rgba(255,255,255,.08); color:#e2e8f0; }
    @@keyframes spspin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .sp-hd-icon-btn.sp-spin svg { animation: spspin .8s linear infinite; }

    /* ── Liste ── */
    .sp-body { flex:1; min-height:0; display:flex; flex-direction:column; }
    .sp-left {
        flex:1; min-height:0; display:flex; flex-direction:column;
        background:rgba(255,255,255,.02); border:1px solid rgba(255,255,255,.07);
        border-radius:12px; overflow:hidden;
    }
    .sp-list-bar { flex-shrink:0; display:flex; align-items:center; gap:10px; padding:9px 14px; border-bottom:1px solid rgba(255,255,255,.06); }
    .sp-count-all { margin-left:auto; font-size:.75rem; color:#475569; }
    .sp-count-sel { font-size:.79rem; font-weight:700; color:#a5b4fc; display:none; }
    .sp-count-sel.show { display:inline; }

    .sp-flat-hdr {
        display:grid;
        grid-template-columns: 26px 130px 1fr 76px 76px 76px 76px 110px 46px 26px;
        align-items:center; gap:8px;
        padding:6px 16px 6px 14px; flex-shrink:0;
        font-size:.68rem; font-weight:700; letter-spacing:.04em; text-transform:none;
        color:#475569; border-bottom:1px solid rgba(255,255,255,.06);
        background:rgba(255,255,255,.02);
    }
    .sp-flat-hdr > span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .sp-fhdr__qty { text-align:right; }

    .sp-list { flex:1; overflow-y:auto; scrollbar-gutter:stable; }
    .sp-list::-webkit-scrollbar { width:4px; }
    .sp-list::-webkit-scrollbar-thumb { background:rgba(255,255,255,.09); border-radius:2px; }
    .sp-empty-list { padding:32px 14px; text-align:center; color:#475569; font-size:.82rem; }

    .sp-row-wrap { border-bottom:1px solid rgba(255,255,255,.04); }
    .sp-flat-row {
        display:grid;
        grid-template-columns: 26px 130px 1fr 76px 76px 76px 76px 110px 46px 26px;
        align-items:center; gap:8px;
        padding:8px 14px; font-size:.79rem; transition:background .1s;
    }
    .sp-flat-row:hover { background:rgba(255,255,255,.025); }
    .sp-flat-row.sel   { background:rgba(99,102,241,.09); }
    .sp-flat-row.is-kit { opacity:.72; }
    .sp-cb { accent-color:#6366f1; width:15px; height:15px; cursor:pointer; margin:0; }
    .sp-cb:disabled { opacity:.35; cursor:not-allowed; }
    .sp-flat-num { font-family:ui-monospace, Menlo, Consolas, monospace; font-size:.79rem; font-weight:700; color:#818cf8; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; background:none; border:none; padding:0; text-align:left; cursor:pointer; }
    .sp-flat-num:hover { color:#a5b4fc; text-decoration:underline; }
    .sp-flat-mat { min-width:0; overflow:hidden; }
    .sp-flat-mat-name { color:#e2e8f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block; }
    .sp-flat-mat-code { color:#475569; font-size:.7rem; font-family:ui-monospace, Menlo, Consolas, monospace; }
    .sp-kit-badge {
        display:inline-flex; align-items:center; gap:3px; margin-left:6px;
        padding:1px 6px; border-radius:999px; font-size:.63rem; font-weight:700;
        background:rgba(139,92,246,.16); color:#c4b5fd; white-space:nowrap;
    }
    .sp-qty  { font-family:ui-monospace, Menlo, Consolas, monospace; font-size:.78rem; color:#cbd5e1; text-align:right; }
    .sp-qty--open { color:#e2e8f0; font-weight:700; }
    .sp-stock { text-align:right; font-family:ui-monospace, Menlo, Consolas, monospace; font-size:.78rem; padding:1px 6px; border-radius:6px; }
    .sp-stock--ok   { color:#34d399; }
    .sp-stock--warn { color:#fbbf24; }
    .sp-stock--none { color:#f87171; }
    .sp-unit { color:#64748b; font-size:.75rem; }
    .sp-exp-btn {
        justify-self:end; width:20px; height:20px; border-radius:5px; padding:0;
        background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.09);
        color:#64748b; cursor:pointer; display:flex; align-items:center; justify-content:center;
        transition:all .12s; line-height:1;
    }
    .sp-exp-btn:hover { background:rgba(99,102,241,.15); border-color:rgba(99,102,241,.3); color:#a5b4fc; }
    .sp-exp-btn.active { background:rgba(99,102,241,.14); border-color:rgba(99,102,241,.28); color:#818cf8; }
    .sp-exp-btn svg { transition:transform .15s; }
    .sp-exp-btn.active svg { transform:rotate(180deg); }

    /* ── Rezervasyon detay bloğu ── */
    .sp-sub { background:rgba(99,102,241,.025); border-top:1px solid rgba(99,102,241,.1); }
    .sp-sub-loading, .sp-sub-empty { padding:8px 14px 8px 48px; font-size:.76rem; color:#475569; font-style:italic; }
    .sp-sub-row {
        display:flex; align-items:center; gap:10px; flex-wrap:wrap;
        padding:6px 14px 6px 48px; border-bottom:1px solid rgba(255,255,255,.03); font-size:.76rem;
    }
    .sp-sub-row:last-child { border-bottom:none; }
    .sp-sub-cb   { accent-color:#6366f1; width:14px; height:14px; cursor:pointer; margin:0; flex-shrink:0; }
    .sp-sub-loc  { color:#94a3b8; min-width:120px; }
    .sp-sub-qty  { color:#e2e8f0; font-weight:600; font-family:ui-monospace, Menlo, Consolas, monospace; min-width:70px; }
    .sp-sub-date { color:#64748b; min-width:80px; }
    .sp-sub-notes { color:#64748b; flex:1; min-width:100px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .sp-sub-actions { margin-left:auto; display:flex; align-items:center; gap:6px; flex-shrink:0; }
    .sp-sub-cancel {
        display:inline-flex; align-items:center; gap:4px;
        padding:3px 9px; border-radius:6px; font-size:.72rem; font-weight:600; cursor:pointer;
        background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.28); color:#fca5a5; transition:all .12s;
    }
    .sp-sub-cancel:hover { background:rgba(239,68,68,.18); border-color:rgba(239,68,68,.4); }
    .sp-sub-ship {
        display:inline-flex; align-items:center; gap:4px;
        padding:3px 9px; border-radius:6px; font-size:.72rem; font-weight:600; cursor:pointer;
        background:rgba(99,102,241,.12); border:1px solid rgba(99,102,241,.32); color:#a5b4fc; transition:all .12s;
    }
    .sp-sub-ship:hover { background:rgba(99,102,241,.2); border-color:rgba(99,102,241,.45); }
    .sp-sub-toolbar {
        display:flex; align-items:center; gap:10px; flex-wrap:wrap;
        padding:6px 14px 6px 48px; border-bottom:1px solid rgba(99,102,241,.14);
        background:rgba(99,102,241,.04);
    }
    .sp-sub-toolbar-cnt { font-size:.74rem; font-weight:700; color:#a5b4fc; }
    .sp-btn--xs { padding:4px 10px; font-size:.73rem; }

    /* ── Seçim aksiyon bar ── */
    .sp-selbar {
        position:fixed; left:50%; bottom:18px; transform:translate(-50%, 120%);
        display:flex; align-items:center; gap:14px; z-index:60;
        padding:9px 12px 9px 16px; border-radius:12px;
        background:rgba(13,18,34,.96); border:1px solid rgba(255,255,255,.09);
        box-shadow:0 16px 40px rgba(0,0,0,.35);
        transition:transform .18s ease;
    }
    .sp-selbar.show { transform:translate(-50%, 0); }
    .sp-sb-cnt { font-size:.83rem; font-weight:700; color:#a5b4fc; white-space:nowrap; }
    .sp-sb-right { display:flex; align-items:center; gap:8px; }
    .sp-fb-cancel { background:none; border:none; color:#64748b; font-size:.78rem; cursor:pointer; padding:5px 4px; }
    .sp-fb-cancel:hover { color:#94a3b8; }

    .sp-btn { display:inline-flex; align-items:center; gap:5px; padding:7px 14px; border-radius:8px; font-size:.8rem; font-weight:600; cursor:pointer; border:none; transition:all .13s; }
    .sp-btn--p { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; }
    .sp-btn--p:hover { opacity:.88; }
    .sp-btn--p:disabled { opacity:.4; cursor:not-allowed; }
    .sp-btn--g { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:#94a3b8; }
    .sp-btn--g:hover { background:rgba(255,255,255,.09); color:#e2e8f0; }

    /* ── Rezervasyon modalı (silme onay standardı ile aynı iskelet: backdrop + ortalanmış kart) ── */
    .sp-modal-backdrop {
        position:fixed; inset:0; z-index:9980;
        background:rgba(6,9,20,.55); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);
        display:flex; align-items:center; justify-content:center;
        opacity:0; pointer-events:none; transition:opacity .12s;
    }
    .sp-modal-backdrop.open { opacity:1; pointer-events:auto; }
    .sp-modal {
        width:min(620px, 94vw); max-height:86vh; display:flex; flex-direction:column;
        background:#0d1222; border:1px solid rgba(255,255,255,.09); border-radius:14px;
        box-shadow:0 32px 80px rgba(0,0,0,.5);
        transform:translateY(10px) scale(.98); opacity:0; transition:transform .16s, opacity .16s;
    }
    .sp-modal-backdrop.open .sp-modal { transform:translateY(0) scale(1); opacity:1; }
    .sp-modal-hd { display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid rgba(255,255,255,.07); flex-shrink:0; }
    .sp-modal-hd-icon {
        width:34px; height:34px; border-radius:9px; flex-shrink:0; display:flex; align-items:center; justify-content:center;
        background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff;
    }
    .sp-modal-hd-tx { flex:1; min-width:0; }
    .sp-modal-hd-tx strong { display:block; font-size:.92rem; font-weight:700; color:#e2e8f0; }
    .sp-modal-hd-tx small  { font-size:.73rem; color:#64748b; }
    .sp-modal-close {
        padding:5px; border-radius:7px; background:none; border:1px solid rgba(255,255,255,.07);
        color:#64748b; cursor:pointer; display:flex; align-items:center; transition:all .12s;
    }
    .sp-modal-close:hover { background:rgba(255,255,255,.07); color:#e2e8f0; }
    .sp-modal-body { flex:1; overflow-y:auto; padding:14px 16px; display:flex; flex-direction:column; gap:12px; }
    .sp-modal-body::-webkit-scrollbar { width:5px; }
    .sp-modal-body::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1); border-radius:3px; }

    .sp-field-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .sp-field { flex:1; min-width:180px; }
    .sp-field label { display:block; font-size:.72rem; font-weight:600; color:#64748b; margin-bottom:4px; }
    .sp-ti, .sp-ts {
        width:100%; padding:6px 8px;
        background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.09);
        border-radius:6px; color:#e2e8f0; font-size:.81rem; outline:none; color-scheme:dark;
    }
    .sp-ti:focus, .sp-ts:focus { border-color:rgba(99,102,241,.45); }
    .sp-ts option { background:#1e293b; }
    textarea.sp-ti { resize:vertical; }

    .sp-modal-tablewrap { border:1px solid rgba(255,255,255,.07); border-radius:10px; overflow:hidden; }
    .sp-modal-tbl { width:100%; border-collapse:collapse; font-size:.8rem; }
    .sp-modal-tbl thead th {
        text-align:left; padding:6px 8px; font-size:.68rem; font-weight:700; color:#64748b;
        background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.07); white-space:nowrap;
    }
    .sp-modal-tbl tbody td { padding:6px 8px; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:middle; }
    .sp-modal-tbl tbody tr:last-child td { border-bottom:none; }
    .sp-modal-mat { color:#cbd5e1; font-size:.79rem; }
    .sp-modal-mat small { display:block; font-family:ui-monospace, Menlo, Consolas, monospace; font-size:.68rem; color:#818cf8; margin-top:1px; }
    .sp-modal-qty-input {
        width:88px; padding:4px 6px; text-align:right;
        background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
        border-radius:6px; color:#e2e8f0; font-size:.8rem; outline:none;
        font-family:ui-monospace, Menlo, Consolas, monospace;
    }
    .sp-modal-qty-input:focus { border-color:rgba(99,102,241,.5); }
    .sp-modal-qty-input.sp-qty-warn { border-color:rgba(245,158,11,.55); color:#fbbf24; }
    .sp-modal-hint { font-size:.67rem; color:#475569; white-space:nowrap; }
    .sp-modal-rm {
        width:24px; height:24px; padding:0; border-radius:6px;
        background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.25); color:#f87171;
        cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .12s;
    }
    .sp-modal-rm:hover { background:rgba(239,68,68,.18); border-color:rgba(239,68,68,.4); color:#fca5a5; }

    .sp-modal-ft { display:flex; align-items:center; gap:10px; padding:12px 16px; border-top:1px solid rgba(255,255,255,.07); flex-shrink:0; }
    .sp-res { display:none; flex:1; padding:6px 10px; border-radius:6px; font-size:.78rem; font-weight:600; }
    .sp-res--ok  { background:rgba(16,185,129,.12); border:1px solid rgba(16,185,129,.3); color:#6ee7b7; }
    .sp-res--err { background:rgba(239,68,68,.1);   border:1px solid rgba(239,68,68,.3);  color:#fca5a5; }
    .sp-res--info { background:rgba(99,102,241,.1); border:1px solid rgba(99,102,241,.3); color:#a5b4fc; }
    .sp-modal-ft-btns { display:flex; gap:8px; flex-shrink:0; margin-left:auto; }

    /* Sonuç dökümü (created/skipped) */
    .sp-result-list { display:flex; flex-direction:column; gap:4px; }
    .sp-result-item { display:flex; align-items:center; gap:8px; font-size:.78rem; padding:4px 8px; border-radius:6px; }
    .sp-result-item--ok  { background:rgba(16,185,129,.08); color:#6ee7b7; }
    .sp-result-item--bad { background:rgba(239,68,68,.08);  color:#fca5a5; }

    /* ── Light tema override — fc3 deseniyle tutarlı (dark default, light override) ── */
    body.app-theme-light .sp-back { background:#f1f5f9; border-color:#e2e8f0; color:#475569; }
    body.app-theme-light .sp-back:hover { background:#e2e8f0; color:#0f172a; }
    body.app-theme-light .sp-title-tx  { color:#0f172a; }
    body.app-theme-light .sp-title-sub { color:#64748b; }
    body.app-theme-light .sp-qs-input { background:#f8fafc; border-color:#e2e8f0; color:#0f172a; color-scheme:light; }
    body.app-theme-light .sp-qs-input::placeholder { color:#94a3b8; }
    body.app-theme-light .sp-qs-icon { color:#94a3b8; }
    body.app-theme-light .sp-hd-icon-btn { background:#f1f5f9; border-color:#e2e8f0; color:#64748b; }
    body.app-theme-light .sp-hd-icon-btn:hover { background:#e2e8f0; color:#0f172a; }

    body.app-theme-light .sp-left { background:#ffffff; border-color:#e2e8f0; }
    body.app-theme-light .sp-list-bar { border-bottom-color:#e2e8f0; }
    body.app-theme-light .sp-count-all { color:#64748b; }
    body.app-theme-light .sp-count-sel { color:#4338ca; }
    body.app-theme-light .sp-flat-hdr { color:#94a3b8; border-bottom-color:#f1f5f9; background:#f8fafc; }
    body.app-theme-light .sp-list::-webkit-scrollbar-thumb { background:#cbd5e1; }
    body.app-theme-light .sp-row-wrap { border-bottom-color:#f1f5f9; }
    body.app-theme-light .sp-flat-row:hover { background:#f8fafc; }
    body.app-theme-light .sp-flat-row.sel { background:rgba(99,102,241,.08); }
    body.app-theme-light .sp-flat-num { color:#4338ca; }
    body.app-theme-light .sp-flat-mat-name { color:#0f172a; }
    body.app-theme-light .sp-flat-mat-code { color:#94a3b8; }
    body.app-theme-light .sp-qty { color:#334155; }
    body.app-theme-light .sp-qty--open { color:#0f172a; }
    body.app-theme-light .sp-unit { color:#94a3b8; }
    body.app-theme-light .sp-exp-btn { background:#f1f5f9; border-color:#e2e8f0; color:#64748b; }
    body.app-theme-light .sp-exp-btn:hover, body.app-theme-light .sp-exp-btn.active { background:#e0e7ff; border-color:#c7d2fe; color:#4338ca; }
    body.app-theme-light .sp-empty-list { color:#64748b; }

    body.app-theme-light .sp-sub { background:#f8fafc; border-top-color:#e0e7ff; }
    body.app-theme-light .sp-sub-row { border-bottom-color:#f1f5f9; }
    body.app-theme-light .sp-sub-loc, body.app-theme-light .sp-sub-date, body.app-theme-light .sp-sub-notes { color:#64748b; }
    body.app-theme-light .sp-sub-qty { color:#0f172a; }
    body.app-theme-light .sp-sub-loading, body.app-theme-light .sp-sub-empty { color:#94a3b8; }
    body.app-theme-light .sp-sub-ship { background:rgba(99,102,241,.08); border-color:rgba(99,102,241,.25); color:#4338ca; }
    body.app-theme-light .sp-sub-ship:hover { background:rgba(99,102,241,.14); border-color:rgba(99,102,241,.38); }
    body.app-theme-light .sp-sub-toolbar { background:rgba(99,102,241,.05); border-bottom-color:rgba(99,102,241,.16); }
    body.app-theme-light .sp-sub-toolbar-cnt { color:#4338ca; }

    body.app-theme-light .sp-selbar { background:#ffffff; border-color:#e2e8f0; box-shadow:0 16px 40px rgba(15,23,42,.14); }
    body.app-theme-light .sp-sb-cnt { color:#4338ca; }
    body.app-theme-light .sp-fb-cancel { color:#94a3b8; }
    body.app-theme-light .sp-fb-cancel:hover { color:#334155; }
    body.app-theme-light .sp-btn--g { background:#f1f5f9; border-color:#e2e8f0; color:#475569; }
    body.app-theme-light .sp-btn--g:hover { background:#e2e8f0; color:#0f172a; }

    body.app-theme-light .sp-modal-backdrop { background:rgba(15,23,42,.32); }
    body.app-theme-light .sp-modal { background:#ffffff; border-color:#e2e8f0; box-shadow:0 32px 80px rgba(15,23,42,.2); }
    body.app-theme-light .sp-modal-hd { border-bottom-color:#e2e8f0; }
    body.app-theme-light .sp-modal-hd-tx strong { color:#0f172a; }
    body.app-theme-light .sp-modal-hd-tx small  { color:#64748b; }
    body.app-theme-light .sp-modal-close { border-color:#e2e8f0; color:#64748b; }
    body.app-theme-light .sp-modal-close:hover { background:#f1f5f9; color:#0f172a; }
    body.app-theme-light .sp-modal-body::-webkit-scrollbar-thumb { background:#cbd5e1; }
    body.app-theme-light .sp-field label { color:#475569; }
    body.app-theme-light .sp-ti, body.app-theme-light .sp-ts {
        background:#ffffff; border-color:#e2e8f0; color:#0f172a; color-scheme:light;
    }
    body.app-theme-light .sp-ts option { background:#ffffff; color:#0f172a; }
    body.app-theme-light .sp-modal-tablewrap { border-color:#e2e8f0; }
    body.app-theme-light .sp-modal-tbl thead th { color:#64748b; background:#f8fafc; border-bottom-color:#e2e8f0; }
    body.app-theme-light .sp-modal-tbl tbody td { border-bottom-color:#f1f5f9; }
    body.app-theme-light .sp-modal-mat { color:#334155; }
    body.app-theme-light .sp-modal-qty-input { background:#ffffff; border-color:#e2e8f0; color:#0f172a; }
    body.app-theme-light .sp-modal-hint { color:#94a3b8; }
    body.app-theme-light .sp-modal-rm { background:rgba(239,68,68,.06); border-color:rgba(239,68,68,.22); color:#dc2626; }
    body.app-theme-light .sp-modal-rm:hover { background:rgba(239,68,68,.12); }
    body.app-theme-light .sp-modal-ft { border-top-color:#e2e8f0; }
</style>
}

