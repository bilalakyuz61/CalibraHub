    body.app-theme-light .sp-modal-tablewrap { border-color:#e2e8f0; }
    body.app-theme-light .sp-modal-tbl thead th { color:#64748b; background:#f8fafc; border-bottom-color:#e2e8f0; }
    body.app-theme-light .sp-modal-tbl tbody td { border-bottom-color:#f1f5f9; }
    body.app-theme-light .sp-modal-mat { color:#334155; }
    body.app-theme-light .sp-modal-qty-input { background:#ffffff; border-color:#e2e8f0; color:#0f172a; }
    body.app-theme-light .sp-modal-rm { background:rgba(239,68,68,.06); border-color:rgba(239,68,68,.22); color:#dc2626; }
