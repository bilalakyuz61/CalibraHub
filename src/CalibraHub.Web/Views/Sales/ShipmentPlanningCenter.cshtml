            <div class="sp-modal-tablewrap">
                <table class="sp-modal-tbl">
                    <thead>
                    <tr>
                        <th></th>
                        <th>Malzeme</th>
                        <th style="text-align:right;">Açık</th>
                        <th style="text-align:right;">Miktar</th>
                        <th>Br.</th>
                    </tr>
                    </thead>
                    <tbody id="spResTbody"></tbody>
                </table>
            </div>

            <div class="sp-field">
                <label>Not</label>
                <textarea id="spResNotes" class="sp-ti" rows="2" placeholder="Opsiyonel…"></textarea>
            </div>

            <div id="spResResultWrap" style="display:none;">
                <div class="sp-result-list" id="spResResultList"></div>
            </div>
        </div>
        <div class="sp-modal-ft">
            <span class="sp-res" id="spResMsg"></span>
            <div class="sp-modal-ft-btns">
                <button type="button" class="sp-btn sp-btn--g" id="spResCancelBtn" onclick="spCloseReserveModal()">Vazgeç</button>
                <button type="button" class="sp-btn sp-btn--p" id="spResOkBtn" onclick="spSubmitReservation()">Rezerve Et</button>
            </div>
        </div>
    </div>
</div>

@* ── Rezervasyonlar modalı — satır İşlemler menüsü "Rezervasyonlar" ──
   Bir kalemin mevcut rezervasyonlarını listeler; her satırda Yükle (irsaliyeye
   çevir) / İptal aksiyonu (destrüktif — ekran-ortası showConfirm zorunlu,
   native confirm YOK). Veri: GET /Sales/ShipmentPlanningLineDetail?lineId=.. *@
<div class="sp-modal-backdrop" id="spResvModalBackdrop" onclick="spResvBackdropClick(event)">
    <div class="sp-modal sp-modal--resv" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
        <div class="sp-modal-hd">
            <div class="sp-modal-hd-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            </div>
            <div class="sp-modal-hd-tx">
                <strong>Rezervasyonlar</strong>
                <small id="spResvSubtitle">—</small>
            </div>
            <button type="button" class="sp-modal-close" onclick="spCloseReservationsModal()" title="Kapat (Esc)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div id="spResvBody"><div class="sp-resv-state">Yükleniyor…</div></div>
        </div>
        <div class="sp-modal-ft">
            <span class="sp-res" id="spResvMsg"></span>
            <div class="sp-modal-ft-btns">
                <button type="button" class="sp-btn sp-btn--g" onclick="spCloseReservationsModal()">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")" />
<script>
    window.__SP_BOARD_CONFIG__ = @Html.Raw(spBoardJson);
    window.__SP_BUNDLE_URL__ = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
</script>
<script>
(function() {
    'use strict';

    // ── Durum ────────────────────────────────────────────────────────────────
    var LINES = [];            // en son yüklenen açık sipariş kalemleri (server'dan geldiği gibi)
    var SELECTED = {};         // lineId -> line objesi (yalnız kit-dışı, seçili kalemler)
    var LOCATIONS = null;      // /Purchase/FulfillmentLocationOptions cache (lazy)
    var EXPANDED = {};         // lineId -> bool (rezervasyon detay paneli açık mı)
    var searchTimer = null;

    function esc(s) {
        return (s == null ? '' : String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function fmtN(n) {
        return parseFloat(n || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    // Kit setleri tam sayı olarak gösterilir (ör. "3 set") — ondalık gösterim kafa karıştırır.
    function fmtSet(n) {
        return Math.round(parseFloat(n || 0)).toLocaleString('tr-TR');
    }
    // Faz 1.5: kit satırlarında availableStock/reservedQty backend'de zaten SET sayısını taşır;
    // availableSets/reservedSets aynı değeri açık isimle etiketler — varsa onu tercih et.
    function spAvailable(line) {
        if (line.isKit) return (line.availableSets != null ? line.availableSets : line.availableStock);
        return line.availableStock;
    }
    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d.getTime())) return '';
        return d.getDate().toString().padStart(2,'0') + '.' + (d.getMonth()+1).toString().padStart(2,'0') + '.' + d.getFullYear();
    }
    function spCsrf() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    // ── Depo dropdown (lazy, cache) ─────────────────────────────────────────────
    function spEnsureLocations(cb) {
        if (LOCATIONS) { cb(LOCATIONS); return; }
        fetch('/Purchase/FulfillmentLocationOptions', { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                LOCATIONS = Array.isArray(data) ? data : [];
                cb(LOCATIONS);
            })
            .catch(function() { LOCATIONS = []; cb(LOCATIONS); });
    }

    // ── Rezervasyon modalı ──────────────────────────────────────────────────────
    window.spOpenReserveModal = function() {
        var lines = Object.values(SELECTED);
        if (!lines.length) return;
        spEnsureLocations(function(locs) {
            var sel = document.getElementById('spResLocation');
            sel.innerHTML = '<option value="">— Otomatik (kalemin deposu) —</option>'
                + locs.map(function(l) { return '<option value="' + l.id + '">' + esc(l.locationName || l.locationCode) + '</option>'; }).join('');
        });
        var tbody = document.getElementById('spResTbody');
        tbody.innerHTML = lines.map(function(l) {
            var isKit = !!l.isKit;
            var avail = spAvailable(l);
            var warn = avail < l.openQty;
            var unitLabel = isKit ? 'set' : esc(l.unitCode || '');
            var openStr = isKit ? fmtSet(l.openQty) : fmtN(l.openQty);
            // Kit: varsayılan miktar openQty(set), availableSets'e clamp edilir, tam sayı.
            var defaultQty = isKit ? Math.min(Math.round(l.openQty), Math.max(0, Math.round(avail))) : l.openQty;
            var defaultQtyStr = isKit ? fmtSet(defaultQty) : fmtN(l.openQty);
            var warnTitle = warn
                ? (isKit
                    ? 'Kullanılabilir set (' + fmtSet(avail) + ') açık set sayısından az — sunucu yetersiz kısmı atlayabilir'
                    : 'Kullanılabilir stok (' + fmtN(l.availableStock) + ') açık miktardan az — sunucu yetersiz kısmı atlayabilir')
                : '';
            var kitBadge = isKit ? ' <span class="sp-kit-badge" title="Kit ürün — miktar set bazındadır">Kit</span>' : '';
            return ''
                + '<tr data-line-id="' + l.lineId + '" data-is-kit="' + (isKit ? '1' : '0') + '">'
                +   '<td><button type="button" class="sp-modal-rm" onclick="spModalRemoveRow(' + l.lineId + ')" title="Bu kalemi çıkar">'
                +     '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
                +   '</button></td>'
                +   '<td class="sp-modal-mat">' + esc(l.materialName || l.materialCode || ('#' + l.itemId)) + kitBadge + '<small>' + esc(l.orderNumber || '') + '</small></td>'
                +   '<td style="text-align:right;">' + openStr + '</td>'
                +   '<td style="text-align:right;">'
                +     '<input type="text" class="sp-modal-qty-input' + (warn ? ' sp-qty-warn' : '') + '" data-line-id="' + l.lineId + '" value="' + defaultQtyStr + '"'
                +     ' title="' + warnTitle + '">'
                +   '</td>'
                +   '<td>' + unitLabel + '</td>'
                + '</tr>';
        }).join('');
        document.getElementById('spResShipDate').value = '';
        document.getElementById('spResNotes').value = '';
        document.getElementById('spResResultWrap').style.display = 'none';
        document.getElementById('spResResultList').innerHTML = '';
        spModalShowMsg('', '');
        document.getElementById('spResOkBtn').disabled = false;
        document.getElementById('spResOkBtn').style.display = '';
        document.getElementById('spResCancelBtn').textContent = 'Vazgeç';
        document.getElementById('spModalBackdrop').classList.add('open');
        document.addEventListener('keydown', spModalEscHandler);
    };

    // Modaldan kalem çıkarma — yalnız modalın kendi durumunu değiştirir.
    // (Liste seçimi artık board'da; oradaki seçim modal kapanınca tazelemede sıfırlanır.)
    window.spModalRemoveRow = function(lineId) {
        delete SELECTED[lineId];
        var row = document.querySelector('#spResTbody tr[data-line-id="' + lineId + '"]');
        if (row) row.remove();
        if (!Object.keys(SELECTED).length) spCloseReserveModal();
    };

    window.spCloseReserveModal = function() {
        document.getElementById('spModalBackdrop').classList.remove('open');
        document.removeEventListener('keydown', spModalEscHandler);
    };

    window.spModalBackdropClick = function(event) {
        if (event.target && event.target.id === 'spModalBackdrop') spCloseReserveModal();
    };

    function spModalEscHandler(e) {
        if (e.key === 'Escape') spCloseReserveModal();
    }

    function spModalShowMsg(text, kind) {
        var el = document.getElementById('spResMsg');
        if (!text) { el.style.display = 'none'; el.textContent = ''; el.className = 'sp-res'; return; }
        el.textContent = text;
        el.className = 'sp-res ' + (kind === 'ok' ? 'sp-res--ok' : (kind === 'info' ? 'sp-res--info' : 'sp-res--err'));
        el.style.display = 'block';
    }

    // POST /Sales/CreateReservation — body { lines:[{orderLineId,qty}], locationId?, plannedShipDate?, notes? }
    // yanıt { ok, created:[{orderLineId,reserved,reason}], skipped:[{orderLineId,reason}] }
    window.spSubmitReservation = function() {
        var rows = document.querySelectorAll('#spResTbody tr');
        var lines = [];
        rows.forEach(function(tr) {
            var lineId = parseInt(tr.getAttribute('data-line-id'), 10);
            var isKit = tr.getAttribute('data-is-kit') === '1';
            var inp = tr.querySelector('.sp-modal-qty-input');
            var q = inp ? parseFloat((inp.value || '0').replace(',', '.')) : 0;
            if (isKit) q = Math.round(q); // set sayısı tam sayı olmalı
            if (q > 0) lines.push({ orderLineId: lineId, qty: q });
        });
        if (!lines.length) { spModalShowMsg('Lütfen en az bir kalem için miktar girin.', 'err'); return; }

        var locSel = document.getElementById('spResLocation');
        var locationId = locSel && locSel.value ? parseInt(locSel.value, 10) : null;
        var shipDateInp = document.getElementById('spResShipDate').value;
        var plannedShipDate = shipDateInp ? shipDateInp : null;
        var notes = document.getElementById('spResNotes').value || null;

        var okBtn = document.getElementById('spResOkBtn');
        var cnBtn = document.getElementById('spResCancelBtn');
        okBtn.disabled = true; cnBtn.disabled = true;
        spModalShowMsg('', '');

        fetch('/Sales/CreateReservation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': spCsrf() },
            body: JSON.stringify({ lines: lines, locationId: locationId, plannedShipDate: plannedShipDate, notes: notes }),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            okBtn.disabled = false; cnBtn.disabled = false;
            if (!d.ok) {
                spModalShowMsg(d.error || 'Rezervasyon oluşturulamadı.', 'err');
                return;
            }
            var created = d.created || [];
            var skipped = d.skipped || [];
            var resultEl = document.getElementById('spResResultList');
            var html = created.map(function(c) {
                var line = LINES.find(function(l) { return l.lineId === c.orderLineId; });
                var label = line ? (line.materialName || line.materialCode || ('#' + c.orderLineId)) : ('#' + c.orderLineId);
                return '<div class="sp-result-item sp-result-item--ok">✓ ' + esc(label) + ' — ' + fmtN(c.reserved) + ' rezerve edildi' + (c.reason ? ' (' + esc(c.reason) + ')' : '') + '</div>';
            }).concat(skipped.map(function(s) {
                var line = LINES.find(function(l) { return l.lineId === s.orderLineId; });
                var label = line ? (line.materialName || line.materialCode || ('#' + s.orderLineId)) : ('#' + s.orderLineId);
                return '<div class="sp-result-item sp-result-item--bad">✕ ' + esc(label) + ' — ' + esc(s.reason || 'Atlandı') + '</div>';
            })).join('');
            resultEl.innerHTML = html;
            document.getElementById('spResResultWrap').style.display = html ? 'block' : 'none';

            if (created.length && !skipped.length) {
                spModalShowMsg('✔ ' + created.length + ' kalem rezerve edildi.', 'ok');
            } else if (created.length && skipped.length) {
                spModalShowMsg('⚠ ' + created.length + ' kalem rezerve edildi, ' + skipped.length + ' kalem atlandı — aşağıya bakın.', 'info');
            } else {
                spModalShowMsg('✖ Hiçbir kalem rezerve edilemedi — aşağıya bakın.', 'err');
            }

            // Başarıyla rezerve edilen kalemleri seçimden düş; atlananlar tekrar denenebilsin diye kalır.
            created.forEach(function(c) { delete SELECTED[c.orderLineId]; });
            okBtn.style.display = 'none';
            cnBtn.textContent = 'Kapat';
            spBoardRefresh();   // in-place — window.location.reload YOK
            if (CalibraAlert && created.length) {
                CalibraAlert.show(created.length + ' kalem rezerve edildi.', { type: 'success', autoDismissMs: 2500 });
            }
        })
        .catch(function() {
            okBtn.disabled = false; cnBtn.disabled = false;
            spModalShowMsg('Bağlantı hatası — rezervasyon oluşturulamadı.', 'err');
        });
    };

    // ── Board köprüsü ───────────────────────────────────────────────────────
    // Rezervasyon modalı işini bitirince board'u tazeler ve seçimi temizler.
    var SP_BOARD_KEY = 'sales-shipment-planning';
    function spBoardRefresh() {
        var api = window.CalibraSmartBoard;
        if (!api) return;
        if (typeof api.clearSelection === 'function') api.clearSelection(SP_BOARD_KEY);
        if (typeof api.refresh === 'function') api.refresh(SP_BOARD_KEY);
    }

    // "Rezerve Et" toplu aksiyonu (SmartBoard type:"event") — seçili kalem id'leri
    // gelir; modal miktar/depo/tarih/not için kalemin TAM verisine ihtiyaç duyduğundan
    // açık kalemler tazece çekilip SELECTED kurulur.
    window.addEventListener('shipmentPlanning:reserve', function (e) {
        var ids = (e && e.detail && e.detail.ids) || [];
        if (!ids.length) return;
        fetch('/Sales/OpenOrderLinesForReservation?materialSearch=&orderNumber=', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (list) {
                if (!Array.isArray(list)) {
                    if (CalibraAlert) CalibraAlert.show((list && list.error) || 'Kalemler okunamadı.', { type: 'error' });
                    return;
                }
                LINES = list;
                SELECTED = {};
                ids.forEach(function (id) {
                    var l = list.find(function (x) { return x.lineId === id; });
                    if (l) SELECTED[id] = l;
                });
                if (!Object.keys(SELECTED).length) {
                    if (CalibraAlert) CalibraAlert.show('Seçilen kalemler artık açık değil — liste tazelendi.', { type: 'warning' });
                    spBoardRefresh();
                    return;
                }
                spOpenReserveModal();
            })
            .catch(function () {
                if (CalibraAlert) CalibraAlert.show('Bağlantı hatası — kalemler okunamadı.', { type: 'error' });
            });
    });

    // ── Rezervasyonlar modalı ────────────────────────────────────────────────
    // Satır İşlemler menüsü → "Rezervasyonlar" (type:"event"). Veri:
    // GET /Sales/ShipmentPlanningLineDetail?lineId=.. → { ok, empty, columns, rowActions, rows }.
    // rowActions[].apiUrl + idsField sözleşmesi: POST { [idsField]: [rowId] }.
    var RESV_LINE_ID = null;
    var RESV_ROW_ACTIONS = [];
    var RESV_BUSY = false;

    function spResvStatusBadgeClass(status) {
        if (status === 'Yüklendi') return 'sp-resv-badge--shipped';
        if (status === 'İptal') return 'sp-resv-badge--cancelled';
        return 'sp-resv-badge--active';
    }

    function spResvRenderRows(data) {
        var cols = Array.isArray(data.columns) ? data.columns : [];
        var rows = Array.isArray(data.rows) ? data.rows : [];
        RESV_ROW_ACTIONS = Array.isArray(data.rowActions) ? data.rowActions : [];
        var wrap = document.getElementById('spResvBody');

        if (!rows.length) {
            wrap.innerHTML = '<div class="sp-resv-state">' + esc(data.empty || 'Kayıt yok.') + '</div>';
            return;
        }

        var theadHtml = cols.map(function (c) {
            return '<th style="text-align:' + (c.align || 'left') + ';' + (c.width ? ('width:' + c.width + 'px;') : '') + '">' + esc(c.label) + '</th>';
        }).join('') + (RESV_ROW_ACTIONS.length ? '<th style="width:1%;"></th>' : '');

        var tbodyHtml = rows.map(function (r) {
            var tds = cols.map(function (c) {
                var v = r[c.key];
                if (c.key === 'status') {
                    return '<td style="text-align:' + (c.align || 'left') + ';"><span class="sp-resv-badge ' + spResvStatusBadgeClass(v) + '">' + esc(v) + '</span></td>';
                }
                return '<td style="text-align:' + (c.align || 'left') + ';">' + esc(v == null || v === '' ? '—' : v) + '</td>';
            }).join('');
            var isActive = r.status === 'Aktif';
            var actionsHtml = '';
            if (RESV_ROW_ACTIONS.length) {
                actionsHtml = '<td><div class="sp-resv-actions">' + RESV_ROW_ACTIONS.map(function (a) {
                    var cls = a.variant === 'danger' ? 'sp-resv-abtn--danger' : 'sp-resv-abtn--primary';
                    return '<button type="button" class="sp-resv-abtn ' + cls + '"' + (isActive ? '' : ' disabled')
                        + ' onclick="spResvRunRowAction(\'' + a.id + '\',' + r.id + ')">' + esc(a.label) + '</button>';
                }).join('') + '</div></td>';
            }
            return '<tr data-resv-id="' + r.id + '">' + tds + actionsHtml + '</tr>';
        }).join('');

        wrap.innerHTML = '<div class="sp-modal-tablewrap"><table class="sp-modal-tbl"><thead><tr>' + theadHtml + '</tr></thead><tbody>' + tbodyHtml + '</tbody></table></div>';
    }

    function spResvLoad(lineId) {
        document.getElementById('spResvBody').innerHTML = '<div class="sp-resv-state">Yükleniyor…</div>';
        spModalShowMsgIn('spResvMsg', '', '');
        fetch('/Sales/ShipmentPlanningLineDetail?lineId=' + encodeURIComponent(lineId), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || data.ok === false) {
                    document.getElementById('spResvBody').innerHTML = '<div class="sp-resv-state">' + esc((data && data.error) || 'Rezervasyon detayı yüklenemedi.') + '</div>';
                    return;
                }
                spResvRenderRows(data);
            })
            .catch(function () {
                document.getElementById('spResvBody').innerHTML = '<div class="sp-resv-state">Bağlantı hatası — rezervasyon detayı yüklenemedi.</div>';
            });
    }

    function spModalShowMsgIn(elId, text, kind) {
        var el = document.getElementById(elId);
        if (!el) return;
        if (!text) { el.style.display = 'none'; el.textContent = ''; el.className = 'sp-res'; return; }
        el.textContent = text;
        el.className = 'sp-res ' + (kind === 'ok' ? 'sp-res--ok' : (kind === 'info' ? 'sp-res--info' : 'sp-res--err'));
        el.style.display = 'block';
    }

    // Satır aksiyonu (Yükle/İptal) — confirm ZORUNLU: destrüktif/geri alınamaz
    // işlem, ekran-ortası custom modal (window.showConfirm), native confirm YOK.
    window.spResvRunRowAction = function (actionId, rowId) {
        if (RESV_BUSY) return;
        var action = RESV_ROW_ACTIONS.find(function (a) { return a.id === actionId; });
        if (!action) return;

        function run() {
            RESV_BUSY = true;
            var idsField = action.idsField || 'ids';
            var body = {};
            body[idsField] = [rowId];
            fetch(action.apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': spCsrf() },
                body: JSON.stringify(body),
            })
            .then(function (r) { return r.text().then(function (txt) { return { status: r.status, ok: r.ok, txt: txt }; }); })
            .then(function (res) {
                var data = null;
                if (res.txt) { try { data = JSON.parse(res.txt); } catch (e) { /* JSON degil */ } }
                var failMsg = data && (data.error || data.message);
                if (!res.ok || (data && (data.ok === false || data.success === false))) {
                    spModalShowMsgIn('spResvMsg', failMsg || ('İstek başarısız (HTTP ' + res.status + ')'), 'err');
                    return;
                }
                spModalShowMsgIn('spResvMsg', 'İşlem tamamlandı.', 'ok');
                if (CalibraAlert) CalibraAlert.show('İşlem tamamlandı.', { type: 'success', autoDismissMs: 2200 });
                if (RESV_LINE_ID != null) spResvLoad(RESV_LINE_ID);
                spBoardRefresh();   // in-place — window.location.reload YOK
            })
            .catch(function (err) {
                spModalShowMsgIn('spResvMsg', 'Bağlantı hatası: ' + err.message, 'err');
            })
            .finally(function () { RESV_BUSY = false; });
        }

        if (action.confirm) {
            window.showConfirm({
                title: action.variant === 'danger' ? 'İptal Onayı' : 'Yükleme Onayı',
                message: action.confirm,
                okLabel: action.variant === 'danger' ? 'Evet, İptal Et' : 'Evet, Yükle',
                danger: action.variant === 'danger',
            }).then(function (ok) { if (ok) run(); });
        } else {
            run();
        }
    };

    window.spCloseReservationsModal = function () {
        document.getElementById('spResvModalBackdrop').classList.remove('open');
        document.removeEventListener('keydown', spResvEscHandler);
        RESV_LINE_ID = null;
    };
    window.spResvBackdropClick = function (event) {
        if (event.target && event.target.id === 'spResvModalBackdrop') spCloseReservationsModal();
    };
    function spResvEscHandler(e) {
        if (e.key === 'Escape') spCloseReservationsModal();
    }

    // "Rezervasyonlar" satır İşlemler menüsü (SmartBoard type:"event") — event.detail.id
    // (SmartTableRow tekil satır id'si gönderir; ids[] de aynı tek elemanla dolu gelir).
    window.addEventListener('shipmentPlanning:reservations', function (e) {
        var lineId = e && e.detail && (e.detail.id != null ? e.detail.id : (e.detail.ids && e.detail.ids[0]));
        if (lineId == null) return;
        RESV_LINE_ID = lineId;
        var subtitleEl = document.getElementById('spResvSubtitle');
        var line = LINES.find(function (l) { return l.lineId === lineId; });
        subtitleEl.textContent = line
            ? ((line.materialName || line.materialCode || ('#' + lineId)) + (line.orderNumber ? ' — ' + line.orderNumber : ''))
            : ('Kalem #' + lineId);
        document.getElementById('spResvModalBackdrop').classList.add('open');
        document.addEventListener('keydown', spResvEscHandler);
        spResvLoad(lineId);
        // LINES cache'i bos olabilir (rezerve modali hic acilmadiysa) — subtitle'i
        // dolduran acik kalem listesini arka planda tazele, gelince yeniden yaz.
        if (!line) {
            fetch('/Sales/OpenOrderLinesForReservation?materialSearch=&orderNumber=', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (list) {
                    if (!Array.isArray(list)) return;
                    LINES = list;
                    var l2 = list.find(function (x) { return x.lineId === lineId; });
                    if (l2 && RESV_LINE_ID === lineId) {
                        subtitleEl.textContent = (l2.materialName || l2.materialCode || ('#' + lineId)) + (l2.orderNumber ? ' — ' + l2.orderNumber : '');
                    }
                })
                .catch(function () { /* sessiz — subtitle fallback zaten gosteriliyor */ });
        }
    });

    // ── SmartBoard mount (Machines/MaterialCards deseni) ────────────────────
    (function mountBoard() {
        var el = document.getElementById('spBoard');
        if (!el) return;
        var BOARD_CONFIG = window.__SP_BOARD_CONFIG__;
        function showError(msg) {
            el.innerHTML = '<div style="padding:48px 16px;text-align:center;color:#94a3b8;font-size:.85rem;">' + msg + '</div>';
        }
        function doMount() {
            if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) { showError('SmartBoard yüklenemedi.'); return; }
            try { window.CalibraHub.mountSmartBoard(el, BOARD_CONFIG); }
            catch (err) { showError('Liste çizilemedi.'); }
        }
        if (window.CalibraHub && window.CalibraHub.mountSmartBoard) { doMount(); return; }
        var sc = document.createElement('script');
        sc.src = window.__SP_BUNDLE_URL__;
        sc.onload = function () { setTimeout(doMount, 0); };
        sc.onerror = function () { showError('Bundle yüklenemedi.'); };
        document.head.appendChild(sc);
    })();
})();
</script>
}
