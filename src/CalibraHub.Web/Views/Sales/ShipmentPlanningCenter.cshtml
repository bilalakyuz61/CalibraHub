    }
    .sp-resv-abtn--primary { background:rgba(99,102,241,.14); border-color:rgba(99,102,241,.3); color:#a5b4fc; }
    .sp-resv-abtn--primary:hover { background:rgba(99,102,241,.22); }
    .sp-resv-abtn--danger { background:rgba(239,68,68,.1); border-color:rgba(239,68,68,.25); color:#fca5a5; }
    .sp-resv-abtn--danger:hover { background:rgba(239,68,68,.18); }
    .sp-resv-abtn:disabled { opacity:.35; cursor:not-allowed; }
    body.app-theme-light .sp-resv-state { color:#64748b; }
    body.app-theme-light .sp-resv-badge--active { background:#eef2ff; color:#4338ca; }
    body.app-theme-light .sp-resv-badge--shipped { background:#ecfdf5; color:#059669; }
    body.app-theme-light .sp-resv-badge--cancelled { background:#fef2f2; color:#dc2626; }
    body.app-theme-light .sp-resv-abtn--primary { background:#eef2ff; border-color:#c7d2fe; color:#4338ca; }
    body.app-theme-light .sp-resv-abtn--primary:hover { background:#e0e7ff; }
    body.app-theme-light .sp-resv-abtn--danger { background:#fef2f2; border-color:#fecaca; color:#dc2626; }
    body.app-theme-light .sp-resv-abtn--danger:hover { background:#fee2e2; }
</style>
}

<section class="integrator-dashboard integrator-dashboard--wide integrator-dashboard__content">
<div class="sp-outer" id="spOuter">
    @* Liste TAMAMEN CalibraSmartBoard (tablo modu): başlık şeridi, arama, filtre,
       dışa aktarım, gruplama ve sütun ayarları standart bileşenden gelir — bu ekran
       artık kendi başlığını/tablosunu çizmez. Ekrana özel olan tek şey rezervasyon
       akışıdır: "Rezerve Et" toplu aksiyonu type:"event" ile aşağıdaki modalı açar,
       satır detayı o kalemin rezervasyonlarını (Yükle/İptal ile) listeler.
       Config: SalesController.BuildShipmentPlanningBoard *@
    <div id="spBoard" style="flex:1 1 auto;min-height:0;overflow:hidden;"></div>
</div>
</section>

@Html.AntiForgeryToken()

@* ── Rezervasyon modalı ── *@
<div class="sp-modal-backdrop" id="spModalBackdrop" onclick="spModalBackdropClick(event)">
    <div class="sp-modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
        <div class="sp-modal-hd">
            <div class="sp-modal-hd-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="sp-modal-hd-tx">
                <strong>Depodan Rezerve Et</strong>
                <small>Seçili sipariş kalemleri için mantıksal stok rezervasyonu oluşturur</small>
            </div>
            <button type="button" class="sp-modal-close" onclick="spCloseReserveModal()" title="Kapat (Esc)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="sp-field-row">
                <div class="sp-field">
                    <label>Depo</label>
