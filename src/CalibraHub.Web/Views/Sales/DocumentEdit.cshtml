            var data = await resp.json();
            // invalidLineIds varsa: belge DB'de olustu/guncellendi ama satirlardan bazilarinda
            // zorunlu widget eksik. ⚙ butonlari kirmizi yanip titresir, KITT tetiklenmez.
            var invalidLineIds = Array.isArray(data.invalidLineIds) ? data.invalidLineIds : [];
            if (!data.success) {
                if (data.quote && data.quote.id) {
                    currentQuoteId = data.quote.id;
                    var sqNumEl = document.getElementById('sqQuoteNumber');
                    if (sqNumEl && data.quote.documentNumber) sqNumEl.value = data.quote.documentNumber;
                    var sqMetaErr = document.getElementById('sqMeta');
                    if (sqMetaErr) sqMetaErr.innerHTML = '<strong>' + (data.quote.documentNumber || '') + '</strong>';
                    // ── ÖNCE: row.__extras sync (refresh ROW state'i ezeceği için onun ONCESINDE) ──
                    // 2026-06-01: Satir kaydedilmemis iken kullanici modal'dan __extras girdiyse,
                    // success=false'da bile bu degerleri kaybetmeyelim — server'dan refLines aldiktan
                    // sonra siraya gore widget API'sine POST edelim. Boylece sonraki ana Kaydet'te
                    // satir gecerli sayilir.
                    try {
                        var refResp0 = await fetch('/Sales/GetQuote?id=' + currentQuoteId);
                        if (refResp0.ok) {
                            var refData0  = await refResp0.json();
                            var refLines0 = Array.isArray(refData0.lines) ? refData0.lines : [];
                            console.log('[SQ-EXTRAS-SYNC fail-path] refLines=' + refLines0.length + ', rowsFilled=' + rowsFilled.length);
                            for (var ii = 0; ii < rowsFilled.length && ii < refLines0.length; ii++) {
                                var lrr = rowsFilled[ii];
                                if (!lrr.__extras || Object.keys(lrr.__extras).length === 0) continue;
                                var tId = refLines0[ii].id;
                                if (!(tId > 0)) continue;
                                try {
                                    console.log('[SQ-EXTRAS-SYNC fail-path] POST', { targetId: tId, code: lrr.materialCode, values: lrr.__extras });
                                    var xResp = await fetch('/api/widgets/forms/@(lineFormCode)/records/' + encodeURIComponent(String(tId)), {
                                        method: 'POST',
                                        credentials: 'same-origin',
                                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        // KURTARMA yolu: ana kayit basarisiz oldu, amac kullanicinin
                                        // girdigi degerleri kaybetmemek. Burada zorunlu dayatmak
                                        // kurtarmanin kendisini dusururdu → her zaman kapali.
                                        body: JSON.stringify({ values: lrr.__extras, grids: null, enforceRequired: false }),
                                    });
                                    var xText = '';
                                    try { xText = await xResp.text(); } catch(_) {}
                                    console.log('[SQ-EXTRAS-SYNC fail-path] response', { targetId: tId, status: xResp.status, body: xText });
                                    // Bu satir artik gecerli — invalidLineIds'den çıkar
                                    var idx = invalidLineIds.indexOf(tId);
                                    if (idx !== -1) invalidLineIds.splice(idx, 1);
                                } catch (xErr) {
                                    console.warn('[SQ] fail-path extras POST hatasi (id=' + tId + '):', xErr);
                                }
                            }
                        }
                    } catch (syncErrPre) {
                        console.warn('[SQ] fail-path extras pre-sync hatasi:', syncErrPre);
                    }
                    // Satirlari yeniden cek ki line.id'ler gunce olsun + widget state yenilensin.
                    try {
                        var refreshResp = await fetch('/Sales/GetQuote?id=' + currentQuoteId);
                        if (refreshResp.ok) {
                            var refreshData = await refreshResp.json();
                            var refreshedLines = (refreshData.lines || []).map(function (ln) {
                                var m = (materials || []).find(function (x) { return x.id === ln.itemId });
                                return Object.assign({}, ln, {
                                    stockCardId:       ln.itemId,
                                    trackCombinations: m ? m.trackCombinations === true : false,
                                    taxRate:           ln.taxRate != null ? ln.taxRate : (m && m.taxRate != null ? m.taxRate : 20),
                                });
                            });
                            if (window.CalibraHub && window.CalibraHub.salesLineGrid) {
                                window.CalibraHub.salesLineGrid.setRows(refreshedLines);
                            }
                        }
                    } catch (refreshErr) { /* ignore */ }
                }
                // 2026-06-01: Pre-sync ile tum eksik widget'lar dolduysa, kullaniciya
                // "basarisiz" gostermek yerine yesil onay ver — gercekten dokumandaki
                // tum satirlar artik gecerli. setInvalidLines bos array ile temizler,
                // toast OK gosterilir.
                if (invalidLineIds.length === 0 && data.quote && data.quote.id) {
                    console.log('[SQ-EXTRAS-SYNC fail-path] tum extras\'lar fixed, success kabul ediliyor');
                    if (window.CalibraHub && window.CalibraHub.salesLineGrid
                        && typeof window.CalibraHub.salesLineGrid.setInvalidLines === 'function') {
                        window.CalibraHub.salesLineGrid.setInvalidLines([]);
                    }
                    if (window.CalibraHub && window.CalibraHub.toast) {
                        window.CalibraHub.toast('Kaydedildi — ek alanlar başarıyla işlendi.', 'ok');
                    }
                    return;
                }
                // Ekrani uyari modalı ile kesmeyelim — sadece gorsel feedback (⚙ kirmiziya dons+titre).
                // Kullanici baska bir sekmedeyse once Kalemler sekmesine yonlendir. Tab gecis +
                // titre tek rAF icinde — panel "genislemeden" once butonlar kirmizi+titre halinde
                // gorunur, kullanici layout'un iki defa yerlesmesini hissetmez.
                if (invalidLineIds.length > 0) {
                    // Onceden ⚙ state'ini kirmiziya cevir ki tab acildiginda direk kirmizi gorunsunler.
                    if (window.CalibraHub && window.CalibraHub.salesLineGrid
                        && typeof window.CalibraHub.salesLineGrid.setInvalidLines === 'function') {
                        window.CalibraHub.salesLineGrid.setInvalidLines(invalidLineIds);
                    }
                    // Tab'a gecis — sqActivateTab senkron, display:block atar.
                    if (typeof sqActivateTab === 'function') sqActivateTab('lines');
                    // Shake animasyonunu bir rAF sonra tetikle ki DOM gorunur hale geldikten sonra
                    // calışsın. Panel-genisleme hissini azaltmak icin setTimeout(200) kullanmiyoruz.
                    // 2026-06-02: Silent save'lerde (malzeme rehberinden auto-tetiklenen)
                    // kullaniciya titreme gostermeyelim — daha alanlari doldurma firsati
                    // bulamadan "titriyor" hissi veriyor. Sadece kirmizi rengi set et;
                    // explicit Kaydet basildiginda shake animasyonu calissin.
                    if (!_silent) {
                        requestAnimationFrame(function () {
                            if (window.CalibraHub && window.CalibraHub.salesLineGrid
                                && typeof window.CalibraHub.salesLineGrid.flashInvalidLines === 'function') {
                                window.CalibraHub.salesLineGrid.flashInvalidLines(invalidLineIds);
                            }
                        });
                    }
                }
                if (data.message && !invalidLineIds.length) {
                    // 2026-05-23: Eskiden sadece console.warn'a yaziyordu — kullanici hatayi
                    // F12 acmadan goremiyordu. Artik sag alt kose toast'ina dusurulur.
                    console.warn('[SQ] save failed:', data.message);
                    if (window.CalibraHub && window.CalibraHub.toast) {
                        window.CalibraHub.toast(data.message, 'err');
                    }
                }
                return;
            }
            currentQuoteId = data.quote.id;
            // Kaydedilen satir Id'lerini grid'e geri yaz (yanittaki lines, LineNo sirasinda).
            // Ozellikle sessiz kayitta (malzeme secimi tetikler) grid satirlari Id'siz
            // kaliyordu; bir sonraki kayit Id'siz payload ile satirlari DELETE+INSERT
            // ediyor, audit'e "Kalem Silindi + Eklendi" dusuyor ve satir widget'lari
            // (WidgetTra) orphan kaliyordu (TKL202600000002 vakasi, 2026-07-10).
            if (Array.isArray(data.lines) && window.CalibraHub && window.CalibraHub.salesLineGrid
                && typeof window.CalibraHub.salesLineGrid.mergeSavedLineIds === 'function') {
                try { window.CalibraHub.salesLineGrid.mergeSavedLineIds(data.lines); } catch (_) {}
            }
            // Basarili kayit sonrasi: eksik yok, grid'e temiz state sinyali ver.
            if (window.CalibraHub && window.CalibraHub.salesLineGrid
                && typeof window.CalibraHub.salesLineGrid.setInvalidLines === 'function') {
                window.CalibraHub.salesLineGrid.setInvalidLines([]);
            }
            document.getElementById('sqQuoteNumber').value = data.quote.documentNumber;
            document.getElementById('sqBtnDelete').disabled = false;
            // ERP'ye Aktar dropdown items'i icin record-id'yi guncelle ve yeniden tara
