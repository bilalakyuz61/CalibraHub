    function sqRepRenderList(filter) {
        var list = document.getElementById('sqSalesRepList');
        if (!list) return;
        var q = (filter || '').toLowerCase().trim();
        var matches = q ? _sqRepsData.filter(function (r) { return r.repName.toLowerCase().includes(q); }) : _sqRepsData;
        var curVal = document.getElementById('sqSalesRepId').value;
        var html = '<div class="sqe-rep-option sqe-rep-empty" data-val="" role="option"' +
            (curVal === '' ? ' class="sqe-rep-option sqe-rep-empty is-selected" ' : '') + '>— Seçiniz —</div>';
        if (matches.length === 0) {
            html += '<div class="sqe-rep-no-result">Sonuç bulunamadı</div>';
        } else {
            matches.forEach(function (r) {
                var sel = String(r.id) === String(curVal) ? ' is-selected' : '';
                html += '<div class="sqe-rep-option' + sel + '" data-val="' + r.id + '" role="option">' + sqEscHtml(r.repName) + '</div>';
            });
        }
        list.innerHTML = html;
    }

    function sqEscHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function sqRepOpen() {
        var btn   = document.getElementById('sqSalesRepBtn');
        var panel = document.getElementById('sqSalesRepPanel');
        var filter = document.getElementById('sqSalesRepFilter');
        if (!btn || !panel) return;
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        filter.value = '';
        sqRepRenderList('');
        filter.focus();
        var selected = panel.querySelector('.is-selected');
        if (selected) selected.scrollIntoView({ block: 'nearest' });
    }

    function sqRepClose() {
        var btn   = document.getElementById('sqSalesRepBtn');
        var panel = document.getElementById('sqSalesRepPanel');
        if (!panel) return;
        panel.hidden = true;
        btn && btn.setAttribute('aria-expanded', 'false');
    }

    function sqRepSelect(val) {
        var rep = _sqRepsData.find(function (r) { return String(r.id) === String(val); });
        var label = document.getElementById('sqSalesRepLabel');
        var hidden = document.getElementById('sqSalesRepId');
        if (!label || !hidden) return;
        if (!val || !rep) {
            hidden.value = '';
            label.textContent = 'Seçiniz';
            label.classList.add('is-placeholder');
        } else {
            hidden.value = rep.id;
            label.textContent = rep.repName;
            label.classList.remove('is-placeholder');
        }
        sqRepClose();
    }

    function sqSetSalesRep(id) {
        sqRepSelect(id == null ? '' : String(id));
