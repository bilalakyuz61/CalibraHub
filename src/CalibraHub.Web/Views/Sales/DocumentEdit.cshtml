    function sqRepWireHiddenField() {
        // attachGuide fillMap dogrudan .value ataması yaptiğinda display'i senkronize et
        var el = document.getElementById('sqSalesRepId');
        if (!el || el._sqWired) return;
        el._sqWired = true;
        var _val = el.value;
        Object.defineProperty(el, 'value', {
            configurable: true,
            get: function () { return _val; },
            set: function (v) {
                _val = String(v == null ? '' : v);
                var rep = _sqRepsData.find(function (r) { return String(r.id) === _val; });
                var label = document.getElementById('sqSalesRepLabel');
                if (label) {
                    if (rep) { label.textContent = rep.repName; label.classList.remove('is-placeholder'); }
                    else     { label.textContent = 'Seçiniz';   label.classList.add('is-placeholder'); }
                }
            }
        });
    }

    document.addEventListener('click', function (e) {
        var wrapper = document.getElementById('sqSalesRepWrapper');
        if (wrapper && !wrapper.contains(e.target)) sqRepClose();
    });

    document.addEventListener('DOMContentLoaded', function () {
        var btn    = document.getElementById('sqSalesRepBtn');
        var filter = document.getElementById('sqSalesRepFilter');
        var list   = document.getElementById('sqSalesRepList');
        if (!btn) return;

        btn.addEventListener('click', function () {
            var panel = document.getElementById('sqSalesRepPanel');
            if (panel && panel.hidden) sqRepOpen(); else sqRepClose();
        });

        if (filter) {
            filter.addEventListener('input', function () { sqRepRenderList(filter.value); });
            filter.addEventListener('keydown', function (e) {
                var opts = list ? list.querySelectorAll('.sqe-rep-option:not(.sqe-rep-no-result)') : [];
                var active = list ? list.querySelector('.is-active') : null;
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    var idx = active ? Array.from(opts).indexOf(active) : -1;
                    if (active) active.classList.remove('is-active');
                    var next = e.key === 'ArrowDown' ? opts[idx + 1] || opts[0] : opts[idx - 1] || opts[opts.length - 1];
                    if (next) { next.classList.add('is-active'); next.scrollIntoView({ block: 'nearest' }); }
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    var target = active || (opts.length === 1 ? opts[0] : null);
                    if (target) sqRepSelect(target.dataset.val);
                } else if (e.key === 'Escape') {
                    sqRepClose();
                }
            });
        }

        if (list) {
            list.addEventListener('click', function (e) {
                var opt = e.target.closest('.sqe-rep-option');
                if (opt) sqRepSelect(opt.dataset.val);
            });
        }
    });

