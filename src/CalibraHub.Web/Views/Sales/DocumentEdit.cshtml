        //   window.CalibraHub.salesLineGrid.getRows() gibi diger auto-save cagrilari her zaman
        //   ({silent:true}) gibi acikca bir opts objesi geciyor — bu varsayilan sadece hicbir
        //   arguman verilmeyen cagriyi etkiler.
        var _silent   = !!(opts && opts.silent);
        var _validate = opts ? !!opts.validate : true;

        if (_validate) {
            // ── Ek alan (widget) zorunlu kontrolu ──────────────────────────────
            if (window._sqDynRenderer && window._sqDynRenderer.validate) {
                var dynValidation = window._sqDynRenderer.validate();
