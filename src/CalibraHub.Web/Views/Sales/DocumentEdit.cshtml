    // Bağlantı kilitleri: /Sales/GetQuote yanıtındaki data.lineLocks ([{lineId,minQuantity,reason}])
    // grid satırlarına iliştirilir. Grid `__canDelete=false` ile silmeyi engeller,
    // `__minQty` ile miktarın taban altına düşürülmesini önler (SaveQuoteAsync ile aynı taban).
    function sqApplyLineLocks(lines, lineLocks) {
        if (!Array.isArray(lines) || !Array.isArray(lineLocks) || lineLocks.length === 0) return lines;
        var byId = {};
        lineLocks.forEach(function (lk) { if (lk && lk.lineId != null) byId[String(lk.lineId)] = lk; });
        return lines.map(function (ln) {
            var lk = byId[String(ln.id)];
            if (!lk) return ln;
            return Object.assign({}, ln, {
                __canDelete:        false,
                __minQty:           lk.minQuantity,
                __deleteLockReason: lk.reason,
            });
        });
    }

    async function sqLoadQuote(id, prefetchedData) {
        try {
            var data = prefetchedData;
            if (!data) {
                var resp = await fetch('/Sales/GetQuote?id=' + id);
                if (!resp.ok) throw new Error('GetQuote HTTP ' + resp.status + ' — id: ' + id);
                data = await resp.json();
            }
            if (!data || !data.quote) throw new Error('GetQuote bos veya gecersiz yanit dondu.');
            var q = data.quote;
            currentQuoteId = q.id;
            // Iyimser eszamanlilik damgasi (2026-08-27): belgeyi actigimiz andaki surum.
            // Kaydederken geri gonderilir; arada baskasi kaydettiyse sunucu reddeder.
            window.__CALIBRA_ROW_VERSION__ = q.rowVersion || null;
            document.getElementById('sqQuoteNumber').value = q.documentNumber || '';
            var docDate = q.documentDate || q.quoteDate;
            window.sqSetDateValue('sqQuoteDate', docDate ? docDate.split('T')[0] : '');
            // Sipariste DeliveryDate/Days kolonu, teklifte ValidUntil — UI ayni input'a yazar.
            // DeliveryDays varsa direkt yaz (kullanici "5 gun" girmis), yoksa tarihten hesapla.
            var __ldIsOrder = @(isOrder ? "true" : "false");
            var __ldDate = __ldIsOrder ? q.deliveryDate : q.validUntil;
            window.sqSetDateValue('sqValidUntil', __ldDate ? __ldDate.split('T')[0] : '');
            if (__ldIsOrder && q.deliveryDays != null) {
                document.getElementById('sqValidDays').value = q.deliveryDays;
            } else {
                sqRecalcDaysFromValid();
            }
            document.getElementById('sqCustomerId').value = q.contactId != null ? q.contactId : '';
            // Rehber display alanını doldur — Cari Kod + Cari İsim
            var custDisp = document.getElementById('sqCustomerDisplay');
            // Cari Kod alani yalnizca AccountCode'u gosterir; isim ayri alanda
            custDisp.value = q.contactCode || '';
            custDisp.setAttribute('data-value', q.contactCode || '');
            // data-display: bridge initial display state'i icin — adres/baslik gosterimi
            custDisp.setAttribute('data-display', q.contactName || q.contactCode || '');
            // FixedFieldLookupBridge mount edildikten SONRA bu satir async olarak deger yaziyor;
            // ffl-sync event'i bridge'a "DOM degisti, state'i tazele" sinyali verir. Aksi halde
            // bridge React state'i bos kaliyor ve kullanici Cari Kod input'unu bos goruyor.
            try { custDisp.dispatchEvent(new CustomEvent('ffl-sync', { bubbles: true })); } catch (_) {}
            document.getElementById('sqCustomerName').textContent = q.contactName || '';
            sqSetSalesRep(q.salesRepId);
            try {
                var reqEl = document.getElementById('sqRequesterId');
                if (reqEl && q.requesterPersonnelId) reqEl.value = q.requesterPersonnelId;
            } catch (_) {}
            // Backend artik currencyId (FK) gonderir; geri uyum icin string currency
            // alani da gelir ama biz ID'yi authoritative sayariz.
            sqSetCurrencyById(q.currencyId || 1);
            // Seq 1067/1068: kur + KDV Dahil yükle (sqSetCurrencyById sonrası — o TRY'de kuru 1'e sıfırlar).
            var _rateEl = document.getElementById('sqExchangeRate');
            if (_rateEl && q.exchangeRate != null && (q.currencyId || 1) !== 1) _rateEl.value = q.exchangeRate;
            // 2026-08-06: kaydedilmiş kur tarihi — kurun hangi güne ait olduğu korunur. Yoksa
            // (eski kayıt) belge tarihine düşülür ki alan boş kalmasın.
            if ((q.currencyId || 1) !== 1) {
                var _rdVal = q.rateDate ? String(q.rateDate).split('T')[0]
                           : (docDate ? String(docDate).split('T')[0] : '');
                if (_rdVal) window.sqSetDateValue('sqRateDate', _rdVal);
            }
            var _vatIncEl = document.getElementById('sqVatIncluded');
            if (_vatIncEl) _vatIncEl.checked = !!q.isVatIncluded;
            var _drEl2 = document.getElementById('sqDiscountRate'); if (_drEl2) _drEl2.value = q.discountRate ?? 0;
            document.getElementById('sqPaymentTerms').value = q.paymentTerms || '';
            document.getElementById('sqDeliveryTerms').value = q.deliveryTerms || '';
            document.getElementById('sqDeliveryAddress').value = q.deliveryAddress || '';
            var sqNotesEl2 = document.getElementById('sqNotes');
            sqNotesEl2.value = q.notes || '';
            autoResizeTextarea(sqNotesEl2);
            document.getElementById('sqBtnDelete').disabled = false;
            // sqStatusSelect kalici sekilde gizli — durum degisikligi Islemler dropdown'undan
            // (sqActionStatus) yapiliyor; eskiden inline acilan select kaldirildi.
            document.getElementById('sqStatusSelect').value = q.status;
            document.getElementById('sqStatusBadge').innerHTML = '<span class="sqe-status-badge sqe-status-' + q.status + '">' + statusLabel(q.status) + '</span>';

            var custName = q.contactName || '';
            var tabTitle = q.documentNumber || 'Teklif';
            document.title = tabTitle + (custName ? ' - ' + custName : '') + ' - CalibraHub';

            // Header kartinda baslik + subtitle'i guncelle (MaterialCardEdit pattern'i)
            var sqMetaEl = document.getElementById('sqMeta');
            if (sqMetaEl) sqMetaEl.innerHTML = '<strong>' + tabTitle + '</strong>' + (custName ? ' — ' + custName : '');
            var wsTab = document.querySelector('[data-workspace-title]');
            if (wsTab) wsTab.setAttribute('data-workspace-title', tabTitle + (custName ? ' — ' + custName : ''));
            try {
                var activeTab = parent.document.querySelector('.workspace-tabs__scroller .workspace-tab.is-active .workspace-tab__label');
                if (activeTab) activeTab.textContent = tabTitle;
                var activeTabEl = parent.document.querySelector('.workspace-tabs__scroller .workspace-tab.is-active');
                if (activeTabEl) activeTabEl.title = tabTitle + (custName ? ' — ' + custName : '');
            } catch(e) {}

            // React grid'e initial satirlari ver (bridge kuyruklar eger hazir degilse).
            // ln.itemId DB source-of-truth; materialCode/materialName/combinationCode ise server
            // JOIN ile Item + ProductConfiguration'dan turetilen display degerler. Grid row
            // stockCardId alani icin itemId'yi kullanir (legacy alias).
            // Sipariş seri rezervasyonu: satır-seri eşlemesini çek (sipariş dışı belgede boş döner → no-op).
            var _serialMap = {};
            try {
                var _srResp = await fetch('/Sales/GetDocumentLineSerials?documentId=' + (q.id || 0));
                if (_srResp.ok) _serialMap = (await _srResp.json()) || {};
            } catch (e) { /* seri yoksa sorun değil */ }

            var initialLines = (data.lines || []).map(function (ln) {
                var m = (materials || []).find(function (x) { return x.id === ln.itemId });
                return Object.assign({}, ln, {
                    stockCardId:       ln.itemId,
                    trackCombinations: m ? m.trackCombinations === true : false,
                    trackSerial:       m ? m.trackSerial === true : false,
                    autoSerial:        m ? m.autoSerial === true : false,
                    serials:           _serialMap[String(ln.id)] || [],
                    taxRate:           ln.taxRate != null ? ln.taxRate : (m && m.taxRate != null ? m.taxRate : 20),
                });
            });
            initialLines = sqApplyLineLocks(initialLines, data.lineLocks);
            setGridRows(initialLines);
            sqRecalc();

            // Kalemi olan belgelerde cari kodu degistirilemez
            window.applyCustomerLock(initialLines.length > 0);

            // Satirlardaki eksik zorunlu widget bilgisi (⚙ rengi icin)
            var initialInvalid = Array.isArray(data.invalidLineIds) ? data.invalidLineIds : [];
            // Grid hazir olana kadar kucuk bir delay — setRows sonrasi state'i bas.
            setTimeout(function () {
                if (window.CalibraHub && window.CalibraHub.salesLineGrid
                    && typeof window.CalibraHub.salesLineGrid.setInvalidLines === 'function') {
                    window.CalibraHub.salesLineGrid.setInvalidLines(initialInvalid);
                }
            }, 80);

            // Ek alanlar renderer'ina integer Id'yi recordId olarak yansit.
            // Polling: renderer ve ic handleRef hazir olana kadar bekle, sonra reload.
            if (q.id) sqReloadRenderer(String(q.id));

            // Belge + kalem gridi burada TAM yuklenmis sayilir — derin-link autoAction
            // (varsa) burada tetiklenir. Bkz. sqRunAutoAction.
            sqRunAutoAction(initialLines.length);
        } catch (e) {
            console.error('sqLoadQuote hatasi:', e);
            CalibraAlert.error('Teklif yuklenemedi: ' + e.message);
        }
    }

    // ── İhtiyaç Kaydından Teklif Pre-fill ────────────────────────────────────
    // fromRequestId varsa ihtiyaç kaydının kalemlerini alır, fiyat=0 olarak
    // yeni teklif formuna yükler. Belge no, tedarikçi vb. boş kalır.
    async function sqPreFillFromRequest(requestId) {
        var resp = await fetch('/Sales/GetQuote?id=' + requestId);
        if (!resp.ok) throw new Error('GetQuote (prefill) HTTP ' + resp.status);
        var data = await resp.json();
        var q    = data && data.quote;
        if (!q) throw new Error('İhtiyaç kaydı verisi alınamadı.');

        var lines = (data.lines || []).map(function (ln) {
            var m = (materials || []).find(function (x) { return x.id === ln.itemId; });
            return {
                stockCardId:       ln.itemId,
                materialCode:      ln.materialCode  || '',
                materialName:      ln.materialName  || '',
                unitId:            ln.unitId        || null,
                quantity:          ln.quantity      || 1,
                unitPrice:         0,
                discountRate:      0,
                taxRate:           ln.taxRate != null ? ln.taxRate : (m && m.taxRate != null ? m.taxRate : 20),
                locationId:        ln.locationId    || null,
                notes:             ln.notes         || null,
                combinationCode:   null,
                combinationId:     null,
                trackCombinations: m ? m.trackCombinations === true : false,
            };
        });

        setGridRows(lines.length > 0 ? lines : [{
            materialCode: '', materialName: '', unitId: null,
            quantity: 1, unitPrice: 0, discountRate: 0,
            locationId: null, notes: null,
        }]);
        sqRecalc();
        window.applyCustomerLock(false);
    }

