    /**
     * Kalemi olan belgenin cari kodu degistirilemez.
     * Kullanici Gridde bir satir ekledigi anda (materialCode girildiginde)
     * tetiklenir. Cari kod input'u + rehber butonu pasiflesir.
     */
    window.applyCustomerLock = function(lock) {
        var disp = document.getElementById('sqCustomerDisplay');
        if (!disp) return;
        var wrapper = disp.parentNode; // ffl-wrapper host
        if (lock) {
            disp.setAttribute('readonly', 'readonly');
            disp.classList.add('is-locked');
            disp.title = 'Kalem girilmis belgenin cari kodu degistirilemez.';
            // Yan sibling olarak React'in enjekte ettigi wrapper'i pasiflestir
            var fflWrap = wrapper && wrapper.querySelector ? wrapper.querySelector('.ffl-wrapper') : null;
            if (fflWrap) fflWrap.style.pointerEvents = 'none';
            if (fflWrap) fflWrap.style.opacity = '0.45';
        } else {
            disp.removeAttribute('readonly');
            disp.classList.remove('is-locked');
            disp.title = '';
            var fflWrap2 = wrapper && wrapper.querySelector ? wrapper.querySelector('.ffl-wrapper') : null;
            if (fflWrap2) fflWrap2.style.pointerEvents = '';
            if (fflWrap2) fflWrap2.style.opacity = '';
        }
    };

    /**
     * Gecerlilik sure (gun) <-> tarih senkronu.
     * Tarih veya gun degistiginde otomatik gecerlilik tarihi hesaplar.
     */
    function sqRecalcValidFromDays() {
        var dateEl = document.getElementById('sqQuoteDate');
        var daysEl = document.getElementById('sqValidDays');
        var validEl = document.getElementById('sqValidUntil');
        if (!dateEl || !daysEl || !validEl) return;
        var dateStr = dateEl.value;
        var daysVal = daysEl.value;
        if (!dateStr || daysVal === '' || daysVal == null) return;
        var days = parseInt(daysVal, 10);
        if (isNaN(days) || days < 0) return;
        var d = new Date(dateStr + 'T00:00:00');
        if (isNaN(d.getTime())) return;
        d.setDate(d.getDate() + days);
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var newVal = yyyy + '-' + mm + '-' + dd;
        if (validEl._flatpickr) validEl._flatpickr.setDate(newVal, false);
        else validEl.value = newVal;
    }

    function sqRecalcDaysFromValid() {
        var dateEl = document.getElementById('sqQuoteDate');
        var validEl = document.getElementById('sqValidUntil');
        var daysEl = document.getElementById('sqValidDays');
        if (!dateEl || !daysEl || !validEl) return;
        var dateStr = dateEl.value;
        var validStr = validEl.value;
        if (!dateStr || !validStr) { daysEl.value = ''; return; }
        var d1 = new Date(dateStr + 'T00:00:00');
        var d2 = new Date(validStr + 'T00:00:00');
        if (isNaN(d1.getTime()) || isNaN(d2.getTime())) return;
        var diffMs = d2.getTime() - d1.getTime();
        var days = Math.round(diffMs / (1000 * 60 * 60 * 24));
        daysEl.value = days >= 0 ? days : 0;
    }
    /* Inline oninput="..." attribute'larinin global scope'ta gormesi icin window'a bagla */
    window.sqRecalcValidFromDays = sqRecalcValidFromDays;
    window.sqRecalcDaysFromValid = sqRecalcDaysFromValid;

    // Başlık lokasyon → satırlar propagasyonu: locationId boş satırlara header lokasyonunu yaz.
    window.sqPropagateHeaderLocation = function () {
        var sel = document.getElementById('sqLocationId');
        if (!sel) return;
        var hLocId = parseInt(sel.value) || null;
        if (!hLocId) return;
        var rows = window.__SQ_LINES__ || [];
        var updated = rows.map(function (r) {
            if (r && !r.locationId) {
                return Object.assign({}, r, { locationId: hLocId });
            }
            return r;
        });
        if (typeof setGridRows === 'function') setGridRows(updated);
    };

    /* ── Currency dropdown: dinamik yukleme + ID/code map ─────────────────
       Backend Document.CurrencyId int FK tutar; dropdown value=id, data-code=ISO.
       Sayfa load'da /PriceList/GetCurrencies'ten option'lar doldurulur.
       sqSetCurrencyById(id) ID ile select'i ayarlar + 'sq:currency' event firlatir
       (kalem grid'i + diger dinleyiciler kod stringini bilmek istiyor). */
    var __sqCurrencyMap = { 1: 'TRY' };  // fallback — endpoint yuklenmeden once
    function sqSetCurrencyById(id) {
        var el = document.getElementById('sqCurrency');
        if (!el) return;
        var idStr = String(id || 1);
        el.value = idStr;
        var opt = el.options[el.selectedIndex];
        var code = (opt && opt.getAttribute('data-code')) || __sqCurrencyMap[id] || 'TRY';
        try {
            window.dispatchEvent(new CustomEvent('sq:currency', {
                detail: { id: parseInt(idStr) || 1, code: code }
            }));
        } catch (_) {}
    }
    window.sqSetCurrencyById = sqSetCurrencyById;

    // Seq 1067/1084/2026-08-19: belge dövizi değişince Kur + Kur Tarihi HÜCRELERİNİ
    // (artık Para Birimi'nden ayrı kendi .sqe-hrow'ları — #sqExchangeRateWrap /
    // #sqRateDateWrap) göster/gizle. TRY=gizli+kur 1, diğerleri=görünür.
    window.addEventListener('sq:currency', function (e) {
        var code = (e && e.detail && e.detail.code) || 'TRY';
        var id   = (e && e.detail && e.detail.id) || 1;
        var isForeign = (String(code).toUpperCase() !== 'TRY') && (id !== 1);
        var rateEl = document.getElementById('sqExchangeRate');
        if (rateEl && !isForeign) rateEl.value = 1;   // TRY belge → kur 1
        var rateElWrap = document.getElementById('sqExchangeRateWrap');
        if (rateElWrap) rateElWrap.style.display = isForeign ? '' : 'none';
        // 2026-08-06: Kur tarihi hücresi de kur ile birlikte göster/gizle. Döviz seçilince
        // kur tarihi boşsa belge tarihini varsayılan yap (kullanıcı ayrı gün seçebilir).
        var rateWrap = document.getElementById('sqRateDateWrap');
        if (rateWrap) rateWrap.style.display = isForeign ? '' : 'none';
        if (isForeign) {
            var _rdEl = document.getElementById('sqRateDate');
            var _qdEl = document.getElementById('sqQuoteDate');
            if (_rdEl && !_rdEl.value && _qdEl && _qdEl.value) window.sqSetDateValue('sqRateDate', _qdEl.value);
        }
        if (typeof sqRecalc === 'function') sqRecalc();
        // Seq 1074: kullanıcı döviz belge seçince kuru TCMB tablosundan otomatik çek.
        // Yalnız kullanıcı-tetiklemeli seçimde (load'da kayıtlı kur korunur, ezilmez).
        if (isForeign && e && e.detail && e.detail.userInitiated) sqFetchTcmbRate(id, code);
    });

    // Seq 1074: GET /GeneralDefinitions/GetCurrencyRate?id=&rateDate= → #sqExchangeRate auto-fill.
    // Kaynak: TCMB günlük kur tablosu (Exchange); belge tarihine göre, yoksa en yakın önceki gün
    // (fallback backend'de). Kur tablosunda hiç yoksa alan boş kalır, kullanıcı elle girer (1067).
    function sqFetchTcmbRate(currencyId, code) {
        var rateEl = document.getElementById('sqExchangeRate');
        if (!rateEl) return;
        // 2026-08-06: Kur tarihi alanı (varsa) esas alınır; yoksa belge tarihine düş.
        // Backend kur tipini (Satış/Alış/Efektif) SALES_QUOTE parametresinden uygular.
        var rdEl = document.getElementById('sqRateDate');
        var qdEl = document.getElementById('sqQuoteDate');
        var rateDate = (rdEl && rdEl.value) ? rdEl.value : ((qdEl && qdEl.value) ? qdEl.value : '');
        var url = '/GeneralDefinitions/GetCurrencyRate?id=' + encodeURIComponent(currencyId) +
                  (rateDate ? ('&rateDate=' + encodeURIComponent(rateDate)) : '');
        fetch(url, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                // Seq 1084: ipucu metni yok — kur doğrudan alana yazılır (yoksa mevcut/elle değer kalır).
                if (d && d.rate != null) {
                    rateEl.value = d.rate;
                    if (typeof sqRecalc === 'function') sqRecalc();
                }
            })
            .catch(function () { /* sessiz — elle giriş serbest */ });
    }

    // 2026-08-06: Kur tarihi değişince o günün kurunu (seçili döviz için) getir.
    // TRY belgede kur sabittir (1) → fetch yok.
    function sqRateDateChanged() {
        var sel = document.getElementById('sqCurrency');
        if (!sel) return;
        var id = parseInt(sel.value) || 1;
        if (id === 1) return;
        var opt = sel.options[sel.selectedIndex];
        var code = (opt && opt.getAttribute('data-code')) || 'TRY';
        sqFetchTcmbRate(id, code);
    }
    window.sqRateDateChanged = sqRateDateChanged;

    function sqLoadCurrencies() {
        return fetch('/PriceList/GetCurrencies', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                var sel = document.getElementById('sqCurrency');
                if (!sel || !Array.isArray(list) || list.length === 0) return;
                var currentId = sel.value || sel.getAttribute('data-current-id') || '1';
                __sqCurrencyMap = {};
                sel.innerHTML = list.map(function (c) {
                    __sqCurrencyMap[c.id] = c.code;
                    return '<option value="' + c.id + '" data-code="' + c.code + '">' + c.code + '</option>';
                }).join('');
                // Onceden secili id varsa onu koru (option'lar yenilendi)
                if (Array.from(sel.options).some(function (o) { return o.value === currentId; })) {
                    sel.value = currentId;
                }
            })
            .catch(function () { /* sessiz: TRY fallback option zaten render edilmis */ });
    }
    // Sayfa hazir olunca yukle (DOMContentLoaded yapilmistir buraya gelindiginde)
    sqLoadCurrencies();

