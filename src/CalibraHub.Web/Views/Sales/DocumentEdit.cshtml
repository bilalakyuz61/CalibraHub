            console.log('[SQ-EXTRAS-SYNC] hasAnyPending=' + hasAnyPending);
            if (hasAnyPending) {
                // Basarisiz kalem ek-alan POST'larini biriktirir — belge zaten kaydedildi
                // (data.success true), bu sadece ek-alan senkronizasyonu; sessiz console.log
                // ile gecmek yerine kullaniciya ⚙ kirmizi + toast ile bildirilir
                // (2026-08-19 review bulgusu).
                var extrasFailedLineIds = [];
                var extrasFailedMessages = [];
                try {
                    var refResp = await fetch('/Sales/GetQuote?id=' + currentQuoteId);
                    if (refResp.ok) {
                        var refData  = await refResp.json();
                        var refLines = Array.isArray(refData.lines) ? refData.lines : [];
                        // Index esleme: rowsFilled[i] → refLines[i] (server sirayi korur).
