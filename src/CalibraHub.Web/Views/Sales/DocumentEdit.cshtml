    // Satir sil (onayli) — rapor §6.6 CalibraAlert.confirm
    window.sqDeleteRow = async function(btn) {
        var card = btn.closest('.sqe-line-card');
        var idx = Array.from(document.getElementById('sqLinesBody').children).indexOf(card) + 1;
        var msg = idx + '. kalemi silmek istediginizden emin misiniz?';
        var ok = window.CalibraAlert && CalibraAlert.confirm
            ? await CalibraAlert.confirm(msg, { title: 'Kalem Sil', okLabel: 'Sil' })
            : confirm(msg);
        if (!ok) return;
        card.remove();
        // Sira numaralarini guncelle
        Array.from(document.getElementById('sqLinesBody').children).forEach(function(el, i) {
            var numEl = el.querySelector('.sqe-line-card__num');
