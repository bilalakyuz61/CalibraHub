            salesRepId:      (function(){ var el = document.getElementById('sqSalesRepId'); return el ? parseInt(el.value) || null : null; })(),
            requesterPersonnelId: (function(){ var el = document.getElementById('sqRequesterId'); return el && el.value ? parseInt(el.value) || null : null; })(),
            locationId:           (function(){ var el = document.getElementById('sqLocationId');  return el && el.value ? parseInt(el.value) || null : null; })(),
            currencyId:      parseInt(document.getElementById('sqCurrency').value) || 1,
            // Seq 1067: elle kur (TRY belgede daima 1). Seq 1068: KDV Dahil bayrağı.
            exchangeRate:    (function(){ var cur = parseInt(document.getElementById('sqCurrency').value) || 1; var el = document.getElementById('sqExchangeRate'); if (cur === 1 || !el) return 1; var v = parseFloat(el.value); return (isFinite(v) && v > 0) ? v : 1; })(),
            isVatIncluded:   (function(){ var el = document.getElementById('sqVatIncluded'); return el ? !!el.checked : false; })(),
            // 2026-08-06: kur tarihi — kurun ALINDIĞI gün. TRY belgede anlamsız → null
