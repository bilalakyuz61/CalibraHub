        background: rgba(248, 113, 113, 0.1) !important;
        color: #fca5a5 !important;
    }

    /* ── Yukleme maskesi — edit modunda alan flashini engeller ──
       Fade kaldirildi: transition opacity sirasinda semi-transparent maske
       arkasindan field'lar gorunur ve "sonradan dolma" izlenimi yaratiyordu.
       Artik opak (koyu/acik tema) zemin + display:none ile tamamen sakli. */
    .sqe-loading-mask {
        position: absolute;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        pointer-events: none;
        border-radius: inherit;
    }
    body.app-theme-dark  .sqe-loading-mask { background: #0b1020; }
    body.app-theme-light .sqe-loading-mask { background: #f8fafc; }
    .sqe-loading-mask.is-hidden { display: none !important; }
    .sqe-loading-mask__spinner {
        width: 18px; height: 18px;
        border-radius: 50%;
        border: 2px solid rgba(99,102,241,0.25);
        border-top-color: #6366f1;
        animation: sqe-spin 0.7s linear infinite;
    }
    .sqe-loading-mask__text {
        font-size: 12px;
        font-weight: 500;
    }
    body.app-theme-dark  .sqe-loading-mask__text { color: rgba(255,255,255,0.5); }
    body.app-theme-light .sqe-loading-mask__text { color: #64748b; }
    @@keyframes sqe-spin { to { transform: rotate(360deg); } }
    /* Maskenin konumlanabilmesi icin ebeveyni relative olmali */
    .sqe-body { position: relative; }

    /* Notlar textarea — icerige gore buyur, ic scroll olmaz */
    .sqe-notes-area {
        display: block;
        width: 100%;
        resize: vertical;
        overflow-y: hidden;   /* ic scroll yok → scroll olaylari uste gider */
        min-height: 120px;
        line-height: 1.6;
        transition: min-height 0.1s;
    }

    /* flatpickr takvim teması: global calibra-datepicker.css'e taşındı (2026-07-06) */

    /* ══════════ Üst-bilgi "kimlik + şerit" düzeni (2026-08-19) ══════════
       Kalem kartıyla aynı görsel dil: kimlik satırı (belge no + cari, büyük/
       vurgulu — sağda salt-okunur genel toplam) + altında ince kenarlıklı
       "şerit" kutu(lar) — her hücre üstte küçük soluk etiket, altta değer.
       React bundle .clc-* sınıfları CSS_URL async yüklendiği için (bkz.
       bootstrapLineGrid) bu statik sayfanın İLK render'ında garanti değil —
       bu yüzden bağımsız sqe- eşdeğeri (aynı renk/ölçü dili). Aşağıdaki
       kurallar mevcut .sqe-hrow/.sqe-hlabel/.sqe-hcombo/.sqe-hinput temel
       tanımlarını (yukarıda) İÇERİK/ID/CLASS'ları DEĞİŞTİRMEDEN, yalnızca bu
       yeni sarmalayıcılar (.sqe-ident-row / .sqe-strip) İÇİNDE override eder —
       dosya sonunda tanımlandığı için eşit özgüllükte de kazanır. */
    /* 2026-08-19 (kullanici istegi): ust bilgi karti ekrani yatayda DOLDURSUN —
       940px tavani sagda genis bir bosluk birakiyordu. */
    .sqe-hform { max-width: none; }
    .sqe-ident-row {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 20px; flex-wrap: wrap;
        padding-bottom: 8px; margin-bottom: 0;
        border-bottom: 1px solid var(--sqe-strip-border, #e2e8f0);
    }
    body.app-theme-dark .sqe-ident-row { --sqe-strip-border: rgba(255,255,255,.1); }
    .sqe-ident-fields { display: flex; align-items: flex-start; gap: 28px; flex-wrap: wrap; flex: 1 1 auto; min-width: 0; }
    .sqe-ident-total { flex: 0 0 auto; text-align: right; display: none; }
    .sqe-ident-total.is-visible { display: block; }
    .sqe-ident-total-label {
        display: block; font-size: .68rem; font-weight: 700; letter-spacing: .02em;
        color: var(--app-text-muted, #94a3b8); opacity: .75; margin-bottom: 3px;
    }
    body.app-theme-dark .sqe-ident-total-label { color: rgba(255,255,255,.55); opacity: 1; }
    .sqe-ident-total-value {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 1.08rem; font-weight: 700; color: #0f172a; white-space: nowrap;
    }
    body.app-theme-dark .sqe-ident-total-value { color: rgba(255,255,255,.92); }

    /* 2026-08-19 (kullanıcı isteği): şeritler AYRI kutular değil, TEK bloğun içinde
       alt alta satırlar — aralarında yatay ayraç. Kenarlık/zemin artık sarmalayıcıda. */
    .sqe-strips {
        border: 1px solid var(--sqe-strip-border, #e2e8f0);
        border-radius: 10px;
        background: var(--sqe-strip-bg, #f8fafc);
        /* 2026-08-19: `overflow: hidden` KALDIRILDI. Temsilci acilir paneli
           (.sqe-rep-panel, position:absolute) bu kabin ICINDE kaliyordu; overflow:hidden
           onu hem kirpiyor hem de kabi kaydirilabilir yapiyordu. sqRepOpen() icindeki
           filter.focus() ve selected.scrollIntoView() bu kabi kaydirinca ust bilgi
           icerigi YUKARI ziplayordu. Overflow acilinca panel serbestce tasar ve
           scrollIntoView dogru hedefi (.sqe-rep-list, overflow-y:auto) kaydirir.
           Koseler bozulmuyor: .sqe-strip'lerin kendi zemini yok, zemin sarmalayicida. */
        margin-top: 4px;
    }
    body.app-theme-dark .sqe-strips {
        --sqe-strip-bg: rgba(255,255,255,.025);
        --sqe-strip-border: rgba(255,255,255,.08);
    }

    /* 2026-08-20 (kullanıcı isteği): "şerit hücreleri iki satır da olsa tablo
       mantığında aynı genişlikte olmalı, alt alta hizalı" — flex-wrap İÇERİK
       genişliğine göre dizdiği için alt alta gelen şeritlerdeki hücreler
       hizalanmıyordu. Artık ORTAK 12(6 dar ekranda)-sütunlu CSS-grid: her
       .sqe-hrow yalnızca `grid-column: span N` alır (satır/sütun konumu
       VERİLMEZ — auto-flow alanları sırayla akıtır, boş hücre oluşmaz),
       N = cardWidth (Standart Alanlar, initCardWidths() ile uygulanır) ??
       defaultCardWidth ?? 3 (CSS varsayılanı — JS hiç çalışmasa/hata verse
       bile FAIL-OPEN: her hücre 3 sütun alır, düzen bozulmaz). Aynı N'e sahip
       hücreler farklı şeritlerde de tam hizalı çıkar çünkü template tüm
       şeritlerde birebir aynıdır (kalem kartıyla aynı desen — bkz.
       CalibraLineItemsGrid.jsx .clc-fields-row). */
    .sqe-strip {
        display: grid;
        /* 2026-08-20: sutun sayisi SABIT 12 DEGIL — ilk seridin GORUNUR hucre
           sayisindan gelir (applyStripColumns), `--sqe-cols` ile bildirilir.
           Sabit 12 iken her hucre varsayilan 3 sutun aliyordu; tam genislikte
           satirda 4 hucre + kalanlar BOS sutun olarak ayraclarla ciziliyordu.
           Fallback 12: degisken gelmezse eski davranis birebir korunur. */
        grid-template-columns: repeat(var(--sqe-cols, 12), minmax(0, 1fr));
        align-items: stretch;
        /* Dikey ayraçlar — hücre border'ı YERİNE konteyner arka planında 1/12
           aralıklarla tekrarlayan çizgi (span'a göre değişen "satırın ilk
           hücresi" hesabını nth-child ile güvenilir yapmak zordu; gradient
           grid şablonuyla matematiksel olarak birebir hizalı kalır, JS
           gerektirmez — bkz. .clc-fields-row aynı desen). Kabul edilen küçük
           kozmetik ödünleşim: son çizgi konteyner sağ kenarına denk gelir,
           .sqe-strips'in kendi 1px kenarlığıyla çakışabilir (göz ardı
           edilebilir düzeyde). */
        background-image: repeating-linear-gradient(
            to right,
            transparent 0,
            transparent calc(100% / var(--sqe-cols, 12) - 1px),
            var(--sqe-strip-border, #e2e8f0) calc(100% / var(--sqe-cols, 12) - 1px),
            var(--sqe-strip-border, #e2e8f0) calc(100% / var(--sqe-cols, 12))
        );
    }
    /* ══ SERBEST DUZEN (layoutMode='free', 2026-08-20) ══════════════════════════
       DocumentEdit 8 belge tipiyle PAYLASIMLI. Bu yuzden izgara kurallari YERINDE
       BIRAKILDI; serbest duzen yalnizca .sqe-strips--free altinda tanimlanir —
       sinif yoksa hicbir sey degismez (diger 7 belge tipi etkilenmez).
       Fark: sabit sutun + dikey ayrac YOK; hucreler kendi px genisliginde,
       satir dolunca alta akar (izgara oncesi flex temeline donus). */
    .sqe-strips--free .sqe-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 12px 22px;
        padding: 10px 14px;
        background-image: none;              /* dikey ayraclar KALKAR */
        grid-template-columns: none;
    }
    .sqe-strips--free .sqe-hrow {
        /* Genislik JS'te alan basina yazilir (applyCellWidths). Buradaki deger yalniz
           veri gelmeden onceki ilk render icin makul bir taban. */
        flex: 0 0 auto;
        width: 200px;
        max-width: 100%;
        grid-column: auto;                   /* izgara span'i etkisiz kalsin */
        border-left: none;                   /* hucre ayraci da yok */
        padding: 0;
    }
    /* Dar konteynerde hucre tasmasin — px degeri korunur ama tavan %100 olur. */
    .sqe-strips--free .sqe-strip--narrow .sqe-hrow { max-width: 100%; }

    /* Baska sekmeden TASINAN blok (2026-08-20). Hedef sekmede hangi bolum oldugu
       belli olsun diye basliklandirilir; ust sinir cizgisiyle ayrilir. */
    .sqe-moved-block { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--sqe-strip-border, #e2e8f0); }
    .sqe-moved-block:first-child { margin-top: 0; padding-top: 0; border-top: none; }
    .sqe-moved-title {
        font-size: .78rem; font-weight: 600; margin-bottom: 8px;
        color: var(--app-text-muted, #64748b);
    }
    body.app-theme-dark .sqe-moved-block { border-top-color: rgba(255,255,255,.08); }
    body.app-theme-dark .sqe-moved-title { color: rgba(255,255,255,.55); }

    /* Alan grubu (2026-08-21): birlikte hareket eden hucreler. Izgara modunda
       `display: contents` ile SEFFAF — sarmalayici hic yokmus gibi davranir, mevcut
       izgara yerlesimi degismez. Serbest modda tek flex ogesi olur ve icinde
       nowrap ile uyeler ayrilmaz. */
    /* Genis hucre — textarea gibi alanlar seritte tam satiri kaplar (2026-08-21). */
    .sqe-hrow--wide { flex: 1 1 100%; width: 100% !important; max-width: 100% !important; }
    .sqe-hrow--wide .sqe-notes-area { width: 100%; }

    .sqe-hgroup { display: contents; }
    .sqe-strips--free .sqe-hgroup {
        display: flex;
        flex-wrap: nowrap;
        align-items: flex-start;
        gap: 12px 22px;
        flex: 0 0 auto;
        max-width: 100%;
    }

    .sqe-strip--narrow {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        background-image: repeating-linear-gradient(
            to right,
            transparent 0,
            transparent calc(100% / 6 - 1px),
            var(--sqe-strip-border, #e2e8f0) calc(100% / 6 - 1px),
            var(--sqe-strip-border, #e2e8f0) calc(100% / 6)
        );
    }
    .sqe-strip + .sqe-strip { border-top: 1px solid var(--sqe-strip-border, #e2e8f0); }
    .sqe-strip:empty { display: none; }
    body.app-theme-dark .sqe-strip { --sqe-strip-border: rgba(255,255,255,.08); }

    /* Kimlik/şerit içindeki .sqe-hrow: etiket ÜSTTE, değer ALTTA (dış sarmalayıcı
       değişiyor, iç input/select/label id+class AYNEN kalıyor). */
    .sqe-hform .sqe-ident-row .sqe-hrow,
    .sqe-hform .sqe-strip .sqe-hrow {
        flex-direction: column; align-items: flex-start; gap: 2px; min-height: auto;
    }
    .sqe-hform .sqe-strip .sqe-hrow {
        /* grid-column: span 3 → FAIL-OPEN varsayılan (backend'in defaultCardWidth
           varsayılanıyla aynı, bkz. FormBehaviorController). initCardWidths()
           (aşağıda) /api/form-behavior yanıtı geldiğinde bunu inline stille
           cardWidth/defaultCardWidth'e göre override eder; istek düşerse/API
           eski ise bu CSS değeri kalır — hiçbir alan kaybolmaz/hizasız kalmaz. */
        /* 2026-08-20: varsayilan span 1 — sutun sayisi zaten hucre sayisina esit
           (bkz. applyStripColumns). Eskiden 3'tu ve sabit 12 sutunla birlikte bos
           sutun birakiyordu. */
        grid-column: span 1;
        padding: 5px 12px;
        min-width: 0;
    }
    /* 2026-08-19: tarih hücreleri daralsın — "19.08.2026 📅" için 176px fazlaydı
       (Seq 1065/1059 genel 176px kuralı kart düzeninde gereksiz genişlik yapıyordu).
       Hücre içi dikey boşluk da kısaldı; etiket ile değer arası tek satır. */
    .sqe-hform .sqe-strip #sqQuoteDate,
    .sqe-hform .sqe-strip #sqQuoteDate + input.calibra-date-input,
    .sqe-hform .sqe-strip #sqValidUntil,
    .sqe-hform .sqe-strip #sqValidUntil + input.calibra-date-input,
    .sqe-hform .sqe-strip #sqRateDate,
    .sqe-hform .sqe-strip #sqRateDate + input.calibra-date-input {
        /* 2026-08-19 DUZELTME: hucre (.sqe-strip .sqe-hrow) flex-direction:column —
           kolon eksende `flex-basis` GENISLIK degil YUKSEKLIK belirler. `flex:0 0 136px`
           bu yuzden Tarih ve Kur Tarihi altInput'unu 136px YUKSEK yapiyordu (hucre 169px,
           digerleri 61px) ve degerler alt satira kayiyordu. Gecerlilik tarihi dogru
           gorunuyordu cunku o input `.sqe-hcombo` (satir eksen) icinde. Cozum: flex-basis
           yerine acik `width`. Olculdu: hucre 169px -> 61px, input 136x136 -> 136x28. */
        flex: 0 0 auto !important;
        width: 136px !important;
        max-width: 136px !important;
    }
    .sqe-hform .sqe-strip .sqe-hrow > * { margin-top: 0; margin-bottom: 0; }
    .sqe-hform .sqe-strip .sqe-hrow .form-control,
    .sqe-hform .sqe-strip .sqe-hrow .form-select { padding-top: 4px; padding-bottom: 4px; }
    .sqe-hform .sqe-ident-row .sqe-hlabel,
    .sqe-hform .sqe-strip .sqe-hlabel {
        flex: 0 0 auto;
        font-size: .68rem; letter-spacing: .02em;
        color: var(--app-text-muted, #94a3b8); opacity: .75;
    }
    body.app-theme-dark .sqe-hform .sqe-ident-row .sqe-hlabel,
    body.app-theme-dark .sqe-hform .sqe-strip .sqe-hlabel {
        color: rgba(255,255,255,.55); opacity: 1;
    }
    .sqe-hform .sqe-ident-row .sqe-hcombo,
    .sqe-hform .sqe-strip .sqe-hcombo,
    .sqe-hform .sqe-ident-row .gl-wrapper,
    .sqe-hform .sqe-strip .gl-wrapper {
        flex: 0 0 auto; max-width: 230px; width: auto;
    }
    .sqe-hform .sqe-ident-row .sqe-hinput,
    .sqe-hform .sqe-strip .sqe-hinput {
        flex: 0 0 auto; max-width: 210px; width: auto;
    }
    /* Belge No — Seq 1104 (kullanıcı isteği): (1) belge numarası her zaman ~15 karakter,
       bu kadar geniş alan gereksizdi → sabit dar genişlik; (2) değer diğerlerinden BÜYÜK
       punto olduğu için Teklif No / Cari Kod / Cari Ad metinleri aynı hizada durmuyordu →
       punto diğer kimlik değerleriyle eşitlendi (vurgu inline font-weight:600 ile kalıyor). */
    .sqe-ident-row #sqQuoteNumber {
        font-size: .95rem !important;
        flex: 0 0 168px !important;
        max-width: 168px !important;
    }
    /* Cari adı (badge) kimlik satırında input'un hemen altına iner — satır içi
       değil (label-üstte deseniyle tutarlı). */
    /* 2026-08-19 (kullanici istegi): Cari adi ALTINDA degil, Cari Kod input'unun
       YANINDA. Hucre column akista oldugu icin etiketi tam satir yapip input + ad'i
       ayni satirda birakiyoruz. */
    .sqe-hform .sqe-ident-row .sqe-hrow[data-field-key="customer"] {
        flex-flow: row wrap; align-items: center; column-gap: 10px;
    }
    .sqe-hform .sqe-ident-row .sqe-hrow[data-field-key="customer"] > .sqe-hlabel { flex: 0 0 100%; }

    /* 2026-08-19 (kullanici istegi): Kimlik satirinda Teklif No / Cari Kod / Cari Ad
       AYNI yatay hizada olmali. #sqQuoteNumber 1.1rem oldugu icin kutusu digerlerinden
       yuksekti ve degerler birkac px kayiyordu. Deger kutularina ORTAK min-height verip
       icerigi dikeyde ortaliyoruz (etiketler zaten flex-start ile hizali). */
    /* input replaced-element: display:flex UYGULANMAZ — dikey ortalama line-height ile. */
    /* 2026-08-22 DUZELTME: `min-height` yetmiyor — kutular TABANI paylasiyor ama
       tavani paylasmiyordu. Teklif No (form-control-sm, .95rem) ile Cari Kod
       (React .gl-card: 28px butonlar + kendi input'u) farkli DOGAL yukseklikler
       uretiyor; ikisi de 34'un USTUNDE kaldigi icin min-height hicbir seyi
       esitlemiyor ve merkezleri birkac px kayiyordu (ayni hata kalem kartinin
       kimlik satirinda da vardi, orada da sabit yukseklikle cozuldu).
       SABIT ortak yukseklik + ic kontrollerin %100 doldurmasi: her kontrolun
       dikey dolgusu simetrik oldugundan metin merkezi = kutu merkezi olur,
       punto farkindan BAGIMSIZ olarak hizalanirlar. */
    .sqe-hform .sqe-ident-row .sqe-hrow > input.sqe-hinput {
        height: 36px; min-height: 36px; line-height: 1.4;
    }
    .sqe-hform .sqe-ident-row .sqe-hrow > .sqe-hcombo,
    .sqe-hform .sqe-ident-row .sqe-hrow > .gl-wrapper {
        height: 36px; min-height: 36px; align-items: center;
    }
    .sqe-hform .sqe-ident-row .sqe-hcombo > input.sqe-hinput,
    .sqe-hform .sqe-ident-row .gl-wrapper > .gl-card,
    .sqe-hform .sqe-ident-row .gl-wrapper .gl-card__input {
        height: 100% !important;
    }
    /* Cari adı: kod input'uyla aynı satırda ve aynı dikey hizada (Seq 1104). */
    .sqe-hform .sqe-ident-row .sqe-hrow[data-field-key="customer"] > .sqe-customer-name {
        align-self: center; height: 36px; min-height: 36px; display: flex; align-items: center;
    }

    /* 2026-08-19 (kullanici istegi): Temsilci combobox'i dar kaliyordu — sarmalayici
       `.sqe-hinput` kuralindan `width:auto` aliyor, panel de `left:0;right:0` ile ona
       yapistigi icin acilir liste daralip metin alt alta sariyordu ("Bilal / Akyuz").
       Hucreye taban genislik + panele min-width veriyoruz, secenekler tek satir. */
    .sqe-hform .sqe-strip .sqe-hrow[data-field-key="salesRep"] { min-width: 250px; }
    .sqe-hform .sqe-strip #sqSalesRepWrapper {
        width: 100% !important; max-width: none !important; min-width: 230px;
    }
    .sqe-rep-panel { min-width: 250px; }
    .sqe-rep-option { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sqe-ident-row .sqe-customer-name.sqe-hlabel-value {
        display: inline-block; margin-left: 0; margin-top: 0; max-width: 320px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
</style>
}

@{
    var _colId = editId.HasValue ? editId.Value.ToString() : $"new-{Guid.NewGuid():N}";
    var _colTitle = editId.HasValue ? $"{entityLabel} #{editId.Value}" : $"Yeni {entityLabel}";
}
<form class="integrator-form" style="display:none" aria-hidden="true"
      data-collaboration-record-type="@headerFormCode"
      data-collaboration-record-id="@_colId"
      data-collaboration-record-title="@_colTitle"></form>

<section class="integrator-dashboard integrator-dashboard--wide integrator-dashboard--compact integrator-dashboard__content">

    <!-- Aksiyon Şeridi — CalibraHub standart butonlar (.pte-btn--icon).
         Container .sqe-action-bar korundu: KITT flash + collaboration lock banner
         host + status akışı buna bağlı. Sadece butonlar standart tile'a çevrildi. -->
    <div class="sqe-action-bar" data-no-proxy data-collaboration-banner-host>
        <!-- İşlemler menüsü — aksiyon şeridinin EN BAŞINDA, Geri (Liste) butonunun
             SOLUNDA (2026-08-03, Seq 1069: sıralama = İşlemler, Geri, Kaydet, Sil).
             --leading varyantı margin-left:auto'yu sıfırlar ki sağa itilmesin. -->
        <div class="sqe-actions-menu sqe-actions-menu--leading" id="sqActionsMenu">
            <button type="button"
                    class="pte-btn pte-btn--actions pte-btn--icon"
                    id="sqActionsBtn"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    data-collaboration-allow
                    title="İşlemler"
                    onclick="sqToggleActionsMenu(event)"
                    aria-label="İşlemler">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>
                </svg>
                <span class="pte-btn__label">İşlemler</span>
            </button>
        </div>
        <a href="@listReturnUrl" class="pte-btn pte-btn--secondary pte-btn--icon" id="ptBtnList" aria-label="Liste" title="Liste">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <button type="button" class="pte-btn pte-btn--primary pte-btn--icon" data-collaboration-write="true" onclick="sqSave({ validate: true })" title="Kaydet" aria-label="Kaydet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span class="pte-btn__label">Kaydet</span>
        </button>
        <button type="button" class="pte-btn pte-btn--danger pte-btn--icon" id="sqBtnDelete" data-collaboration-write="true" disabled onclick="sqDelete()" title="Sil" aria-label="Sil">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            <span class="pte-btn__label">Sil</span>
        </button>
        @if ((isOrder || isPurchaseOrder) && Model.DocumentId.HasValue)
        {
            var dlvLabel   = isPurchaseOrder ? "Mal Kabul" : "Teslim Et";
            var dlvEndpoint = isPurchaseOrder ? "/Warehouse/ReceivePurchaseOrderJson" : "/Warehouse/DeliverSalesOrderJson";
            var dlvTitle   = isPurchaseOrder
                ? "Açık kalemleri mal kabul et — Alış İrsaliyesi oluşturur, stok girişi yazar"
                : "Açık kalemleri teslim et — Satış İrsaliyesi oluşturur, stok çıkışı yazar";
            <button type="button" class="pte-btn pte-btn--secondary pte-btn--icon" id="sqBtnDeliver" data-collaboration-allow onclick="sqDeliverOrder()" title="@dlvTitle" aria-label="@dlvLabel">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <span class="pte-btn__label">@dlvLabel</span>
            </button>
            <script>
            var _sqDlvEndpoint = '@dlvEndpoint';
            var _sqDlvLabel = '@dlvLabel';
            var _sqDlvOpenUrl = '/Warehouse/OrderOpenLinesJson';
            // Kısmi teslimat: önce açık kalemleri çek, miktar modalını aç.
            function sqDeliverOrder() {
                var oid = @(Model.DocumentId ?? 0);
                if (!oid) return;
                fetch(_sqDlvOpenUrl + '?orderId=' + oid, { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d || !d.success) { _sqDlvToast((d && d.message) || 'Açık kalemler yüklenemedi.', false); return; }
                        var lines = d.lines || [];
                        if (!lines.length) { _sqDlvToast('Teslim edilecek açık kalem yok (tümü zaten irsaliyeye dönüştürülmüş).', false); return; }
                        _sqDlvModal(oid, lines);
                    })
                    .catch(function (e) { _sqDlvToast('İşlem sırasında hata: ' + e, false); });
            }
            // Sayı biçimi (gösterim) — 4 haneye yuvarla, gereksiz sıfırları at, ondalık virgül.
            function _sqFmt(n) {
                if (n === null || n === undefined || n === '') return '0';
                var x = Math.round((parseFloat(n) + Number.EPSILON) * 10000) / 10000;
                if (isNaN(x)) return '0';
                return (x % 1 === 0) ? String(x) : String(x).replace('.', ',');
            }
            // Faz 3 — kit bileşen anahtarı: ComponentItemId + ConfigId (ID-tabanlı eşleşme, CLAUDE.md).
            function _sqKitCompKey(c) { return c.componentItemId + ':' + (c.configId || 0); }
            function _sqDlvModal(oid, lines) {
                var bd = document.createElement('div');
                bd.style.cssText = 'position:fixed;inset:0;z-index:100000;background:rgba(2,6,23,.6);display:flex;align-items:center;justify-content:center;padding:20px;';
                var brd = '1px solid var(--app-border,#334155)';
                var _inpStyle = 'width:96px;padding:5px 8px;border-radius:7px;border:' + brd + ';background:var(--app-input-bg,rgba(255,255,255,.06));color:inherit;text-align:right;font-weight:600';
                // Faz 3 — kit satırı başına takipli bileşen listesi + kaynak depo (panel açılışında kullanılır).
                var _sqKitCompsByLine = {};
                var _sqKitLocByLine = {};
                // Faz 3 — kit satırı başına seçim durumu: { comps, dataByComp, selections, loaded }.
                var _sqKitState = {};
                var rows = lines.map(function (l) {
                    var td = 'padding:6px 8px;border-bottom:' + brd;
                    // Kit satırı: miktar birimi "set"; yalnız TAM set teslim edilir, bileşenler otomatik patlar.
                    // Faz 3 — seri/lot takipli bileşenli kit de teslim edilebilir (bileşen bazında elle seçim paneli).
                    if (l.isKit) {
                        var comps = l.kitComponents || [];
                        var trackedComps = comps.filter(function (c) { return c.tracking && c.tracking !== 'None'; });
                        var hasTracked = trackedComps.length > 0;
                        if (hasTracked) { _sqKitCompsByLine[l.lineId] = trackedComps; _sqKitLocByLine[l.lineId] = l.sourceLocationId; }
                        var kitBadge = ' <span style="font-size:.6rem;font-weight:700;color:#0ea5e9;border:1px solid #0ea5e9;border-radius:4px;padding:0 4px;vertical-align:middle">KİT</span>';
                        var compText = comps.map(function (c) { return (c.name || c.code || '?') + ' ×' + _sqFmt(c.perSet); }).join(' · ');
                        var breakdown = '<div style="font-size:.68rem;opacity:.7;margin-top:2px">1 set = ' + (compText || '—') + '</div>';
                        var pickBtn = hasTracked
                            ? '<button type="button" class="_sqKitPickBtn" data-line="' + l.lineId + '" style="margin-top:4px;font-size:.66rem;font-weight:700;color:#0ea5e9;background:transparent;border:1px solid #0ea5e9;border-radius:5px;padding:1px 7px;cursor:pointer">Seri/Lot Seç</button>'
                            : '';
                        var hint = hasTracked ? '<div style="font-size:.66rem;color:#0ea5e9;margin-top:2px">ℹ Seri/lot takipli bileşen var — teslimden önce "Seri/Lot Seç" ile bileşen seçimini tamamlayın.' + pickBtn + '</div>' : '';
                        var qtyCell = '<input type="number" class="_sqDlvQty" data-line="' + l.lineId + '" data-open="' + l.open + '" data-kit="1" min="0" step="1" value="' + l.open + '" style="' + _inpStyle + '" />';
                        var mainRow = '<tr>'
                            + '<td style="' + td + '">' + ((l.itemName || l.itemCode || ('#' + l.lineId))) + kitBadge + breakdown + hint + '</td>'
                            + '<td style="' + td + ';text-align:center;opacity:.8">set</td>'
                            + '<td style="' + td + ';text-align:right;opacity:.65">' + _sqFmt(l.ordered) + '</td>'
                            + '<td style="' + td + ';text-align:right;opacity:.65">' + _sqFmt(l.delivered) + '</td>'
                            + '<td style="' + td + ';text-align:right;font-weight:600">' + _sqFmt(l.open) + '</td>'
                            + '<td style="' + td + ';text-align:right">' + qtyCell + '</td>'
                            + '</tr>';
                        var panelRow = hasTracked
                            ? '<tr class="_sqKitPanelRow" data-line="' + l.lineId + '" style="display:none">'
                              + '<td colspan="6" style="padding:4px 8px 12px;border-bottom:' + brd + '"><div class="_sqKitPanel" data-line="' + l.lineId + '" style="font-size:.74rem"></div></td></tr>'
                            : '';
                        return mainRow + panelRow;
                    }
                    var serialBadge = l.serialTracked ? ' <span style="font-size:.6rem;font-weight:700;color:#8b5cf6;border:1px solid #8b5cf6;border-radius:4px;padding:0 4px;vertical-align:middle">SERİ</span>' : '';
                    return '<tr>'
                        + '<td style="' + td + '">' + ((l.itemName || l.itemCode || ('#' + l.lineId))) + serialBadge + '</td>'
                        + '<td style="' + td + ';text-align:center;opacity:.8">' + (l.unitName || '') + '</td>'
                        + '<td style="' + td + ';text-align:right;opacity:.65">' + _sqFmt(l.ordered) + '</td>'
                        + '<td style="' + td + ';text-align:right;opacity:.65">' + _sqFmt(l.delivered) + '</td>'
                        + '<td style="' + td + ';text-align:right;font-weight:600">' + _sqFmt(l.open) + '</td>'
                        + '<td style="' + td + ';text-align:right">'
                        + '<input type="number" class="_sqDlvQty" data-line="' + l.lineId + '" data-open="' + l.open + '" min="0" step="any" value="' + l.open + '" style="' + _inpStyle + '" /></td>'
                        + '</tr>';
                }).join('');
                bd.innerHTML = '<div style="max-width:740px;width:96%;max-height:88vh;display:flex;flex-direction:column;background:var(--app-surface,#1a1f2e);border:' + brd + ';border-radius:14px;color:var(--bs-body-color,#e2e8f0);box-shadow:0 20px 60px rgba(0,0,0,.5)">'
                    + '<div style="padding:16px 20px 12px;border-bottom:' + brd + '">'
                    +   '<div style="font-size:1rem;font-weight:700">' + _sqDlvLabel + ' → İrsaliye</div>'
                    +   '<div style="font-size:.78rem;opacity:.72;margin-top:3px">Teslim edilecek miktarları girin. Kalandan az girerseniz kısmi teslimat yapılır; kalan sipariş açık kalır. 0 girilen kalem bu teslimatta atlanır. Kit satırları tam SET olarak teslim edilir — bileşenler irsaliyede otomatik patlar; seri/lot takipli bileşenler için elle seçim gerekir.</div>'
                    + '</div>'
                    + '<div style="overflow:auto;padding:6px 20px 4px">'
                    +   '<table style="width:100%;border-collapse:collapse;font-size:.82rem">'
                    +     '<thead><tr style="opacity:.7;font-size:.68rem;letter-spacing:.4px">'
                    +       '<th style="padding:6px 8px;text-align:left">Malzeme</th><th style="padding:6px 8px;text-align:center">Birim</th>'
                    +       '<th style="padding:6px 8px;text-align:right">Sipariş</th><th style="padding:6px 8px;text-align:right">Teslim</th>'
                    +       '<th style="padding:6px 8px;text-align:right">Kalan</th><th style="padding:6px 8px;text-align:right">Teslim Edilecek</th></tr></thead>'
                    +     '<tbody>' + rows + '</tbody></table>'
                    + '</div>'
                    + '<div style="padding:12px 20px;border-top:' + brd + ';display:flex;gap:8px;justify-content:space-between;align-items:center;flex-wrap:wrap">'
                    +   '<div style="display:flex;gap:8px">'
                    +     '<button id="_sqDlvAll" style="padding:7px 12px;border-radius:8px;border:' + brd + ';background:transparent;color:inherit;cursor:pointer;font-weight:600;font-size:.76rem">Tümünü Doldur</button>'
                    +     '<button id="_sqDlvNone" style="padding:7px 12px;border-radius:8px;border:' + brd + ';background:transparent;color:inherit;cursor:pointer;font-weight:600;font-size:.76rem">Temizle</button>'
                    +   '</div>'
                    +   '<div style="display:flex;gap:8px">'
                    +     '<button id="_sqDlvCancel" style="padding:8px 14px;border-radius:8px;border:' + brd + ';background:transparent;color:inherit;cursor:pointer;font-weight:600">Vazgeç</button>'
                    +     '<button id="_sqDlvOk" style="padding:8px 16px;border-radius:8px;border:none;background:#10b981;color:#fff;cursor:pointer;font-weight:600">' + _sqDlvLabel + '</button>'
                    +   '</div>'
                    + '</div></div>';
                document.body.appendChild(bd);
                function close() { if (bd.parentNode) bd.parentNode.removeChild(bd); }
                bd.addEventListener('click', function (e) { if (e.target === bd) close(); });
                bd.querySelector('#_sqDlvCancel').onclick = close;
                var qtyInputs = bd.querySelectorAll('._sqDlvQty');

                // Faz 3 — bileşen seçim panelini (ilk açılışta fetch + render) doldurur/gösterir.
                function _sqOpenKitPanel(lineId) {
                    var panelRow = bd.querySelector('._sqKitPanelRow[data-line="' + lineId + '"]');
                    if (!panelRow) return;
                    var isHidden = panelRow.style.display === 'none';
                    if (!isHidden) { panelRow.style.display = 'none'; return; }
                    panelRow.style.display = '';
                    var st = _sqKitState[lineId];
                    if (st && st.loaded) { _sqRenderKitPanelBody(lineId); return; }
                    var comps = _sqKitCompsByLine[lineId] || [];
                    var loc = _sqKitLocByLine[lineId];
                    _sqKitState[lineId] = { comps: comps, dataByComp: {}, selections: {}, loaded: false };
                    var panelDiv = panelRow.querySelector('._sqKitPanel');
                    if (panelDiv) panelDiv.innerHTML = '<div style="opacity:.6;padding:6px 0">Yükleniyor…</div>';
                    var fetches = comps.map(function (c) {
                        var url = (c.tracking === 'Serial'
                            ? '/Warehouse/GetSerialsJson?itemId=' + c.componentItemId
                            : '/Warehouse/GetLotBalancesJson?itemId=' + c.componentItemId)
                            + (loc ? '&locationId=' + loc : '');
                        return fetch(url, { credentials: 'same-origin' })
                            .then(function (r) { return r.json(); })
                            .then(function (data) { _sqKitState[lineId].dataByComp[_sqKitCompKey(c)] = data || []; })
                            .catch(function () { _sqKitState[lineId].dataByComp[_sqKitCompKey(c)] = []; });
                    });
                    Promise.all(fetches).then(function () {
                        _sqKitState[lineId].loaded = true;
                        _sqRenderKitPanelBody(lineId);
                    });
                }

                // Faz 3 — panel içeriğini geçerli set miktarına (N) göre yeniden çizer; seri bileşende
                // seçim yoksa listenin ilk N×PerSet serisi (GetSerialsJson sırası) öneçilir, lot bileşende
                // ilk lot öneçilir. Kullanıcı seçimi elle değiştirebilir.
                function _sqRenderKitPanelBody(lineId) {
                    var panelRow = bd.querySelector('._sqKitPanelRow[data-line="' + lineId + '"]');
                    var panelDiv = panelRow ? panelRow.querySelector('._sqKitPanel') : null;
                    var st = _sqKitState[lineId];
                    if (!panelDiv || !st) return;
                    var qtyInput = bd.querySelector('._sqDlvQty[data-line="' + lineId + '"]');
                    var n = parseFloat(qtyInput ? qtyInput.value : 0) || 0;
                    var html = '';
                    st.comps.forEach(function (c) {
                        var key = _sqKitCompKey(c);
                        var need = n * c.perSet;
                        var data = st.dataByComp[key] || [];
                        if (c.tracking === 'Serial') {
                            var needInt = Math.round(need);
                            if (!st.selections[key]) st.selections[key] = data.slice(0, needInt).map(function (s) { return s.serialNo; });
                            var sel = st.selections[key];
                            html += '<div style="margin-bottom:10px;border:' + brd + ';border-radius:8px;padding:8px 10px">'
                                + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;gap:8px">'
                                +   '<span style="font-weight:600">' + (c.name || c.code || '?') + ' <span style="opacity:.6;font-weight:400">(Seri)</span></span>'
                                +   '<span class="_sqKitCountLbl" data-line="' + lineId + '" data-key="' + key + '" data-need="' + needInt + '" style="font-size:.7rem;font-weight:700;' + (sel.length === needInt ? 'color:#10b981' : 'color:#f59e0b') + '">seçili ' + sel.length + ' / gereken ' + needInt + '</span>'
                                + '</div>'
                                + '<div style="max-height:140px;overflow:auto;border-top:1px dashed var(--app-border,#334155);padding-top:4px">'
                                + (data.length ? data.map(function (s) {
                                    var checked = sel.indexOf(s.serialNo) >= 0 ? 'checked' : '';
                                    var lbl = s.serialNo + (s.lotNo ? ' · Lot: ' + s.lotNo : '') + (s.expiryDate ? ' · SKT: ' + String(s.expiryDate).substring(0, 10) : '');
                                    return '<label style="display:flex;align-items:center;gap:6px;padding:2px 0;font-size:.74rem;cursor:pointer"><input type="checkbox" class="_sqKitSerialChk" data-line="' + lineId + '" data-key="' + key + '" value="' + s.serialNo + '" ' + checked + ' /> ' + lbl + '</label>';
                                }).join('') : '<div style="opacity:.5;padding:4px 0">Bu depoda uygun seri bulunamadı.</div>')
                                + '</div></div>';
                        } else if (c.tracking === 'Lot') {
                            if (st.selections[key] === undefined) st.selections[key] = data.length ? data[0].lotNo : '';
                            var selLot = st.selections[key];
                            html += '<div style="margin-bottom:10px;border:' + brd + ';border-radius:8px;padding:8px 10px">'
                                + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;gap:8px">'
                                +   '<span style="font-weight:600">' + (c.name || c.code || '?') + ' <span style="opacity:.6;font-weight:400">(Lot) · gereken ' + _sqFmt(need) + '</span></span>'
                                + '</div>'
                                + (data.length
                                    ? '<select class="_sqKitLotSel" data-line="' + lineId + '" data-key="' + key + '" style="width:100%;padding:5px 8px;border-radius:6px;border:' + brd + ';background:var(--app-input-bg,rgba(255,255,255,.06));color:inherit">'
                                        + data.map(function (lo) { return '<option value="' + lo.lotNo + '" ' + (lo.lotNo === selLot ? 'selected' : '') + '>' + lo.label + '</option>'; }).join('')
                                        + '</select>'
                                    : '<div style="opacity:.5;padding:4px 0">Bu depoda uygun lot bulunamadı.</div>')
                                + '</div>';
                        }
                    });
                    panelDiv.innerHTML = html;
                    panelDiv.querySelectorAll('._sqKitSerialChk').forEach(function (chk) {
                        chk.addEventListener('change', function () {
                            var key = chk.getAttribute('data-key');
                            var arr = st.selections[key] || [];
                            if (chk.checked) { if (arr.indexOf(chk.value) < 0) arr.push(chk.value); }
                            else { arr = arr.filter(function (v) { return v !== chk.value; }); }
                            st.selections[key] = arr;
                            var lblEl = panelDiv.querySelector('._sqKitCountLbl[data-key="' + key + '"]');
                            if (lblEl) {
                                var needAttr = parseInt(lblEl.getAttribute('data-need'), 10) || 0;
                                lblEl.textContent = 'seçili ' + arr.length + ' / gereken ' + needAttr;
                                lblEl.style.color = arr.length === needAttr ? '#10b981' : '#f59e0b';
                            }
                        });
                    });
                    panelDiv.querySelectorAll('._sqKitLotSel').forEach(function (sel3) {
                        sel3.addEventListener('change', function () { st.selections[sel3.getAttribute('data-key')] = sel3.value; });
                    });
                }

                bd.querySelectorAll('._sqKitPickBtn').forEach(function (btn) {
                    btn.addEventListener('click', function () { _sqOpenKitPanel(btn.getAttribute('data-line')); });
                });

                qtyInputs.forEach(function (inp) {
                    var isKit = inp.getAttribute('data-kit') === '1';
                    inp.addEventListener('input', function () {
                        var mx = parseFloat(inp.getAttribute('data-open')) || 0;
                        var v = parseFloat(inp.value);
                        // Kit: yalnız TAM set — kesirli girişi aşağı yuvarla (backend de reddeder).
                        if (isKit && !isNaN(v)) { v = Math.floor(v); inp.value = String(v); }
                        if (!isNaN(v) && v > mx) inp.value = String(isKit ? Math.floor(mx) : mx);
                        if (!isNaN(v) && v < 0) inp.value = '0';
                        // Faz 3 — set miktarı değişince açık panelin seri varsayılanı yeniden hesaplanır.
                        if (isKit) {
                            var lineId = inp.getAttribute('data-line');
                            var st = _sqKitState[lineId];
                            if (st && st.loaded) {
                                st.comps.forEach(function (c) { if (c.tracking === 'Serial') delete st.selections[_sqKitCompKey(c)]; });
                                _sqRenderKitPanelBody(lineId);
                            }
                        }
                    });
                });
                bd.querySelector('#_sqDlvAll').onclick = function () {
                    qtyInputs.forEach(function (inp) { inp.value = inp.getAttribute('data-open'); inp.dispatchEvent(new Event('input', { bubbles: true })); });
                };
                bd.querySelector('#_sqDlvNone').onclick = function () {
                    qtyInputs.forEach(function (inp) { inp.value = 0; inp.dispatchEvent(new Event('input', { bubbles: true })); });
                };
                var okBtn = bd.querySelector('#_sqDlvOk');
                okBtn.onclick = function () {
                    var payload = [];
                    var validationError = null;
                    qtyInputs.forEach(function (inp) {
                        if (validationError) return;
                        var q = parseFloat(inp.value);
                        var mx = parseFloat(inp.getAttribute('data-open')) || 0;
                        if (isNaN(q) || q <= 0) return;
                        if (q > mx) q = mx;
                        var lineId = inp.getAttribute('data-line');
                        var entry = { lineId: parseInt(lineId, 10), quantity: q };
                        // Faz 3 — takipli bileşenli kit satırı: seçimleri payload'a ekle + eksikse engelle.
                        var trackedComps = _sqKitCompsByLine[lineId];
                        if (trackedComps && trackedComps.length) {
                            var st = _sqKitState[lineId];
                            var components = [];
                            for (var i = 0; i < trackedComps.length; i++) {
                                var c = trackedComps[i];
                                var key = _sqKitCompKey(c);
                                var need = Math.round(q * c.perSet);
                                if (c.tracking === 'Serial') {
                                    var sel = (st && st.selections[key]) || [];
                                    if (sel.length !== need) {
                                        validationError = (c.name || c.code || 'Bileşen') + ' için ' + need + ' seri seçilmeli (şu an ' + sel.length + ' seçili). "Seri/Lot Seç" ile tamamlayın.';
                                        break;
                                    }
                                    components.push({ componentItemId: c.componentItemId, configId: c.configId ?? null, serials: sel, lotCode: null });
                                } else if (c.tracking === 'Lot') {
                                    var lotSel = st && st.selections[key];
                                    if (!lotSel) {
                                        validationError = (c.name || c.code || 'Bileşen') + ' için lot seçilmeli. "Seri/Lot Seç" ile seçim yapın.';
                                        break;
                                    }
                                    // Faz 3 (v1) — bileşen başına TEK lot: seçilen lotun bakiyesi ihtiyacı karşılamalı
                                    // (aksi halde backend EnsureLotBalance tüm teslimatı rollback eder — erken uyar).
                                    var lotNeed = q * c.perSet;
                                    var lotData = (st && st.dataByComp[key]) || [];
                                    var chosenLot = lotData.filter(function (lo) { return lo.lotNo === lotSel; })[0];
                                    if (chosenLot && typeof chosenLot.balance === 'number' && chosenLot.balance < lotNeed - 0.00005) {
                                        validationError = (c.name || c.code || 'Bileşen') + ' için seçilen lot bakiyesi yetersiz (gereken ' + _sqFmt(lotNeed) + ', lot bakiyesi ' + _sqFmt(chosenLot.balance) + '). Tek seferde yeterli bakiyeli bir lot seçin.';
                                        break;
                                    }
                                    components.push({ componentItemId: c.componentItemId, configId: c.configId ?? null, serials: null, lotCode: lotSel });
                                }
                            }
                            if (validationError) return;
                            if (components.length) entry.components = components;
                        }
                        payload.push(entry);
                    });
                    if (validationError) { _sqDlvToast(validationError, false); return; }
                    if (!payload.length) { _sqDlvToast('En az bir kalem için teslim miktarı girin.', false); return; }
                    okBtn.disabled = true; okBtn.style.opacity = '.6';
                    var tokEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    fetch(_sqDlvEndpoint, {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tokEl ? tokEl.value : '' },
                        body: JSON.stringify({ orderId: oid, lines: payload })
                    }).then(function (r) { return r.json(); }).then(function (d) {
                        if (d && d.success) { close(); _sqDlvToast('İrsaliye oluşturuldu: ' + (d.docNo || ('#' + d.id)) + '. Stok hareketi yazıldı.', true); setTimeout(function () { window.location.reload(); }, 1100); }
                        else { _sqDlvToast((d && d.message) || (_sqDlvLabel + ' başarısız.'), false); okBtn.disabled = false; okBtn.style.opacity = '1'; }
                    }).catch(function (e) { _sqDlvToast('İşlem sırasında hata: ' + e, false); okBtn.disabled = false; okBtn.style.opacity = '1'; });
                };
                okBtn.focus();
            }
            function _sqDlvToast(msg, ok) {
                var t = document.createElement('div');
                t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:100001;padding:12px 18px;border-radius:10px;font-size:.85rem;font-weight:600;color:#fff;box-shadow:0 10px 30px rgba(0,0,0,.4);max-width:90%;background:' + (ok ? '#10b981' : '#ef4444');
                t.textContent = msg;
                document.body.appendChild(t);
                setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 4000);
            }
            </script>
        }
        @if ((isPurchaseDemand || isPurchaseQuote) && Model.DocumentId.HasValue)
        {
            var cvtLabel = isPurchaseDemand ? "Teklife Dönüştür" : "Siparişe Dönüştür";
            <button type="button" class="pte-btn pte-btn--secondary pte-btn--icon" id="sqBtnConvert" data-collaboration-allow onclick="sqConvertPurchaseDoc()" title="@cvtLabel — kalemleri kopyalayıp bağlantı kurar" aria-label="@cvtLabel">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span class="pte-btn__label">@cvtLabel</span>
            </button>
            <script>
            function sqConvertPurchaseDoc() {
                var sid = @(Model.DocumentId ?? 0);
                if (!sid) return;
                var tokEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var btn = document.getElementById('sqBtnConvert');
                if (typeof CalibraConfirm === 'function') {
                    CalibraConfirm({ title: '@cvtLabel', message: 'Bu belgenin kalemleri kopyalanarak yeni belge oluşturulacak ve iki belge birbirine bağlanacak. Devam edilsin mi?', okLabel: '@cvtLabel' })
                        .then(function (ok) { if (ok) _sqDoConvert(sid, tokEl, btn); });
                } else { _sqDoConvert(sid, tokEl, btn); }
            }
            function _sqDoConvert(sid, tokEl, btn) {
                if (btn) btn.disabled = true;
                fetch('/Sales/ConvertPurchaseDocJson?sourceId=' + sid, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'RequestVerificationToken': tokEl ? tokEl.value : '' }
                }).then(function (r) { return r.json(); }).then(function (d) {
                    if (d && d.success) {
                        if (typeof CalibraAlert !== 'undefined') CalibraAlert.success((d.targetLabel || 'Belge') + ' oluşturuldu.');
                        setTimeout(function () {
                            if (d.editUrl) { if (window.calibraOpenWorkspaceTab) window.calibraOpenWorkspaceTab(d.editUrl, d.targetLabel); else window.location.href = d.editUrl; }
                            else window.location.reload();
                        }, 700);
                    } else {
                        if (typeof CalibraAlert !== 'undefined') CalibraAlert.error((d && d.message) || 'Dönüştürme başarısız.');
                        if (btn) btn.disabled = false;
                    }
                }).catch(function (e) {
                    if (typeof CalibraAlert !== 'undefined') CalibraAlert.error('Dönüştürme hatası: ' + e);
                    if (btn) btn.disabled = false;
                });
            }
            </script>
        }
        <!-- Muayene Oluştur / DÖF Aç — Islemler menusune tasindi (Seq 1112-a,
             2026-08-24). Buton/JS: bkz. sqActionsDropdown icindeki isPurchaseDelivery
             bloğu (sqActionCreateInspection / sqActionCreateDof). -->
        <!-- Status select gizli — UI uzerinden direkt degistirilmiyor; sqActionStatus
             (Islemler dropdown'undan) deger atayip change tetikliyor. Badge gorunur kaldi. -->
        <select id="sqStatusSelect" class="form-select form-select-sm" style="display:none;" onchange="sqChangeStatus()">
            <option value="Draft">Taslak</option>
            <option value="Sent">Gonderildi</option>
            <option value="Approved">Onaylandi</option>
            <option value="Rejected">Reddedildi</option>
            <option value="Cancelled">Iptal</option>
        </select>
        <span id="sqStatusBadge"></span>
        <span class="sqe-meta" id="sqMeta"></span>
    </div>

    <!-- Islemler Dropdown — aksiyon sertinin DISINDA ki backdrop-filter +
         overflow stacking context'i icin kesilmesin. JS ile sqActionsBtn'in
         viewport koordinatlarina gore pozisyonlanir. -->
    <div class="sqe-actions-dropdown" role="menu" id="sqActionsDropdown">
        <!-- Gorunum (2026-08-22): grid ustundeki Kart/Tablo secici serit kaldirildi.
             TEK madde — etiketi HEDEF modu soyler (tablodayken "Kart Görünümüne Geç").
             Iki ayri satir gereksizdi; secim zaten iki degerli. -->
        <button type="button" role="menuitem" class="sqe-actions-item" id="sqViewToggleItem" onclick="sqToggleLineView(event)">
            <svg id="sqViewToggleIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>
            </svg>
            <span id="sqViewToggleLabel">Kalem Görünümünü Değiştir</span>
        </button>
        <button type="button" role="menuitem" class="sqe-actions-item" onclick="sqActionPrint(event)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            <span>Yazdir</span>
        </button>
        <button type="button" role="menuitem" class="sqe-actions-item" onclick="sqActionSendMail(event)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>Mail Gönder</span>
        </button>
        @if (isSalesQuote)
        {
            <!-- Tum Urunlerin Maliyeti — yalniz Satis Teklifi tipinde anlamli (Seq 1112-b,
                 2026-08-24); diger 4 belge tipinde hic render edilmez. -->
            <button type="button" role="menuitem" class="sqe-actions-item" onclick="sqActionShowAllCosts(event)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="2" width="16" height="20" rx="2"/>
                    <line x1="8" y1="6" x2="16" y2="6"/>
                    <line x1="8" y1="10" x2="16" y2="10"/>
                    <line x1="8" y1="14" x2="16" y2="14"/>
                    <line x1="8" y1="18" x2="13" y2="18"/>
                </svg>
                <span>Tüm Ürünlerin Maliyeti</span>
            </button>
        }
        @if (Model.DocumentId.HasValue)
        {
            <!-- Onay Süreci — sağ çekmeceyi açar (bkz. _WorkflowDrawer.cshtml). Rozet
                 sayfa yüklenirken tek seferlik GetInstanceByDocument'ten dolduruluyor. -->
            <button type="button" role="menuitem" class="sqe-actions-item" onclick="sqActionOpenApproval(event)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 9v3a9 9 0 0 0 9 9"/>
                </svg>
                <span style="flex:1;">Onay Süreci</span>
                <span id="sqApprovalBadge" class="sqe-approval-badge" style="display:none;"></span>
            </button>
        }
        @if (isPurchaseDelivery && Model.DocumentId.HasValue)
        {
            <!-- Muayene Oluştur / DÖF Aç — üst şeritten taşındı (Seq 1112-a, 2026-08-24):
                 bu tür belgelerde ("işlem" niteliğinde) Islemler menusunde yer almalari
                 istendi. Gorunurluk kosulu birebir korundu. -->
            <button type="button" role="menuitem" class="sqe-actions-item" data-collaboration-allow onclick="sqActionCreateInspection(event)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>
                </svg>
                <span>Muayene Oluştur</span>
            </button>
            <button type="button" role="menuitem" class="sqe-actions-item" data-collaboration-allow onclick="sqActionCreateDof(event)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/>
                </svg>
                <span>DÖF Aç</span>
            </button>
            <script>
            window.sqActionCreateInspection = function (ev) {
                if (ev) ev.stopPropagation();
                sqCloseActionsMenu();
                var sid = @(Model.DocumentId ?? 0);
                if (!sid) return;
                window.location.href = '/Quality/InspectionEdit?sourceKind=alis_irsaliyesi&sourceId=' + sid;
            };
            window.sqActionCreateDof = function (ev) {
                if (ev) ev.stopPropagation();
                sqCloseActionsMenu();
                var sid = @(Model.DocumentId ?? 0);
                if (!sid) return;
                window.location.href = '/Quality/CapaEdit?sourceKind=alis_irsaliyesi&sourceId=' + sid;
            };
            </script>
        }
        <!-- Durum Degistir — tek item, hover/click ile yan acilan sub-popup -->
        <button type="button" role="menuitem"
                class="sqe-actions-item sqe-actions-item--has-sub"
                aria-haspopup="menu"
                aria-expanded="false"
                onclick="sqToggleStatusSubmenu(event)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <polyline points="12 7 12 12 15 14"/>
            </svg>
            <span style="flex:1;">Durum Değiştir</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </button>
        @* Entegrasyonlar — bu form icin Manual trigger'li aktif entegrasyonlar
           dinamik olarak divider + header + items seklinde dropdown'a eklenir.
           Hicbiri yoksa goruunmez (placeholder gizli kalir).

           ÖNEMLI (bug fix 2026-05-20): Wizard'da kullanici "Satıs Teklifi" altinda
           ya SALES_QUOTE_NEW ya SALES_QUOTE_EDIT kodunu secebilir (Forms tablosunda
           ikisi de var). Edit ekraninda her ikisini de gostermek icin partial'a
           VIRGULLE AYRILMIS form kod listesi gonderiyoruz. _IntegrationActionItems
           her birini ayri sorgulayip dedup ile birlestirir. *@
        @{
            // 2026-05-23: VM'den okuyoruz — 5 belge tipi icin de "EDIT,NEW" cifti.
            var integrationFormCodes = $"{Model.HeaderFormCode},{Model.HeaderFormCodeNew}";
        }
        @await Html.PartialAsync("_IntegrationActionItems",
            new CalibraHub.Web.Models.IntegrationButtonsModel {
                FormCode = integrationFormCodes,
                RecordId = (editId ?? 0).ToString()
            })
    </div>

    <!-- Durum Degistir alt-popup — actions dropdown'unun yan tarafinda acilir.
         JS pozisyonu sqStatusSubBtn (yukaridaki has-sub item) referans alir. -->
    <div class="sqe-status-sub" role="menu" id="sqStatusSubmenu">
        <button type="button" role="menuitem" class="sqe-actions-item" data-status="Draft"     onclick="sqActionStatus('Draft', event)">
            <span class="sqe-actions-item__dot sqe-status-dot--draft"></span>
            <span>Taslak</span>
        </button>
        <button type="button" role="menuitem" class="sqe-actions-item" data-status="Sent"      onclick="sqActionStatus('Sent', event)">
            <span class="sqe-actions-item__dot sqe-status-dot--sent"></span>
            <span>Gonderildi</span>
        </button>
        @* Hibrit governance (2026-08-04): belge türünde tanımlı+aktif onay akışı varsa
           Onaylandı/Reddedildi ELLE seçilemez — yalnız onay akışından gelir. Asıl zorlama
           ChangeQuoteStatus sunucu gate'inde; burası UI gizlemesidir. *@
        @if (!Model.ApprovalGoverned)
        {
            <button type="button" role="menuitem" class="sqe-actions-item" data-status="Approved"  onclick="sqActionStatus('Approved', event)">
                <span class="sqe-actions-item__dot sqe-status-dot--approved"></span>
                <span>Onaylandi</span>
            </button>
            <button type="button" role="menuitem" class="sqe-actions-item" data-status="Rejected"  onclick="sqActionStatus('Rejected', event)">
                <span class="sqe-actions-item__dot sqe-status-dot--rejected"></span>
                <span>Reddedildi</span>
            </button>
        }
        <button type="button" role="menuitem" class="sqe-actions-item" data-status="Cancelled" onclick="sqActionStatus('Cancelled', event)">
            <span class="sqe-actions-item__dot sqe-status-dot--cancelled"></span>
            <span>Iptal</span>
        </button>
    </div>

    <!-- Sol tab + sag icerik -->
    <div class="sqe-body">

        <!-- Yukleme maskesi: edit modunda veri gelene kadar bos alan flashini onler -->
        <div id="sqLoadingMask" class="sqe-loading-mask@(editId.HasValue ? "" : " is-hidden")" aria-hidden="true">
            <div class="sqe-loading-mask__spinner"></div>
            <span class="sqe-loading-mask__text">Yukleniyor…</span>
        </div>

        <nav class="sqe-tab-nav">
            <button type="button" class="sqe-tab-btn is-active" data-sqe-tab-btn="general" onclick="sqSwitchTab('general')">Genel Bilgiler</button>
            <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="lines" onclick="sqSwitchTab('lines')">Kalem Bilgileri</button>
            <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="conditions" onclick="sqSwitchTab('conditions')">Kosullar</button>
            <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="notes" onclick="sqSwitchTab('notes')">Notlar</button>
            <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="widgets" onclick="sqSwitchTab('widgets')">Ek Alanlar</button>
            <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="attachments" onclick="sqSwitchTab('attachments')">Ekli Dosyalar</button>
            @if (Model.DocumentId.HasValue)
            {
                <button type="button" class="sqe-tab-btn" data-sqe-tab-btn="lineage" onclick="sqSwitchTab('lineage')">İlişkili Belgeler</button>
            }
        </nav>
        <div class="sqe-tab-content">

        <!-- TAB 1: Genel Bilgiler -->
        <div class="sqe-tab-pane is-active" data-sqe-pane="general">
            <div class="sqe-hform">
                @* data-field-key: Form Davranış Katmanı (2026-08-05) — formBehavior.js bu
                   attribute ile alanı bulur (gizle/başlık/zorunlu işaret). Yeni sabit alan
                   eklerken DocumentHeaderFieldCatalog'a da satır ekle.
                   2026-08-19: "Kimlik + Şerit" kart düzeni (kalem kartıyla aynı görsel dil) —
                   sarmalayıcılar (.sqe-ident-row/.sqe-strip, data-sqe-section) VARSAYILAN
                   dağılımı temsil eder (Kimlik=0 / Şerit1=1 / Şerit2=2). Her .sqe-hrow'un
                   içeriği (id/class/handler) DEĞİŞMEDİ — yalnız gruplama/sıra değişti.
                   sqApplyCardSections() (asağıda) backend'in /api/form-behavior cardSection
                   alanına göre bu varsayılanı runtime'da override eder (fail-open: alan
                   için cardSection yoksa burada göründüğü grupta kalır). *@
                <div class="sqe-ident-row" data-sqe-section="0">
                    <div class="sqe-ident-fields">
                        <div class="sqe-hrow" data-field-key="quoteNumber">
                            @* 2026-05-23: 5 belge tipini destekler — entityLabel switch'ten gelir.
                               satis_teklifi → "Teklif No", satis_siparisi → "Siparis No",
                               alis_talebi → "İhtiyaç No", alis_teklifi → "Teklif No", alis_siparisi → "Siparis No" *@
                            <label class="sqe-hlabel">@(entityLabel) No</label>
                            <div class="sqe-hcombo" style="align-items:center;gap:6px;">
                                <input id="sqQuoteNumber" class="form-control form-control-sm sqe-hinput" readonly placeholder="Kaydedildiginde olusturulur" style="font-size:1rem; font-weight:600;" />
                                @if (isOrder)
                                {
                                    <button type="button" id="sqOrderLookupBtn" class="sqe-lookup-btn" title="Tekliften olusturulan siparislerden sec" onclick="openOrderLookup()" style="flex-shrink:0;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="11" cy="11" r="7"></circle>
                                            <path d="m21 21-4.3-4.3"></path>
                                        </svg>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="sqe-hrow" data-field-key="customer" style="@(isPurchaseRequest ? "display:none;" : "")">
                            @* 2026-05-23: Satin alma belgelerinde label "Tedarikci", satista "Cari Kod".
                               Element id'leri (sqCustomerDisplay/sqCustomerId) bilincli olarak ayni —
                               JS handler'lari ve save akisi degismez. *@
                            <label class="sqe-hlabel sqe-hlabel--link" title="@(isPurchase ? "Tedarikci karta gitmek icin cift tiklayin" : "Cari karta gitmek icin cift tiklayin")" ondblclick="sqGoToCustomerCard()">@(isPurchase ? "Tedarikçi" : "Cari Kod")</label>
                            <!-- Stok karti pattern: yazinca lookup; varsa otomatik dolar, yoksa yeni cari ekranina yonlendirir.
                                 attachGuide rehber butonu hala calisir, ek olarak elle yazma destegi (readonly KALDIRILDI). -->
                            <input type="text" id="sqCustomerDisplay" class="form-control form-control-sm sqe-hinput"
                                   placeholder="Kod yazin veya rehberden secin" autocomplete="off" />
                            <input type="hidden" id="sqCustomerId" />
                            <span id="sqCustomerName" class="sqe-hlabel-value sqe-customer-name" data-placeholder="Cari secildiginde otomatik dolar"></span>
                        </div>
                    </div>
                </div>

                @* 2026-08-19: şeritler tek blok içinde alt alta satırlar (ayrı kutular değil). *@
                <div class="sqe-strips">
                <div class="sqe-strip" data-sqe-section="1">
                    <div class="sqe-hrow" data-field-key="quoteDate">
                        <label class="sqe-hlabel">Tarih</label>
                        <input id="sqQuoteDate" type="date" class="form-control form-control-sm sqe-hinput" oninput="sqRecalcValidFromDays()" />
                    </div>
                    @if (isOrder)
                    {
                        @* Siparis: Teslim Gun + Tarih (iki input)
                           2026-08-01 PageComment Seq 1060: yeni kayitta varsayilan Gun=0
                           (asil deger atamasi sqInitNew() JS'te yapilir; buradaki value
                           sadece JS calisana kadarki ilk render'da tutarli gorunsun diyedir). *@
                        <div class="sqe-hrow" data-field-key="validUntil">
                            <label class="sqe-hlabel">Teslim Gun/Tarih</label>
                            @* 2026-08-05: Tarih ONCE, Gun SONRA — ustteki "Tarih" ile tarihler
                               sol kenardan alt alta gelsin. *@
                            <div class="sqe-hcombo">
                                <input id="sqValidUntil" type="date" class="form-control form-control-sm sqe-hinput" oninput="sqRecalcDaysFromValid()" />
                                <input id="sqValidDays" type="number" min="0" class="form-control form-control-sm sqe-hinput sqe-fp-days" placeholder="Gun" value="0" oninput="sqRecalcValidFromDays()" />
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Teklif / İhtiyaç Kaydı: Gecerlilik Gun + Tarih (iki input)
                           2026-08-01 PageComment Seq 1060: yeni kayitta varsayilan Gun=0
                           tum belge tiplerinde (onceden yalniz alis_talebi/Ihtiyac Kaydi
                           icindi, Teklif bos kaliyordu). Asil deger atamasi sqInitNew()
                           JS'te yapilir (bkz. asagida); buradaki value ilk render icindir. *@
                        <div class="sqe-hrow" data-field-key="validUntil">
                            <label class="sqe-hlabel">@(isDelivery ? "Vade Gun/Tarih" : "Gecerlilik Gun/Tarih")</label>
                            @* 2026-08-05: Tarih ONCE, Gun SONRA — ustteki "Tarih" ile tarihler
                               sol kenardan alt alta gelsin. *@
                            <div class="sqe-hcombo">
                                <input id="sqValidUntil" type="date" class="form-control form-control-sm sqe-hinput" oninput="sqRecalcDaysFromValid()" />
                                <input id="sqValidDays" type="number" min="0" class="form-control form-control-sm sqe-hinput sqe-fp-days" placeholder="Gun" value="0" oninput="sqRecalcValidFromDays()" />
                            </div>
                        </div>
                    }
                    @* 2026-05-23: Satin Alma Talebi belge tipinde Para Birimi ve Cari Kod
                       gizlenir — talep iç hareket, fiyatlandırma teklifle gelir, tedarikçi
                       sipariş aşamasında belli olur. Diğer 4 belge tipinde her ikisi de görünür.
                       Inputlar DOM'da hala mevcut (hidden) — JS save akışı bos string gönderir,
                       backend default değerleri (CurrencyId=1, ContactId=NULL) uygular. *@
                    @* 2026-08-21 (kullanici istegi): "Para Birimi, Kur ve Kur Tarihi ortak
                       hareket etmeli ve ayrilmamali". Uc hucre tek bir sarmalayiciya alindi:
                       - IZGARA modunda sarmalayici `display: contents` — hucreler yine dogrudan
                         grid ogesi kalir, gorunum BIREBIR degismez.
                       - SERBEST modda sarmalayici tek bir flex ogesidir ve icinde
                         `flex-wrap: nowrap` vardir → satir sonunda ucu birden alta iner,
                         asla birbirinden ayrilmaz.
                       - applySections grup uyesi bir alani tasirken SARMALAYICIYI tasir
                         (bkz. __HGROUP_ANCHOR), boylece bolum degisiminde de birlikte gider. *@
                    <div class="sqe-hgroup" data-hgroup="currency">
                    <div class="sqe-hrow" data-field-key="currency" style="@(isPurchaseRequest ? "display:none;" : "")">
                        <label class="sqe-hlabel">Para Birimi</label>
                        <!-- ID-bazli FK (CurrencyId): value=currencies.id, data-code attribute'unda
                             ISO kodu (TRY/USD/EUR) tasinir — event listener'lar code'u okur.
                             Options sayfa load'da /Finance/GetCurrenciesLookup'tan dinamik dolar. -->
                        <select id="sqCurrency" class="form-select form-select-sm sqe-hinput" style="max-width:90px;"
                                data-current-id="1"
                                onchange="(function(el){
                                    try {
                                        var opt = el.options[el.selectedIndex];
                                        var code = (opt && opt.getAttribute('data-code')) || 'TRY';
                                        window.dispatchEvent(new CustomEvent('sq:currency', { detail: { id: parseInt(el.value) || 1, code: code, userInitiated: true } }));
                                    } catch(e) {}
                                })(this)">
                            <option value="1" data-code="TRY">TRY</option>
                        </select>
                    </div>
                    @if (!isPurchaseRequest)
                    {
                        @* 2026-08-19: Kur — Para Birimi'nden ayrı KENDİ hücresi (data-field-key="exchangeRate"),
                           Standart Alanlar'dan bağımsız Bölüm/sıra atanabilir. TRY seçiliyken gizli —
                           sq:currency event'i HÜCREYİ (wrapper) show/hide eder, artık yalnız input'u değil;
                           böylece kart düzeninde tek hücreye sıkışıp alt alta dizilmezler. *@
                        <div class="sqe-hrow" id="sqExchangeRateWrap" data-field-key="exchangeRate" style="display:none;">
                            <label class="sqe-hlabel">Kur</label>
                            <input id="sqExchangeRate" type="number" class="form-control form-control-sm sqe-hinput sq-no-spinner sq-no-negative"
                                   @* Seq 1094: deger saga yasli (sayisal alan okunurlugu) *@
                                   style="max-width:88px; text-align:right;" value="1" min="0" step="0.000001"
                                   title="Kur — 1 birim belge dövizinin TL karşılığı"
                                   oninput="sqRecalc()" onchange="(function(el){var v=parseFloat(el.value);if(!isFinite(v)||v<=0)el.value=1;sqRecalc();})(this)" />
                        </div>
                        @* 2026-08-06/2026-08-19: Kur tarihi — seçilen günün kurunu (SALES_QUOTE "Kur Tipi"
                           parametresine göre Satış/Alış/Efektif) getirir. Kur hücresiyle birlikte göster/gizle.
                           Kendi hrow'u = flatpickr altInput'u da bu div İÇİNE eklenir, toggle native+altInput'u
                           birlikte gizler. Değeri programatik: window.sqSetDateValue('sqRateDate', iso). *@
                        <div class="sqe-hrow" id="sqRateDateWrap" data-field-key="rateDate" style="display:none;">
                            <label class="sqe-hlabel">Kur Tarihi</label>
                            <input id="sqRateDate" type="date" class="form-control form-control-sm sqe-hinput"
                                   title="Kur tarihi — seçilen günün kurunu getirir"
                                   onchange="sqRateDateChanged()" />
                        </div>
                    }
                    </div>@* /.sqe-hgroup (currency + exchangeRate + rateDate) *@
                    @if (!isPurchaseRequest)
                    {
                        @* Seq 1068: KDV Dahil switch — aktifse girilen birim fiyat KDV dahil kabul edilir. *@
                        <div class="sqe-hrow" data-field-key="vatIncluded">
                            <label class="sqe-hlabel">KDV Dahil</label>
                            <label class="sqe-switch" title="Aktifse birim fiyatlar KDV dahil girilir, net geriye hesaplanır">
                                <input type="checkbox" id="sqVatIncluded" onchange="sqRecalc()" />
                                <span class="sqe-switch-track"><span class="sqe-switch-thumb"></span></span>
                            </label>
                        </div>
                    }
                </div>

                <div class="sqe-strip" data-sqe-section="2">
                    @if (!isPurchaseRequest)
                    {
                    <div class="sqe-hrow" data-field-key="salesRep">
                        @if ((bool)(ViewData["CanViewSalesReps"] ?? false))
                        {
                            @* Seq 1066/1089: yetki varsa etiket ÇİFT TIKLAYINCA (Cari Kod ile aynı desen)
                               Satış Temsilcileri tanımlama ekranını workspace sekmesi olarak açar — teklif
                               sayfası açık kalır. Tek tık navigasyon yok (href kaldırıldı, ondblclick). *@
                            <label class="sqe-hlabel sqe-hlabel--link" style="cursor:pointer;"
                                   ondblclick="sqOpenSalesRepDefs(event)"
                                   title="Çift tıklayınca Satış Temsilcileri tanımlama ekranını açar">Temsilci</label>
                        }
                        else
                        {
                            <label class="sqe-hlabel">Temsilci</label>
                        }
                        <div class="sqe-rep-cb sqe-hinput" id="sqSalesRepWrapper">
                            <button type="button" class="sqe-rep-btn" id="sqSalesRepBtn" aria-haspopup="listbox" aria-expanded="false">
                                <span class="sqe-rep-label is-placeholder" id="sqSalesRepLabel">Seçiniz</span>
                                <svg class="sqe-rep-chevron" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                            <input type="hidden" id="sqSalesRepId" />
                            <div class="sqe-rep-panel" id="sqSalesRepPanel" hidden role="listbox">
                                <div class="sqe-rep-search-wrap" data-nodirty>
                                    <svg class="sqe-rep-search-icon" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10 10l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                    <input type="text" class="sqe-rep-filter" id="sqSalesRepFilter" placeholder="İsimde ara…" autocomplete="off" />
                                </div>
                                <div class="sqe-rep-list" id="sqSalesRepList"></div>
                            </div>
                        </div>
                    </div>
                    }
                    @if (isPurchaseRequest)
                    {
                        var personnels         = ViewData["RequesterPersonnels"] as System.Collections.IEnumerable;
                        var requesterLocked    = (bool)(ViewData["RequesterLocked"] ?? false);
                        var curPersonnelId     = ViewData["CurrentUserPersonnelId"] as int?;
                        var locationList       = ViewData["LocationList"] as System.Collections.IEnumerable;
                        var curLocationId      = ViewData["CurrentLocationId"] as int?;
                        <div class="sqe-hrow" data-field-key="requester">
                            <label class="sqe-hlabel">Talep Eden</label>
                            <select id="sqRequesterId" class="form-select form-select-sm sqe-hinput"
                                @(requesterLocked ? "disabled" : "")>
                                <option value="">Seçiniz…</option>
                                @if (personnels != null)
                                {
                                    foreach (dynamic p in personnels)
                                    {
                                        <option value="@p.Id" data-dept="@p.Dept">@p.Name</option>
                                    }
                                }
                            </select>
                            @if (requesterLocked && curPersonnelId == null)
                            {
                                <small class="text-warning ms-1" title="Hesabınıza bağlı personel kaydı bulunamadı.">⚠ Personel kaydı yok</small>
                            }
                        </div>
                        @if (curPersonnelId.HasValue)
                        {
                            <script>
                            (function(){
                                var sel = document.getElementById('sqRequesterId');
                                if (sel) { sel.value = '@curPersonnelId'; }
                            })();
                            </script>
                        }

                        <div class="sqe-hrow" data-field-key="location">
                            <label class="sqe-hlabel">Lokasyon</label>
                            <select id="sqLocationId" class="form-select form-select-sm sqe-hinput" onchange="sqPropagateHeaderLocation()">
                                <option value="">Seçiniz…</option>
                                @if (locationList != null)
                                {
                                    foreach (dynamic loc in locationList)
                                    {
                                        <option value="@loc.Id">@loc.LocationName</option>
                                    }
                                }
                            </select>
                        </div>
                        @if (curLocationId.HasValue)
                        {
                            <script>
                            (function(){
                                var sel = document.getElementById('sqLocationId');
                                if (sel) { sel.value = '@curLocationId'; }
                            })();
                            </script>
                        }
                    }
                </div>
                </div>

                @* 2026-08-21 (kullanici istegi): ust bilgide Genel Toplam KALDIRILDI.
                   Asil toplam Kalem Bilgileri footer'indaki #sqGrandTotal'dedir; buradaki
                   yalnizca aynaydi. sqRecalc() aynayi `if (mirrorWrap && mirrorVal)` ile
                   yaziyor — element yoklugunda sessizce atliyor, bu yuzden JS'e
                   DOKUNULMADI (ayni null-guvenli yol Ihtiyac Kaydi icin zaten vardi). *@
            </div>
        </div>

