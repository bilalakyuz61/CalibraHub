                    });
                    return;
                }
            }
        }

        // Satirlari React CalibraLineItemsGrid'ten al (bridge)
        var rawLines = window.__SQ_LINES__ || [];
        if (window.CalibraHub && window.CalibraHub.salesLineGrid) {
            try { rawLines = window.CalibraHub.salesLineGrid.getRows() || rawLines; } catch (e) {}
        }
        var rowsFilled = rawLines.filter(function (r) { return r && (r.materialCode || r.materialName); });

        if (_validate) {
            // ── Kombinasyon zorunlu kontrolu ────────────────────────────────────
            var missingCombos = rowsFilled.filter(function (r) {
                var m = (materials || []).find(function (x) { return x.materialCode === r.materialCode; });
                var needs = m ? m.trackCombinations === true : r.trackCombinations === true;
                var hasComboId = r.combinationId != null && r.combinationId !== '' && parseInt(r.combinationId, 10) > 0;
                return needs && !hasComboId;
            });
            if (missingCombos.length > 0) {
                sqActivateTab('lines');
                requestAnimationFrame(function () {
                    document.querySelectorAll('[data-comb-btn][data-needs-combo="1"]').forEach(function (btn) {
                        btn.classList.remove('cb-invalid-shake');
                        void btn.offsetWidth;
                        btn.classList.add('cb-invalid-shake');
                        setTimeout(function () { btn.classList.remove('cb-invalid-shake'); }, 600);
                    });
                });
                return;
            }
        }

        var lines = rowsFilled
            .map(function (r) {
                // ItemId DB'de source-of-truth; materialCode/materialName tabloda tutulmaz,
                // server JOIN ile Item'dan turetir. unitId, combinationId ve locationId ayni sekilde.
                // Id dolu gelirse UPSERT (UPDATE) — widget kayitlari orphanlanmaz.
                // trackCombinations: satirin (bayat olabilen) bayragi yerine MASTER (stok karti)
                // degeri gonderilir — client dogrulamasi da master'a bakar; server payload'a
                // guvendigi icin ikisi ayni kaynaktan gelmezse yanlis "kombinasyon secilmelidir"
                // hatasi cikiyordu (2026-07-08).
                var mCombo = (materials || []).find(function (x) { return x.materialCode === r.materialCode; });
                return {
                    id:                 r.id != null && r.id !== '' && Number(r.id) > 0 ? Number(r.id) : null,
                    itemId:             r.stockCardId != null && r.stockCardId !== '' ? parseInt(r.stockCardId, 10) : 0,
                    trackCombinations:  mCombo ? mCombo.trackCombinations === true : (r.trackCombinations === true),
                    unitId:             r.unitId != null && r.unitId !== '' ? parseInt(r.unitId, 10) : null,
                    quantity:           Number(r.quantity) || 0,
                    unitPrice:          Number(r.unitPrice) || 0,
                    discountRate:       Number(r.discountRate) || 0,
                    combinationId:      r.combinationId != null && r.combinationId !== '' ? parseInt(r.combinationId, 10) : null,
                    locationId:         r.locationId != null && r.locationId !== '' ? parseInt(r.locationId, 10) : null,
                    combinationDetails: Array.isArray(r.combinationDetails) ? r.combinationDetails : [],
                    notes:              r.notes || null,
                    notesPinned:        r.notesPinned === true,
                    revisedFromId:      r.revisedFromId != null && Number(r.revisedFromId) > 0 ? Number(r.revisedFromId) : null,
                    // Seri-takipli kalemde siparişe seçilen seriler (satış siparişi rezervasyonu)
                    serials:            Array.isArray(r.serials) && r.serials.length > 0 ? r.serials : null
                };
            });
        var custIdVal  = document.getElementById('sqCustomerId').value;
        var custCodeVal = (document.getElementById('sqCustomerDisplay').value || '').trim();
        var custText   = null;

        if (_validate) {
            // ── Cari zorunlu kontrolu ───────────────────────────────────────────
            // 2026-05-23: İhtiyaç Kaydı (alis_talebi) bir IC belge — tedarikci/musteri
            // bu asamada belli degil. Cari Kod UI'da zaten gizli; save akisinda da
            // zorunluluk uygulanmaz. Diger 4 belge tipinde kontrol aynen calisir.
            var __isPurchaseRequest = @(isPurchaseRequest ? "true" : "false");
            if (!__isPurchaseRequest && !custIdVal && !custCodeVal && !custText) {
                flashCustomerRequired();
                return;
            }
            // ── Talep Eden zorunlu kontrolu (sadece İhtiyaç Kaydı) ─────────────
            // 2026-06-01: alis_talebi'nde Talep Eden personel secimi zorunlu —
            // talep kimden geldiyse onay akisi + raporlama o uzerine kurulur.
            if (__isPurchaseRequest) {
                var __reqEl = document.getElementById('sqRequesterId');
                if (!__reqEl || !__reqEl.value || String(__reqEl.value).trim() === '') {
                    flashRequesterRequired();
                    return;
                }
            }

            // ── Form Davranış Katmanı zorunlulukları (2026-08-05) ──────────────
            // Admin'in tanımladığı (statik + requiredIf) zorunlu alanlardan boş
            // olan varsa: ilgili sekmeye git, alanları kırmızı işaretle, kaydı durdur.
            // Server SaveDocument'ta aynı kontrolün paritesi vardır (fail-open).
            if (window.CalibraHub && window.CalibraHub.formBehaviorValidate) {
                var __fb = window.CalibraHub.formBehaviorValidate();
                if (__fb && !__fb.ok && __fb.missing.length > 0) {
                    var __fbFirst = __fb.missing[0];
                    try { sqActivateTab(__fbFirst.tab || 'general'); } catch (e) {}
                    __fb.missing.forEach(function (mm) {
                        if (!mm.el) return;
                        mm.el.style.boxShadow = 'inset 0 0 0 1.5px #ef4444';
                        var __clr = function () {
                            mm.el.style.boxShadow = '';
                            mm.el.removeEventListener('input', __clr);
                            mm.el.removeEventListener('change', __clr);
                        };
                        mm.el.addEventListener('input', __clr);
                        mm.el.addEventListener('change', __clr);
                    });
                    if (__fbFirst.el) {
                        try { __fbFirst.el.focus(); __fbFirst.el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) {}
                    }
                    // Hafif toast — sayfada genel toast altyapısı olmadığı için kendi
                    // kendini temizleyen minimal bir uyarı kutusu.
                    (function showFbToast(msg) {
                        var t = document.createElement('div');
                        t.textContent = msg;
                        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;' +
                            'background:var(--app-surface, #fff);color:var(--bs-body-color, #0f172a);' +
                            'border:1px solid #ef4444;border-left:4px solid #ef4444;border-radius:10px;' +
                            'padding:10px 16px;font-size:12.5px;font-weight:600;box-shadow:0 8px 24px rgba(15,23,42,.18);max-width:420px;';
                        document.body.appendChild(t);
                        setTimeout(function () { try { t.remove(); } catch (e) {} }, 4500);
                    })('Zorunlu alanlar boş: ' + __fb.missing.map(function (x) { return x.label; }).join(', '));
                    return;
                }
            }
        }

        // Tarih + Gun ikilisini belge tipine gore dogru kolona yaz:
        //   - Teklif → validUntil (eski davranis)
        //   - Siparis → deliveryDate + deliveryDays (Faz M)
        // sqValidUntil/sqValidDays input'lari ID olarak ayni; sadece backend kolon farkli.
        var __isOrder = @(isOrder ? "true" : "false");
        var __dateVal = document.getElementById('sqValidUntil').value || null;
        var __daysVal = parseInt(document.getElementById('sqValidDays').value) || null;

        var payload  = {
            id: currentQuoteId,
            // Belgeyi actigimizda okunan surum damgasi — sunucu UPDATE'i bununla sartlar.
            rowVersion: window.__CALIBRA_ROW_VERSION__ || null,
            // Belge tipi: yeni belge ise server-side resolved id (window.__CALIBRA_DOC_TYPE__),
            // mevcut belgede null gonderilir (server existing.DocumentTypeId'i korur).
            documentTypeId:  (window.__CALIBRA_DOC_TYPE__ && window.__CALIBRA_DOC_TYPE__.id) || null,
