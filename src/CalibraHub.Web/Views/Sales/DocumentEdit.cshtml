            notes:           document.getElementById('sqNotes').value || null,
            // Kaynak İhtiyaç Kaydı ID'si — yeni belge ise köprü oluşturulur (document_source).
            // Mevcut belgede null gönderilir (server-side isNew kontrolü zaten var).
            fromRequestId:   currentQuoteId ? null : (fromRequestId || null),
            lines: lines
        };
        try {
            var resp = await fetch('/Sales/SaveDocument', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
