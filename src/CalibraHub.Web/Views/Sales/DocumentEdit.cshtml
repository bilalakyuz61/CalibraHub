@section Scripts {
<script>
    /* Tarih inputlari global standarttan flatpickr olur (calibra-datepicker.js):
       TR locale + altInput d.m.Y + click-only open. Takvim secimi orijinal input'a
       'input' event'i yansitir — sqQuoteDate/sqValidUntil inline oninput recalc'lari
       (sqRecalcValidFromDays / sqRecalcDaysFromValid) ayni sekilde calisir. */

    /* sqSetDateValue: programatik deger atamada flatpickr-uyumlu helper.
       Flatpickr binding varsa setDate() kullanir; yoksa native value. */
    window.sqSetDateValue = function (id, isoValue) {
        var el = document.getElementById(id);
        if (!el) return;
        if (el._flatpickr) el._flatpickr.setDate(isoValue || null, false);
        else el.value = isoValue || '';
    };
</script>
<script>
    // ══════════════════════════════════════════════════════════════
    // CalibraLineItemsGrid inline config — server-side hazirlandi
    // (SalesController.BuildDocumentLineGridConfig). Kolonlar ve
    // meta bilgi tamamen C#'tan gelir — React bileseni hardcode yapmaz.
    // ══════════════════════════════════════════════════════════════
    window.__CALIBRA_SALES_QUOTE_LINE_GRID__ = @Html.Raw(Model.LineGridConfigJson);
    // 2026-06-01: Grid'in satir context menusunden Fiyat Geçmişi/Maliyet/Revize'yi
    // alis_talebi (İhtiyaç Kaydı) icin gizlemek uzere documentTypeCode'u config'e enjekte.
    try { window.__CALIBRA_SALES_QUOTE_LINE_GRID__.documentTypeCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocumentTypeCode ?? "")); } catch (e) { }
    // 2026-06-02: Satir ek alanlari modal'i + schema fetch dogru form code'u
    // kullansin diye config'e enjekte. Onceden grid hardcoded SALES_QUOTE_LINES
    // kullaniyordu; alis_talebi'nde modal yanlis form widget'larini gosteriyor +
    // backend dogru formu kontrol edip eksik gorerek gear'i kirmizi tutuyordu.
    try { window.__CALIBRA_SALES_QUOTE_LINE_GRID__.lineFormCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LineFormCode ?? "SALES_QUOTE_LINES")); } catch (e) { }
    // Belge tipi server-side resolve — SaveDocument body'sine documentTypeId set etmek
    // ve UI label/davranis ayrimlari icin (teklif vs siparis).
    window.__CALIBRA_DOC_TYPE__ = {
        id: @(Model.DocumentTypeId?.ToString() ?? "null"),
        code: '@Model.DocumentTypeCode',
        isOrder: @(string.Equals(Model.DocumentTypeCode, "satis_siparisi", StringComparison.OrdinalIgnoreCase) ? "true" : "false")
    };
    // PageComment Seq 6 (2026-07-21): "Satis siparis kalemlerinde depo kodu gorunmeli."
    // DocumentLineDto zaten locationId/locationCode/locationName tasir — malzeme secilince
    // lookupFillMap (materialCode kolonu) ile Item'in varsayilan lokasyonu otomatik yaziliyor
    // ve sqSave zaten r.locationId'yi SaveDocumentLineRequest'e gonderiyor (bkz. asagida
    // "locationId: r.locationId..."); ama grid'de GORUNUR bir kolon olmadigi icin kullanici
    // bu veriyi hic goremiyor/duzenleyemiyordu. Kolon tanimi backend'in BuildDocumentLineGridConfig
    // (SalesController, Controller sahasi) yerine burada View katmaninda enjekte edilir — ayni
    // yontem documentTypeCode/lineFormCode enjeksiyonunda yukarida zaten kullaniliyor. Yalnizca
    // satis siparisinde (isOrder) eklenir; teklif/talep/diger belge tipleri ETKILENMEZ.
    (function () {
        var cfg = window.__CALIBRA_SALES_QUOTE_LINE_GRID__;
        if (!window.__CALIBRA_DOC_TYPE__.isOrder || !cfg || !Array.isArray(cfg.columns)) return;
        var cols = cfg.columns.filter(function (c) { return c && c.key !== 'locationId'; });
        var qtyIdx = cols.findIndex(function (c) { return c && c.key === 'quantity'; });
        var locationCol = {
            key: 'locationId',
            label: 'Depo',
            type: 'select',
            optionsUrl: '/Warehouse/GetLocationsJson',
            optionsValueKey: 'id',
            optionsLabelKey: 'locationName',
            width: 150,
            align: 'left',
            icon: 'Warehouse',
        };
        cols.splice(qtyIdx >= 0 ? qtyIdx + 1 : cols.length, 0, locationCol);
        cfg.columns = cols;
    })();
</script>
<script>
(function () {
    // ── Tab gecis ──────────────────────────────────────────
    /**
     * Cari bilgisi girilmemisse "Genel Bilgiler" disindaki sekmelere gecisi engelle.
     * Kaydedilmis belge (currentQuoteId) oldugunda mumkun — ama kayit sonrasi zaten
     * customerId dolu olur. Yeni teklifte bos birakilinca bloke eder.
     */
    function hasCustomer() {
        // Oncelik: numeric Id; Id bos ise AccountCode (display input) uzerinden kontrol et
        var idVal = document.getElementById('sqCustomerId');
        if (idVal && idVal.value && idVal.value.trim() !== '') return true;
        var disp = document.getElementById('sqCustomerDisplay');
        if (disp && disp.value && disp.value.trim() !== '') return true;
        return false;
    }

    function flashCustomerRequired() {
        var disp = document.getElementById('sqCustomerDisplay');
        if (!disp) return;
        // Kirmizi cerceve + shake animasyonu; kullanici input'a ilk karakter yazdiginda temizlenir
        disp.classList.add('is-invalid', 'sqe-flash');
        setTimeout(function() { disp.classList.remove('sqe-flash'); }, 600);
        var clearInvalid = function() {
            disp.classList.remove('is-invalid');
            disp.removeEventListener('input', clearInvalid);
            disp.removeEventListener('change', clearInvalid);
        };
        disp.addEventListener('input', clearInvalid);
        disp.addEventListener('change', clearInvalid);
        // Genel Bilgiler sekmesine don ve focus ver
        sqActivateTab('general');
        setTimeout(function() { disp.focus(); }, 50);
    }

    // Talep Eden zorunlu uyarisi — flashCustomerRequired pattern'i ile ayni:
    // kirmizi cerceve + shake animasyonu, kullanici seciminde temizlenir,
    // Genel Bilgiler sekmesi acilir, focus verilir.
    function flashRequesterRequired() {
        var sel = document.getElementById('sqRequesterId');
        if (!sel) return;
        sel.classList.add('is-invalid', 'sqe-flash');
        setTimeout(function() { sel.classList.remove('sqe-flash'); }, 600);
        var clearInvalid = function() {
            sel.classList.remove('is-invalid');
            sel.removeEventListener('change', clearInvalid);
        };
        sel.addEventListener('change', clearInvalid);
        sqActivateTab('general');
        setTimeout(function() { sel.focus(); }, 50);
    }

    // Zorunlu ust bilgi (widget) alanlari icin UYARI-ONLY kontrol. Hicbir seyi
    // engellemez; renderer.validate() eksikleri isaretler ve toast gosterir.
    // Renderer henuz mount olmadiysa veya formda hic widget yoksa sessizce cikar
    // (fail-open: kontrol edilemiyorsa kullanicinin onunu kesme).
    function sqWarnMissingHeaderWidgets() {
        try {
            var r = window._sqDynRenderer;
            if (!r || typeof r.validate !== 'function') return;
            if (typeof r.getHasWidgets === 'function' && !r.getHasWidgets()) return;
            r.validate();
        } catch (e) {
            console.warn('[SQ] zorunlu ek alan uyarisi atlandi:', e);
        }
    }

    function sqActivateTab(tabKey) {
        document.querySelectorAll('[data-sqe-tab-btn]').forEach(function(btn) {
            btn.classList.toggle('is-active', btn.getAttribute('data-sqe-tab-btn') === tabKey);
        });
        document.querySelectorAll('[data-sqe-pane]').forEach(function(pane) {
            pane.classList.toggle('is-active', pane.getAttribute('data-sqe-pane') === tabKey);
        });
        try { localStorage.setItem('sqe-active-tab', tabKey); } catch(e) {}
    }

    window.sqSwitchTab = function(tabKey) {
        sqActivateTab(tabKey);
        // ── Kalem Bilgileri'ne gecerken zorunlu UST BILGI ek alanlarini UYAR ──
        // (2026-08-19 kullanici karari: "uyar ama engelleme")
        // Bolge gibi belge-bazinda zorunlu bir ek alan, kalem girisine baslamadan
        // once fark edilmeli; aksi halde kullanici tum kalemleri girip ancak
        // Kaydet'te ogreniyor. Gecis ENGELLENMEZ — kullanici kalemlere goz atmak
        // isteyebilir; kesin engel acik "Kaydet"te (sqSave({validate:true})).
        // validate() zaten eksik alanlari kirmizi isaretler + kendi toast'ini
        // gosterir; burada sadece tetikliyoruz, donen degeri yok sayiyoruz.
        if (tabKey === 'lines') sqWarnMissingHeaderWidgets();

        /* ── Sekme kancalari (2026-08-21 Faz 3) ───────────────────────────────
           Kancalar eskiden sekme ANAHTARINA baglıydı (`tabKey === 'attachments'`).
           Icerik baska bir sekmeye tasinabildigi icin bu yanlis: Ekli Dosyalar'ı
           Genel Bilgiler'e tasiyinca liste hic yuklenmezdi. Artik kanca, ilgili
           ICERIGIN acilan pane'de BULUNUP bulunmadigina bakar — icerik nereye
           giderse kanca onu takip eder. */
        (function runPaneHooks() {
            var pane = document.querySelector('[data-sqe-pane="' + tabKey + '"]');
            if (!pane) return;
            if (pane.querySelector('.sqe-att-wrap')) { try { sqAttLoad(); } catch (e) {} }
            if (pane.querySelector('#sqLineageHost')) { try { sqLineageLoad(); } catch (e) {} }
            if (pane.querySelector('#sqDynamicWidgets') && typeof window.sqProbeWidgets === 'function') {
                try { window.sqProbeWidgets(); } catch (e) {}
            }
            var ta = pane.querySelector('#sqNotes');
            if (ta) { try { autoResizeTextarea(ta); } catch (e) {} }
        })();
        // NOT: Notlar (textarea yeniden boyutlandirma) ve Ek Alanlar (widget probe)
        // kancalari YUKARIDAKI runPaneHooks icine tasindi — icerik tasindiginda
        // anahtar degil ICERIK takip edilsin diye.
    };

    // ── İlişkili Belgeler / Akış (belge soyağacı) ─────────────────────────────
    var _sqLineageLoaded = false;
    window.sqLineageLoad = function() {
        if (_sqLineageLoaded) return;
        var host = document.getElementById('sqLineageHost');
        if (!host) return;
        var docId = host.getAttribute('data-doc-id');
        if (!docId) return;
        _sqLineageLoaded = true;
        host.innerHTML = '<div class="dlg-empty">Yükleniyor…</div>';
        fetch('/Document/Lineage?id=' + encodeURIComponent(docId), { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(data) { sqRenderLineage(host, data); })
            .catch(function() { host.innerHTML = '<div class="dlg-empty">İlişkili belgeler yüklenemedi.</div>'; });
    };

    function sqLinEsc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

    function sqLinStatus(st) {
        switch (st) {
            case 'Approved':  return { label: 'Onaylandı',     cls: 'dlg-st--ok'    };
            case 'Rejected':  return { label: 'Reddedildi',    cls: 'dlg-st--rej'   };
            case 'Sent':      return { label: 'Onayda',        cls: 'dlg-st--pend'  };
            case 'Cancelled': return { label: 'İptal',         cls: 'dlg-st--mut'   };
            case 'Closed':    return { label: 'Kapalı',        cls: 'dlg-st--mut'   };
            case 'Converted': return { label: 'Dönüştürüldü',  cls: 'dlg-st--mut'   };
            case 'Deleted':   return { label: 'Silinmiş',      cls: 'dlg-st--rej'   };
            default:          return { label: st || 'Taslak',  cls: 'dlg-st--draft' };
        }
    }

    function sqRenderLineage(host, data) {
        var nodes = (data && data.nodes) || [];
        if (nodes.length <= 1) {
            host.innerHTML = '<div class="dlg-empty">Bu belgeyle ilişkili başka belge yok.</div>';
            return;
        }
        var byDepth = {};
        nodes.forEach(function(n) { (byDepth[n.depth] = byDepth[n.depth] || []).push(n); });
        var depths = Object.keys(byDepth).map(Number).sort(function(a, b) { return a - b; });
        var html = '<div class="dlg-hint">Seçili belgenin öncesindeki (kaynak) ve sonrasındaki (türeyen) belgeler. Yetkiniz olan belgeye tıklayınca yeni sekmede açılır.</div>';
        html += '<div class="dlg-flow">';
        depths.forEach(function(dep, i) {
            if (i > 0) html += '<div class="dlg-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></div>';
            html += '<div class="dlg-col">';
            var label = dep < 0 ? 'Önceki' : dep > 0 ? 'Sonraki' : 'Bu Belge';
            html += '<div class="dlg-col-lbl">' + label + '</div>';
            byDepth[dep].forEach(function(n) {
                var si = sqLinStatus(n.status);
                var clickable = n.canView && n.url && !n.isRoot;
                var d = n.date ? new Date(n.date).toLocaleDateString('tr-TR') : '';
                html += '<div class="dlg-card' + (n.isRoot ? ' dlg-card--root' : '') + (clickable ? ' dlg-card--link' : '') + (!n.canView ? ' dlg-card--noauth' : '') + '"'
                    + (clickable ? ' data-url="' + sqLinEsc(n.url) + '" data-title="' + sqLinEsc(n.typeName + ' ' + n.documentNumber) + '"' : '')
                    + (!n.canView ? ' title="Bu belgeyi görüntüleme yetkiniz yok"' : '') + '>'
                    + '<div class="dlg-card-type">' + sqLinEsc(n.typeName) + '</div>'
                    + '<div class="dlg-card-no">' + sqLinEsc(n.documentNumber || '—') + (!n.canView ? ' <span class="dlg-lock">🔒</span>' : '') + '</div>'
                    + '<div class="dlg-card-meta"><span class="dlg-st ' + si.cls + '">' + sqLinEsc(si.label) + '</span>' + (d ? '<span class="dlg-card-date">' + d + '</span>' : '') + '</div>'
                    + '</div>';
            });
            html += '</div>';
        });
        html += '</div>';
        host.innerHTML = html;
        host.querySelectorAll('.dlg-card--link').forEach(function(card) {
            card.addEventListener('click', function() {
                var url = card.getAttribute('data-url');
                var title = card.getAttribute('data-title');
                if (!url) return;
                if (window.calibraOpenWorkspaceTab) window.calibraOpenWorkspaceTab(url, title);
                else window.location.href = url;
            });
        });
    }

    // ── Ekli Dosyalar yonetimi ──
    function sqFormatBytes(n) {
        if (!n || n < 0) return '0 B';
        var k = 1024, u = ['B','KB','MB','GB'];
        var i = Math.min(Math.floor(Math.log(n)/Math.log(k)), u.length - 1);
        return (n/Math.pow(k,i)).toFixed(i === 0 ? 0 : 1) + ' ' + u[i];
    }

    // fetch + Blob URL ile indir — anchor navigasyon olmaz (iframe/workspace uyumlu)
    window.sqAttDownload = function(id) {
        fetch('/Sales/DownloadDocumentAttachment?id=' + id, { credentials: 'same-origin' })
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                var disp = r.headers.get('content-disposition') || '';
                var star  = disp.match(/filename\*=UTF-8''([^;\s\r\n]+)/i);
                var plain = disp.match(/filename="([^"]+)"/i);
                var name  = star ? decodeURIComponent(star[1]) : (plain ? plain[1] : 'dosya');
                return r.blob().then(function(b) { return { blob: b, name: name }; });
            })
            .then(function(d) {
                var url = URL.createObjectURL(d.blob);
                var el = document.createElement('a');
                el.href = url; el.download = d.name; el.style.display = 'none';
                document.body.appendChild(el); el.click();
                setTimeout(function() { URL.revokeObjectURL(url); el.remove(); }, 100);
            })
            .catch(function(e) {
                if (window.CalibraAlert) CalibraAlert.error('İndirme hatası: ' + (e.message || e));
            });
    };

    async function sqAttLoad() {
        var listEl = document.getElementById('sqAttList');
        if (!listEl) return;
        if (!currentQuoteId) {
            listEl.innerHTML = '<div class="sqe-att-empty">Ekleme yapmak icin once teklifi kaydedin.</div>';
            return;
        }
        listEl.innerHTML = '<div class="sqe-att-empty">Yukleniyor...</div>';
        try {
            var resp = await fetch('/Sales/GetDocumentAttachments?documentId=' + encodeURIComponent(currentQuoteId));
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            var data = await resp.json();
            sqAttRender(data || []);
        } catch (e) {
            listEl.innerHTML = '<div class="sqe-att-empty">Liste yuklenemedi: ' + (e.message||e) + '</div>';
        }
    }

    function sqAttRender(items) {
        var listEl = document.getElementById('sqAttList');
        if (!listEl) return;
        if (!items || items.length === 0) {
            listEl.innerHTML = '<div class="sqe-att-empty">Henuz ekli dosya yok.</div>';
            return;
        }
        listEl.innerHTML = items.map(function(a) {
            return '<div class="sqe-att-item">' +
                '<span class="sqe-att-item__name" title="' + a.fileName.replace(/"/g,'&quot;') + '">' + a.fileName + '</span>' +
                '<span class="sqe-att-item__meta">' + sqFormatBytes(a.fileSize) + '</span>' +
                '<button type="button" class="sqe-att-item__btn" onclick="event.stopPropagation();sqAttDownload(' + a.id + ')">İndir</button>' +
                '<button type="button" class="sqe-att-item__btn is-danger" onclick="event.stopPropagation();sqAttDelete(' + a.id + ')">Sil</button>' +
                '</div>';
        }).join('');
    }

    async function sqAttUpload(files) {
        if (!currentQuoteId) {
            CalibraAlert.warning('Dosya eklemek icin once teklifi kaydedin.');
            document.getElementById('sqAttFile').value = '';
            return;
        }
        if (!files || files.length === 0) return;
        var fd = new FormData();
        fd.append('documentId', currentQuoteId);
        for (var i = 0; i < files.length; i++) fd.append('files', files[i]);
        var csrfEl = document.querySelector('input[name="__RequestVerificationToken"]');
        if (csrfEl) fd.append('__RequestVerificationToken', csrfEl.value);
        try {
            var resp = await fetch('/Sales/UploadDocumentAttachment', { method: 'POST', body: fd });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
        } catch (e) {
            CalibraAlert.error('Yukleme hatasi: ' + (e.message||e));
        } finally {
            document.getElementById('sqAttFile').value = '';
            sqAttLoad();
        }
    }
    window.sqAttUpload = sqAttUpload;

    window.sqAttDelete = async function(id) {
        // Rapor §6.6 — CalibraAlert.confirm tercih edilir; CalibraAlert yoksa fallback.
        var ok = window.CalibraAlert && CalibraAlert.confirm
            ? await CalibraAlert.confirm('Dosya silinecek. Emin misiniz?', { title: 'Dosya Sil', okLabel: 'Sil' })
            : confirm('Dosya silinecek. Emin misiniz?');
        if (!ok) return;
        var csrfToken = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        try {
            await fetch('/Sales/DeleteDocumentAttachment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                body: JSON.stringify({ id: Number(id) })
            });
        } catch (e) { CalibraAlert.error('Silme hatasi: ' + (e.message||e)); }
        sqAttLoad();
    };
    // Her zaman Genel Bilgiler tab'indan basla
    sqSwitchTab('general');

    var searchTimer = null;
    var currentQuoteId  = @Html.Raw(editId.HasValue ? $"'{editId.Value}'" : "null");
    var fromRequestId   = @Html.Raw(Model.FromRequestId.HasValue ? Model.FromRequestId.Value.ToString() : "null");

    // ── Form Davranış Katmanı (2026-08-05) ─────────────────────────────────
    // Standart alan davranışlarını (görünürlük/zorunluluk/varsayılan/başlık/sekme)
    // sabit markup'a uygular. Davranış kaydı yoksa no-op (fail-open). React bundle
    // async yüklendiği için polling ile beklenir.
    (function initFormBehavior() {
        function run() {
            if (!(window.CalibraHub && window.CalibraHub.applyFormBehavior)) { setTimeout(run, 300); return; }
            window.CalibraHub.applyFormBehavior({
                formCode: '@headerFormCode',
                isNew: !currentQuoteId,
                fieldElements: {
                    quoteNumber: 'sqQuoteNumber', quoteDate: 'sqQuoteDate', validUntil: 'sqValidUntil',
                    currency: 'sqCurrency', vatIncluded: 'sqVatIncluded', customer: 'sqCustomerDisplay',
                    salesRep: 'sqSalesRepId', requester: 'sqRequesterId', location: 'sqLocationId',
                    discountRate: 'sqDiscountRate', paymentTerms: 'sqPaymentTerms',
                    deliveryTerms: 'sqDeliveryTerms', deliveryAddress: 'sqDeliveryAddress', notes: 'sqNotes',
                },
                onTabHidden: function () { try { sqActivateTab('general'); } catch (e) {} },
            });
        }
        run();
    })();

    // ── Üst-bilgi "Kimlik + Şerit" alan dağılımı (2026-08-19) ─────────────
    // Markup varsayılan olarak Kimlik(0)/Şerit1(1)/Şerit2(2) grupları halinde
    // render edilir (bkz. .sqe-ident-row / .sqe-strip[data-sqe-section]).
    // Backend /api/form-behavior/{formCode} yanıtına her alan için cardSection
    // (int|null) eklendiğinde bu alanları ilgili şerit kutusuna TAŞIR — kendi
    // bağımsız (formBehavior.js'ten ayrı) fetch'i, o dosyaya dokunmadan çalışır.
    // FAIL-OPEN: istek başarısız / cardSection alanı yok / API henüz güncel
    // değil → hiçbir şey yapılmaz, yukarıdaki varsayılan gruplama aynen kalır.
    (function initCardSections() {
        // Duzen bayragi: 'free' ise serbest akis + px genislik, aksi halde IZGARA
        // (bugunku davranis). fetch yanitindan set edilir; oncesinde false kalir
        // ki veri gelmeden izgara yolu bozulmasin (fail-open).
        var __sqFreeLayout = false;
        // fields: API'den gelen tam liste ({key, cardSection, cardOrder, ...}).
        // Yalnizca cardSection'i ACIKCA ayarli alanlar tasinir/siralanir; digerleri
        // markup'taki yerinde kalir (fail-open, alan bazinda).
        /* Birlikte hareket eden alan gruplari (2026-08-21 kullanici istegi).
           ANCHOR = grubun bolum/sirasini belirleyen alan; digerlerinin kendi
           cardSection/cardOrder degeri YOK SAYILIR (aksi halde ucu farkli seritlere
           dagilip "ayrilmamali" kurali cignenirdi). */
        var __HGROUP_ANCHOR = { currency: 'currency', exchangeRate: 'currency', rateDate: 'currency' };

        function applySections(fields) {
            // 2026-08-21 Faz 3: kapsam BELGE GENELI. Onceden yalniz ilk .sqe-hform
            // (Genel Bilgiler) icinde arıyordu; artik alan Kosullar/Notlar/ozel
            // sekmelerden de gelebilir ve BASKA bir sekmeye tasinabilir.
            var scope = document.querySelector('.sqe-tab-content') || document;
            var __stripsById = {}, __stripsSeq = 0;
            var firstHform = document.querySelector('.sqe-hform');
            if (!firstHform) return;
            // Tasima ONCESI markup sirasi — cardOrder=null alanlar bu sirayi korur.
            var domOrder = {};
            Array.prototype.forEach.call(scope.querySelectorAll('[data-field-key]'), function (el, idx) {
                var k = el.getAttribute('data-field-key');
                if (k && !(k in domOrder)) domOrder[k] = idx;
            });
            /* Alanin gidecegi .sqe-strips kabi: TargetTab verilmisse o sekmenin,
               yoksa alanin bulundugu sekmenin kabi. Hedef pane yoksa (ör. ozel sekme
               silinmis) alan YERINDE kalir — fail-open. */
            function stripsFor(targetTab, container) {
                if (targetTab) {
                    var pane = document.querySelector('[data-sqe-pane="' + targetTab + '"]');
                    var w = pane && pane.querySelector('.sqe-strips');
                    if (w) return w;
                }
                return container.closest ? container.closest('.sqe-strips') : null;
            }
            // section -> [{key, container, order, domIndex}]
            var bySection = {};
            fields.forEach(function (f) {
                if (!f || !f.key) return;
                if (f.cardSection === null || f.cardSection === undefined) return;
                var section = parseInt(f.cardSection, 10);
                if (!isFinite(section)) return;
                // Grup uyesi ise ANCHOR disindakiler atlanir; anchor icin de asil
                // tasinan sey hucre degil SARMALAYICIDIR (uc hucre birlikte gider).
                var anchor = __HGROUP_ANCHOR[f.key];
                if (anchor && anchor !== f.key) return;
                var container = scope.querySelector('[data-field-key="' + f.key + '"]');
                if (!container) return; // bu belge tipinde render edilmemis alan
                if (anchor) {
                    var grp = container.closest ? container.closest('.sqe-hgroup') : null;
                    if (grp) container = grp;
                }
                var order = null;
                if (f.cardOrder !== null && f.cardOrder !== undefined) {
                    var n = parseInt(f.cardOrder, 10);
                    if (isFinite(n)) order = n;
                }
                // Hedef serit kabi alanin sekmesine gore secilir; ayni kap+bolum
                // birlikte gruplanir ki siralama kap icinde tutarli olsun.
                var wrap = stripsFor(f.targetTab, container);
                if (!wrap) return;
                var bucket = (wrap.getAttribute('data-strips-id')
                    || (function () {
                        var id = 'sw' + (++__stripsSeq);
                        wrap.setAttribute('data-strips-id', id);
                        __stripsById[id] = wrap;
                        return id;
                    })()) + ':' + section;
                (bySection[bucket] = bySection[bucket] || []).push({
                    container: container,
                    order: order,
                    domIndex: domOrder[f.key] !== undefined ? domOrder[f.key] : 1e9
                });
            });
            Object.keys(bySection).forEach(function (bucketKey) {
                // bucket = "<stripsId>:<section>" — hangi sekmenin serit kabinda,
                // hangi bolum oldugunu birlikte tasir.
                var parts = String(bucketKey).split(':');
                var wrap = __stripsById[parts[0]];
                var section = parseInt(parts[1], 10);
                if (!wrap) return;
                var ownerHform = wrap.closest ? wrap.closest('.sqe-hform') : firstHform;
                var entries = bySection[bucketKey];
                // cardOrder'i olanlar once (kucukten buyuge), null'lar SONRA ve kendi
                // aralarinda markup sirasini koruyarak (kararli siralama).
                entries.sort(function (a, b) {
                    if (a.order !== null && b.order !== null) {
                        if (a.order !== b.order) return a.order - b.order;
                        return a.domIndex - b.domIndex;
                    }
                    if (a.order !== null) return -1;
                    if (b.order !== null) return 1;
                    return a.domIndex - b.domIndex;
                });
                // Kimlik alanları (0) .sqe-ident-fields İÇİNE, şerit alanları (1,2,…) .sqe-strip İÇİNE girer.
                var target;
                if (section === 0) {
                    // Kimlik satiri yalnizca Genel Bilgiler'de var; ozel sekmede
                    // kimlik bolumu yok → alan o sekmenin 1. seridine duser.
                    target = ownerHform && ownerHform.querySelector('.sqe-ident-row .sqe-ident-fields');
                    if (!target) section = 1;
                }
                if (!target) {
                    target = wrap.querySelector(':scope > .sqe-strip[data-sqe-section="' + section + '"]');
                    if (!target) {
                        target = document.createElement('div');
                        target.className = 'sqe-strip';
                        target.setAttribute('data-sqe-section', String(section));
                        // Yeni şerit, o sekmenin KENDI serit blogunun icine eklenir.
                        wrap.appendChild(target);
                    }
                }
                if (!target) return;
                entries.forEach(function (entry) { target.appendChild(entry.container); });
            });
        }
        // ── Şerit hücre genişliği (cardWidth, 2026-08-20) ──────────────────
        // Kalem kartıyla AYNI sözleşme: alan başına cardWidth (1..12|null),
        // yanıt kökünde defaultCardWidth (1..12|null, null → 3). CSS zaten
        // `.sqe-hform .sqe-strip .sqe-hrow { grid-column: span 3; }` ile
        // FAIL-OPEN varsayılanı taşıyor — bu fonksiyon yalnızca veri VARSA
        // inline stille override eder; istek düşer/API eski olursa hiçbir
        // şey yapmaz, CSS varsayılanı aynen kalır (düzen bozulmaz).
        function applyCardWidths(fields, defaultCardWidth) {
            var hform = document.querySelector('.sqe-hform');
            if (!hform) return;
            var defW = (typeof defaultCardWidth === 'number' && isFinite(defaultCardWidth)) ? defaultCardWidth : 3;
            defW = Math.min(12, Math.max(1, Math.round(defW)));
            fields.forEach(function (f) {
                if (!f || !f.key) return;
                var row = hform.querySelector('.sqe-strip [data-field-key="' + f.key + '"]');
                if (!row) return; // kimlik satırındaki alan veya bu belge tipinde render edilmeyen alan — ızgaraya girmez
                // Alan bazinda cardWidth ACIKCA verilmisse o kazanir; verilmemisse
                // span 1 (form-seviye defaultCardWidth artik varsayilan span DEGIL —
                // sutun sayisi hucre sayisina esit oldugundan her hucre bir sutun).
                var w = (typeof f.cardWidth === 'number' && isFinite(f.cardWidth)) ? f.cardWidth : 1;
                w = Math.min(12, Math.max(1, Math.round(w)));
                row.style.gridColumn = 'span ' + w;
            });
        }
        // ── Dar konteyner — 12 sütun sığmayan genişlikte 6'ya düşülür (yatay
        // taşma/kaydırma olmasın; ör. bölünmüş ekran/tablet dikey). Kalem
        // kartındaki ResizeObserver (gridNarrow) ile aynı fikir, bağımsız
        // uygulaması — bu sayfa React kullanmıyor. Fetch'ten SONRA (fail-open
        // dahil, .finally) çağrılır ki applySections() sonradan yeni .sqe-strip
        // yaratmışsa o da izlemeye girsin.
        function initStripNarrowWatch() {
            var strips = document.querySelectorAll('.sqe-strip');
            if (!strips.length || typeof ResizeObserver === 'undefined') return;
            var ro = new ResizeObserver(function (entries) {
                entries.forEach(function (entry) {
                    var el = entry.target;
                    var w = entry.contentRect ? entry.contentRect.width : 0;
                    el.classList.toggle('sqe-strip--narrow', w > 0 && w < 480);
                });
                // Genislik degisince sutun sayisi da yeniden hesaplanir (dar
                // konteynerde tavan 3'e iner).
                applyStripColumns();
            });
            strips.forEach(function (el) { ro.observe(el); });
        }

        /* ── Şerit sütun sayısı (2026-08-20 kullanıcı kararı) ────────────────
           Sütun sayısı = İLK ŞERİDİN GÖRÜNÜR hücre sayısı. Böylece ilk şerit tam
           olarak bir satıra oturur, boş sütun ve o boşlukları çizen ayraçlar
           kalmaz; diğer şeritler de aynı sütunlara hizalanır (kalem kartıyla aynı
           kural — bkz. CalibraLineItemsGrid STRIP_GRID_COLS).
           GÖRÜNÜR sayılır: belge tipine göre gizlenen (display:none) ve Alan
           Düzeni görünürlük kuralıyla kapatılan hücreler ızgarada yer kaplamaz.
           Fail-open: hiç görünür hücre yoksa değişken yazılmaz → CSS 12'ye düşer. */
        /* ── Serbest duzen: alan basina PIKSEL genislik (2026-08-20) ──────────────
           Tip bazli varsayilanlar — cellWidthPx verilmemis alanlar bunu kullanir.
           Anahtar = data-field-key; tip bilgisi markup'ta olmadigi icin alan
           anahtarindan turetilir (katalogla ayni kume, tek yerde tutulur). */
        var FREE_DEFAULT_W = {
            quoteDate: 150, validUntil: 220, rateDate: 150,
            currency: 90, exchangeRate: 120, vatIncluded: 90,
            salesRep: 240, warehouse: 200, paymentPlan: 200,
        };
        function freeDefaultWidth(key) {
            return FREE_DEFAULT_W[key] || 200;
        }
        /* Serbest duzende hucre genisligini uygular. Izgara modunda CAGRILMAZ
           (applyCardWidths gorevini surdurur) — iki yol birbirine karismaz. */
        function applyCellWidths(fields) {
            // 2026-08-21 Faz 1: artik BIRDEN COK .sqe-hform var (Genel Bilgiler +
            // Kosullar + Notlar serit modeline alindi). Tek querySelector yalniz
            // ILKINI bulur ve diger sekmelerin hucreleri genisliksiz kalirdi.
            var byKey = {};
            (fields || []).forEach(function (f) { if (f && f.key) byKey[f.key] = f; });
            document.querySelectorAll('.sqe-hform .sqe-strip .sqe-hrow[data-field-key]').forEach(function (row) {
                var key = row.getAttribute('data-field-key');
                var f = byKey[key];
                var w = (f && typeof f.cellWidthPx === 'number' && isFinite(f.cellWidthPx))
                    ? f.cellWidthPx : freeDefaultWidth(key);
                w = Math.min(600, Math.max(60, Math.round(w)));
                row.style.width = w + 'px';
                row.style.flex = '0 0 auto';
                row.style.gridColumn = 'auto';   // izgaradan kalan span'i temizle
            });
        }

        /* ── Sekme davranisi (2026-08-20, Faz 3) ────────────────────────────────
           GET /api/form-behavior yaniti `tabs[]` ZATEN donuyordu ve Alan Duzeni'nde
           duzenleniyordu, ama belge ekrani bunu HIC uygulamiyordu — olu veriydi.
           Burada uygulanir: gorunurluk, sira, etiket ve icerik TASIMA.

           GATE YOK (bilincli): sekme ayari form koduna bagli veridir; ayar
           yapilmamis formda `tabs[]` katalog varsayilanini doner ve bu fonksiyon
           HIC BIR SEY degistirmez (no-op). CSS'teki serbest/izgara gate'i paylasilan
           stil icindi; burada gerek yok. Aksi halde bir formun sekmesini gizlemek
           icin o formun TUM gorunumunu 'free'ye cevirmek gerekirdi.

           SIRA: once plan (DOM'a dokunmadan) hesaplanir, guvenlik kontrolleri
           gecerse uygulanir. Boylece "hicbir sekme kalmadi" durumunda kullanici
           ekranda kilitlenmez — hicbir degisiklik yapilmaz. */
        /* Kullanici tanimli sekme icin buton + pane uretir (2026-08-21 Faz 3).
           Pane, Genel Bilgiler ile AYNI iskeleti tasir (.sqe-hform > .sqe-strips >
           .sqe-strip) — kullanici karari "ozel sekmenin ici Genel Bilgiler ile ayni".
           Boylece serit/genislik/yukseklik motoru hic degistirilmeden calisir.
           Idempotent: zaten varsa yeniden uretmez (applyTabs birden cok kez cagrilabilir). */
        function ensureCustomTab(key, label) {
            var nav = document.querySelector('.sqe-tab-nav');
            if (!nav) return null;
            var btn = nav.querySelector('[data-sqe-tab-btn="' + key + '"]');
            if (!btn) {
                btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'sqe-tab-btn';
                btn.setAttribute('data-sqe-tab-btn', key);
                btn.textContent = label || key;
                btn.addEventListener('click', function () { sqSwitchTab(key); });
                nav.appendChild(btn);
            }
            var pane = document.querySelector('[data-sqe-pane="' + key + '"]');
            if (!pane) {
                pane = document.createElement('div');
                pane.className = 'sqe-tab-pane';
                pane.setAttribute('data-sqe-pane', key);
                pane.innerHTML = '<div class="sqe-hform"><div class="sqe-strips">'
                               + '<div class="sqe-strip" data-sqe-section="1"></div>'
                               + '</div></div>';
                var lastPane = document.querySelectorAll('.sqe-tab-pane');
                if (lastPane.length) lastPane[lastPane.length - 1].parentNode.appendChild(pane);
            }
            return pane;
        }

        function applyTabs(tabs) {
            if (!Array.isArray(tabs) || !tabs.length) return;
            var nav = document.querySelector('.sqe-tab-nav');
            if (!nav) return;

            // Ozel sekmeler once uretilir — sonraki adimlar (tasima, gorunurluk,
            // sira) onlari da normal sekme gibi gorsun.
            tabs.forEach(function (t) {
                if (t && t.isCustom && t.key) ensureCustomTab(t.key, t.labelText || t.label);
            });

            var cfg = {};
            tabs.forEach(function (t) { if (t && t.key) cfg[t.key] = t; });

            function btnOf(k)  { return nav.querySelector('[data-sqe-tab-btn="' + k + '"]'); }
            function paneOf(k) { return document.querySelector('[data-sqe-pane="' + k + '"]'); }

            // ── 1) Tasima hedeflerini coz (zincir/dongu KORUMASI) ──
            // Yalniz TEK adim tasima destekli: hedefin kendi hedefi varsa tasima
            // yapilmaz. Bu, A→B→C zincirini ve A→B / B→A dongusunu tek kuralla keser.
            var moveTo = {};
            Object.keys(cfg).forEach(function (k) {
                var t = cfg[k].targetTabKey;
                if (!t || t === k || !cfg[t]) return;
                if (cfg[t].targetTabKey) {
                    try { console.warn('[Tabs] zincir/dongu — tasima atlandi:', k, '→', t); } catch (_) {}
                    return;
                }
                if (!paneOf(k) || !paneOf(t)) return;
                moveTo[k] = t;
            });

            // ── 2) Nihai icerik durumunu DOM'a DOKUNMADAN hesapla ──
            var receives = {};
            Object.keys(moveTo).forEach(function (k) { receives[moveTo[k]] = true; });

            var visible = {};
            Object.keys(cfg).forEach(function (k) {
                var pane = paneOf(k), btn = btnOf(k);
                if (!pane || !btn) return;                       // bu belge tipinde render edilmemis
                var hasOwn = pane.children.length > 0;
                var finalHas = (moveTo[k] ? false : hasOwn) || !!receives[k];
                visible[k] = (cfg[k].isVisible !== false) && finalHas;
            });

            // ── 3) Guvenlik: en az bir sekme gorunur kalmali ──
            var anyVisible = Object.keys(visible).some(function (k) { return visible[k]; });
            if (!anyVisible) {
                try { console.warn('[Tabs] tum sekmeler gizlenecekti — ayar UYGULANMADI.'); } catch (_) {}
                return;
            }

            // ── 4) Uygula: tasi ──
            Object.keys(moveTo).forEach(function (k) {
                var src = paneOf(k), dst = paneOf(moveTo[k]);
                if (!src || !dst) return;
                var block = document.createElement('div');
                block.className = 'sqe-moved-block';
                block.setAttribute('data-moved-from', k);
                /* 2026-08-22 (kullanici istegi): tasinan blogun BASLIK satiri
                   kaldirildi — "Kalem Bilgileri" yazisi tek basina bir satir
                   kapliyordu. Bloklar birbirinden ust ayrac cizgisiyle zaten
                   ayriliyor (.sqe-moved-block border-top). Kaynak sekme adi
                   `data-moved-from` ile DOM'da izlenebilir kaliyor. */
                while (src.firstChild) block.appendChild(src.firstChild);
                dst.appendChild(block);
            });

            // ── 5) Uygula: etiket + gorunurluk ──
            Object.keys(cfg).forEach(function (k) {
                var btn = btnOf(k);
                if (!btn) return;
                if (cfg[k].labelText) btn.textContent = cfg[k].labelText;
                btn.style.display = visible[k] ? '' : 'none';
            });

            // ── 6) Uygula: sira (yalniz gorunurler yeniden dizilir) ──
            Object.keys(cfg)
                .filter(function (k) { return visible[k] && btnOf(k); })
                .sort(function (a, b) { return (cfg[a].sortOrder || 0) - (cfg[b].sortOrder || 0); })
                .forEach(function (k) { nav.appendChild(btnOf(k)); });

            // ── 7) Aktif sekme gizlendiyse ilk gorunure dus ──
            var activeBtn = nav.querySelector('.sqe-tab-btn.is-active');
            var activeKey = activeBtn ? activeBtn.getAttribute('data-sqe-tab-btn') : null;
            if (!activeKey || !visible[activeKey]) {
                var first = Object.keys(cfg)
                    .filter(function (k) { return visible[k] && btnOf(k); })
                    .sort(function (a, b) { return (cfg[a].sortOrder || 0) - (cfg[b].sortOrder || 0); })[0];
                if (first && typeof sqActivateTab === 'function') sqActivateTab(first);
            }
        }

        function applyStripColumns() {
            // Serbest duzende sutun kavrami yok — hucreler kendi px genisliginde akar.
            if (__sqFreeLayout) return;
            // 2026-08-21 Faz 1: sutun sayisi artik HER .sqe-strips kabi icin AYRI
            // hesaplanir. Onceden tek bir sayi tum seritlere yaziliyordu; Kosullar/
            // Notlar da serit modeline gecince onlar Genel Bilgiler'in sutun sayisini
            // alip bos sutunlarla cizilirdi.
            function visibleCells(strip) {
                return Array.prototype.filter.call(
                    strip.querySelectorAll(':scope > .sqe-hrow'),
                    function (el) { return el.offsetParent !== null; });
            }
            document.querySelectorAll('.sqe-hform .sqe-strips').forEach(function (wrap) {
                var strips = wrap.querySelectorAll(':scope > .sqe-strip');
                if (!strips.length) return;
                var first = visibleCells(strips[0]).length;
                if (!first) return;
                var narrow = strips[0].classList.contains('sqe-strip--narrow');
                var cols = narrow ? Math.min(first, 3) : first;
                Array.prototype.forEach.call(strips, function (el) {
                    el.style.setProperty('--sqe-cols', String(cols));
                });
            });
        }
        fetch('/api/form-behavior/' + encodeURIComponent('@headerFormCode'), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data || data.ok !== true || !Array.isArray(data.fields)) return;
                var any = data.fields.some(function (f) {
                    return f && f.key && f.cardSection !== null && f.cardSection !== undefined;
                });
                if (any) applySections(data.fields);

                // ── Duzen gate'i (2026-08-20) ──────────────────────────────────
                // layoutMode 'free' DEGILSE hicbir sey degismez: izgara yolu
                // (applyCardWidths + applyStripColumns) aynen calisir. Bu sayede
                // DocumentEdit'i paylasan diger 7 belge tipi etkilenmez.
                __sqFreeLayout = (data.layoutMode === 'free');
                if (__sqFreeLayout) {
                    // Faz 1 sonrasi birden cok .sqe-strips var (Genel/Kosullar/Notlar)
                    document.querySelectorAll('.sqe-strips').forEach(function (el) {
                        el.classList.add('sqe-strips--free');
                    });
                    applyCellWidths(data.fields);
                } else {
                    applyCardWidths(data.fields, data.defaultCardWidth);
                }

                // Sekme gorunurluk / sira / etiket / TASIMA — duzen modundan bagimsiz
                // (veri form koduna bagli; ayarsiz formda no-op). Alan tasima
                // (applySections) SONRASINDA calisir ki pane doluluk hesabi dogru olsun.
                applyTabs(data.tabs);
            })
            .catch(function (e) { try { console.warn('[CardSections] yükleme hatası (fail-open):', e && e.message) } catch (_) {} })
            // Once genislik gozcusu (narrow sinifi yerlesir), SONRA sutun sayisi —
            // applyStripColumns narrow durumuna gore tavan uygular. Iki dalda da
            // (basari/hata) calisir: fail-open'da bile izgara bos sutunla kalmaz.
            .then(function () { initStripNarrowWatch(); applyStripColumns(); },
                  function () { initStripNarrowWatch(); applyStripColumns(); });
    })();

    // Liste ekranlarindaki "Islemler" menusunden gelen derin-link: ?autoAction=costs|approval|status.
    // Yalnizca MEVCUT kayitta (currentQuoteId dolu) gecerlidir; belge+kalem gridi TAM
    // yuklendikten sonra sqLoadQuote icinde TEK SEFER tetiklenir (bkz. sqRunAutoAction).
    var autoActionParam    = (function () {
        try { return new URLSearchParams(window.location.search).get('autoAction'); }
        catch (_) { return null; }
    })();
    var __sqAutoActionFired = false;
    var materials = [];
    var customers = [];

    // ── React CalibraLineItemsGrid bridge ─────────────────────────
    // Grid satirlari window.__SQ_LINES__ uzerinde tutulur; sqRecalc ve
    // sqSave bunu okur. Grid mount'tan once gelen setRows istekleri
    // kuyruga alinir, grid hazir olunca flush edilir.
    window.__SQ_LINES__ = [];
    var _gridReady = false;
    var _pendingRows = null;

    function setGridRows(rows) {
        if (_gridReady && window.CalibraHub && window.CalibraHub.salesLineGrid) {
            window.CalibraHub.salesLineGrid.setRows(rows || []);
        } else {
            _pendingRows = rows || [];
        }
    }

    function bootstrapLineGrid() {
        var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
        var CSS_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';

        function mountGrid() {
            var el = document.getElementById('reactDocumentLineGrid');
            if (!el) { console.error('[SQE] grid mount element yok'); return; }
            if (!window.CalibraHub || !window.CalibraHub.mountLineItemsGrid) {
                console.error('[SQE] mountLineItemsGrid fonksiyonu yok');
                return;
            }
            try {
                window.CalibraHub.mountLineItemsGrid(el, window.__CALIBRA_SALES_QUOTE_LINE_GRID__, {
                    onRowsChange: function (rows) {
                        window.__SQ_LINES__ = rows || [];
                        if (typeof window.sqRecalc === 'function') window.sqRecalc();
                        // Anlamli kalem (materialCode dolu) varsa cari kilitlenir
                        if (typeof window.applyCustomerLock === 'function') {
                            var hasLine = (rows || []).some(function (r) {
                                return r && r.materialCode && String(r.materialCode).trim() !== '';
                            });
                            window.applyCustomerLock(hasLine);
                        }
                    }
                });
                // Imperative API (setRows/getRows) useEffect sonrasi hazir —
                // polling ile bekle
                var tries = 0;
                var timer = setInterval(function () {
                    if (window.CalibraHub && window.CalibraHub.salesLineGrid) {
                        clearInterval(timer);
                        _gridReady = true;
                        if (_pendingRows) {
                            window.CalibraHub.salesLineGrid.setRows(_pendingRows);
                            _pendingRows = null;
                        }
                        console.log('[SQE] line grid hazir');
                    } else if (++tries > 50) {
                        clearInterval(timer);
                        console.error('[SQE] grid API zaman asimi');
                    }
                }, 20);
            } catch (ex) {
                console.error('[SQE] grid mount exception:', ex);
            }
        }

        // CSS
        if (!document.querySelector('link[data-sqe-grid-css]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = CSS_URL;
            link.setAttribute('data-sqe-grid-css', '1');
            document.head.appendChild(link);
        }

        // JS bundle
        if (window.CalibraHub && window.CalibraHub.mountLineItemsGrid) {
            mountGrid();
        } else {
            var script = document.createElement('script');
            script.src = BUNDLE_URL;
            script.setAttribute('data-sqe-grid-js', '1');
            script.onload = function () { setTimeout(mountGrid, 0); };
            script.onerror = function () { console.error('[SQE] bundle yuklenemedi'); };
            document.head.appendChild(script);
        }
    }

    // ── Katlanir kart state persist (localStorage) ─────────────
    // 4 kartin (genel / lines / conditions / notes) acik/kapali durumu
    // localStorage'da tutulur. Kullanici tercih ettigi sekli koruyor.
    function initCollapsiblePersistence() {
        var LS_KEY = 'sqe.card-groups-open';
        var state = {};
        try { state = JSON.parse(localStorage.getItem(LS_KEY) || '{}') || {}; }
        catch (e) { state = {}; }

        document.querySelectorAll('details.sqe-card[data-sqe-group]').forEach(function (d) {
            var key = d.getAttribute('data-sqe-group');
            if (!key) return;
            // Kayitli durum false ise kapat (default: acik)
            if (state[key] === false) d.open = false;
            d.addEventListener('toggle', function () {
                state[key] = d.open;
                try { localStorage.setItem(LS_KEY, JSON.stringify(state)); }
                catch (e) { /* quota/private — sessiz gec */ }
            });
        });
    }

    // Textarea'yi icerigi kadar buyutir — ic scroll olmaz, sayfa scroll'u calisir
    function autoResizeTextarea(el) {
        el.style.height = 'auto';
        el.style.height = el.scrollHeight + 'px';
    }

    document.addEventListener('DOMContentLoaded', function () {
        // React grid'i non-blocking olarak mount et (bundle async yuklenir)
        bootstrapLineGrid();

        // Notlar textarea auto-resize
        var sqNotesEl = document.getElementById('sqNotes');
        if (sqNotesEl) {
            sqNotesEl.addEventListener('input', function () { autoResizeTextarea(sqNotesEl); });
        }

        // Sekmeler arasi veri senkronizasyonu:
        // Baska bir sekmede (ornek malzeme karti) stok/birim/KDV degisirse,
        // bu sayfaya geri donuldugunde cache'lenmis materials ve units snapshot'lari
        // stale olabilir. Focus/visibility alindiginda cache'leri invalide et.
        function sqRefreshLookupCaches() {
            try {
                if (window.CalibraHub && window.CalibraHub.clearLookupCache) {
                    window.CalibraHub.clearLookupCache();
                }
            } catch (e) { /* sessizce gec */ }
            // Materyal snapshot'ini yeniden fetch et (bridge fallback'leri icin)
            loadMaterials().catch(function (e) { console.warn('[SQ] materials refresh hatasi:', e); });
        }
        window.addEventListener('focus', sqRefreshLookupCaches);
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') sqRefreshLookupCaches();
        });

        // Sayisal input'lari koru: eksi girisi engelle + spinner'lar CSS ile gizli.
        // Capturing phase — React'in kendi handler'lari calismadan once devreye girer.
        document.addEventListener('input', function (e) {
            var t = e.target;
            if (t && t.tagName === 'INPUT' && t.type === 'number') {
                if (parseFloat(t.value) < 0) t.value = '0';
            }
        }, true);
        document.addEventListener('keydown', function (e) {
            var t = e.target;
            if (t && t.tagName === 'INPUT' && t.type === 'number' && (e.key === '-' || e.key === 'Subtract')) {
                e.preventDefault();
            }
        }, true);

        // Katlanir kart persist — markup hazir oldugunda baglan
        initCollapsiblePersistence();

        // Veri yukleme — 4 fetch (3 lookup + 1 belge) toplamda paralel.
        // GetQuote network'u lookup'larla ayni anda tetiklenir; processing materials'a
        // ihtiyac duydugu icin lookup tamamlandiktan sonra prefetch sonucu kullanilir.
        // Boylece toplam bekleme = max(lookup, GetQuote) — once series'di (max + GetQuote).
        (async function () {
            var quotePrefetch = currentQuoteId
                ? fetch('/Sales/GetQuote?id=' + currentQuoteId).then(function (r) {
                    if (!r.ok) throw new Error('GetQuote HTTP ' + r.status);
                    return r.json();
                  }).catch(function (e) {
                    console.error('GetQuote prefetch hatasi (sqLoadQuote icindeki fallback fetch devreye girecek):', e);
                    return null;
                  })
                : null;

            // loadCustomers SADECE picker (Cari Kod rehber butonu) icin gerekli — degeri
            // gostermek icin sqLoadQuote zaten data-value/data-display attribute'larini set
            // eder, picker attach sonrasi degeri okur. Bu yuzden kritik yoldan cikariyoruz:
            // background'da calissin, kullanici beklesin diye degil.
            loadCustomers().catch(function(e) { console.error('loadCustomers hatasi:', e); });

            try {
                await Promise.all([
                    loadSalesReps().catch(function(e) { console.error('loadSalesReps hatasi:', e); }),
                    loadMaterials().catch(function(e) { console.error('loadMaterials hatasi:', e); }),
                ]);
            } catch (e) { console.error('Paralel yukleme hatasi:', e); }

            if (currentQuoteId) {
                try {
                    var data = await quotePrefetch;
                    await sqLoadQuote(currentQuoteId, data);
                } catch (e) { console.error('sqLoadQuote hatasi:', e); }
            } else if (fromRequestId) {
                sqInitNew();
                try { await sqPreFillFromRequest(fromRequestId); }
                catch (e) { console.error('sqPreFillFromRequest hatasi:', e); }
            } else {
                sqInitNew();
            }

            // Son bir rAF — React wrapper/layout shift'leri bu frame'de settle eder,
            // maske bir sonraki frame'de kalktiginda tum alanlar zaten tam ayarlanmistir.
            requestAnimationFrame(function () {
                var mask = document.getElementById('sqLoadingMask');
                if (mask) mask.classList.add('is-hidden');
            });
        })();
    });

    // Cari karta git — satis teklif tab'i acik kalmali, cari kart varsa onu switch et,
    // yoksa yeni workspace tab'i ac (tabsheet). window.location.href tum iframe'i
    // navigate ediyordu → satis teklif kapaniyordu; workspace API uzerinden gidip
    // calisma alani sekmesinde yan-yana acariz.
    window.sqGoToCustomerCard = function () {
        var custId = document.getElementById('sqCustomerId').value;
        if (!custId) return;
        var custName = (document.getElementById('sqCustomerName') || {}).textContent || '';
        var url = '/Finance/ContactEdit?id=' + encodeURIComponent(custId);
        var title = custName ? ('Cari Kart — ' + custName) : 'Cari Kart';
        try {
            var topWin = window.top || window;
            if (topWin && topWin.CalibraHub && typeof topWin.CalibraHub.openWorkspaceTab === 'function') {
                topWin.CalibraHub.openWorkspaceTab({
                    url:       url,
                    title:     title,
                    matchPath: '/Finance/ContactEdit'  // bu path'li tab acik ise onu switch
                });
                return;
            }
        } catch (_) { /* cross-origin → fallback */ }
        // Fallback: parent shell yoksa yeni sekmede ac (mevcut tab'i bozma)
        window.open(url, '_blank');
    }

    function attachCustomerGuide() {
        if (window.CalibraHub && window.CalibraHub.attachGuide) {
            // 2026-05-23: Satin alma belgelerinde (purchase_quote/order) tedarikci
            // rehberi (SUPPLIERS) acilir — sales tarafinda CUSTOMERS. Talep zaten Cari
            // Kod alanini gizler (isPurchaseRequest), bu nedenle burada talep ele alinmaz.
            // customerGuideCode top of view'da resolve edilir; simple C# variable ile JS'e gelir.
            var guideCode = '@customerGuideCode';
            window.CalibraHub.attachGuide('#sqCustomerDisplay', guideCode, {
                formCode: '@headerFormCode',
                // SalesRepId — cari kart uzerinde tanimliysa otomatik dolar; bos gelen
                // (cari icin temsilci atanmamis) durumda mevcut deger korunur cunku
                // attachGuide bos string yazmaz.
                // NOT: SUPPLIERS view'inde SalesRepId yok — fillMap'te eksik kolonu
                // attachGuide sessizce atlar (uyari yazmaz), gecmis sales mantigi bozulmaz.
                fillMap: {
                    '#sqCustomerId': 'Id',
                    '#sqCustomerName': 'AccountTitle',
                    '#sqSalesRepId': 'SalesRepId'
                }
            });
            return true;
        }
        return false;
    }

    /**
     * Stok karti pattern: Cari Kod input'a el ile yazip blur (Tab/Enter/disari tik)
     * yapilinca DB'de lookup. Varsa otomatik dolar (Id+Name+SalesRepId), yoksa
     * yeni cari ekranina (ContactEdit) yonlendirir — code parametresi ile.
     * AttachGuide rehber pick'i hala calisir; bu el-yazimi alternatif.
     */
    (function attachCustomerCodeLookup() {
        var disp = document.getElementById('sqCustomerDisplay');
        if (!disp) return;
        var idEl   = document.getElementById('sqCustomerId');
        var nameEl = document.getElementById('sqCustomerName');
        var repEl  = document.getElementById('sqSalesRepId');

        // Last-fetched code — ayni kod tekrar lookup yapmasin (tab toggling).
        var lastChecked = '';

        async function lookupAndFill() {
            var code = (disp.value || '').trim();
            if (!code || code === lastChecked) return;
            // Eger zaten Id dolu ve display ona ait kod ise atla (rehberden secim)
            if (idEl && idEl.value && idEl.getAttribute('data-display') === code) {
                lastChecked = code;
                return;
            }
            lastChecked = code;

            try {
                var r = await fetch('/Finance/GetContact?code=' + encodeURIComponent(code),
                    { credentials: 'same-origin' });
                if (r.ok) {
                    // BULDU — dolduran alanlar (rehberden gelmis gibi)
                    var c = await r.json();
                    if (idEl)   { idEl.value = c.id; idEl.setAttribute('data-display', c.accountCode); }
                    if (nameEl)  nameEl.textContent = c.accountTitle || c.accountCode || '';
                    if (repEl && c.salesRepId) repEl.value = c.salesRepId;
                    disp.value = c.accountCode;
                    disp.classList.remove('is-invalid');
                    // ffl-sync — diger lookup-bagimli alanlari tetikle
                    try { disp.dispatchEvent(new CustomEvent('ffl-sync', { bubbles: true })); } catch (_) {}
                    // Cari degisti → kalem fiyat cozucusu yeniden fiyatlandirsin. Guide secimi
                    // fillTargets ile zaten 'change' yayar; elle kod-lookup'ta burada manuel tetik.
                    try { if (idEl) idEl.dispatchEvent(new Event('change', { bubbles: true })); } catch (_) {}
                    return;
                }
                if (r.status === 404) {
                    // YOK — kullaniciya sor; istiyorsa yeni cari ekrani ac
                    var msg = '"' + code + '" kodlu cari bulunamadi.\n\nYeni cari hesap olusturmak ister misiniz?';
                    var ok = (window.CalibraAlert && CalibraAlert.confirm)
                        ? await CalibraAlert.confirm(msg, { title: 'Cari Bulunamadi', okText: 'Yeni Cari Ekle', cancelText: 'Vazgec' })
                        : window.confirm(msg);
                    if (ok) {
                        // Yeni sekme: cari karti olustur, code on-fill
                        var url = '/Finance/ContactEdit?new=1&code=' + encodeURIComponent(code);
                        window.open(url, '_blank', 'noopener');
                    }
                    // Reset: kullanici tekrar denesin
                    disp.value = '';
                    if (idEl) { idEl.value = ''; idEl.removeAttribute('data-display'); }
                    if (nameEl) nameEl.textContent = '';
                    lastChecked = '';
                }
            } catch (e) {
                if (window.CalibraHub && CalibraHub.toast)
                    CalibraHub.toast('Cari lookup hatasi: ' + e.message, 'err');
            }
        }

        disp.addEventListener('blur', lookupAndFill);
        disp.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === 'Tab') {
                // Enter: lookup et + form'un submit edilmesini engelle
                if (e.key === 'Enter') e.preventDefault();
                lookupAndFill();
            }
        });
    })();

    /**
     * openOrderLookup — Sipariş modu (window.__CALIBRA_DOC_TYPE__.isOrder) iken,
     * sipariş no'nun yanındaki rehber butonu tarafından çağrılır.
     * SALES_ORDERS standart rehberini (cbv_Guide_SalesOrders) açar; secilen
     * sipariş için DocumentEdit'e ?id= ile yonlendirir.
     */
    // Inline onclick (satir ~3114) YALNIZCA global scope'u gorur; bu fonksiyon
    // sayfanin buyuk IIFE'sinin (3602-7448) icinde tanimli oldugu icin oradan
    // erisilemiyordu -> butona basinca sessiz ReferenceError. Ayni sinif hata bu
    // dosyada daha once sqToggleLineView'de de yasandi. window'a acikca yaziliyor.
    window.openOrderLookup = openOrderLookup;
    function openOrderLookup() {
        if (!window.CalibraHub || !window.CalibraHub.openGuideLookup) {
            console.warn('[SQE] openGuideLookup hazir degil');
            return;
        }
        window.CalibraHub.openGuideLookup('SALES_ORDERS', {
            guideLabel: 'Tekliften Olusturulan Siparisler',
            onPick: function (row) {
                var id = row && row.cells && row.cells.Id;
                if (!id) {
                    console.warn('[SQE] order lookup: secilen satirda Id yok', row);
                    return;
                }
                // currentQuoteId ayni ise tekrar yukleme
                if (typeof currentQuoteId !== 'undefined' && Number(id) === Number(currentQuoteId)) return;
                window.location.href = '/Sales/DocumentEdit?id=' + id;
            }
        });
