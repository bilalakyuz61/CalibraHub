            rateDate:        (function(){ var cur = parseInt(document.getElementById('sqCurrency').value) || 1; var el = document.getElementById('sqRateDate'); if (cur === 1 || !el || !el.value) return null; return el.value; })(),
            discountRate:    (function(){ var el = document.getElementById('sqDiscountRate'); return el ? parseFloat(el.value || 0) : 0; })(),
            // Satir bazli KDV hesaplandigi icin belge basligindaki TaxRate legacy —
