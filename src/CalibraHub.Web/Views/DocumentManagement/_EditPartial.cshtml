@model CalibraHub.Domain.Entities.Attachment
@{
    var antiforgery = ViewContext.HttpContext.RequestServices
        .GetRequiredService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>();
    var tokens = antiforgery.GetAndStoreTokens(ViewContext.HttpContext);
    var existingCategoryId = Model.DocumentCategoryId;
}
<style>
.dm-ep { font-family: inherit; }
.dm-ep .dm-ep-label { display:block; font-size:0.78rem; font-weight:600; color:var(--bs-secondary-color,#6c757d); margin-bottom:4px; }
.dm-ep .dm-ep-input {
    width:100%; padding:7px 10px; border-radius:6px; font-size:0.88rem;
    border:1px solid var(--app-border,#e2e8f0); background:var(--app-input-bg,#fff);
    color:var(--bs-body-color,#0f172a); outline:none; box-sizing:border-box;
    transition:border-color .15s;
}
.dm-ep .dm-ep-input:focus { border-color:#6366f1; box-shadow:0 0 0 2px rgba(99,102,241,.12); }
.dm-ep .dm-ep-row { margin-bottom:14px; }
.dm-ep .dm-ep-info { font-size:0.76rem; color:var(--bs-secondary-color,#6c757d); margin-top:3px; }
.dm-ep .dm-ep-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:6px; }
.dm-ep .dm-ep-btn {
    padding:7px 18px; border-radius:6px; font-size:0.88rem; font-weight:600;
    border:none; cursor:pointer; transition:background .15s;
}
.dm-ep .dm-ep-btn--primary { background:#6366f1; color:#fff; }
.dm-ep .dm-ep-btn--primary:hover { background:#4f46e5; }
.dm-ep .dm-ep-btn--secondary { background:var(--app-surface-2,#f1f5f9); color:var(--bs-body-color,#0f172a); }
.dm-ep .dm-ep-btn--secondary:hover { background:var(--app-border,#e2e8f0); }
.dm-ep .dm-ep-status { font-size:0.8rem; margin-top:8px; text-align:center; min-height:18px; }
.dm-ep .dm-ep-status--ok  { color:#22c55e; }
.dm-ep .dm-ep-status--err { color:#ef4444; }
body.app-theme-dark .dm-ep .dm-ep-input { background:var(--app-input-bg,#1e293b); border-color:var(--app-border,#334155); color:#e2e8f0; }
body.app-theme-dark .dm-ep .dm-ep-btn--secondary { background:#1e293b; color:#e2e8f0; }
</style>

<div class="dm-ep">
    <div class="dm-ep-row">
        <label class="dm-ep-label">Başlık</label>
        <input id="dmep-title" class="dm-ep-input" type="text" value="@Model.Title" placeholder="Belge başlığı (opsiyonel)">
        <div class="dm-ep-info">Boş bırakılırsa dosya adı gösterilir.</div>
    </div>
    <div class="dm-ep-row">
        <label class="dm-ep-label">Kategori</label>
        <select id="dmep-category" class="dm-ep-input">
            <option value="">— Seçiniz —</option>
        </select>
    </div>
    <div class="dm-ep-row">
        <label class="dm-ep-label">Tip</label>
        <select id="dmep-doctype" class="dm-ep-input" disabled>
            <option value="">— Önce kategori seçin —</option>
        </select>
    </div>
    <div class="dm-ep-row">
        <label class="dm-ep-label">Etiketler</label>
        <input id="dmep-tags" class="dm-ep-input" type="text" value="@Model.Tags" placeholder="Virgülle ayırın: kalite, teknik, revize">
    </div>
    <div class="dm-ep-row">
        <label class="dm-ep-label">Açıklama</label>
        <textarea id="dmep-desc" class="dm-ep-input" rows="3" style="resize:vertical;" placeholder="Kısa açıklama">@Model.Description</textarea>
    </div>
    <div class="dm-ep-actions">
        <button class="dm-ep-btn dm-ep-btn--secondary" onclick="window._dmepCancel && window._dmepCancel()">Vazgeç</button>
        <button class="dm-ep-btn dm-ep-btn--primary" onclick="dmepSave(@Model.Id)">Kaydet</button>
    </div>
    <div id="dmep-status" class="dm-ep-status"></div>
</div>

<script>
(function() {
    // ── Kategori (L1) > Tip (L2) kaskad — DocumentCategory kontratı ────────
    // Uç noktalar: GET /DocumentCategory/Categories, GET /DocumentCategory/Types?parentId=
    var CATEGORIES_URL = '/DocumentCategory/Categories';
    var TYPES_URL       = '/DocumentCategory/Types';
    var existingId = @Html.Raw(existingCategoryId.HasValue ? existingCategoryId.Value.ToString() : "null");

    function fillSelect(select, items, placeholder) {
        select.innerHTML = '';
        var ph = document.createElement('option');
        ph.value = ''; ph.textContent = placeholder;
        select.appendChild(ph);
        (items || []).forEach(function(it) {
            var opt = document.createElement('option');
            opt.value = it.id; opt.textContent = it.name;
            select.appendChild(opt);
        });
    }

    function loadTypesForCategory(catId, preselectTypeId) {
        var typeSelect = document.getElementById('dmep-doctype');
        if (!catId) {
            fillSelect(typeSelect, [], '— Önce kategori seçin —');
            typeSelect.disabled = true;
            return;
        }
        typeSelect.disabled = true;
        fillSelect(typeSelect, [], 'Yükleniyor…');
        fetch(TYPES_URL + '?parentId=' + encodeURIComponent(catId), { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var list = Array.isArray(data) ? data : (data.types || data.items || []);
                fillSelect(typeSelect, list, list.length ? '— Seçiniz (opsiyonel) —' : '— Bu kategoride tip yok —');
                typeSelect.disabled = false;
                if (preselectTypeId != null) typeSelect.value = String(preselectTypeId);
            })
            .catch(function() { fillSelect(typeSelect, [], '— Tip listesi yüklenemedi —'); });
    }

    document.getElementById('dmep-category').addEventListener('change', function() {
        loadTypesForCategory(this.value || null, null);
    });

    // Mevcut kaydın documentCategoryId'si ya bir Kategori(L1) ya da bir Tip(L2) olabilir.
    // Önce L1 listesinde eşleşme arar; yoksa her kategori için Tip listesini kontrol eder.
    fetch(CATEGORIES_URL, { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var cats = Array.isArray(data) ? data : (data.categories || data.items || []);
            var catSelect = document.getElementById('dmep-category');
            fillSelect(catSelect, cats, '— Seçiniz —');

            if (existingId == null) return;

            var directMatch = cats.filter(function(c) { return String(c.id) === String(existingId); })[0];
            if (directMatch) {
                catSelect.value = String(existingId);
                loadTypesForCategory(existingId, null);
                return;
            }

            // Tip (L2) olarak dene — sırayla her kategorinin tiplerini kontrol et
            var idx = 0;
            function tryNextCategory() {
                if (idx >= cats.length) return; // eşleşme yok — eski/silinmiş kayıt olabilir
                var cat = cats[idx++];
                fetch(TYPES_URL + '?parentId=' + encodeURIComponent(cat.id), { credentials: 'same-origin' })
                    .then(function(r) { return r.json(); })
                    .then(function(td) {
                        var types = Array.isArray(td) ? td : (td.types || td.items || []);
                        var found = types.filter(function(t) { return String(t.id) === String(existingId); })[0];
                        if (found) {
                            catSelect.value = String(cat.id);
                            loadTypesForCategory(cat.id, existingId);
                        } else {
                            tryNextCategory();
                        }
                    })
                    .catch(tryNextCategory);
            }
            tryNextCategory();
        })
        .catch(function() { console.error('[DocMgmt] Kategori listesi yüklenemedi'); });
})();

function dmepSave(id) {
    var dmepCatVal  = document.getElementById('dmep-category').value;
    var dmepTypeVal = document.getElementById('dmep-doctype').value;
    var form = new FormData();
    form.append('id',                id);
    form.append('title',             document.getElementById('dmep-title').value);
    form.append('documentCategoryId', dmepTypeVal || dmepCatVal || '');
    form.append('tags',              document.getElementById('dmep-tags').value);
    form.append('description',       document.getElementById('dmep-desc').value);
    form.append('__RequestVerificationToken', '@tokens.RequestToken');
    var statusEl = document.getElementById('dmep-status');
    fetch('/DocumentManagement/UpdateMeta', { method:'POST', body:form, credentials:'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(d) {
            if (d.ok) {
                statusEl.className = 'dm-ep-status dm-ep-status--ok';
                statusEl.textContent = 'Kaydedildi.';
                setTimeout(function() {
                    window.dispatchEvent(new CustomEvent('close-sc-modal', { detail: { refresh: true } }));
                    if (window._dmBoardRefresh) window._dmBoardRefresh();
                }, 800);
            } else {
                statusEl.className = 'dm-ep-status dm-ep-status--err';
                statusEl.textContent = d.error || 'Hata oluştu.';
            }
        })
        .catch(function(e) {
            statusEl.className = 'dm-ep-status dm-ep-status--err';
            statusEl.textContent = 'Bağlantı hatası.';
        });
}
</script>
