@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = "Onayda Bekleyenler";
    ViewData["HelpKey"] = "pending-approval";
    ViewData["BodyClass"] = "page-pending-approval";
    var scopes = ViewBag.AvailableScopes as IReadOnlyList<string> ?? new[] { "mine" };
    var defaultScope = (string)(ViewBag.DefaultScope ?? "mine");
}

@*
    2026-08-01 — CalibraSmartBoard (C-Grid) donusumu (PageComment Seq 1057).
    Eski custom pa-table/sidebar/sutun-ayarlari kaldirildi; liste artik standart
    SmartBoard (kart) ile render ediliyor — arama/filtre/excel/widget-ayarlari
    standart C-Grid header'indan gelir (bkz. CLAUDE.md "CalibraSmartBoard (C-Grid)
    kurallari"). Bekleyen/Tamamlanan + Kapsam (Sadece Benim/Departmanim/Tumu)
    SERVER SORGUSU degistirdigi icin (client-side filtre degil) ince bir arac
    seridinde kalir; belge turu/cari/tutar/adim gibi alan-bazli filtreler
    standart "Filtre" panelinden (SmartBoardFilterPanel) yonetilir.

    Onay/Red is mantigi DEGISMEDI: detay + onay sureci zaman cizelgesi + Onayla/
    Reddet, karttaki "Incele" aksiyonu (type:'trigger') ile acilan AYNI custom
    modalda kalmaya devam ediyor (Approval/ApproveStep, Approval/RejectApproval,
    PendingApproval/Detail, PendingApproval/CompletedDetail — hicbiri degismedi).

    NOT (backend ihtiyaci — bu view'in calismasi icin gerekli):
    PendingApprovalController'a yeni bir GET action eklenmeli:
        BoardConfig(string? scope, string? mode, CancellationToken ct)
    → SmartBoard JSON config'i doner (boardKey/title/subtitle/icon/refreshUrl/
      masterWidgets/entities). Tam sozlesme bu dosyanin sonundaki JS yorumunda
      ve gorev raporunda verildi. Bu controller degisikligi bu ajanin sinirlari
      disinda (Views/ClientApp) oldugu icin BURADA YAZILMADI.
*@

<style>
    .page-pending-approval .app-content-area--workspace-frame,
    .workspace-frame-body.page-pending-approval .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }

    .pa-wrap {
        padding: 0; flex: 1 1 auto; min-height: 0; overflow: hidden;
        display: flex; flex-direction: column;
    }

    /* ── İnce araç şeridi: Bekleyen/Tamamlanan + Kapsam ── */
    .pa-toolbar {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 18px; flex: 0 0 auto;
        border-bottom: 1px solid rgba(148,163,184,.14);
        background: var(--app-surface, #fff);
    }
    body.app-theme-dark .pa-toolbar {
        background: rgba(15,23,42,.35);
        border-bottom-color: rgba(255,255,255,.06);
    }
    .pa-header-sep { width: 1px; height: 18px; background: rgba(148,163,184,.25); flex-shrink: 0; }
    body.app-theme-dark .pa-header-sep { background: rgba(255,255,255,.12); }

    .pa-mode-tabs, .pa-scope-radio {
        display: flex; align-items: center; gap: 1px;
        background: rgba(148,163,184,.12); border-radius: 8px; padding: 2px;
        flex-shrink: 0;
    }
    body.app-theme-dark .pa-mode-tabs, body.app-theme-dark .pa-scope-radio { background: rgba(255,255,255,.07); }
    .pa-mode-tab {
        padding: 5px 14px; border-radius: 6px; border: none; background: transparent;
        font-size: 12px; font-weight: 500; color: #64748b; cursor: pointer;
        white-space: nowrap; user-select: none; transition: background .12s, color .12s;
    }
    .pa-mode-tab.active { background: #6366f1; color: #fff; }
    body.app-theme-dark .pa-mode-tab { color: #94a3b8; }
    body.app-theme-dark .pa-mode-tab.active { background: #6366f1; color: #fff; }

    .pa-scope-opt { display: flex; align-items: center; cursor: pointer; }
    .pa-scope-opt input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
    .pa-scope-opt span {
        padding: 5px 13px; border-radius: 6px; font-size: 12px; font-weight: 500; color: #64748b;
        cursor: pointer; white-space: nowrap; user-select: none; transition: background .12s, color .12s;
    }
    .pa-scope-opt input[type="radio"]:checked + span { background: #6366f1; color: #fff; }
    body.app-theme-dark .pa-scope-opt span { color: #94a3b8; }
    body.app-theme-dark .pa-scope-opt input[type="radio"]:checked + span { background: #6366f1; color: #fff; }

    /* ── Modal (Onay detayı + zaman çizelgesi) — korunan bespoke UI ── */
    .pa-modal-backdrop {
        position: fixed; inset: 0; background: rgba(15,23,42,.55);
        backdrop-filter: blur(3px);
        display: none; align-items: center; justify-content: center;
        z-index: 1050;
    }
    .pa-modal-backdrop.show { display: flex; }
    .pa-modal {
        background: #fff; border-radius: 12px;
        width: min(720px, 92vw); max-height: 88vh;
        display: flex; flex-direction: column;
        box-shadow: 0 20px 60px rgba(15,23,42,.30);
        animation: pa-modal-in 0.18s ease-out;
        color-scheme: light;
    }
    body.app-theme-dark .pa-modal { background: #1e293b; color: #e2e8f0; color-scheme: dark; }
    @@keyframes pa-modal-in {
        from { opacity: 0; transform: translateY(20px) scale(.98); }
        to   { opacity: 1; transform: translateY(0)     scale(1); }
    }
    .pa-modal-header {
        padding: 16px 20px; border-bottom: 1px solid rgba(148,163,184,.18);
        display: flex; align-items: flex-start; gap: 14px;
    }
    .pa-modal-title { font-size: 16px; font-weight: 700; margin: 0 0 4px; }
    .pa-modal-sub { font-size: 12px; color: #64748b; }
    .pa-modal-close { margin-left: auto; background: transparent; border: 0; font-size: 22px; color: #94a3b8; cursor: pointer; line-height: 1; }
    .pa-modal-body { padding: 18px 20px; overflow-y: auto; flex: 1 1 auto; }
    .pa-modal-footer { padding: 14px 20px; border-top: 1px solid rgba(148,163,184,.18); display: flex; gap: 8px; justify-content: flex-end; flex: 0 0 auto; }
    .pa-btn { padding: 8px 16px; border-radius: 8px; border: 0; font-size: 13px; font-weight: 600; cursor: pointer; transition: opacity 0.15s, transform 0.12s; }
    .pa-btn:hover { transform: translateY(-1px); }
    .pa-btn-primary { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
    .pa-btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
    .pa-btn-ghost   { background: rgba(148,163,184,.15); color: #64748b; }

    .pa-note-panel { padding: 12px 20px 14px; border-top: 1px solid rgba(148,163,184,.18); flex: 0 0 auto; }
    .pa-note-label { font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--app-text, #0f172a); }
    .pa-note-textarea {
        width: 100%; box-sizing: border-box; resize: vertical;
        border: 1px solid rgba(148,163,184,.3); border-radius: 8px;
        padding: 7px 10px; font-size: 13px; line-height: 1.4;
        background: transparent; color: var(--app-text, #0f172a);
        font-family: inherit; outline: none; transition: border-color .12s;
    }
    .pa-note-textarea:focus { border-color: rgba(99,102,241,.55); }
    body.app-theme-dark .pa-note-textarea { border-color: rgba(255,255,255,.15); color: #e2e8f0; }
    .pa-note-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
    .pa-note-panel--approve { background: rgba(16,185,129,.05); }
    .pa-note-panel--reject  { background: rgba(239,68,68,.05); }
    .pa-note-panel--approve .pa-note-label { color: #059669; }
    .pa-note-panel--reject  .pa-note-label { color: #dc2626; }

    .pa-detail-grid { display: grid; grid-template-columns: 110px 1fr; gap: 6px 14px; font-size: 13px; margin-bottom: 20px; }
    .pa-detail-grid dt { color: #94a3b8; font-weight: 500; }
    .pa-detail-grid dd { margin: 0; font-weight: 500; }

    .pa-flow-section-title { font-size: 11px; font-weight: 700; letter-spacing: .06em; color: #94a3b8; margin-bottom: 14px; }
    .pa-htl { display: flex; flex-direction: row; overflow-x: auto; padding: 4px 4px 12px; }
    .pa-htl::-webkit-scrollbar { height: 4px; }
    .pa-htl::-webkit-scrollbar-thumb { background: rgba(148,163,184,.3); border-radius: 2px; }
    .pa-htl-node { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 130px; max-width: 210px; }
    .pa-htl-spine { display: flex; align-items: center; width: 100%; height: 36px; }
    .pa-htl-line { flex: 1; height: 2px; background: #e2e8f0; }
    body.app-theme-dark .pa-htl-line { background: rgba(255,255,255,.12); }
    .pa-htl-line.htl-done { background: #10b981; }
    .pa-htl-node:first-child .pa-htl-spine .pa-htl-line:first-child { visibility: hidden; }
    .pa-htl-node:last-child  .pa-htl-spine .pa-htl-line:last-child  { visibility: hidden; }
    .pa-htl-dot {
        width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; font-weight: 700; border: 2px solid #e2e8f0;
        background: var(--app-surface, #fff); color: #94a3b8; position: relative; z-index: 1;
    }
    body.app-theme-dark .pa-htl-dot { background: #1e293b; border-color: rgba(255,255,255,.15); color: #64748b; }
    .pa-htl-node.sf-approved .pa-htl-dot { border-color: #10b981; background: #ecfdf5; color: #059669; }
    .pa-htl-node.sf-pending  .pa-htl-dot { border-color: #f59e0b; background: #fffbeb; color: #b45309; }
    .pa-htl-node.sf-rejected .pa-htl-dot { border-color: #ef4444; background: #fef2f2; color: #dc2626; }
    body.app-theme-dark .pa-htl-node.sf-approved .pa-htl-dot { background: rgba(16,185,129,.15); }
    body.app-theme-dark .pa-htl-node.sf-pending  .pa-htl-dot { background: rgba(245,158,11,.12); }
    body.app-theme-dark .pa-htl-node.sf-rejected .pa-htl-dot { background: rgba(239,68,68,.12); }
    .pa-htl-card { margin-top: 10px; width: 100%; padding: 6px 8px; text-align: center; }
    .pa-htl-node.sf-current .pa-htl-dot { box-shadow: 0 0 0 4px rgba(245,158,11,.22), 0 0 12px rgba(245,158,11,.18); }
    body.app-theme-dark .pa-htl-node.sf-current .pa-htl-dot { box-shadow: 0 0 0 4px rgba(245,158,11,.3), 0 0 14px rgba(245,158,11,.22); }
    .pa-htl-node.sf-current .pa-htl-card { background: rgba(245,158,11,.07); border: 1.5px solid rgba(245,158,11,.28); border-radius: 10px; }
    body.app-theme-dark .pa-htl-node.sf-current .pa-htl-card { background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.38); }
    .pa-htl-node.sf-queued { opacity: .55; }
    .pa-htl-name { font-size: 12px; font-weight: 600; color: var(--app-text, #0f172a); margin-bottom: 3px; }
    body.app-theme-dark .pa-htl-name { color: #e2e8f0; }
    .pa-htl-badge { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px; letter-spacing: .03em; white-space: nowrap; margin-bottom: 4px; }
    .badge-approved { background: #d1fae5; color: #065f46; }
    .badge-pending  { background: #fef3c7; color: #92400e; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }
    .badge-waiting  { background: #f1f5f9; color: #64748b; }
    body.app-theme-dark .badge-approved { background: rgba(16,185,129,.18); color: #6ee7b7; }
    body.app-theme-dark .badge-pending  { background: rgba(245,158,11,.18); color: #fcd34d; }
    body.app-theme-dark .badge-rejected { background: rgba(239,68,68,.18); color: #fca5a5; }
    body.app-theme-dark .badge-waiting  { background: rgba(148,163,184,.1); color: #94a3b8; }
    .pa-htl-approver { font-size: 11px; color: #64748b; margin-bottom: 3px; }
    .pa-htl-times { display: flex; flex-direction: column; align-items: center; gap: 1px; font-size: 10px; color: #94a3b8; }
    .pa-htl-time-lbl { font-weight: 600; color: #94a3b8; }
    .pa-htl-note { margin-top: 5px; font-size: 11px; padding: 4px 8px; text-align: left; border-left: 3px solid #e2e8f0; color: #64748b; border-radius: 0 4px 4px 0; background: rgba(148,163,184,.06); }
    body.app-theme-dark .pa-htl-note { border-color: rgba(255,255,255,.12); background: rgba(255,255,255,.04); }

    .cb-mount-error {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        height: 100%; min-height: 400px; background: #0c0f1a; color: #f87171; font-size: 14px; gap: 12px;
    }
    .cb-mount-error button { padding: 8px 20px; border-radius: 8px; border: 1px solid #4f46e5; background: #6366f1; color: #fff; cursor: pointer; font-size: 13px; }
</style>

<div class="pa-wrap">
    <div class="pa-toolbar">
        <div class="pa-mode-tabs" id="paModeTabsGroup">
            <button type="button" class="pa-mode-tab active" data-mode="pending" onclick="paSetMode('pending')">Bekleyenler</button>
            <button type="button" class="pa-mode-tab" data-mode="completed" onclick="paSetMode('completed')">Tamamlananlar</button>
        </div>
        @if (scopes.Count > 1)
        {
            <div class="pa-header-sep"></div>
            <div class="pa-scope-radio" id="paScopeGroup">
                @foreach (var s in scopes)
                {
                    var label = s switch
                    {
                        "mine" => "Sadece Benim",
                        "department" => "Departmanım",
                        "all" => "Tümü",
                        _ => s
                    };
                    var isDefault = string.Equals(s, defaultScope, StringComparison.OrdinalIgnoreCase);
                    <label class="pa-scope-opt">
                        <input type="radio" name="paScope" value="@s" @(isDefault ? "checked" : "")>
                        <span>@label</span>
                    </label>
                }
            </div>
        }
        else
        {
            <div style="display:none;" id="paScopeGroup">
                @foreach (var s in scopes)
                {
                    var isDefault = string.Equals(s, defaultScope, StringComparison.OrdinalIgnoreCase);
                    <label class="pa-scope-opt">
                        <input type="radio" name="paScope" value="@s" @(isDefault ? "checked" : "")>
                        <span>@s</span>
                    </label>
                }
            </div>
        }
    </div>

    <div id="reactSmartBoard" style="flex:1 1 auto;min-height:0;overflow:hidden;"></div>
</div>

<!-- Onay detay modalı (SmartCard "İncele" trigger'ı ile açılır — bespoke, korunan) -->
<div class="pa-modal-backdrop" id="paModalBackdrop">
    <div class="pa-modal" role="dialog" aria-modal="true">
        <div class="pa-modal-header">
            <div>
                <div class="pa-modal-title" id="paModalTitle">Belge Detayı</div>
                <div class="pa-modal-sub" id="paModalSub"></div>
            </div>
            <button type="button" class="pa-modal-close" id="paModalClose" aria-label="Kapat">×</button>
        </div>
        <div class="pa-modal-body" id="paModalBody">
            <div style="text-align:center;padding:30px;color:#94a3b8;">Yükleniyor…</div>
        </div>
        <div class="pa-note-panel" id="paNotePanel" style="display:none;">
            <div class="pa-note-label" id="paNoteLabel">Onay Notu</div>
            <textarea id="paNoteText" class="pa-note-textarea" rows="2" placeholder="Not girin…"></textarea>
            <div class="pa-note-actions">
                <button type="button" class="pa-btn pa-btn-ghost" id="paNoteCancel">Vazgeç</button>
                <button type="button" class="pa-btn" id="paNoteSubmit">Gönder</button>
            </div>
        </div>
        <div class="pa-modal-footer" id="paModalFooter">
            <button type="button" class="pa-btn pa-btn-danger"  id="paBtnReject">Reddet</button>
            <span id="paChoiceArms" style="display:contents;"></span>
            <button type="button" class="pa-btn pa-btn-primary" id="paBtnApprove">Onayla</button>
            <button type="button" class="pa-btn pa-btn-ghost"   id="paBtnCancel">Kapat</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
(function() {
    var BUNDLE_URL = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';

    var mountEl = document.getElementById('reactSmartBoard');
    var boardHandle = null;
    var _currentMode = 'pending'; // 'pending' | 'completed' — sunucu sorgusu degisir

    function getScope() {
        var c = document.querySelector('input[name="paScope"]:checked');
        return c ? c.value : 'mine';
    }

    function showError(msg) {
        mountEl.innerHTML = '<div class="cb-mount-error">'
            + '<div>' + msg + '</div>'
            + '<button onclick="location.reload()">Sayfayı Yenile</button>'
            + '</div>';
    }

    /*
     * Board config sozlesmesi (backend PendingApprovalController.BoardConfig
     * GET action'i tarafindan uretilmesi gereken JSON — bkz. dosya ustu yorum +
     * gorev raporu):
     *   {
     *     boardKey: 'pending-approval-pending' | 'pending-approval-completed',
     *     title: 'Onay Takibi',
     *     subtitle: '<n> bekleyen kayıt' | '<n> tamamlanmış kayıt',
     *     icon: 'ClipboardList', iconColor: 'indigo',  // 'ClipboardList' whitelisted in
     *                                                   // DynamicWidgetFactory.js iconMap
     *                                                   // ('ClipboardCheck' YOK — CircleDot'a düşer)
     *     refreshUrl: '/PendingApproval/BoardConfig?scope=<scope>&mode=<mode>',
     *     searchPlaceholder: 'Belge no, cari, onaylayıcı ara…',
     *     emptyText: '...',
     *     actions: [],
     *     masterWidgets: [
     *       { id:'w_typ',  label:'Belge Türü',  dataType:'text' },
     *       { id:'w_cari', label:'Cari',        dataType:'text' },
     *       { id:'w_amt',  label:'Tutar',       dataType:'numeric' },
     *       { id:'w_step', label:'Adım',        dataType:'text' },
     *       { id:'w_apvr', label:'Onaylayıcı',  dataType:'text' },
     *       { id:'w_dt',   label:'Bekliyor'|'Tamamlanma', dataType:'datetime' },
     *     ],
     *     entities: [{
     *       id: instanceId, title: documentNumber, subtitle: documentTypeName,
     *       description: flowName + ' • ' + stepName,
     *       statusBadge: null | { label:'Gecikti'|'Onaylandı'|'Reddedildi', color:'rose'|'emerald' },
     *       widgets: [ ...yukaridaki id'lerle esleşen deger nesneleri... ],
     *       extraActions: [{
     *         id:'inspect', type:'trigger', trigger:'paOpenDetail', label:'İncele',
     *         icon:'Eye', color:'indigo', payload:{ instanceId: <id> }
     *       }]
     *     }]
     *   }
     * scope=mine/department/all, mode=pending/completed — GetListAsync/
     * GetCompletedListAsync (IPendingApprovalService, DEĞİŞMEDİ) üzerinden
     * kurulur; documentTypeId artik server-side gruplama icin gonderilmez
     * (sidebar kaldirildi — "Belge Türü" alan-bazli filtre panelinden secilir).
     */
    function boardConfigUrl() {
        return '/PendingApproval/BoardConfig?scope=' + encodeURIComponent(getScope()) + '&mode=' + _currentMode;
    }

    function loadBoard() {
        return fetch(boardConfigUrl(), { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(cfg) {
                if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) {
                    showError('SmartBoard mount fonksiyonu bulunamadı');
                    return;
                }
                if (!boardHandle) {
                    boardHandle = window.CalibraHub.mountSmartBoard(mountEl, cfg);
                } else {
                    boardHandle.refresh(cfg);
                }
            })
            .catch(function(err) {
                console.error('[PendingApproval] Board yüklenemedi:', err);
                showError('Liste yüklenemedi: ' + (err.message || err));
            });
    }

    function loadCss() {
        if (document.querySelector('link[data-pa-sb]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL;
        link.setAttribute('data-pa-sb', '1');
        document.head.appendChild(link);
    }

    function loadScript(cb) {
        if (document.querySelector('script[data-pa-sb]')) { cb(); return; }
        var script = document.createElement('script');
        script.src = BUNDLE_URL;
        script.setAttribute('data-pa-sb', '1');
        script.onload  = function() { setTimeout(cb, 0); };
        script.onerror = function() { showError('Bundle yüklenemedi'); };
        document.head.appendChild(script);
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountSmartBoard) {
        loadBoard();
    } else {
        loadScript(loadBoard);
    }

    window.paSetMode = function(mode) {
        if (_currentMode === mode) return;
        _currentMode = mode;
        document.querySelectorAll('.pa-mode-tab').forEach(function(btn) {
            btn.classList.toggle('active', btn.getAttribute('data-mode') === mode);
        });
        loadBoard();
    };
    var scopeGroupEl = document.getElementById('paScopeGroup');
    if (scopeGroupEl) scopeGroupEl.addEventListener('change', loadBoard);

    // ── Onay detay modalı — kart "İncele" aksiyonundan (type:'trigger') açılır ──
    var backdropEl = document.getElementById('paModalBackdrop');
    var modalCloseEl = document.getElementById('paModalClose');
    var modalCancelEl = document.getElementById('paBtnCancel');
    var modalApproveEl = document.getElementById('paBtnApprove');
    var modalRejectEl = document.getElementById('paBtnReject');
    var modalBodyEl = document.getElementById('paModalBody');
    var modalTitleEl = document.getElementById('paModalTitle');
    var modalSubEl = document.getElementById('paModalSub');
    var modalFooterEl = document.getElementById('paModalFooter');
    var choiceArmsEl  = document.getElementById('paChoiceArms');
    var notePanelEl = document.getElementById('paNotePanel');
    var noteLabelEl = document.getElementById('paNoteLabel');
    var noteTextEl = document.getElementById('paNoteText');
    var noteSubmitEl = document.getElementById('paNoteSubmit');
    var noteCancelEl = document.getElementById('paNoteCancel');
    var _noteAction = null; // 'approve' | 'reject'
    var _currentChoiceArmId = null;
    var currentInstanceId = null;

    function csrf() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
    function escapeHtml(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, function(c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]); });
    }
    function fmtDate(iso) {
        if (!iso) return '—';
        var d = new Date(iso);
        if (isNaN(d.getTime())) return '—';
        return d.toLocaleDateString('tr-TR') + ' ' + d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    function fmtMoney(v, code) {
        if (v == null) return '—';
        var n = Number(v);
        return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + (code || '');
    }

    // Global trigger — SmartCard extraAction { type:'trigger', trigger:'paOpenDetail', payload:{instanceId} }
    window.paOpenDetail = function(payload) {
        var instanceId = payload && payload.instanceId;
        if (instanceId != null) openDetail(Number(instanceId));
    };

    function openDetail(instanceId) {
        currentInstanceId = instanceId;
        backdropEl.classList.add('show');
        modalBodyEl.innerHTML = '<div style="text-align:center;padding:30px;color:#94a3b8;">Yükleniyor…</div>';
        modalTitleEl.textContent = 'Belge Detayı';
        modalSubEl.textContent = '';
        if (_currentMode === 'completed') {
            modalApproveEl.style.display = 'none';
            modalRejectEl.style.display  = 'none';
        } else {
            modalApproveEl.style.display = '';
            modalRejectEl.style.display  = '';
        }
        var scope = getScope();
        var ep = _currentMode === 'completed' ? '/PendingApproval/CompletedDetail' : '/PendingApproval/Detail';
        fetch(ep + '?instanceId=' + instanceId + '&scope=' + encodeURIComponent(scope), { credentials: 'same-origin' })
            .then(function(resp) { return resp.json(); })
            .then(function(data) {
                if (!data.ok) throw new Error(data.error || 'Hata');
                renderDetail(data.detail);
                renderChoiceArms(data.detail.choiceArms);
            })
            .catch(function(err) {
                modalBodyEl.innerHTML = '<div style="color:#ef4444;padding:20px;">Hata: ' + escapeHtml(err.message) + '</div>';
            });
    }

    var STATUS_TR = {
        'Approved':  'Onaylandı', 'Pending': 'Bekliyor', 'Rejected': 'Reddedildi',
        'Waiting':   'Beklemede', 'Skipped': 'Atlandı',  'Cancelled': 'İptal Edildi',
    };
    var STATUS_CSS = {
        'Approved': 'sf-approved', 'Pending': 'sf-pending', 'Rejected': 'sf-rejected',
        'Waiting':  'sf-waiting',  'Skipped': 'sf-waiting', 'Cancelled': 'sf-rejected',
    };
    var STATUS_BADGE = {
        'Approved': 'badge-approved', 'Pending': 'badge-pending', 'Rejected': 'badge-rejected',
        'Waiting':  'badge-waiting',  'Skipped': 'badge-waiting', 'Cancelled': 'badge-rejected',
    };
    var STATUS_ICON = {
        'Approved': '✓', 'Pending': '…', 'Rejected': '✕', 'Waiting': '○', 'Skipped': '–', 'Cancelled': '✕',
    };

    function renderDetail(d) {
        var h = d.header;
        modalTitleEl.textContent = 'Belge: ' + (h.documentNumber || '—');
        modalSubEl.textContent = h.flowName + ' • Adım ' + h.stepPosition + ' / ' + h.totalSteps;

        var html = '<dl class="pa-detail-grid">' +
                   '<dt>Belge No</dt><dd>' + escapeHtml(h.documentNumber || '—') + '</dd>' +
                   '<dt>Tür</dt><dd>' + escapeHtml(h.documentTypeName || 'Belirsiz') + '</dd>' +
                   '<dt>Cari</dt><dd>' + escapeHtml(h.contactName || '—') + '</dd>' +
                   '<dt>Tutar</dt><dd>' + fmtMoney(h.grandTotal, h.currencyCode) + '</dd>' +
                   '</dl>';

        if (d.steps && d.steps.length > 0) {
            html += '<div class="pa-flow-section-title">Onay Süreci</div>';
            html += '<div class="pa-htl">';

            html += '<div class="pa-htl-node sf-approved">' +
                    '<div class="pa-htl-spine">' +
                    '<div class="pa-htl-line"></div>' +
                    '<div class="pa-htl-dot">✓</div>' +
                    '<div class="pa-htl-line htl-done"></div>' +
                    '</div>' +
                    '<div class="pa-htl-card">' +
                    '<div class="pa-htl-name">Belge Oluşturma</div>' +
                    '<span class="pa-htl-badge badge-approved">Tamamlandı</span>' +
                    '<div class="pa-htl-times">' +
                    '<span><span class="pa-htl-time-lbl">Tarih:</span> ' + fmtDate(h.documentDate) + '</span>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

            var instanceDone = h.instanceStatus === 'Approved' || h.instanceStatus === 'Rejected';
            var visibleSteps = d.steps.filter(function(s) {
                return !instanceDone || s.status !== 'Pending' || s.actionDate != null;
            });
            var firstPendingIdx = visibleSteps.findIndex(function(s) { return (s.status || 'Waiting') === 'Pending'; });
            visibleSteps.forEach(function(s, idx) {
                var status = s.status || 'Waiting';
                var isQueued  = status === 'Pending' && idx !== firstPendingIdx;
                var isCurrent = status === 'Pending' && idx === firstPendingIdx;

                var cssClass = isQueued ? 'sf-waiting sf-queued' : (STATUS_CSS[status] || 'sf-waiting');
                var badge    = isQueued ? 'badge-waiting'        : (STATUS_BADGE[status] || 'badge-waiting');
                var icon     = isQueued ? '○'                    : (STATUS_ICON[status]  || '○');

                var hasStarted = status === 'Approved' || status === 'Rejected' || isCurrent;
                var entryTime = hasStarted
                    ? (idx === 0 ? (h.instanceStarted || s.enteredAt) : (visibleSteps[idx - 1].actionDate || h.instanceStarted))
                    : null;

                var lineBeforeDone = idx === 0 || visibleSteps[idx - 1].status === 'Approved';
                var lineAfterDone  = status === 'Approved';

                html += '<div class="pa-htl-node ' + cssClass + (isCurrent ? ' sf-current' : '') + '">' +
                        '<div class="pa-htl-spine">' +
                        '<div class="pa-htl-line' + (lineBeforeDone ? ' htl-done' : '') + '"></div>' +
                        '<div class="pa-htl-dot">' + icon + '</div>' +
                        '<div class="pa-htl-line' + (lineAfterDone ? ' htl-done' : '') + '"></div>' +
                        '</div>' +
                        '<div class="pa-htl-card">' +
                        '<div class="pa-htl-name">' + escapeHtml(s.stepName || ('Adım ' + (idx + 1))) + '</div>' +
                        '<span class="pa-htl-badge ' + badge + '">' + (isQueued ? 'Sırada' : (STATUS_TR[status] || status)) + '</span>' +
                        (s.approverName ? '<div class="pa-htl-approver">' + escapeHtml(s.approverName) + '</div>' : '') +
                        (entryTime || s.actionDate
                            ? '<div class="pa-htl-times">' +
                              (entryTime ? '<span><span class="pa-htl-time-lbl">G:</span> ' + fmtDate(entryTime) + '</span>' : '') +
                              (s.actionDate ? '<span><span class="pa-htl-time-lbl">Ç:</span> ' + fmtDate(s.actionDate) + '</span>' : '') +
                              '</div>'
                            : '') +
                        (s.note ? '<div class="pa-htl-note">' + escapeHtml(s.note) + '</div>' : '') +
                        '</div>' +
                        '</div>';
            });
            html += '</div>';
        }

        modalBodyEl.innerHTML = html;
    }

    function renderChoiceArms(arms) {
        _currentChoiceArmId = null;
        if (!choiceArmsEl) return;
        choiceArmsEl.innerHTML = '';
        if (_currentMode === 'completed' || !arms || arms.length === 0) {
            modalApproveEl.style.display = _currentMode === 'completed' ? 'none' : '';
            modalRejectEl.style.display  = _currentMode === 'completed' ? 'none' : '';
            return;
        }
        modalRejectEl.style.display = '';
        modalApproveEl.style.display = '';
        var COLOR_MAP = {
            indigo:  'linear-gradient(135deg,#6366f1,#4f46e5)',
            emerald: 'linear-gradient(135deg,#10b981,#059669)',
            rose:    'linear-gradient(135deg,#ef4444,#dc2626)',
            amber:   'linear-gradient(135deg,#f59e0b,#d97706)',
            blue:    'linear-gradient(135deg,#3b82f6,#2563eb)',
            violet:  'linear-gradient(135deg,#8b5cf6,#7c3aed)',
            slate:   'linear-gradient(135deg,#64748b,#475569)',
        };
        arms.forEach(function (a) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'pa-btn';
            btn.style.background = COLOR_MAP[a.color] || COLOR_MAP.indigo;
            btn.style.color = '#fff';
            btn.textContent = a.label;
            btn.addEventListener('click', function () {
                _currentChoiceArmId = a.armId;
                showNotePanel('approve', a.label);
            });
            choiceArmsEl.appendChild(btn);
        });
    }

    function closeModal() {
        backdropEl.classList.remove('show');
        currentInstanceId = null;
        hideNotePanel();
    }

    function showNotePanel(action, actionLabel) {
        _noteAction = action;
        notePanelEl.className = 'pa-note-panel pa-note-panel--' + action;
        noteTextEl.value = '';
        if (action === 'approve') {
            var lbl = actionLabel || 'Onayla';
            noteLabelEl.textContent = lbl + ' — Not (opsiyonel)';
            noteTextEl.placeholder = 'Onay notu eklemek isterseniz girin…';
            noteSubmitEl.className = 'pa-btn pa-btn-primary';
            noteSubmitEl.textContent = lbl;
        } else {
            noteLabelEl.textContent = 'Ret Gerekçesi';
            noteTextEl.placeholder = 'Ret gerekçesini girin…';
            noteSubmitEl.className = 'pa-btn pa-btn-danger';
            noteSubmitEl.textContent = 'Reddet';
        }
        notePanelEl.style.display = '';
        modalFooterEl.style.display = 'none';
        noteTextEl.focus();
    }

    function hideNotePanel() {
        notePanelEl.style.display = 'none';
        modalFooterEl.style.display = '';
        _noteAction = null;
        _currentChoiceArmId = null;
    }

    function submitNote() {
        if (!currentInstanceId || !_noteAction) return;
        var note = noteTextEl.value.trim();
        if (_noteAction === 'reject' && !note) {
            noteTextEl.focus();
            noteTextEl.style.borderColor = '#ef4444';
            setTimeout(function() { noteTextEl.style.borderColor = ''; }, 1500);
            return;
        }
        noteSubmitEl.disabled = true;
        var fd = new FormData();
        fd.set('instanceId', currentInstanceId);
        if (note) fd.set('note', note);
        if (_noteAction === 'approve' && _currentChoiceArmId) fd.set('choiceArmId', _currentChoiceArmId);
        var url = _noteAction === 'approve' ? '/Approval/ApproveStep' : '/Approval/RejectApproval';
        fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'RequestVerificationToken': csrf() },
            body: fd,
        })
            .then(function(resp) { return resp.json(); })
            .then(function(data) {
                if (!data.ok) throw new Error(data.error || 'Hata');
                closeModal();
                // In-place refresh — sayfa yenilenmez, SmartBoard entity listesi yeniden çekilir.
                loadBoard();
            })
            .catch(function(err) {
                var prefix = _noteAction === 'approve' ? 'Onaylama' : 'Reddetme';
                noteLabelEl.innerHTML = noteLabelEl.textContent
                    + '<span style="color:#ef4444;font-weight:400;margin-left:8px;">' + escapeHtml(prefix) + ' hatası: ' + escapeHtml(err.message) + '</span>';
            })
            .finally(function() {
                noteSubmitEl.disabled = false;
            });
    }

    function approveCurrent() { if (currentInstanceId) showNotePanel('approve'); }
    function rejectCurrent()  { if (currentInstanceId) showNotePanel('reject');  }

    if (modalCloseEl)  modalCloseEl.addEventListener('click', closeModal);
    if (modalCancelEl) modalCancelEl.addEventListener('click', closeModal);
    if (backdropEl)    backdropEl.addEventListener('click', function(e) { if (e.target === backdropEl) closeModal(); });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && backdropEl.classList.contains('show')) {
            if (_noteAction) hideNotePanel(); else closeModal();
        }
        if (e.key === 'Enter' && e.ctrlKey && _noteAction) submitNote();
    });
    if (modalApproveEl) modalApproveEl.addEventListener('click', approveCurrent);
    if (modalRejectEl)  modalRejectEl.addEventListener('click', rejectCurrent);
    if (noteSubmitEl)   noteSubmitEl.addEventListener('click', submitNote);
    if (noteCancelEl)   noteCancelEl.addEventListener('click', hideNotePanel);

    window.addEventListener('pageshow', function(e) {
        if (e.persisted) location.reload();
    });
})();
</script>
}
