@model IReadOnlyList<CalibraHub.Web.Models.Approval.InvoiceLineItem>

@functions {
    string Fmt(string? s)
    {
        if (decimal.TryParse(s, System.Globalization.CultureInfo.InvariantCulture, out var n))
            return n.ToString("#,##0.00", new System.Globalization.CultureInfo("tr-TR"));
        return s ?? "-";
    }
}

@* Renkler ve grid-enhancer davranışı Cari Eşleştir modalıyla aynı gerekçelerle sabitlenir. *@
<style>
    .dl-table { color: var(--bs-body-color, #0f172a); --bs-table-color: inherit; --bs-table-bg: transparent; }
    .dl-table > :not(caption) > * > * { background-color: transparent; color: inherit; }
    .dl-table thead th {
        background: var(--app-surface-2, #f8fafc) !important;
        color: var(--bs-secondary-color, #6c757d) !important;
        border-bottom: 1px solid var(--app-border, #e2e8f0);
    }
    .dl-table tbody td { border-bottom-color: var(--app-border-soft, #eef1f4); }
    .dl-table tbody tr:hover > * { background: rgba(99,102,241,.10) !important; }
    body.app-theme-dark .dl-table { color: rgba(255,255,255,.88); }
    body.app-theme-dark .dl-table thead th { background: #0f172a !important; color: rgba(255,255,255,.55) !important; border-bottom-color: rgba(255,255,255,.10); }
    body.app-theme-dark .dl-table tbody td { border-bottom-color: rgba(255,255,255,.06); }
    body.app-theme-dark .dl-table .text-muted { color: rgba(255,255,255,.5) !important; }
    body.app-theme-dark .dl-table .text-dark { color: rgba(255,255,255,.92) !important; }
</style>

<div class="table-responsive mb-0" style="max-height: 480px;">
    <table class="table table-hover table-sm align-middle mb-0 dl-table" style="font-size: 0.85rem;"
           data-grid-actions-skip="1">
        <thead class="sticky-top">
            <tr>
                <th style="width: 2.5rem;" class="text-center">#</th>
                <th style="min-width: 250px;">Ürün / Hizmet Ayrıntısı</th>
                <th class="text-end" style="min-width: 90px;">Miktar</th>
                <th class="text-end" style="min-width: 90px;">Br. Fiyat</th>
                <th class="text-end" style="min-width: 60px;">KDV %</th>
                <th class="text-end" style="min-width: 90px;">KDV Tutarı</th>
                <th class="text-end" style="min-width: 100px;">Kalem Tutarı</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var line in Model)
        {
            <tr>
                <td class="text-muted text-center">@(line.LineNo ?? "-")</td>
                <td class="fw-medium text-wrap" style="max-width: 300px;">@(line.ItemName ?? "-")</td>
                <td class="text-end">
                    <span class="fw-semibold">@(line.Quantity ?? "-")</span> 
                    <span class="text-muted" style="font-size: 0.75rem;">@line.UnitCode</span>
                </td>
                <td class="text-end font-monospace">@Fmt(line.UnitPrice)</td>
                <td class="text-end">@(line.TaxRate ?? "-")</td>
                <td class="text-end text-muted font-monospace">@Fmt(line.TaxAmount)</td>
                <td class="text-end fw-semibold text-dark font-monospace">@Fmt(line.LineAmount)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
