            <button type="button" class="idl-btn idl-btn-lock" id="idlBulkLock">Kilitle</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var BOARD_CONFIG = @Html.Raw(boardConfigJson);
    var BUNDLE_URL = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';

    var el = document.getElementById('reactSmartBoard');
    if (!el) { console.error('[ItemDocumentLocks] Mount elementi yok'); return; }

    var mountHandle = null;
    var activeLockedType = (BOARD_CONFIG && BOARD_CONFIG.activeLockedDocType) || '';
    var DOC_TYPES = (BOARD_CONFIG && BOARD_CONFIG.docTypeCatalog)
        ? BOARD_CONFIG.docTypeCatalog.map(function (t) { return { code: t.code, label: t.label }; })
        : [];
    var DOC_TYPE_LABEL_MAP = {};
    DOC_TYPES.forEach(function (t) { DOC_TYPE_LABEL_MAP[t.code] = t.label; });

    function showError(msg) {
        el.innerHTML = '<div class="cb-mount-error">'
            + '<div>' + msg + '</div>'
            + '<button onclick="location.reload()">Sayfayı Yenile</button>'
            + '</div>';
    }

    // ── PageComment Seq 1129: kilitler artık satır bazında, sağdaki widget
    // şeridinde okunabilir bir liste halinde görünür (İşlemler/"Kilitleri
    // Düzenle" butonuna gitmeden). Bu dönüşüm TAMAMEN CLIENT-SIDE'dır —
    // controller/backend'e (board config üretimi) dokunulmadı; ekran kendi
    // sınırları içinde kalıyor (CLAUDE.md sınır kuralı).
    //
    // 1) viewMode='card' zorlanır: değişken sayıda kilit rozeti sabit sütunlu
    //    tablo görünümüne (2026-07-18 "kesin tablo" varsayılanı) sığmaz —
    //    SmartBoard'ın belgelenmiş viewMode:'card' opt-out'u kullanılır.
    // 2) Her satırın widget listesine, kilitli her belge tipi için TIKLANABİLİR
    //    tekil bir rozet (type:'link') eklenir → tıklayınca sadece o belge
    //    tipinin kilidini kaldırma onayı ister (bkz. openUnlockConfirm).
    //    Ayrıca "Kilit Ekle" rozeti eklenir (mevcut çoklu-seçim panelini açar —
    //    birden fazla tip eklerken checklist hâlâ en pratik yol).
    // 3) Sistem widget'ı 'w_locked_types' (filtre panelindeki "Kilitli Tipler"
    //    master widget'ının eşleştiği id) DEĞİŞTİRİLMEZ — SmartBoardFilterPanel
    //    bu widget'ın ham value'sunu (kod CSV) okuyor; değerini bozmak filtreyi
    //    kırar. Küçük bir görsel fazlalık (özet chip + tekil rozetler yan yana)
    //    bilinçli kabul edildi — bkz. rapor.
    // 4) NOT: entity-bazlı dönüşüm burada değil, SmartBoard'a config.entityTransform
    //    olarak VERİLİR (bkz. transformBoardConfig altı) — board kendi içinde
    //    sonsuz-kaydırma/sayfalama ile yeni satır çektiğinde (apiUrl fetch,
    //    ItemDocumentLocksPage) bu ikinci sayfa/sonraki satırlar cshtml'in
    //    kendi fetch akışından GEÇMEZ; tek seferlik dizi haritalaması yalnızca
    //    ilk sayfayı kapsardı. SmartBoard.jsx'e minimal, opt-in bir
    //    `entityTransform` prop'u eklendi (bkz. rapor — paylaşılan bileşene
    //    zorunlu, küçük dokunuş) ki dönüşüm HER sayfada tutarlı uygulansın.
    function transformEntity(entity) {
        if (!entity) return entity;
        var locked = (entity.recordValues && entity.recordValues.lockedDocTypes) || [];
        if (!Array.isArray(locked)) locked = [];
        var pills = locked.slice().sort(function (a, b) {
            var la = DOC_TYPE_LABEL_MAP[a] || a, lb = DOC_TYPE_LABEL_MAP[b] || b;
            return la.localeCompare(lb, 'tr');
        }).map(function (code) {
            return {
                id: 'w_lock_pill_' + code,
                type: 'link',
                label: DOC_TYPE_LABEL_MAP[code] || code,
                value: 'Kilitli',
                detail: 'Kaldırmak için tıklayın',
                icon: 'XCircle',
                color: 'rose',
                url: '#idl-unlock-' + entity.id + '-' + encodeURIComponent(code),
                alwaysVisible: true,
            };
        });
        pills.push({
            id: 'w_lock_add',
            type: 'link',
            label: 'Kilit Ekle',
            value: 'Ekle',
            detail: 'Bu malzemeye yeni belge tipi kilidi ekle',
            icon: 'Plus',
            color: 'indigo',
            url: '#idl-' + entity.id,
            alwaysVisible: true,
        });
        var next = Object.assign({}, entity);
        next.widgets = (Array.isArray(entity.widgets) ? entity.widgets : []).concat(pills);
        // Sol aksiyon şeridindeki "Kilitleri Düzenle" ikon-butonu kaldırılır —
        // satırdaki rozet listesi ekleme/kaldırmayı karşılıyor. Başlığa tıklama
        // hâlâ tam paneli açar (kart tıklaması hideButton'dan bağımsız çalışır,
        // bkz. SmartCard.jsx).
        if (next.primaryAction) next.primaryAction = Object.assign({}, next.primaryAction, { hideButton: true });
        return next;
    }

    function transformBoardConfig(config) {
        if (!config) return config;
        config.viewMode = 'card';
        config.entityTransform = transformEntity;
        return config;
    }

    function doMount(config) {
        if (!config) { showError('Board config bulunamadı'); return; }
        if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) { showError('SmartBoard mount fonksiyonu bulunamadı'); return; }
        config = transformBoardConfig(config);
        try {
            mountHandle = window.CalibraHub.mountSmartBoard(el, config);
        } catch (ex) {
            console.error('[ItemDocumentLocks] Mount exception:', ex);
            showError('Mount hatası: ' + (ex.message || ex));
        }
    }

    function loadCss() {
        if (document.querySelector('link[data-idl-sb]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL;
        link.setAttribute('data-idl-sb', '1');
        document.head.appendChild(link);
    }

    function loadScript(cb) {
        if (document.querySelector('script[data-idl-sb]')) { cb(); return; }
        var script = document.createElement('script');
        script.src = BUNDLE_URL;
        script.setAttribute('data-idl-sb', '1');
        script.onload  = function () { setTimeout(cb, 0); };
        script.onerror = function () { showError('Bundle yüklenemedi'); };
        document.head.appendChild(script);
    }

    // ── CSRF + fetch yardımcıları ────────────────────────────────
    function csrfToken() {
        var elTok = document.querySelector('input[name="__RequestVerificationToken"]');
        return elTok ? elTok.value : '';
    }
    function getJson(url) {
        return fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); });
    }
    function postJson(url, payload) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'RequestVerificationToken': csrfToken()
            },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.json(); });
    }
    function notify(msg, kind) {
        if (window.CalibraHub && window.CalibraHub.toast) window.CalibraHub.toast(msg, kind === 'err' ? 'err' : 'ok');
        else if (kind === 'err') alert(msg);
    }
    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // Belge-tipi hızlı filtre çipleri kaldırıldı — filtreleme artık board filtre
    // panelinden (Kilitli Tipler master widget'ı) yapılır. reloadBoard yalnız
    // kaydet/toplu-işlem sonrası board'u tazelemek için board config'i yeniden çeker.
    function reloadBoard() {
        var url = '/Logistics/ItemDocumentLocksBoardConfig' + (activeLockedType ? ('?lockedDocType=' + encodeURIComponent(activeLockedType)) : '');
        getJson(url).then(function (config) {
            if (!config || config.error) { notify('Board yenilenemedi.', 'err'); return; }
            config = transformBoardConfig(config);
            if (mountHandle) mountHandle.refresh(config);
        }).catch(function () { notify('Bağlantı hatası.', 'err'); });
    }

    // ── Ortak switch listesi (tekil + toplu panel paylaşır) ───────
    // "Tümü" öğesi en başta: gerçek bir belge tipi değil, tüm belge tipi
    // switch'lerini tek seferde açıp/kapatan yardımcı toggle (data-doctype
    // taşımaz → readCheckedDocTypes'a dahil olmaz).
    function buildSwitchListHtml(idPrefix, checkedCodes) {
        var allChecked = DOC_TYPES.length > 0 && DOC_TYPES.every(function (t) { return checkedCodes.indexOf(t.code) !== -1; });
        var html = '<label class="idl-switch-row idl-switch-row--all">'
            + '<span class="idl-switch-label idl-switch-label--all">Tümü</span>'
            + '<span class="form-check form-switch" style="margin:0;">'
            + '<input class="form-check-input" type="checkbox" role="switch" data-select-all="1" id="' + idPrefix + '-all"' + (allChecked ? ' checked' : '') + '>'
            + '</span>'
            + '</label>';
        DOC_TYPES.forEach(function (t) {
            var checked = checkedCodes.indexOf(t.code) !== -1;
            html += '<label class="idl-switch-row">'
                + '<span class="idl-switch-label">' + escapeHtml(t.label) + '</span>'
                + '<span class="form-check form-switch" style="margin:0;">'
                + '<input class="form-check-input" type="checkbox" role="switch" data-doctype="' + t.code + '" id="' + idPrefix + '-' + t.code + '"' + (checked ? ' checked' : '') + '>'
                + '</span>'
                + '</label>';
        });
        return html;
    }
    function readCheckedDocTypes(container) {
        var result = [];
        Array.prototype.forEach.call(container.querySelectorAll('input[data-doctype]:checked'), function (inp) {
            result.push(inp.getAttribute('data-doctype'));
        });
        return result;
    }
    // "Tümü" switch'ini alt öğelerle iki yönlü senkronize eder: üstten
    // toggle → tüm alt switch'ler; alttan herhangi bir değişiklik → "Tümü"
    // durumu (tam/kısmi/boş) yeniden hesaplanır.
    function wireSelectAllToggle(container, idPrefix) {
        var allCb = container.querySelector('#' + idPrefix + '-all');
        if (!allCb) return;
        var itemCbs = container.querySelectorAll('input[data-doctype]');
        function syncAllState() {
            var checkedCount = 0;
            Array.prototype.forEach.call(itemCbs, function (cb) { if (cb.checked) checkedCount++; });
            allCb.checked = itemCbs.length > 0 && checkedCount === itemCbs.length;
            allCb.indeterminate = checkedCount > 0 && checkedCount < itemCbs.length;
        }
        allCb.addEventListener('change', function () {
            Array.prototype.forEach.call(itemCbs, function (cb) { cb.checked = allCb.checked; });
            allCb.indeterminate = false;
        });
        Array.prototype.forEach.call(itemCbs, function (cb) {
            cb.addEventListener('change', syncAllState);
        });
        syncAllState();
    }

    // ── Tekil düzenleme paneli ─────────────────────────────────────
    var editBackdrop = document.getElementById('idlEditBackdrop');
    var editBody = document.getElementById('idlEditBody');
    var editSaveBtn = document.getElementById('idlEditSave');
    var editCurrentItemId = null;

    function onEditKeydown(e) { if (e.key === 'Escape') closeEditModal(); }

    function openEditModal(itemId) {
        editCurrentItemId = itemId;
        editBody.innerHTML = '<div class="idl-loading">Yükleniyor…</div>';
        editBackdrop.hidden = false;
        document.addEventListener('keydown', onEditKeydown);
        getJson('/Logistics/ItemDocumentLockGet?itemId=' + itemId).then(function (data) {
            if (!data || data.error) { editBody.innerHTML = '<div class="idl-error">Yüklenemedi.</div>'; return; }
            editBody.innerHTML = buildSwitchListHtml('idl-edit', data.docTypes || []);
            wireSelectAllToggle(editBody, 'idl-edit');
        }).catch(function () { editBody.innerHTML = '<div class="idl-error">Bağlantı hatası.</div>'; });
    }
    function closeEditModal() {
        editBackdrop.hidden = true;
        editCurrentItemId = null;
        document.removeEventListener('keydown', onEditKeydown);
    }
    document.getElementById('idlEditCancel').addEventListener('click', closeEditModal);
    document.getElementById('idlEditClose').addEventListener('click', closeEditModal);
    editBackdrop.addEventListener('click', function (e) { if (e.target === editBackdrop) closeEditModal(); });
    editSaveBtn.addEventListener('click', function () {
        if (!editCurrentItemId) return;
        var docTypes = readCheckedDocTypes(editBody);
        editSaveBtn.disabled = true;
        postJson('/Logistics/ItemDocumentLockSave', { itemId: editCurrentItemId, docTypes: docTypes })
            .then(function (res) {
                editSaveBtn.disabled = false;
                if (!res || res.success === false) { notify((res && res.message) || 'Kaydedilemedi.', 'err'); return; }
                notify('Kilitler kaydedildi.', 'ok');
                closeEditModal();
                reloadBoard();
            })
            .catch(function (err) { editSaveBtn.disabled = false; notify('Bağlantı hatası: ' + err.message, 'err'); });
    });

    // Kart/satır tıklaması → primaryAction.url = '#idl-{id}' (hash-tetikli, workspace
    // iframe navigasyonunu bozmaz — sayfa değişmez, yalnız hashchange olayı tetiklenir).
    // Satır içi tekil rozet tıklaması → '#idl-unlock-{id}-{docType}' (bkz.
    // transformBoardConfig) — sadece o belge tipinin kilidini kaldırma onayı ister.
    function handleHash() {
        var hash = window.location.hash || '';
        var mUnlock = /^#idl-unlock-(\d+)-(.+)$/.exec(hash);
        if (mUnlock) {
            var unlockItemId = parseInt(mUnlock[1], 10);
            var unlockDocType = decodeURIComponent(mUnlock[2]);
            try { history.replaceState(null, '', window.location.pathname + window.location.search); } catch (e) { /* ignore */ }
            if (unlockItemId > 0 && unlockDocType) openUnlockConfirm(unlockItemId, unlockDocType);
            return;
        }
        var m = /^#idl-(\d+)$/.exec(hash);
        if (!m) return;
        var itemId = parseInt(m[1], 10);
        try { history.replaceState(null, '', window.location.pathname + window.location.search); } catch (e) { /* ignore */ }
        if (itemId > 0) openEditModal(itemId);
    }
    window.addEventListener('hashchange', handleHash);

    // Tek bir belge tipi kilidini kaldırma — DESTRÜKTİF (kilit kalkınca malzeme o
    // belge tipinde tekrar seçilebilir hale gelir), bu yüzden tek tıkla OLMAZ:
    // ortak showConfirm() modalı (ekran-ortası, CLAUDE.md silme onay standardı)
    // ile onay alınır, sonra güncel kilit seti okunup (tekil) tip çıkarılıp
    // ItemDocumentLockSave ile ANINDA kaydedilir — ekranda "kaydedilmemiş
    // değişiklik" durumu hiç oluşmaz (satırdan ayrılınca veri kaybı riski yok).
    function openUnlockConfirm(itemId, docType) {
        var found = null;
        for (var i = 0; i < DOC_TYPES.length; i++) { if (DOC_TYPES[i].code === docType) { found = DOC_TYPES[i]; break; } }
        var label = found ? found.label : docType;
        window.showConfirm({
            title: 'Kilit Kaldırma Onayı',
            message: '"' + label + '" belge tipi kilidi bu malzemeden kaldırılacak; malzeme bu belge tipinde tekrar seçilebilir olacak. Devam edilsin mi?',
            okLabel: 'Evet, Kaldır',
            danger: true
        }).then(function (ok) {
            if (!ok) return;
            getJson('/Logistics/ItemDocumentLockGet?itemId=' + itemId).then(function (data) {
                if (!data || data.error) { notify('Kilit bilgisi okunamadı.', 'err'); return null; }
                var next = (data.docTypes || []).filter(function (c) { return c !== docType; });
                return postJson('/Logistics/ItemDocumentLockSave', { itemId: itemId, docTypes: next });
            }).then(function (res) {
                if (!res) return;
                if (res.success === false) { notify(res.message || 'Kaldırılamadı.', 'err'); return; }
                notify('Kilit kaldırıldı.', 'ok');
                reloadBoard();
            }).catch(function (err) { notify('Bağlantı hatası: ' + err.message, 'err'); });
        });
    }

    // ── Toplu işlem paneli ─────────────────────────────────────────
    var bulkBackdrop = document.getElementById('idlBulkBackdrop');
    var bulkDocTypesBody = document.getElementById('idlBulkDocTypes');
    var bulkSearchInput = document.getElementById('idlBulkSearch');
    var bulkResultsEl = document.getElementById('idlBulkResults');
    var bulkSelectedEl = document.getElementById('idlBulkSelected');
    var bulkSelectedCountEl = document.getElementById('idlBulkSelectedCount');
    var bulkSelectedItems = {};
    var bulkSearchTimer = null;

    function onBulkKeydown(e) { if (e.key === 'Escape') closeBulkModal(); }

    function openBulkModal() {
        bulkSelectedItems = {};
        bulkSearchInput.value = '';
        bulkResultsEl.innerHTML = '<div class="idl-empty-hint">Aramak için yazın…</div>';
        renderBulkSelected();
        bulkDocTypesBody.innerHTML = buildSwitchListHtml('idl-bulk', []);
        wireSelectAllToggle(bulkDocTypesBody, 'idl-bulk');
        bulkBackdrop.hidden = false;
        document.addEventListener('keydown', onBulkKeydown);
    }
    function closeBulkModal() {
        bulkBackdrop.hidden = true;
        document.removeEventListener('keydown', onBulkKeydown);
    }
    // Board header'daki "Toplu İşlem" aksiyonu (config.actions[].trigger = 'idlOpenBulk')
    // bu global fonksiyonu çağırır (bkz. SmartBoard.jsx handleActionClick trigger yolu).
    window.idlOpenBulk = openBulkModal;
    document.getElementById('idlBulkCancel').addEventListener('click', closeBulkModal);
    document.getElementById('idlBulkClose').addEventListener('click', closeBulkModal);
    bulkBackdrop.addEventListener('click', function (e) { if (e.target === bulkBackdrop) closeBulkModal(); });

    bulkSearchInput.addEventListener('input', function () {
        clearTimeout(bulkSearchTimer);
        var q = bulkSearchInput.value;
        bulkSearchTimer = setTimeout(function () { runBulkSearch(q); }, 350);
    });

    function runBulkSearch(q) {
        if (!q || q.trim().length === 0) { bulkResultsEl.innerHTML = '<div class="idl-empty-hint">Aramak için yazın…</div>'; return; }
        getJson('/Logistics/ItemDocumentLockSearchItems?search=' + encodeURIComponent(q) + '&pageSize=20')
            .then(function (data) {
                if (!data || data.error) { bulkResultsEl.innerHTML = '<div class="idl-error">Arama başarısız.</div>'; return; }
                renderBulkResults(data.items || []);
            })
            .catch(function () { bulkResultsEl.innerHTML = '<div class="idl-error">Bağlantı hatası.</div>'; });
    }

    function renderBulkResults(items) {
        if (items.length === 0) { bulkResultsEl.innerHTML = '<div class="idl-empty-hint">Sonuç yok.</div>'; return; }
        var html = '';
        items.forEach(function (it) {
            var picked = !!bulkSelectedItems[it.id];
            html += '<label class="idl-pick-row' + (picked ? ' idl-pick-row--picked' : '') + '">'
                + '<input type="checkbox" data-item-id="' + it.id + '" data-item-code="' + escapeHtml(it.code) + '" data-item-name="' + escapeHtml(it.name) + '"' + (picked ? ' checked' : '') + '>'
                + '<span class="idl-pick-name">' + escapeHtml(it.name) + '</span>'
                + '<span class="idl-pick-code">' + escapeHtml(it.code) + '</span>'
                + '</label>';
        });
        bulkResultsEl.innerHTML = html;
        Array.prototype.forEach.call(bulkResultsEl.querySelectorAll('input[type="checkbox"]'), function (cb) {
            cb.addEventListener('change', function () {
                var id = cb.getAttribute('data-item-id');
                if (cb.checked) bulkSelectedItems[id] = { code: cb.getAttribute('data-item-code'), name: cb.getAttribute('data-item-name') };
                else delete bulkSelectedItems[id];
                renderBulkSelected();
            });
        });
    }

    function renderBulkSelected() {
        var ids = Object.keys(bulkSelectedItems);
        bulkSelectedCountEl.textContent = ids.length + ' malzeme seçildi';
        var html = '';
        ids.forEach(function (id) {
            var it = bulkSelectedItems[id];
            html += '<span class="idl-pill">' + escapeHtml(it.name) + '<button type="button" class="idl-pill-x" data-remove-id="' + id + '" aria-label="Kaldır">&times;</button></span>';
        });
        bulkSelectedEl.innerHTML = html;
        Array.prototype.forEach.call(bulkSelectedEl.querySelectorAll('[data-remove-id]'), function (btn) {
            btn.addEventListener('click', function () {
                var rid = btn.getAttribute('data-remove-id');
                delete bulkSelectedItems[rid];
                renderBulkSelected();
                var cb = bulkResultsEl.querySelector('input[data-item-id="' + rid + '"]');
                if (cb) cb.checked = false;
            });
        });
    }

    function runBulkAction(mode) {
        var itemIds = Object.keys(bulkSelectedItems).map(function (x) { return parseInt(x, 10); });
        var docTypes = readCheckedDocTypes(bulkDocTypesBody);
        if (itemIds.length === 0) { notify('En az bir malzeme seçilmeli.', 'err'); return; }
        if (docTypes.length === 0) { notify('En az bir belge tipi seçilmeli.', 'err'); return; }

        var verb = mode === 'unlock' ? 'kaldırılacak' : 'uygulanacak';
        var msg = itemIds.length + ' malzemeye, seçili ' + docTypes.length + ' belge tipi kilidi ' + verb + '. Devam edilsin mi?';
        window.showConfirm({
            title: mode === 'unlock' ? 'Kilit Kaldırma Onayı' : 'Toplu Kilitleme Onayı',
            message: msg,
            okLabel: 'Evet, Uygula',
            danger: mode === 'unlock'
        }).then(function (ok) {
            if (!ok) return;
            postJson('/Logistics/ItemDocumentLockBulkSave', { itemIds: itemIds, docTypes: docTypes, mode: mode })
                .then(function (res) {
                    if (!res || res.success === false) { notify((res && res.message) || 'İşlem başarısız.', 'err'); return; }
                    notify(res.updatedItemCount + ' malzeme güncellendi.', 'ok');
                    closeBulkModal();
                    reloadBoard();
                })
                .catch(function (err) { notify('Bağlantı hatası: ' + err.message, 'err'); });
        });
    }
    document.getElementById('idlBulkLock').addEventListener('click', function () { runBulkAction('lock'); });
    document.getElementById('idlBulkUnlock').addEventListener('click', function () { runBulkAction('unlock'); });

    // ── Başlat ──────────────────────────────────────────────────
    if (window.location.hash) handleHash();
    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountSmartBoard) doMount(BOARD_CONFIG);
    else loadScript(function () { doMount(BOARD_CONFIG); });
})();
</script>
}
