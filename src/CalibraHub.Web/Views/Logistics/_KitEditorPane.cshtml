@*
    _KitEditorPane — Kit (paket ürün) içerik editörü, GÖMÜLÜ pane olarak.

    2026-08-06 (kullanıcı isteği): "kit içeriği için ayrı bir sayfa olmasın, stok kartının
    kit içeriği sayfasından gerekli tanımlamaları yapabilelim". Editör eskiden ayrı bir
    sayfaydı (/Logistics/KitEdit); artık Malzeme Kartı → "Kit İçeriği" sekmesine gömülür.
    Ayrı sayfanın kendi topbar'ı (Geri / Kaydet) ve yönlendirme mantığı BURADA YOKTUR —
    kayıt, malzeme kartının tek Kaydet butonuna bağlanır.

    Dışa açtığı API (MaterialCardEdit kullanır):
      window.mceKitEditorInit(itemId, code, name)  → kiti yükle/yenile
      window.mceKitEditorIsDirty()                 → kullanıcı bu sekmede değişiklik yaptı mı
      window.mceKitEditorSave()                    → Promise<{ok, message, count, versionNo}>

    ÖNEMLİ — VersionNo: repository her UpdateKit'te VersionNo'yu artırır. Bu yüzden malzeme
    kartı her kaydedildiğinde kit kaydedilmez; yalnız IsDirty() true iken kaydedilir, aksi
    halde dokunulmayan kitin versiyonu boşuna şişerdi.
*@
<style>
    /* Kit editörü — 'ke-' prefix (mce- ile çakışmaz). Light default → dark override. */
    .ke-embed {
        color-scheme: light;
        --ke-surface:   var(--app-surface);
        --ke-surface-2: var(--app-muted-surface);
        --ke-border:    var(--app-border);
        --ke-text:      var(--app-text);
        --ke-muted:     var(--app-text-muted);
        --ke-primary:   #6366f1;
        --ke-primary-weak: rgba(99,102,241,.10);
        --ke-danger:    #e11d48;
        --ke-ok:        #059669;
        display: flex; flex-direction: column; gap: 12px;
        color: var(--ke-text); font-size: 14px;
    }
    body.app-theme-dark .ke-embed {
        color-scheme: dark;
        --ke-primary-weak: rgba(99,102,241,.16);
    }

    .ke-embed .ke-btn {
        display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
        border: 1px solid var(--ke-border); background: var(--ke-surface-2);
        color: var(--ke-text); border-radius: 9px; padding: 8px 15px;
        font-size: .82rem; font-weight: 600; transition: all .15s;
    }
    .ke-embed .ke-btn:hover { border-color: var(--ke-primary); }
    .ke-embed .ke-btn--primary { background: var(--ke-primary); border-color: var(--ke-primary); color: #fff; }
    .ke-embed .ke-btn--primary:hover { filter: brightness(1.06); }
    .ke-embed .ke-btn--sm { padding: 6px 11px; font-size: .78rem; }
    .ke-embed .ke-btn:disabled { opacity: .5; cursor: not-allowed; }

    .ke-embed .ke-card {
        background: var(--ke-surface); border: 1px solid var(--ke-border);
        border-radius: 13px; padding: 14px 16px;
    }
    .ke-embed .ke-card__title { margin: 0 0 10px; font-size: .92rem; font-weight: 700; }

    .ke-embed .ke-grid { display: grid; grid-template-columns: 160px 1fr; gap: 10px 14px; align-items: center; max-width: 1040px; }
    .ke-embed .ke-label { font-size: .8rem; font-weight: 600; color: var(--ke-muted); }
    .ke-embed .ke-input {
        width: 100%; box-sizing: border-box; background: var(--ke-surface-2);
        border: 1px solid var(--ke-border); border-radius: 8px; padding: 7px 10px;
        color: var(--ke-text); font-size: .84rem; font-family: inherit;
    }
    .ke-embed .ke-input:focus { outline: none; border-color: var(--ke-primary); box-shadow: 0 0 0 3px var(--ke-primary-weak); }
    .ke-embed .ke-input[readonly] { background: transparent; color: var(--ke-muted); }
    .ke-embed textarea.ke-input { resize: vertical; min-height: 44px; }

    /* Fiyat modu segment kontrolü */
    .ke-embed .ke-seg { display: inline-flex; flex-wrap: wrap; background: var(--ke-surface-2); border: 1px solid var(--ke-border); border-radius: 9px; padding: 3px; gap: 3px; }
    .ke-embed .ke-seg button {
        border: 0; background: transparent; color: var(--ke-muted); cursor: pointer;
        padding: 7px 13px; border-radius: 7px; font-size: .78rem; font-weight: 600; transition: all .15s; white-space: nowrap;
    }
    .ke-embed .ke-seg button.is-active { background: var(--ke-primary); color: #fff; }

    /* Bileşen ekleme çubuğu — listenin ALTINA sarkan tek satır, "+ Yeni Bileşen" ile açılır/kapanır.
       Ayrı bir kart/başlık DEĞİL: tabloya bitişik, aynı kartın içinde. Fiyat alanı yalnız
       FixedComponent modda görünür. */
    .ke-embed .ke-addbar {
        display: none; flex-wrap: wrap; gap: 8px; align-items: end;
        margin-top: 4px; padding-top: 6px; border-top: 1px dashed var(--ke-border);
    }
    .ke-embed .ke-addbar.is-open { display: flex; }
    .ke-embed .ke-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ke-embed .ke-field > span { font-size: .72rem; font-weight: 600; color: var(--ke-muted); }
    .ke-embed .ke-field--code  { flex: 1 1 220px; }
    .ke-embed .ke-field--name  { flex: 1.3 1 240px; }
    .ke-embed .ke-field--combo { flex: 0 0 160px; }
    .ke-embed .ke-field--qty   { flex: 0 0 110px; }
    .ke-embed .ke-field--unit  { flex: 0 0 140px; }
    .ke-embed .ke-field--price { flex: 0 0 130px; display: none; }
    .ke-embed .ke-addbar.ke-mode-fixedcomponent .ke-field--price { display: flex; }
    .ke-embed .ke-field--note  { flex: 1.3 1 220px; }
    .ke-embed .ke-field--actions { flex: 0 0 auto; display: flex; gap: 6px; }

    .ke-embed .ke-addnew-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
    .ke-embed .ke-addnew-row .ke-hint { margin: 0; }

    .ke-embed .ke-combo-btn { width: 100%; justify-content: center; }
    .ke-embed .ke-combo-btn.is-set { border-color: var(--ke-ok); color: var(--ke-ok); }
    .ke-embed .ke-combo-btn:disabled { opacity: .45; }

    /* Stok kodu rehberi (autocomplete + standart Tip-1 rehber butonu) */
    .ke-embed .ke-lookup { position: relative; }
    .ke-embed .ke-lookup input#keCompCode { padding-right: 32px; }
    .ke-embed .ke-guide-btn {
        position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
        width: 25px; height: 25px; display: inline-flex; align-items: center; justify-content: center;
        border: none; background: transparent; color: var(--ke-muted); cursor: pointer; border-radius: 6px;
    }
    .ke-embed .ke-guide-btn:hover { background: var(--ke-primary-weak); color: var(--ke-primary); }
    .ke-embed .ke-dd {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 50;
        background: var(--ke-surface); border: 1px solid var(--ke-border);
        border-radius: 10px; box-shadow: 0 14px 36px rgba(0,0,0,.20);
        max-height: 288px; overflow-y: auto; padding: 4px;
    }
    .ke-embed .ke-dd-item {
        display: flex; flex-direction: column; gap: 1px; padding: 7px 10px;
        border-radius: 7px; cursor: pointer;
    }
    .ke-embed .ke-dd-item.is-active, .ke-embed .ke-dd-item:hover { background: var(--ke-primary-weak); }
    .ke-embed .ke-dd-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; color: var(--ke-primary); font-size: .8rem; }
    .ke-embed .ke-dd-name { font-size: .77rem; color: var(--ke-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ke-embed .ke-dd-msg  { padding: 12px; text-align: center; color: var(--ke-muted); font-size: .8rem; }

    /* Bileşen listesi */
    .ke-embed .ke-table-wrap { overflow-x: auto; border: 1px solid var(--ke-border); border-radius: 11px; }
    .ke-embed table.ke-table { width: 100%; border-collapse: collapse; font-size: .83rem; }
    .ke-embed .ke-table th {
        text-align: left; font-size: .71rem; font-weight: 700; text-transform: none;
        color: var(--ke-muted); padding: 7px 10px; background: var(--ke-surface-2);
        border-bottom: 1px solid var(--ke-border); white-space: nowrap;
    }
    .ke-embed .ke-table td { padding: 5px 10px; border-bottom: 1px solid var(--ke-border); vertical-align: middle; }
    .ke-embed .ke-table tr:last-child td { border-bottom: 0; }
    .ke-embed .ke-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; color: var(--ke-primary); }
    .ke-embed .ke-qty-cell { width: 110px; }
    .ke-embed .ke-col-price { display: none; }
    .ke-embed table.ke-table.ke-mode-fixedcomponent .ke-col-price { display: table-cell; }
    .ke-embed .ke-comb-badge {
        display: inline-block; margin-top: 3px; padding: 2px 8px; border-radius: 999px;
        font-size: .68rem; font-weight: 700; background: var(--ke-primary-weak); color: var(--ke-primary);
    }
    .ke-embed .ke-x {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 7px; cursor: pointer;
        border: 1px solid var(--ke-border); background: var(--ke-surface-2); color: var(--ke-danger);
    }
    .ke-embed .ke-x:hover { background: var(--ke-danger); color: #fff; border-color: var(--ke-danger); }

    .ke-embed .ke-empty { padding: 8px 12px; text-align: center; color: var(--ke-muted); font-size: .84rem; font-style: italic; }
    /* Ekleme çubuğu açıkken boş-durum metni gereksiz (çubuk hemen altında) — yer tutmasın. */
    .ke-embed .ke-card:has(.ke-addbar.is-open) .ke-empty { display: none; }
    .ke-embed .ke-badge {
        display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px;
        font-size: .72rem; font-weight: 700; background: var(--ke-primary-weak); color: var(--ke-primary);
    }
    .ke-embed .ke-hint { font-size: .74rem; color: var(--ke-muted); margin-top: 8px; }

    /* Toast — sayfa geneline sabit (malzeme kartının kendi mesajından bağımsız) */
    .ke-msg {
        position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%) translateY(20px);
        padding: 11px 20px; border-radius: 10px; font-size: .85rem; font-weight: 600;
        background: #059669; color: #fff; opacity: 0; pointer-events: none; transition: all .25s; z-index: 60;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .ke-msg.is-show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .ke-msg.is-err { background: #e11d48; }

    @@media (max-width: 720px) {
        .ke-embed .ke-grid { grid-template-columns: 1fr; max-width: none; }
        .ke-embed .ke-addbar .ke-field { flex-basis: 100%; }
    }
</style>

<div class="ke-embed" id="keEmbedRoot">

    <!-- Kit bilgi + fiyatlandırma -->
    <div class="ke-card">
        <p class="ke-card__title">Paket Bilgileri</p>
        <div class="ke-grid">
            <label class="ke-label">Fiyat Modu</label>
            <div>
                <div class="ke-seg" id="kePriceModeSeg">
                    <button type="button" data-mode="FixedPackage" class="is-active">Sabit Paket Fiyatı</button>
                    <button type="button" data-mode="FixedComponent">Sabit Bileşen Fiyatı</button>
                    <button type="button" data-mode="ListPackage">Liste Paket Fiyatı</button>
                    <button type="button" data-mode="ListComponent">Liste Bileşen Fiyatı</button>
                </div>
                <div class="ke-hint" id="kePriceModeHint">Kit kendi sabit satış fiyatıyla satılır; sipariş/teklife bu fiyat gelir.</div>
            </div>

            <label class="ke-label" id="keFixedPriceLabel">Sabit Birim Fiyat</label>
            <div id="keFixedPriceWrap">
                <input type="number" id="keFixedPrice" class="ke-input" step="any" min="0" placeholder="0,00" style="max-width:220px;" />
            </div>

            <label class="ke-label">Açıklama</label>
            <textarea id="keDescription" class="ke-input" placeholder="Paket hakkında not (opsiyonel)..."></textarea>
        </div>
    </div>

    <!-- Bileşen listesi + ekleme — TEK yer: kalemler burada eklenir, burada düzenlenir. -->
    <div class="ke-card">
        <p class="ke-card__title">
            Paket İçeriği
            <span class="ke-badge" id="keCount" style="margin-left:8px;">0 bileşen</span>
            <span class="ke-badge" id="keHeaderVer" style="margin-left:6px;display:none;"></span>
        </p>
        <div class="ke-table-wrap">
            <table class="ke-table" id="keTable">
                <thead>
                    <tr>
                        <th style="width:32px;">#</th>
                        <th style="width:140px;">Kod</th>
                        <th>Ad</th>
                        <th style="width:110px;">Miktar</th>
                        <th style="width:100px;">Birim</th>
                        <th class="ke-col-price" style="width:120px;">Birim Fiyat</th>
                        <th>Açıklama</th>
                        <th style="width:40px;"></th>
                    </tr>
                </thead>
                <tbody id="keLinesBody"></tbody>
            </table>
        </div>
        <div class="ke-empty" id="keEmpty">Henüz bileşen eklenmedi. Aşağıdaki <strong>+ Yeni Bileşen</strong> ile başlayın.</div>

        <!-- Ekleme çubuğu — listenin hemen altında, "+ Yeni Bileşen" ile açılır. Eklenen satır
             miktar/fiyat/not açısından zaten listede düzenlenebildiği için ayrı bir bölüm gerekmez. -->
        <div class="ke-addbar" id="keAddrow">
            <div class="ke-field ke-field--code">
                <span>Stok Kodu *</span>
                <div class="ke-lookup">
                    <input type="text" id="keCompCode" class="ke-input" placeholder="Kod veya ad ile ara..." autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="keCompDD" />
                    <button type="button" id="keCompGuideBtn" class="ke-guide-btn" title="Stok Rehberinden Seç">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
                    </button>
                    <div class="ke-dd" id="keCompDD" role="listbox" style="display:none;"></div>
                </div>
            </div>
            <div class="ke-field ke-field--name">
                <span>Stok Adı</span>
                <input type="text" id="keCompName" class="ke-input" readonly placeholder="Otomatik gelir..." />
            </div>
            <div class="ke-field ke-field--combo">
                <span>Kombinasyon</span>
                <button type="button" id="keCompCombo" class="ke-btn ke-btn--sm ke-combo-btn" disabled title="Önce stok kodu seçin">Seç...</button>
            </div>
            <div class="ke-field ke-field--qty">
                <span>Miktar *</span>
                <input type="number" id="keCompQty" class="ke-input" value="1" min="0" step="any" />
            </div>
            <div class="ke-field ke-field--unit">
                <span title="Malzemenin kendi biriminden farklı bir birim seçilebilir; seçim kayıtla birlikte saklanır.">Ölçü Birimi</span>
                <select id="keCompUnit" class="ke-input" disabled></select>
            </div>
            <div class="ke-field ke-field--price" id="keCompPriceField">
                <span>Birim Fiyat *</span>
                <input type="number" id="keCompPrice" class="ke-input" placeholder="0,00" min="0" step="any" />
            </div>
            <div class="ke-field ke-field--note">
                <span>Açıklama</span>
                <input type="text" id="keCompNote" class="ke-input" placeholder="Opsiyonel..." />
            </div>
            <div class="ke-field ke-field--actions">
                <span>&nbsp;</span>
                <button type="button" class="ke-btn ke-btn--primary ke-btn--sm" id="keCompAdd" title="Bileşeni listeye ekle">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Ekle
                </button>
                <button type="button" class="ke-btn ke-btn--sm" id="keAddCloseBtn" title="Ekleme çubuğunu kapat">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <div class="ke-addnew-row" id="keAddNewRow">
            <button type="button" class="ke-btn ke-btn--primary ke-btn--sm" id="keAddNewBtn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Yeni Bileşen
            </button>
            <span class="ke-hint">Kod alanında <strong>Enter</strong> ile alanlar arasında ilerleyip hızlıca ekleyin; miktar/birim/not eklendikten sonra da listeden düzenlenebilir.</span>
        </div>
    </div>

    <div class="ke-msg" id="keMsg"></div>
</div>

<script>
(function () {
    'use strict';

    var $ = function (id) { return document.getElementById(id); };

    // Runtime durum — ayrı sayfadaki derleme-zamanı sabitlerinin (KIT_ITEM_ID/CODE/NAME)
    // yerini alır; malzeme kartı kaydedildikçe init ile tazelenir.
    var KIT_ITEM_ID = 0;
    var KIT_CODE = '';
    var KIT_NAME = '';

    var lines = [];              // { code, name, quantity, note, configId, configCode, unitPrice, unitId, unitCode }
    var priceMode = 'FixedPackage';
    var dirty = false;           // kullanıcı bu sekmede değişiklik yaptı mı (VersionNo şişmesin)

    function markDirty() { dirty = true; }

    // ── Toast ──
    var msgTimer = null;
    function showMsg(text, isError) {
        var el = $('keMsg');
        if (!el) return;
        el.textContent = text;
        el.classList.toggle('is-err', !!isError);
        el.classList.add('is-show');
        clearTimeout(msgTimer);
        msgTimer = setTimeout(function () { el.classList.remove('is-show'); }, 2600);
    }

    // ── Fiyat modu (4 mod, backend KitPriceMode ile birebir) ──
    var KIT_PRICE_MODES = ['FixedPackage', 'FixedComponent', 'ListPackage', 'ListComponent'];
    var KIT_PRICE_MODE_LEGACY = { 'Fixed': 'FixedPackage', 'RollUp': 'ListComponent' };
    var KIT_PRICE_MODE_HINTS = {
        FixedPackage:   'Kit kendi sabit satış fiyatıyla satılır; sipariş/teklife bu fiyat gelir.',
        FixedComponent: 'Kit fiyatı, her bileşen için burada elle girilen birim fiyat × miktar toplamından hesaplanır.',
        ListPackage:    'Kit fiyatı, kit kartının kendi (Genel Liste) satış fiyatından, satış anında çözülür.',
        ListComponent:  'Kit fiyatı, bileşenlerin fiyat listesindeki satış fiyatları × miktar toplamından, satış anında çözülür.'
    };
    function setPriceMode(mode) {
        mode = KIT_PRICE_MODE_LEGACY[mode] || mode;
        if (KIT_PRICE_MODES.indexOf(mode) === -1) mode = 'FixedPackage';
        priceMode = mode;
        Array.prototype.forEach.call($('kePriceModeSeg').children, function (b) {
            b.classList.toggle('is-active', b.getAttribute('data-mode') === priceMode);
        });
        var isFixedPackage = priceMode === 'FixedPackage';
        $('keFixedPriceLabel').style.display = isFixedPackage ? '' : 'none';
        $('keFixedPriceWrap').style.display = isFixedPackage ? '' : 'none';
        $('kePriceModeHint').textContent = KIT_PRICE_MODE_HINTS[priceMode];
        $('keTable').classList.toggle('ke-mode-fixedcomponent', priceMode === 'FixedComponent');
        $('keAddrow').classList.toggle('ke-mode-fixedcomponent', priceMode === 'FixedComponent');
    }
    $('kePriceModeSeg').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-mode]');
        if (b) {
            setPriceMode(b.getAttribute('data-mode'));
            markDirty();
            if (priceMode === 'FixedPackage') keAutofillFixedPriceFromList(false);
        }
    });
    $('keFixedPrice').addEventListener('input', markDirty);
    $('keDescription').addEventListener('input', markDirty);

    // Sabit Paket birim fiyatı Genel (varsayılan) fiyat listesinden OTOMATİK doldurulur ama
    // DÜZENLENEBİLİR — alan boşsa yazılır, kayıtlı/elle girilmiş değer EZİLMEZ.
    function keAutofillFixedPriceFromList(force) {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) return;
        var el = $('keFixedPrice');
        if (!el) return;
        if (!force && String(el.value || '').trim() !== '') return;   // dolu → dokunma
        var csrf = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        fetch('/Sales/ResolveLinePrices', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify({ currencyId: 1, direction: 's', keys: [{ itemId: KIT_ITEM_ID }] })
        })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (rows) {
            if (!Array.isArray(rows) || !rows.length) return;
            var p = rows[0] ? rows[0].price : null;
            if (p == null) return;
            if (force || String(el.value || '').trim() === '') el.value = p;
        })
        .catch(function () { /* liste yoksa/erisilemezse sessiz — elle giris serbest */ });
    }

    // ── Bileşen listesi render ──
    function renderLines() {
        var body = $('keLinesBody');
        body.innerHTML = '';
        $('keEmpty').style.display = lines.length ? 'none' : '';
        lines.forEach(function (l, i) {
            var tr = document.createElement('tr');

            var tdNo = document.createElement('td'); tdNo.textContent = (i + 1); tr.appendChild(tdNo);
            var tdCode = document.createElement('td'); tdCode.innerHTML = '<span class="ke-code"></span>';
            tdCode.querySelector('.ke-code').textContent = l.code; tr.appendChild(tdCode);

            var tdName = document.createElement('td');
            tdName.textContent = l.name || '';
            if (l.configCode) {
                tdName.appendChild(document.createElement('br'));
                var badge = document.createElement('span');
                badge.className = 'ke-comb-badge';
                badge.textContent = 'Kombinasyon: ' + l.configCode;
                badge.title = 'Değiştirmek için tıklayın';
                badge.style.cursor = 'pointer';
                badge.addEventListener('click', function () {
                    keOpenComboPicker(l.code, {
                        materialName: l.name || '',
                        currentCode: l.configCode,
                        onApply: function (configId, code) {
                            l.configId = configId; l.configCode = code;
                            markDirty(); renderLines();
                        }
                    });
                });
                tdName.appendChild(badge);
            }
            tr.appendChild(tdName);

            var tdQty = document.createElement('td'); tdQty.className = 'ke-qty-cell';
            var qtyInput = document.createElement('input');
            qtyInput.type = 'number'; qtyInput.className = 'ke-input'; qtyInput.value = l.quantity;
            qtyInput.min = '0'; qtyInput.step = 'any'; qtyInput.style.padding = '5px 8px';
            qtyInput.addEventListener('change', function () {
                var v = parseFloat(qtyInput.value.replace(',', '.'));
                l.quantity = (isFinite(v) && v > 0) ? v : 1;
                qtyInput.value = l.quantity;
                markDirty();
            });
            tdQty.appendChild(qtyInput); tr.appendChild(tdQty);

            var tdUnit = document.createElement('td');
            tdUnit.style.color = 'var(--ke-muted)'; tdUnit.style.fontSize = '.8rem';
            tdUnit.textContent = l.unitCode || '—';
            tr.appendChild(tdUnit);

            // Yalnız FixedComponent modda görünür (CSS .ke-col-price)
            var tdPrice = document.createElement('td'); tdPrice.className = 'ke-col-price ke-qty-cell';
            var priceInput = document.createElement('input');
            priceInput.type = 'number'; priceInput.className = 'ke-input'; priceInput.step = 'any'; priceInput.min = '0';
            priceInput.placeholder = '0,00'; priceInput.style.padding = '5px 8px';
            priceInput.value = (l.unitPrice != null) ? l.unitPrice : '';
            priceInput.addEventListener('change', function () {
                var v = parseFloat(priceInput.value.replace(',', '.'));
                l.unitPrice = (isFinite(v) && v >= 0) ? v : null;
                priceInput.value = (l.unitPrice != null) ? l.unitPrice : '';
                markDirty();
            });
            tdPrice.appendChild(priceInput); tr.appendChild(tdPrice);

            var tdNote = document.createElement('td');
            var noteInput = document.createElement('input');
            noteInput.type = 'text'; noteInput.className = 'ke-input'; noteInput.value = l.note || '';
            noteInput.placeholder = '—'; noteInput.style.padding = '5px 8px';
            noteInput.addEventListener('change', function () { l.note = noteInput.value; markDirty(); });
            tdNote.appendChild(noteInput); tr.appendChild(tdNote);

            var tdX = document.createElement('td');
            var x = document.createElement('button'); x.type = 'button'; x.className = 'ke-x'; x.title = 'Çıkar';
            x.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
            x.addEventListener('click', function () { lines.splice(i, 1); markDirty(); renderLines(); });
            tdX.appendChild(x); tr.appendChild(tdX);

            body.appendChild(tr);
        });
        $('keCount').textContent = lines.length + ' bileşen';
    }

    // ── Stok kodu çözümleme (StockLookup) ──
    function resolveComp(code, cb) {
        code = (code || '').trim();
        if (!code) { cb(null); return; }
        fetch('/Logistics/StockLookup?q=' + encodeURIComponent(code), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                var m = (list || []).find(function (s) { return (s.code || '').toLowerCase() === code.toLowerCase(); });
                cb(m || null);
            })
            .catch(function () { cb(null); });
    }

    // ── Ölçü birimi seçimi ──
    // Malzemenin ana birimi + tanımlı çevrim birimleri /Warehouse/GetMaterialUnitsJson'dan gelir
    // (belge kalem grid'indeki "farklı birimden giriş" ile aynı endpoint/veri kaynağı).
    // ItemKitLine.UnitId kolonu MEVCUT — seçim kalıcı saklanır.
    var keCompUnitOptions = [];   // [{ id, code, name }]
    function keLoadUnitsForCode(code) {
        var sel = $('keCompUnit');
        keCompUnitOptions = [];
        sel.innerHTML = ''; sel.disabled = true;
        if (!code) return;
        fetch('/Warehouse/GetMaterialUnitsJson?materialCode=' + encodeURIComponent(code), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                keCompUnitOptions = Array.isArray(list) ? list : [];
                if (!keCompUnitOptions.length) return;
                keCompUnitOptions.forEach(function (u) {
                    var opt = document.createElement('option');
                    opt.value = String(u.id);
                    opt.textContent = u.name && u.name !== u.code ? (u.code + ' — ' + u.name) : u.code;
                    sel.appendChild(opt);
                });
                sel.disabled = false;   // ilk seçenek (malzemenin ana birimi) varsayılan seçili gelir
            })
            .catch(function () { keCompUnitOptions = []; });
    }

    // ── Kombinasyon seçimi ──
    // DocumentEdit'teki satış kalemi kombinasyon seçimiyle AYNI mekanizma
    // (window.CalibraHub.openCombinationPicker → React CombinationPickerModal).
    var keCompSelectedMaterial = null;   // { id, code, name, hasConfig, unitId, unitCode }
    var keCompCombo = null;              // { configId, code, details }

    function keOpenComboPicker(materialCode, opts, retriesLeft) {
        if (retriesLeft === undefined) retriesLeft = 15;
        if (!window.CalibraHub || typeof window.CalibraHub.openCombinationPicker !== 'function') {
            if (retriesLeft > 0) { setTimeout(function () { keOpenComboPicker(materialCode, opts, retriesLeft - 1); }, 200); return; }
            showMsg('Kombinasyon seçici yüklenemedi, sayfayı yenileyin.', true);
            return;
        }
        window.CalibraHub.openCombinationPicker(materialCode, opts);
    }

    function updateComboButton() {
        var btn = $('keCompCombo');
        var trackable = !!(keCompSelectedMaterial && keCompSelectedMaterial.hasConfig);
        btn.disabled = !trackable;
        btn.classList.toggle('is-set', trackable && !!keCompCombo);
        if (!trackable) {
            btn.textContent = 'Seç...';
            btn.title = keCompSelectedMaterial ? 'Bu malzemede kombinasyon takibi yok' : 'Önce stok kodu seçin';
        } else if (keCompCombo) {
            btn.textContent = keCompCombo.code;
            btn.title = 'Seçili kombinasyon: ' + keCompCombo.code + ' — değiştirmek için tıklayın';
        } else {
            btn.textContent = 'Kombinasyon Seç...';
            btn.title = 'Kombinasyon seçmek için tıklayın';
        }
    }

    function setSelectedMaterial(m, autoOpen) {
        keCompSelectedMaterial = m || null;
        keCompCombo = null;
        updateComboButton();
        keLoadUnitsForCode(m ? m.code : null);
        if (autoOpen && m && m.hasConfig) {
            keOpenComboPicker(m.code, {
                materialName: m.name || '',
                onApply: function (configId, code, details) {
                    keCompCombo = { configId: configId, code: code, details: details || [] };
                    updateComboButton();
                    var qtyEl = $('keCompQty'); qtyEl.focus(); try { qtyEl.select(); } catch (e) {}
                }
            });
        }
    }

    $('keCompCombo').addEventListener('click', function () {
        if (!keCompSelectedMaterial || !keCompSelectedMaterial.hasConfig) return;
        keOpenComboPicker(keCompSelectedMaterial.code, {
            materialName: keCompSelectedMaterial.name || '',
            currentCode: keCompCombo ? keCompCombo.code : null,
            currentDetails: keCompCombo ? keCompCombo.details : [],
            onApply: function (configId, code, details) {
                keCompCombo = { configId: configId, code: code, details: details || [] };
                updateComboButton();
            }
        });
    });

    $('keCompCode').addEventListener('change', function () {
        resolveComp($('keCompCode').value, function (m) {
            $('keCompName').value = m ? (m.name || '') : '';
            setSelectedMaterial(m, false);
        });
    });

    // ── Stok kodu rehberi (autocomplete dropdown) ──
    var ddItems  = [];
    var ddActive = -1;
    var ddTimer  = null;
    var ddSeq    = 0;    // yarış koşulu koruması — yalnız son isteği kabul et

    function ddIsOpen() { return $('keCompDD').style.display !== 'none'; }

    function closeDD() {
        ddItems = []; ddActive = -1;
        var dd = $('keCompDD'); dd.style.display = 'none'; dd.innerHTML = '';
        $('keCompCode').setAttribute('aria-expanded', 'false');
    }

    function renderDD() {
        var dd = $('keCompDD'); dd.innerHTML = '';
        if (ddItems.length === 0) {
            dd.innerHTML = '<div class="ke-dd-msg">Eşleşen stok bulunamadı</div>';
        } else {
            ddItems.forEach(function (m, i) {
                var it = document.createElement('div');
                it.className = 'ke-dd-item' + (i === ddActive ? ' is-active' : '');
                it.setAttribute('role', 'option');
                var c = document.createElement('div'); c.className = 'ke-dd-code'; c.textContent = m.code || '';
                var n = document.createElement('div'); n.className = 'ke-dd-name'; n.textContent = m.name || '';
                it.appendChild(c); it.appendChild(n);
                // mousedown: input blur'undan ÖNCE seç (blur dropdown'ı kapatır)
                it.addEventListener('mousedown', function (e) { e.preventDefault(); selectDD(m); });
                dd.appendChild(it);
            });
        }
        dd.style.display = ''; $('keCompCode').setAttribute('aria-expanded', 'true');
    }

    function selectDD(m) {
        $('keCompCode').value = m.code || '';
        $('keCompName').value = m.name || '';
        closeDD();
        setSelectedMaterial(m, true);
        if (!m.hasConfig) {
            var qtyEl = $('keCompQty'); qtyEl.focus(); try { qtyEl.select(); } catch (e) {}
        }
    }

    // ── Standart stok rehberi (Tip 1) ──
    function keApplyPickedCode(code, display) {
        code = (code || '').trim();
        if (!code) return;
        $('keCompCode').value = code;
        $('keCompName').value = display || '';
        closeDD();
        resolveComp(code, function (m) {
            if (!m) { setSelectedMaterial(null); showMsg('"' + code + '" kodlu stok bulunamadı.', true); return; }
            $('keCompName').value = m.name || display || '';
            setSelectedMaterial(m, true);
            if (!m.hasConfig) {
                var qtyEl = $('keCompQty'); qtyEl.focus(); try { qtyEl.select(); } catch (e) {}
            }
        });
    }

    function keOpenGuideLookup(retriesLeft) {
        if (retriesLeft === undefined) retriesLeft = 15;
        if (!window.CalibraHub || typeof window.CalibraHub.openGuideLookup !== 'function') {
            if (retriesLeft > 0) { setTimeout(function () { keOpenGuideLookup(retriesLeft - 1); }, 200); return; }
            showMsg('Stok rehberi yüklenemedi, sayfayı yenileyin.', true);
            return;
        }
        window.CalibraHub.openGuideLookup('ITEMS', {
            guideLabel: 'Stok Kartı',
            onPick: function (row) {
                keApplyPickedCode(row && row.value, row && row.display);
            }
        });
    }
    $('keCompGuideBtn').addEventListener('click', function () { keOpenGuideLookup(); });

    function searchDD(q) {
        q = (q || '').trim();
        if (!q) { closeDD(); return; }
        var seq = ++ddSeq;
        fetch('/Logistics/StockLookup?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                if (seq !== ddSeq) return;   // eski (yarışan) istek — yoksay
                var kitLc = (KIT_CODE || '').toLowerCase();  // kit kendi bileşeni olamaz
                ddItems = (list || []).filter(function (s) { return (s.code || '').toLowerCase() !== kitLc; });
                ddActive = ddItems.length ? 0 : -1;
                renderDD();
            })
            .catch(function () { if (seq === ddSeq) closeDD(); });
    }

    function ddMove(delta) {
        if (ddItems.length === 0) return;
        ddActive = (ddActive + delta + ddItems.length) % ddItems.length;
        var dd = $('keCompDD');
        Array.prototype.forEach.call(dd.children, function (c, i) { c.classList.toggle('is-active', i === ddActive); });
        var el = dd.children[ddActive];
        if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
    }

    $('keCompCode').addEventListener('input', function () {
        $('keCompName').value = '';   // kod değişti → eski ad artık geçersiz
        setSelectedMaterial(null);    // kombinasyon seçimi de geçersiz — yeniden çöz
        var v = $('keCompCode').value;
        clearTimeout(ddTimer);
        ddTimer = setTimeout(function () { searchDD(v); }, 160);
    });
    $('keCompCode').addEventListener('focus', function () {
        var v = ($('keCompCode').value || '').trim();
        if (v) searchDD(v);
    });
    $('keCompCode').addEventListener('blur', function () { setTimeout(closeDD, 150); });
    $('keCompCode').addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') {
            if (ddIsOpen()) ddMove(1); else searchDD($('keCompCode').value);
            e.preventDefault();
        } else if (e.key === 'ArrowUp') {
            if (ddIsOpen()) { ddMove(-1); e.preventDefault(); }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (ddIsOpen() && ddActive >= 0 && ddItems[ddActive]) selectDD(ddItems[ddActive]);
            else addComponent();
        } else if (e.key === 'Escape') {
            if (ddIsOpen()) { closeDD(); e.preventDefault(); }
        }
    });

    // addComponent() bir Promise<{ok, message}> döner — hem Enter/Ekle akışında (sonuç yoksayılır,
    // hata zaten showMsg ile gösterilir) hem save() öncesi "çubukta yarım kalan giriş var mı"
    // kontrolünde (bkz. save()) kullanılır — kullanıcının yazdığı ama eklemediği satır sessizce kaybolmasın.
    function addComponent() {
        return new Promise(function (resolve) {
            var code = ($('keCompCode').value || '').trim();
            if (!code) { showMsg('Bileşen kodu girin.', true); $('keCompCode').focus(); resolve({ ok: false, message: 'Bileşen kodu girin.' }); return; }
            if (lines.some(function (l) { return l.code.toLowerCase() === code.toLowerCase(); })) {
                showMsg('Bu bileşen zaten eklenmiş.', true); resolve({ ok: false, message: 'Bu bileşen zaten eklenmiş.' }); return;
            }
            var qty = parseFloat(($('keCompQty').value || '1').replace(',', '.'));
            if (!isFinite(qty) || qty <= 0) qty = 1;
            var note = ($('keCompNote').value || '').trim();

            var unitPrice = null;
            if (priceMode === 'FixedComponent') {
                var pv = parseFloat(($('keCompPrice').value || '').replace(',', '.'));
                if (!isFinite(pv) || pv < 0) {
                    showMsg('Sabit Bileşen Fiyatı modunda birim fiyat girin.', true);
                    $('keCompPrice').focus(); try { $('keCompPrice').select(); } catch (e) {}
                    resolve({ ok: false, message: 'Sabit Bileşen Fiyatı modunda birim fiyat girin.' });
                    return;
                }
                unitPrice = pv;
            }

            resolveComp(code, function (m) {
                if (!m) { showMsg('"' + code + '" kodlu stok bulunamadı.', true); resolve({ ok: false, message: '"' + code + '" kodlu stok bulunamadı.' }); return; }
                // Seçili kombinasyon yalnız hâlâ AYNI malzemeye aitse taşınır — kod elle
                // değiştirilip Enter'a doğrudan basılırsa eski kombinasyon yeni satıra sızmaz.
                var combo = (keCompCombo && keCompSelectedMaterial &&
                             (keCompSelectedMaterial.code || '').toLowerCase() === (m.code || '').toLowerCase())
                    ? keCompCombo : null;
                var unitSel = $('keCompUnit');
                var unitOpt = (!unitSel.disabled && keCompSelectedMaterial &&
                               (keCompSelectedMaterial.code || '').toLowerCase() === (m.code || '').toLowerCase())
                    ? keCompUnitOptions.find(function (u) { return String(u.id) === unitSel.value; })
                    : null;
                lines.push({
                    code: m.code || code, name: m.name || $('keCompName').value || '', quantity: qty, note: note,
                    configId: combo ? combo.configId : null,
                    configCode: combo ? combo.code : null,
                    unitPrice: unitPrice,
                    unitId: unitOpt ? unitOpt.id : null,
                    unitCode: unitOpt ? unitOpt.code : null
                });
                markDirty();
                renderLines();
                $('keCompCode').value = ''; $('keCompName').value = ''; $('keCompQty').value = '1';
                $('keCompPrice').value = ''; $('keCompNote').value = '';
                setSelectedMaterial(null);
                $('keCompCode').focus();
                resolve({ ok: true });
            });
        });
    }
    $('keCompAdd').addEventListener('click', addComponent);

    // ── Ekleme çubuğu aç/kapa — "+ Yeni Bileşen" listenin altında tek giriş noktasıdır ──
    function openAddBar() {
        $('keAddrow').classList.add('is-open');
        $('keAddNewRow').style.display = 'none';
        focusAndSelect('keCompCode');
    }
    function closeAddBar() {
        $('keAddrow').classList.remove('is-open');
        $('keAddNewRow').style.display = '';
    }
    $('keAddNewBtn').addEventListener('click', openAddBar);
    $('keAddCloseBtn').addEventListener('click', closeAddBar);

    // ── Enter zinciri (belge kalem girişindeki akışa benzer) ──
    function focusAndSelect(id) {
        var el = $(id); if (!el) return;
        el.focus(); try { el.select(); } catch (e) {}
    }
    $('keCompQty').addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        focusAndSelect(priceMode === 'FixedComponent' ? 'keCompPrice' : 'keCompNote');
    });
    $('keCompPrice').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); focusAndSelect('keCompNote'); }
    });
    $('keCompNote').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); addComponent(); }
    });

    // ── Yükleme ──
    function loadKit() {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) {
            setPriceMode('FixedPackage'); lines = []; renderLines(); dirty = false;
            return Promise.resolve();
        }
        return fetch('/Logistics/GetKit?itemId=' + KIT_ITEM_ID, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { found: false }; })
            .then(function (d) {
                if (d && d.found) {
                    if (d.itemCode) KIT_CODE = d.itemCode;
                    if (d.itemName) KIT_NAME = d.itemName;
                    setPriceMode(d.priceMode || 'FixedPackage');
                    $('keFixedPrice').value = (d.fixedPrice != null) ? d.fixedPrice : '';
                    $('keDescription').value = d.description || '';
                    lines = (d.lines || []).map(function (l) {
                        return {
                            code: l.componentMaterialCode, name: l.componentMaterialName, quantity: l.quantity, note: l.note || '',
                            configId: l.configId || null, configCode: l.componentConfigCode || null,
                            unitPrice: (l.unitPrice != null) ? l.unitPrice : null,
                            unitId: l.unitId || null, unitCode: l.unit || null
                        };
                    });
                    var ver = $('keHeaderVer');
                    ver.style.display = ''; ver.textContent = 'v' + (d.versionNo || 1);
                } else {
                    setPriceMode('FixedPackage');
                    lines = [];
                    $('keHeaderVer').style.display = 'none';
                }
                renderLines();
                dirty = false;   // taze yüklendi — kullanıcı henüz değiştirmedi
                if (priceMode === 'FixedPackage') keAutofillFixedPriceFromList(false);
            })
            .catch(function () { setPriceMode('FixedPackage'); renderLines(); dirty = false; });
    }

    // ── Kaydet — malzeme kartının Kaydet'i tarafından çağrılır ──
    // Ekleme çubuğu açıkken kullanıcı bir kod yazıp Ekle'ye basmadan Kaydet'e geçebilir;
    // yarım kalan girişi sessizce kaybetmemek için önce onu eklemeyi dene (bkz. addComponent).
    function save() {
        var pendingCode = ($('keCompCode').value || '').trim();
        if (pendingCode) {
            return addComponent().then(function (res) {
                if (!res.ok) return { ok: false, message: 'Ekleme çubuğunda tamamlanmamış bir bileşen var: ' + (res.message || '') };
                return doSave();
            });
        }
        return doSave();
    }

    function doSave() {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) {
            return Promise.resolve({ ok: false, message: 'Önce malzeme kartını kaydedin.' });
        }
        if (lines.length === 0) {
            return Promise.resolve({ ok: false, message: 'Kit içinde en az bir bileşen olmalı.' });
        }

        var fixedPrice = null;
        if (priceMode === 'FixedPackage') {
            var fp = parseFloat(($('keFixedPrice').value || '').replace(',', '.'));
            fixedPrice = isFinite(fp) ? fp : null;
        }
        var payload = {
            id: null,
            itemId: KIT_ITEM_ID,
            materialCode: KIT_CODE || null,
            priceMode: priceMode,
            fixedPrice: fixedPrice,
            description: ($('keDescription').value || '').trim() || null,
            lines: lines.map(function (l) {
                return {
                    itemId: 0,
                    componentMaterialCode: l.code,
                    configId: l.configId || null,
                    componentConfigCode: l.configCode || null,
                    quantity: l.quantity,
                    note: l.note || null,
                    unitPrice: (priceMode === 'FixedComponent' && l.unitPrice != null) ? l.unitPrice : null,
                    unitId: l.unitId || null,
                    unit: l.unitCode || null
                };
            })
        };

        var csrf = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        return fetch('@Url.Action("SaveKit", "Kit")', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
            if (res.ok && res.d && res.d.success) {
                dirty = false;
                return loadKit().then(function () {
                    return { ok: true, count: lines.length };
                });
            }
            return { ok: false, message: (res.d && res.d.message) || 'Kit kaydedilirken hata oluştu.' };
        })
        .catch(function () { return { ok: false, message: 'Sunucuya ulaşılamadı (kit içeriği).' }; });
    }

    // ── Dışa açılan API (MaterialCardEdit kullanır) ──
    window.mceKitEditorInit = function (itemId, code, name) {
        KIT_ITEM_ID = parseInt(itemId, 10) || 0;
        KIT_CODE = code || '';
        KIT_NAME = name || '';
        return loadKit();
    };
    window.mceKitEditorIsDirty = function () { return !!dirty; };
    window.mceKitEditorSave = save;
    window.mceKitEditorLineCount = function () { return lines.length; };
})();
</script>
