@*
    _KitEditorPane — Kit (paket ürün) içerik editörü, GÖMÜLÜ pane olarak.

    2026-08-06 (kullanıcı isteği): "kit içeriği için ayrı bir sayfa olmasın, stok kartının
    kit içeriği sayfasından gerekli tanımlamaları yapabilelim". Editör eskiden ayrı bir
    sayfaydı (/Logistics/KitEdit); artık Malzeme Kartı → "Kit İçeriği" sekmesine gömülür.
    Ayrı sayfanın kendi topbar'ı (Geri / Kaydet) ve yönlendirme mantığı BURADA YOKTUR —
    kayıt, malzeme kartının tek Kaydet butonuna bağlanır.

    Dışa açtığı API (MaterialCardEdit kullanır):
      window.mceKitEditorInit(itemId, code, name)  → kiti yükle/yenile
      window.mceKitEditorIsDirty()                 → kullanıcı bu sekmede değişiklik yaptı mı
      window.mceKitEditorSave()                    → Promise<{ok, message, count, versionNo}>

    ÖNEMLİ — VersionNo: repository her UpdateKit'te VersionNo'yu artırır. Bu yüzden malzeme
    kartı her kaydedildiğinde kit kaydedilmez; yalnız IsDirty() true iken kaydedilir, aksi
    halde dokunulmayan kitin versiyonu boşuna şişerdi.
*@
<style>
    /* Kit editörü — 'ke-' prefix (mce- ile çakışmaz). Light default → dark override. */
    .ke-embed {
        color-scheme: light;
        --ke-surface:   var(--app-surface);
        --ke-surface-2: var(--app-muted-surface);
        --ke-border:    var(--app-border);
        --ke-text:      var(--app-text);
        --ke-muted:     var(--app-text-muted);
        --ke-primary:   #6366f1;
        --ke-primary-weak: rgba(99,102,241,.10);
        --ke-danger:    #e11d48;
        --ke-ok:        #059669;
        display: flex; flex-direction: column; gap: 12px;
        color: var(--ke-text); font-size: 14px;
    }
    body.app-theme-dark .ke-embed {
        color-scheme: dark;
        --ke-primary-weak: rgba(99,102,241,.16);
    }

    .ke-embed .ke-btn {
        display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
        border: 1px solid var(--ke-border); background: var(--ke-surface-2);
        color: var(--ke-text); border-radius: 9px; padding: 8px 15px;
        font-size: .82rem; font-weight: 600; transition: all .15s;
    }
    .ke-embed .ke-btn:hover { border-color: var(--ke-primary); }
    .ke-embed .ke-btn--primary { background: var(--ke-primary); border-color: var(--ke-primary); color: #fff; }
    .ke-embed .ke-btn--primary:hover { filter: brightness(1.06); }
    .ke-embed .ke-btn--sm { padding: 6px 11px; font-size: .78rem; }
    .ke-embed .ke-btn:disabled { opacity: .5; cursor: not-allowed; }

    .ke-embed .ke-card {
        background: var(--ke-surface); border: 1px solid var(--ke-border);
        border-radius: 13px; padding: 14px 16px;
    }
    .ke-embed .ke-card__title { margin: 0 0 10px; font-size: .92rem; font-weight: 700; }

    .ke-embed .ke-grid { display: grid; grid-template-columns: 160px 1fr; gap: 10px 14px; align-items: center; max-width: 1040px; }
    .ke-embed .ke-label { font-size: .8rem; font-weight: 600; color: var(--ke-muted); }
    .ke-embed .ke-input {
        width: 100%; box-sizing: border-box; background: var(--ke-surface-2);
        border: 1px solid var(--ke-border); border-radius: 8px; padding: 7px 10px;
        color: var(--ke-text); font-size: .84rem; font-family: inherit;
    }
    .ke-embed .ke-input:focus { outline: none; border-color: var(--ke-primary); box-shadow: 0 0 0 3px var(--ke-primary-weak); }
    .ke-embed .ke-input[readonly] { background: transparent; color: var(--ke-muted); }
    .ke-embed textarea.ke-input { resize: vertical; min-height: 44px; }

    /* Fiyat modu segment kontrolü */
    .ke-embed .ke-seg { display: inline-flex; flex-wrap: wrap; background: var(--ke-surface-2); border: 1px solid var(--ke-border); border-radius: 9px; padding: 3px; gap: 3px; }
    .ke-embed .ke-seg button {
        border: 0; background: transparent; color: var(--ke-muted); cursor: pointer;
        padding: 7px 13px; border-radius: 7px; font-size: .78rem; font-weight: 600; transition: all .15s; white-space: nowrap;
    }
    .ke-embed .ke-seg button.is-active { background: var(--ke-primary); color: #fff; }

    /* Bileşen giriş satırı — HEP görünür, kartın en üstünde. Eklenen bileşenler bu satırın
       ALTINA aynı kolon düzeninde (ke-field genişlikleri ortak) satır satır dizilir; ayrı
       tablo/başlık yok. Fiyat alanı yalnız FixedComponent modda görünür. */
    /* TEK kolon şablonu: giriş satırı ve eklenen satırlar aynı grid'i paylaşır → kolonlar
       birebir hizalı kalır ve fiyat kolonu açılınca satır ALT SATIRA TAŞMAZ (flex-wrap yerine
       grid; gizli .ke-field--price grid akışından çıkar, şablon moda göre değişir). */
    /* Kolonlar ESNEK (minmax(0,fr)) — sabit px kullanılmaz; böylece dar kapsayıcıda da
       satır TAŞMAZ/kaymaz, fiyat kolonu açılınca diğerleri orantılı daralır. */
    .ke-embed .ke-head,
    .ke-embed .ke-line {
        display: grid;
        grid-template-columns:
            minmax(0, 1.25fr)   /* Stok Kodu */
            minmax(0, 1.2fr)    /* Stok Adı */
            minmax(0, 0.95fr)   /* Kombinasyon */
            minmax(0, 0.7fr)    /* Miktar */
            minmax(0, 0.8fr)    /* Ölçü Birimi */
            minmax(0, 1.25fr)   /* Açıklama */
            84px;               /* Aksiyon */
        gap: 8px;
    }
    .ke-embed .ke-head { align-items: end; padding-bottom: 4px; }
    .ke-embed .ke-head.ke-mode-fixedcomponent,
    .ke-embed .ke-lines.ke-mode-fixedcomponent .ke-line {
        grid-template-columns:
            minmax(0, 1.15fr)   /* Stok Kodu */
            minmax(0, 1.1fr)    /* Stok Adı */
            minmax(0, 0.9fr)    /* Kombinasyon */
            minmax(0, 0.65fr)   /* Miktar */
            minmax(0, 0.72fr)   /* Ölçü Birimi */
            minmax(0, 0.8fr)    /* Birim Fiyat */
            minmax(0, 1.15fr)   /* Açıklama */
            84px;               /* Aksiyon */
    }
    .ke-embed .ke-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ke-embed .ke-field > span {
        font-size: .72rem; font-weight: 600; color: var(--ke-muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ke-embed .ke-field--price { display: none; }
    .ke-embed .ke-head.ke-mode-fixedcomponent .ke-field--price { display: flex; }
    /* Satirlarda alan etiketleri YOK (basliklar ustte) — dikey bosluk yemesin. */
    .ke-embed .ke-line .ke-field { justify-content: center; }
    .ke-embed .ke-addline { margin-top: 10px; }
    .ke-embed .ke-empty {
        padding: 14px 2px; font-size: .82rem; color: var(--ke-muted);
        border-top: 1px dashed var(--ke-border);
    }
    .ke-embed .ke-field--actions { flex-direction: row; align-items: end; justify-content: flex-end; gap: 6px; }
    .ke-embed .ke-line .ke-field--actions { align-items: center; }

    /* Eklenen bileşen satırları */
    .ke-embed .ke-lines { display: flex; flex-direction: column; margin-top: 6px; }
    .ke-embed .ke-line { align-items: center; padding: 6px 0; border-top: 1px dashed var(--ke-border); }
    .ke-embed .ke-lines .ke-field--price { display: none; }
    .ke-embed .ke-lines.ke-mode-fixedcomponent .ke-field--price { display: flex; }
    .ke-embed .ke-line .ke-ro {
        font-size: .84rem; padding: 6px 2px; min-width: 0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ke-embed .ke-line .ke-ro--muted { color: var(--ke-muted); }

    .ke-embed .ke-combo-btn { width: 100%; justify-content: center; }
    .ke-embed .ke-combo-btn.is-set { border-color: var(--ke-ok); color: var(--ke-ok); }
    .ke-embed .ke-combo-btn:disabled { opacity: .45; }

    /* Stok kodu — Tip-1 standart rehber (mountLookupForInput/LookupCard) */
    .ke-embed .ke-lookup { position: relative; }
    .ke-embed .ke-lookup .gl-wrapper { width: 100%; }

    .ke-embed .ke-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; color: var(--ke-primary); }
    .ke-embed .ke-comb-badge {
        display: inline-block; margin-top: 3px; padding: 2px 8px; border-radius: 999px;
        font-size: .68rem; font-weight: 700; background: var(--ke-primary-weak); color: var(--ke-primary);
    }
    .ke-embed .ke-x {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 7px; cursor: pointer;
        border: 1px solid var(--ke-border); background: var(--ke-surface-2); color: var(--ke-danger);
    }
    .ke-embed .ke-x:hover { background: var(--ke-danger); color: #fff; border-color: var(--ke-danger); }

    .ke-embed .ke-badge {
        display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px;
        font-size: .72rem; font-weight: 700; background: var(--ke-primary-weak); color: var(--ke-primary);
    }
    .ke-embed .ke-hint { font-size: .74rem; color: var(--ke-muted); margin-top: 8px; }

    /* Toast — sayfa geneline sabit (malzeme kartının kendi mesajından bağımsız) */
    .ke-msg {
        position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%) translateY(20px);
        padding: 11px 20px; border-radius: 10px; font-size: .85rem; font-weight: 600;
        background: #059669; color: #fff; opacity: 0; pointer-events: none; transition: all .25s; z-index: 60;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .ke-msg.is-show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .ke-msg.is-err { background: #e11d48; }

    /* ── Revizyon geçmişi modalı (salt-okunur) ──
       Ölçü SABİT (CLAUDE.md "Modal boyut sabitliği"): revizyon seçtikçe içerik
       değişir ama kabuk büyüyüp küçülmez; taşan içerik kendi içinde kayar. */
    .ke-embed .ke-ver-badge { cursor: pointer; border: 1px solid transparent; }
    .ke-embed .ke-ver-badge:hover { border-color: var(--ke-primary); }

    .ikh-backdrop {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 70;
        background: rgba(15, 23, 42, .55); backdrop-filter: blur(2px);
        display: flex; align-items: center; justify-content: center;
    }
    .ikh-box {
        width: min(920px, calc(100vw - 96px));
        height: min(580px, calc(100vh - 64px));
        display: flex; flex-direction: column;
        background: var(--ke-surface); color: var(--ke-text);
        border: 1px solid var(--ke-border); border-radius: 14px;
        box-shadow: 0 24px 60px rgba(0,0,0,.32); overflow: hidden;
    }
    .ikh-head {
        display: flex; align-items: center; gap: 10px;
        padding: 13px 16px; border-bottom: 1px solid var(--ke-border);
    }
    .ikh-head h3 { margin: 0; font-size: .95rem; font-weight: 700; }
    .ikh-head .ikh-sub { font-size: .76rem; color: var(--ke-muted); }
    .ikh-close {
        margin-left: auto; width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
        border: 1px solid var(--ke-border); background: var(--ke-surface-2); color: var(--ke-muted);
        display: inline-flex; align-items: center; justify-content: center;
    }
    .ikh-close:hover { color: var(--ke-danger); border-color: var(--ke-danger); }

    .ikh-body { flex: 1; min-height: 0; display: flex; }
    /* Sol ray HER ZAMAN mount ve sabit genişlikte — koşullu mount layout shift üretir. */
    .ikh-rail {
        width: 246px; flex: 0 0 246px; min-height: 0; overflow-y: auto;
        border-right: 1px solid var(--ke-border); background: var(--ke-surface-2);
    }
    .ikh-rev {
        width: 100%; text-align: left; cursor: pointer; padding: 9px 12px;
        border: none; border-bottom: 1px solid var(--ke-border); background: transparent; color: inherit;
        display: flex; flex-direction: column; gap: 2px;
    }
    .ikh-rev:hover { background: var(--ke-primary-weak); }
    .ikh-rev.is-active { background: var(--ke-primary-weak); box-shadow: inset 3px 0 0 var(--ke-primary); }
    .ikh-rev b { font-size: .82rem; font-weight: 700; color: var(--ke-primary); }
    .ikh-rev span { font-size: .72rem; color: var(--ke-muted); }

    .ikh-detail { flex: 1; min-width: 0; min-height: 0; overflow-y: auto; padding: 14px 16px; }
    .ikh-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 12px; }
    .ikh-meta div { font-size: .78rem; }
    .ikh-meta div b { display: block; font-size: .7rem; font-weight: 600; color: var(--ke-muted); }
    .ikh-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
    .ikh-table th {
        text-align: left; font-size: .7rem; font-weight: 600; color: var(--ke-muted);
        padding: 6px 8px; border-bottom: 1px solid var(--ke-border); white-space: nowrap;
    }
    .ikh-table td { padding: 6px 8px; border-bottom: 1px dashed var(--ke-border); }
    .ikh-table td.ikh-num { text-align: right; font-variant-numeric: tabular-nums; }
    .ikh-table td.ikh-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; color: var(--ke-primary); }
    .ikh-empty { padding: 26px 10px; text-align: center; font-size: .82rem; color: var(--ke-muted); }

    /* Dar ekran — kolonlar 2'li bloklara iner (giriş ve satırlar yine hizalı kalır). */
    @@media (max-width: 720px) {
        .ke-embed .ke-grid { grid-template-columns: 1fr; max-width: none; }
        .ke-embed .ke-head, .ke-embed .ke-line,
        .ke-embed .ke-head.ke-mode-fixedcomponent,
        .ke-embed .ke-lines.ke-mode-fixedcomponent .ke-line {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<div class="ke-embed" id="keEmbedRoot">

    <!-- Kit bilgi + fiyatlandırma -->
    <div class="ke-card">
        <p class="ke-card__title">Paket Bilgileri</p>
        <div class="ke-grid">
            <label class="ke-label">Fiyat Modu</label>
            <div>
                <div class="ke-seg" id="kePriceModeSeg">
                    <button type="button" data-mode="FixedPackage" class="is-active">Sabit Paket Fiyatı</button>
                    <button type="button" data-mode="FixedComponent">Sabit Bileşen Fiyatı</button>
                    <button type="button" data-mode="ListPackage">Liste Paket Fiyatı</button>
                    <button type="button" data-mode="ListComponent">Liste Bileşen Fiyatı</button>
                </div>
                <div class="ke-hint" id="kePriceModeHint">Kit kendi sabit satış fiyatıyla satılır; sipariş/teklife bu fiyat gelir.</div>
            </div>

            <label class="ke-label" id="keFixedPriceLabel">Sabit Birim Fiyat</label>
            <div id="keFixedPriceWrap">
                <input type="number" id="keFixedPrice" class="ke-input" step="any" min="0" placeholder="0,00" style="max-width:220px;" />
            </div>

            <label class="ke-label">Açıklama</label>
            <textarea id="keDescription" class="ke-input" placeholder="Paket hakkında not (opsiyonel)..."></textarea>
        </div>
    </div>

    <!-- Bileşen listesi + ekleme — TEK yer: kalemler burada eklenir, burada düzenlenir. -->
    <div class="ke-card">
        <p class="ke-card__title">
            Paket İçeriği
            <span class="ke-badge" id="keCount" style="margin-left:8px;">0 bileşen</span>
            <span class="ke-badge ke-ver-badge" id="keHeaderVer" style="margin-left:6px;display:none;"
                  role="button" tabindex="0" title="Revizyon geçmişini görüntüle"></span>
        </p>
        <!-- Kolon başlıkları — satırlarla AYNI grid şablonu (hizalı kalsın).
             Ayrı bir "giriş çubuğu" YOK: kalemler "Kalem Ekle" ile açılan boş satırda
             girilir ve her satır sonradan da yerinde düzenlenir (2026-08-06 kullanıcı isteği). -->
        <div class="ke-head" id="keHeadRow">
            <div class="ke-field ke-field--code"><span>Stok Kodu *</span></div>
            <div class="ke-field ke-field--name"><span>Stok Adı</span></div>
            <div class="ke-field ke-field--combo"><span>Kombinasyon</span></div>
            <div class="ke-field ke-field--qty"><span>Miktar *</span></div>
            <div class="ke-field ke-field--unit"><span title="Malzemenin kendi biriminden farklı bir birim seçilebilir; seçim kayıtla birlikte saklanır.">Ölçü Birimi</span></div>
            <div class="ke-field ke-field--price"><span>Birim Fiyat *</span></div>
            <div class="ke-field ke-field--note"><span>Açıklama</span></div>
            <div class="ke-field ke-field--actions"><span>&nbsp;</span></div>
        </div>

        <!-- Bileşen satırları — hepsi düzenlenebilir -->
        <div class="ke-lines" id="keLinesBody"></div>
        <div class="ke-empty" id="keEmpty" style="display:none;">Henüz bileşen yok — “Kalem Ekle” ile başlayın.</div>

        <div class="ke-addline">
            <button type="button" class="ke-btn ke-btn--primary ke-btn--sm" id="keAddLine" title="Yeni bileşen satırı aç">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Kalem Ekle
            </button>
        </div>
        <div class="ke-hint">Satırdaki <strong>Enter</strong> ile alanlar arasında ilerleyin; son alanda Enter yeni satır açar. Eklenmiş satırların kodu dahil tüm alanları yerinde düzenlenebilir.</div>
    </div>

    <!-- Revizyon geçmişi — SALT OKUNUR (geri yükleme yok). Kit her kaydedildiğinde
         o anki içerik ItemKitRevision'a snapshot olarak yazılır. -->
    <div class="ikh-backdrop" id="keRevBackdrop" style="display:none;">
        <div class="ikh-box" role="dialog" aria-modal="true" aria-label="Kit Revizyon Geçmişi">
            <div class="ikh-head">
                <div>
                    <h3>Revizyon Geçmişi</h3>
                    <div class="ikh-sub" id="keRevSub">Kit içeriğinin kayıt anındaki halleri (salt okunur)</div>
                </div>
                <button type="button" class="ikh-close" id="keRevClose" title="Kapat (Esc)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="ikh-body">
                <div class="ikh-rail" id="keRevList"></div>
                <div class="ikh-detail" id="keRevDetail"></div>
            </div>
        </div>
    </div>

    <div class="ke-msg" id="keMsg"></div>
</div>

<script>
(function () {
    'use strict';

    var $ = function (id) { return document.getElementById(id); };

    // Runtime durum — ayrı sayfadaki derleme-zamanı sabitlerinin (KIT_ITEM_ID/CODE/NAME)
    // yerini alır; malzeme kartı kaydedildikçe init ile tazelenir.
    var KIT_ITEM_ID = 0;
    var KIT_CODE = '';
    var KIT_NAME = '';

    var lines = [];              // { code, name, quantity, note, configId, configCode, unitPrice, unitId, unitCode }
    var priceMode = 'FixedPackage';
    var dirty = false;           // kullanıcı bu sekmede değişiklik yaptı mı (VersionNo şişmesin)

    function markDirty() { dirty = true; }

    // ── Toast ──
    var msgTimer = null;
    function showMsg(text, isError) {
        var el = $('keMsg');
        if (!el) return;
        el.textContent = text;
        el.classList.toggle('is-err', !!isError);
        el.classList.add('is-show');
        clearTimeout(msgTimer);
        msgTimer = setTimeout(function () { el.classList.remove('is-show'); }, 2600);
    }

    // ── Fiyat modu (4 mod, backend KitPriceMode ile birebir) ──
    var KIT_PRICE_MODES = ['FixedPackage', 'FixedComponent', 'ListPackage', 'ListComponent'];
    var KIT_PRICE_MODE_LEGACY = { 'Fixed': 'FixedPackage', 'RollUp': 'ListComponent' };
    var KIT_PRICE_MODE_HINTS = {
        FixedPackage:   'Kit kendi sabit satış fiyatıyla satılır; sipariş/teklife bu fiyat gelir.',
        FixedComponent: 'Kit fiyatı, her bileşen için burada elle girilen birim fiyat × miktar toplamından hesaplanır.',
        ListPackage:    'Kit fiyatı, kit kartının kendi (Genel Liste) satış fiyatından, satış anında çözülür.',
        ListComponent:  'Kit fiyatı, bileşenlerin fiyat listesindeki satış fiyatları × miktar toplamından, satış anında çözülür.'
    };
    function setPriceMode(mode) {
        mode = KIT_PRICE_MODE_LEGACY[mode] || mode;
        if (KIT_PRICE_MODES.indexOf(mode) === -1) mode = 'FixedPackage';
        priceMode = mode;
        Array.prototype.forEach.call($('kePriceModeSeg').children, function (b) {
            b.classList.toggle('is-active', b.getAttribute('data-mode') === priceMode);
        });
        var isFixedPackage = priceMode === 'FixedPackage';
        $('keFixedPriceLabel').style.display = isFixedPackage ? '' : 'none';
        $('keFixedPriceWrap').style.display = isFixedPackage ? '' : 'none';
        $('kePriceModeHint').textContent = KIT_PRICE_MODE_HINTS[priceMode];
        $('keLinesBody').classList.toggle('ke-mode-fixedcomponent', priceMode === 'FixedComponent');
        $('keHeadRow').classList.toggle('ke-mode-fixedcomponent', priceMode === 'FixedComponent');
    }
    $('kePriceModeSeg').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-mode]');
        if (b) {
            setPriceMode(b.getAttribute('data-mode'));
            markDirty();
            if (priceMode === 'FixedPackage') keAutofillFixedPriceFromList(false);
        }
    });
    $('keFixedPrice').addEventListener('input', markDirty);
    $('keDescription').addEventListener('input', markDirty);

    // Sabit Paket birim fiyatı Genel (varsayılan) fiyat listesinden OTOMATİK doldurulur ama
    // DÜZENLENEBİLİR — alan boşsa yazılır, kayıtlı/elle girilmiş değer EZİLMEZ.
    function keAutofillFixedPriceFromList(force) {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) return;
        var el = $('keFixedPrice');
        if (!el) return;
        if (!force && String(el.value || '').trim() !== '') return;   // dolu → dokunma
        var csrf = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        fetch('/Sales/ResolveLinePrices', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify({ currencyId: 1, direction: 's', keys: [{ itemId: KIT_ITEM_ID }] })
        })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (rows) {
            if (!Array.isArray(rows) || !rows.length) return;
            var p = rows[0] ? rows[0].price : null;
            if (p == null) return;
            if (force || String(el.value || '').trim() === '') el.value = p;
        })
        .catch(function () { /* liste yoksa/erisilemezse sessiz — elle giris serbest */ });
    }

    /* ── Satır bazlı yardımcılar (2026-08-06) ────────────────────────────────
       Ayrı "giriş çubuğu" kalktı: her satır kendi rehberi, birim listesi ve
       kombinasyon seçiciyle YERİNDE düzenlenir; yeni kalem "Kalem Ekle" ile
       açılan boş satırdır. */
    function keMountLookupOn(input, retriesLeft) {
        if (retriesLeft === undefined) retriesLeft = 25;
        if (!window.CalibraHub || typeof window.CalibraHub.mountLookupForInput !== 'function') {
            if (retriesLeft > 0) setTimeout(function () { keMountLookupOn(input, retriesLeft - 1); }, 200);
            return;
        }
        if (!input.isConnected) return;   // satır bu arada silinmiş
        window.CalibraHub.mountLookupForInput({
            inputElement: input,
            formCode: 'MATERIAL_CARD_EDIT',
            fieldKey: 'itemKitLine.itemCode',
            guideCode: 'ITEMS',            // varsayılan; admin Alan Ayarları'ndan değiştirebilir
            isRequired: true
        });
    }

    // Malzemenin ana birimi + tanımlı çevrim birimleri (belge kalem grid'iyle aynı endpoint).
    function keFillUnitSelect(sel, code, selectedUnitId, onDone) {
        sel.innerHTML = ''; sel.disabled = true;
        if (!code) { if (onDone) onDone([]); return; }
        fetch('/Warehouse/GetMaterialUnitsJson?materialCode=' + encodeURIComponent(code), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                var opts = Array.isArray(list) ? list : [];
                opts.forEach(function (u) {
                    var opt = document.createElement('option');
                    opt.value = String(u.id);
                    opt.textContent = (u.name && u.name !== u.code) ? (u.code + ' — ' + u.name) : u.code;
                    sel.appendChild(opt);
                });
                if (opts.length) {
                    sel.disabled = false;
                    if (selectedUnitId) sel.value = String(selectedUnitId);
                }
                if (onDone) onDone(opts);
            })
            .catch(function () { if (onDone) onDone([]); });
    }

    function keSyncComboBtn(btn, l) {
        var trackable = !!l._hasConfig;
        btn.disabled = !trackable;
        btn.classList.toggle('is-set', trackable && !!l.configCode);
        if (!trackable) {
            btn.textContent = 'Seç...';
            btn.title = l.code ? 'Bu malzemede kombinasyon takibi yok' : 'Önce stok kodu seçin';
        } else if (l.configCode) {
            btn.textContent = l.configCode;
            btn.title = 'Seçili kombinasyon: ' + l.configCode + ' — değiştirmek için tıklayın';
        } else {
            btn.textContent = 'Kombinasyon Seç...';
            btn.title = 'Kombinasyon seçmek için tıklayın';
        }
    }

    // ── Bileşen listesi render — başlık satırıyla AYNI kolon düzeni (ke-field--*);
    //    satırın TÜM alanları (kod dahil) yerinde düzenlenir. ──
    function renderLines() {
        var body = $('keLinesBody');
        body.innerHTML = '';
        lines.forEach(function (l, i) {
            var row = document.createElement('div');
            row.className = 'ke-line';

            function cell(cls) { var d = document.createElement('div'); d.className = 'ke-field ' + cls; row.appendChild(d); return d; }

            // ── Stok Kodu — Tip-1 standart rehber (her satırda ayrı mount) ──
            var cCode = cell('ke-field--code');
            var codeWrap = document.createElement('div'); codeWrap.className = 'ke-lookup';
            var codeInput = document.createElement('input');
            codeInput.type = 'text'; codeInput.className = 'ke-input';
            codeInput.value = l.code || '';
            codeInput.placeholder = 'Kod veya ad ile ara...';
            codeInput.autocomplete = 'off';
            codeWrap.appendChild(codeInput);
            cCode.appendChild(codeWrap);
            keMountLookupOn(codeInput);

            var cName = cell('ke-field--name');
            var nameEl = document.createElement('input');
            nameEl.type = 'text'; nameEl.className = 'ke-input'; nameEl.readOnly = true;
            nameEl.placeholder = 'Otomatik gelir...';
            nameEl.value = l.name || ''; nameEl.title = l.name || '';
            cName.appendChild(nameEl);

            var cCombo = cell('ke-field--combo');
            var comboBtn = document.createElement('button');
            comboBtn.type = 'button'; comboBtn.className = 'ke-btn ke-btn--sm ke-combo-btn';
            comboBtn.addEventListener('click', function () {
                if (!l._hasConfig || !l.code) return;
                keOpenComboPicker(l.code, {
                    materialName: l.name || '',
                    currentCode: l.configCode || null,
                    onApply: function (configId, code) {
                        l.configId = configId; l.configCode = code;
                        keSyncComboBtn(comboBtn, l);
                        markDirty();
                    }
                });
            });
            cCombo.appendChild(comboBtn);
            keSyncComboBtn(comboBtn, l);

            /* Kod degisiminde: malzeme cozumlenir, ad/birim/kombinasyon TAZELENIR.
               Satir yeniden CIZILMEZ (rehber mount'u ve odak korunur). */
            codeInput.addEventListener('change', function () {
                var code = (codeInput.value || '').trim();
                if (!code) {
                    l.code = ''; l.name = ''; l._hasConfig = false;
                    l.configId = null; l.configCode = null;
                    l.unitId = null; l.unitCode = null;
                    nameEl.value = ''; keSyncComboBtn(comboBtn, l);
                    keFillUnitSelect(unitSel, null, null);
                    markDirty();
                    return;
                }
                if (KIT_CODE && code.toLowerCase() === KIT_CODE.toLowerCase()) {
                    showMsg('Kit kendi bileşeni olamaz.', true);
                    codeInput.value = l.code || '';
                    return;
                }
                var dup = lines.some(function (o) { return o !== l && (o.code || '').toLowerCase() === code.toLowerCase(); });
                if (dup) {
                    showMsg('Bu bileşen zaten eklenmiş.', true);
                    codeInput.value = l.code || '';
                    return;
                }
                resolveComp(code, function (m) {
                    if (!m) {
                        showMsg('"' + code + '" kodlu stok bulunamadı.', true);
                        l.code = code; l.name = ''; l._hasConfig = false;
                        nameEl.value = ''; keSyncComboBtn(comboBtn, l);
                        markDirty();
                        return;
                    }
                    l.code = m.code || code;
                    l.name = m.name || '';
                    l._hasConfig = !!m.hasConfig;
                    // Kod degisti → onceki kombinasyon/birim gecersiz
                    l.configId = null; l.configCode = null;
                    l.unitId = null; l.unitCode = null;
                    codeInput.value = l.code;
                    nameEl.value = l.name; nameEl.title = l.name;
                    keSyncComboBtn(comboBtn, l);
                    keFillUnitSelect(unitSel, l.code, null, function (opts) {
                        if (opts.length) { l.unitId = opts[0].id; l.unitCode = opts[0].code; }
                    });
                    markDirty();
                    if (l._hasConfig) comboBtn.click();   // kombinasyon takipliyse seçici açılır
                    else { qtyInput.focus(); try { qtyInput.select(); } catch (e) {} }
                });
            });

            // Kayitli satirlarda kombinasyon takibi bilinmiyorsa bir kez cozumle
            if (l.code && l._hasConfig === undefined) {
                l._hasConfig = !!l.configCode;   // gecici varsayim
                resolveComp(l.code, function (m) {
                    l._hasConfig = !!(m && m.hasConfig);
                    if (comboBtn.isConnected) keSyncComboBtn(comboBtn, l);
                });
            }

            var cQty = cell('ke-field--qty');
            var qtyInput = document.createElement('input');
            qtyInput.type = 'number'; qtyInput.className = 'ke-input'; qtyInput.value = l.quantity;
            qtyInput.min = '0'; qtyInput.step = 'any';
            qtyInput.addEventListener('change', function () {
                var v = parseFloat(qtyInput.value.replace(',', '.'));
                l.quantity = (isFinite(v) && v > 0) ? v : 1;
                qtyInput.value = l.quantity;
                markDirty();
            });
            cQty.appendChild(qtyInput);

            // ── Ölçü Birimi — malzemenin ana birimi + çevrim birimleri (seçim saklanır) ──
            var cUnit = cell('ke-field--unit');
            var unitSel = document.createElement('select');
            unitSel.className = 'ke-input'; unitSel.disabled = true;
            unitSel.addEventListener('change', function () {
                var opt = (l._units || []).find(function (u) { return String(u.id) === unitSel.value; });
                l.unitId = opt ? opt.id : null;
                l.unitCode = opt ? opt.code : null;
                markDirty();
            });
            cUnit.appendChild(unitSel);
            if (l.code) {
                keFillUnitSelect(unitSel, l.code, l.unitId, function (opts) {
                    l._units = opts;
                    if (!opts.length) return;
                    if (!l.unitId) { l.unitId = opts[0].id; l.unitCode = opts[0].code; }
                });
            }

            // Yalnız FixedComponent modda görünür (.ke-lines.ke-mode-fixedcomponent)
            var cPrice = cell('ke-field--price');
            var priceInput = document.createElement('input');
            priceInput.type = 'number'; priceInput.className = 'ke-input'; priceInput.step = 'any'; priceInput.min = '0';
            priceInput.placeholder = '0,00';
            priceInput.value = (l.unitPrice != null) ? l.unitPrice : '';
            priceInput.addEventListener('change', function () {
                var v = parseFloat(priceInput.value.replace(',', '.'));
                l.unitPrice = (isFinite(v) && v >= 0) ? v : null;
                priceInput.value = (l.unitPrice != null) ? l.unitPrice : '';
                markDirty();
            });
            cPrice.appendChild(priceInput);

            var cNote = cell('ke-field--note');
            var noteInput = document.createElement('input');
            noteInput.type = 'text'; noteInput.className = 'ke-input'; noteInput.value = l.note || '';
            noteInput.placeholder = '—';
            noteInput.addEventListener('change', function () { l.note = noteInput.value; markDirty(); });
            cNote.appendChild(noteInput);

            var cX = cell('ke-field--actions');
            var x = document.createElement('button'); x.type = 'button'; x.className = 'ke-x'; x.title = 'Çıkar';
            x.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
            x.addEventListener('click', function () { lines.splice(i, 1); markDirty(); renderLines(); });
            cX.appendChild(x);

            // ── Enter zinciri: kod → miktar → (fiyat) → açıklama → yeni satır ──
            qtyInput.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var next = (priceMode === 'FixedComponent') ? priceInput : noteInput;
                next.focus(); try { next.select(); } catch (err) {}
            });
            priceInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); noteInput.focus(); try { noteInput.select(); } catch (err) {} }
            });
            noteInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); if (i === lines.length - 1) addEmptyLine(); }
            });

            body.appendChild(row);
        });
        $('keCount').textContent = lines.length + ' bileşen';
        var emptyEl = $('keEmpty');
        if (emptyEl) emptyEl.style.display = lines.length ? 'none' : '';
    }

    /* "Kalem Ekle" — listeye BOŞ bir satır açar ve kod alanına odaklanır.
       (Eski sabit giriş çubuğunun yerini alır; satır sonradan da düzenlenebilir.) */
    function addEmptyLine() {
        lines.push({
            code: '', name: '', quantity: 1, note: '',
            configId: null, configCode: null, unitPrice: null,
            unitId: null, unitCode: null, _hasConfig: false, _units: []
        });
        markDirty();
        renderLines();
        // Yeni satırın rehber input'una odaklan (LookupCard mount'u asenkron — kısa gecikme)
        var rows = $('keLinesBody').children;
        var last = rows[rows.length - 1];
        if (!last) return;
        setTimeout(function () {
            var wrap = last.querySelector('.ke-lookup');
            var visible = wrap ? wrap.querySelector('input') : null;
            if (visible) visible.focus();
        }, 120);
    }
    $('keAddLine').addEventListener('click', addEmptyLine);

    // ── Stok kodu çözümleme (StockLookup) ──
    function resolveComp(code, cb) {
        code = (code || '').trim();
        if (!code) { cb(null); return; }
        fetch('/Logistics/StockLookup?q=' + encodeURIComponent(code), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                var m = (list || []).find(function (s) { return (s.code || '').toLowerCase() === code.toLowerCase(); });
                cb(m || null);
            })
            .catch(function () { cb(null); });
    }

    // ── Kombinasyon seçimi ──
    // DocumentEdit'teki satış kalemi kombinasyon seçimiyle AYNI mekanizma
    // (window.CalibraHub.openCombinationPicker → React CombinationPickerModal).
    function keOpenComboPicker(materialCode, opts, retriesLeft) {
        if (retriesLeft === undefined) retriesLeft = 15;
        if (!window.CalibraHub || typeof window.CalibraHub.openCombinationPicker !== 'function') {
            if (retriesLeft > 0) { setTimeout(function () { keOpenComboPicker(materialCode, opts, retriesLeft - 1); }, 200); return; }
            showMsg('Kombinasyon seçici yüklenemedi, sayfayı yenileyin.', true);
            return;
        }
        window.CalibraHub.openCombinationPicker(materialCode, opts);
    }


    // ── Yükleme ──
    function loadKit() {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) {
            setPriceMode('FixedPackage'); lines = []; renderLines(); dirty = false;
            return Promise.resolve();
        }
        return fetch('/Logistics/GetKit?itemId=' + KIT_ITEM_ID, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { found: false }; })
            .then(function (d) {
                if (d && d.found) {
                    if (d.itemCode) KIT_CODE = d.itemCode;
                    if (d.itemName) KIT_NAME = d.itemName;
                    setPriceMode(d.priceMode || 'FixedPackage');
                    $('keFixedPrice').value = (d.fixedPrice != null) ? d.fixedPrice : '';
                    $('keDescription').value = d.description || '';
                    lines = (d.lines || []).map(function (l) {
                        return {
                            code: l.componentMaterialCode, name: l.componentMaterialName, quantity: l.quantity, note: l.note || '',
                            configId: l.configId || null, configCode: l.componentConfigCode || null,
                            unitPrice: (l.unitPrice != null) ? l.unitPrice : null,
                            unitId: l.unitId || null, unitCode: l.unit || null
                        };
                    });
                    var ver = $('keHeaderVer');
                    ver.style.display = ''; ver.textContent = 'v' + (d.versionNo || 1);
                } else {
                    setPriceMode('FixedPackage');
                    lines = [];
                    $('keHeaderVer').style.display = 'none';
                }
                renderLines();
                dirty = false;   // taze yüklendi — kullanıcı henüz değiştirmedi
                if (priceMode === 'FixedPackage') keAutofillFixedPriceFromList(false);
            })
            .catch(function () { setPriceMode('FixedPackage'); renderLines(); dirty = false; });
    }

    // ── Kaydet — malzeme kartının Kaydet'i tarafından çağrılır ──
    // Yarım kalan satır (kodu girilmemiş) SESSİZCE ATILMAZ; kullanıcıya hangi satır
    // olduğu söylenir (CLAUDE.md sessiz-kırık kuralı 3).
    function save() {
        var emptyIdx = -1, priceIdx = -1;
        lines.forEach(function (l, i) {
            if (emptyIdx < 0 && !String(l.code || '').trim()) emptyIdx = i;
            if (priceIdx < 0 && priceMode === 'FixedComponent' && !(l.unitPrice >= 0)) priceIdx = i;
        });
        if (emptyIdx >= 0) {
            return Promise.resolve({
                ok: false,
                message: (emptyIdx + 1) + '. kalem satırında stok kodu boş — kodu girin veya satırı silin.'
            });
        }
        if (priceIdx >= 0) {
            return Promise.resolve({
                ok: false,
                message: (priceIdx + 1) + '. kalem satırında birim fiyat girin (Sabit Bileşen Fiyatı modu).'
            });
        }
        return doSave();
    }

    function doSave() {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) {
            return Promise.resolve({ ok: false, message: 'Önce malzeme kartını kaydedin.' });
        }
        if (lines.length === 0) {
            return Promise.resolve({ ok: false, message: 'Kit içinde en az bir bileşen olmalı.' });
        }

        var fixedPrice = null;
        if (priceMode === 'FixedPackage') {
            var fp = parseFloat(($('keFixedPrice').value || '').replace(',', '.'));
            fixedPrice = isFinite(fp) ? fp : null;
        }
        var payload = {
            id: null,
            itemId: KIT_ITEM_ID,
            materialCode: KIT_CODE || null,
            priceMode: priceMode,
            fixedPrice: fixedPrice,
            description: ($('keDescription').value || '').trim() || null,
            lines: lines.map(function (l) {
                return {
                    itemId: 0,
                    componentMaterialCode: l.code,
                    configId: l.configId || null,
                    componentConfigCode: l.configCode || null,
                    quantity: l.quantity,
                    note: l.note || null,
                    unitPrice: (priceMode === 'FixedComponent' && l.unitPrice != null) ? l.unitPrice : null,
                    unitId: l.unitId || null,
                    unit: l.unitCode || null
                };
            })
        };

        var csrf = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        return fetch('@Url.Action("SaveKit", "Kit")', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
            if (res.ok && res.d && res.d.success) {
                dirty = false;
                return loadKit().then(function () {
                    return { ok: true, count: lines.length };
                });
            }
            return { ok: false, message: (res.d && res.d.message) || 'Kit kaydedilirken hata oluştu.' };
        })
        .catch(function () { return { ok: false, message: 'Sunucuya ulaşılamadı (kit içeriği).' }; });
    }

    // ── Revizyon geçmişi (salt okunur) ──
    // Kit her kaydedildiğinde backend ItemKitRevision'a snapshot yazar (içerik semantik
    // olarak değişmediyse yazmaz). Buradaki liste o snapshot'ları gösterir; geri yükleme
    // BİLİNÇLİ olarak yok — geçmiş belgeler kendi KitVersionNo snapshot'larını taşır.
    var PRICE_MODE_LABELS = {
        FixedPackage: 'Sabit Paket Fiyatı', FixedComponent: 'Sabit Bileşen Fiyatı',
        ListPackage: 'Liste Paket Fiyatı', ListComponent: 'Liste Bileşen Fiyatı'
    };

    function fmtNum(v) {
        if (v == null || v === '') return '—';
        var n = Number(v);
        return isFinite(n) ? n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) : String(v);
    }
    function fmtDateTime(iso) {
        if (!iso) return '—';
        var d = new Date(iso);
        return isNaN(d.getTime()) ? String(iso) : d.toLocaleString('tr-TR');
    }
    function metaItem(label, value) {
        var d = document.createElement('div');
        var b = document.createElement('b'); b.textContent = label;
        d.appendChild(b);
        d.appendChild(document.createTextNode(value));
        return d;
    }

    function openRevisions() {
        if (!KIT_ITEM_ID || KIT_ITEM_ID <= 0) { showMsg('Önce malzeme kartını kaydedin.', true); return; }
        $('keRevBackdrop').style.display = 'flex';
        document.addEventListener('keydown', revEscHandler);

        var list = $('keRevList');
        list.innerHTML = '';
        var loading = document.createElement('div');
        loading.className = 'ikh-empty'; loading.textContent = 'Yükleniyor...';
        list.appendChild(loading);
        $('keRevDetail').innerHTML = '';

        fetch('/Logistics/KitRevisions?itemId=' + KIT_ITEM_ID, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { items: [] }; })
            .then(function (d) { renderRevList((d && d.items) || []); })
            .catch(function () {
                list.innerHTML = '';
                var err = document.createElement('div');
                err.className = 'ikh-empty'; err.textContent = 'Revizyon geçmişi yüklenemedi.';
                list.appendChild(err);
            });
    }

    function renderRevList(items) {
        var list = $('keRevList');
        list.innerHTML = '';
        $('keRevSub').textContent = items.length
            ? items.length + ' revizyon — kit içeriğinin kayıt anındaki halleri (salt okunur)'
            : 'Kit içeriğinin kayıt anındaki halleri (salt okunur)';

        if (!items.length) {
            var empty = document.createElement('div');
            empty.className = 'ikh-empty';
            empty.textContent = 'Henüz revizyon yok.';
            list.appendChild(empty);
            $('keRevDetail').innerHTML = '';
            var hint = document.createElement('div');
            hint.className = 'ikh-empty';
            hint.textContent = 'Kit bir sonraki kaydedişte geçmişe alınacak.';
            $('keRevDetail').appendChild(hint);
            return;
        }

        items.forEach(function (it, idx) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ikh-rev' + (idx === 0 ? ' is-active' : '');
            var b = document.createElement('b'); b.textContent = 'v' + it.revisionNo;
            var s1 = document.createElement('span'); s1.textContent = fmtDateTime(it.createdAt);
            var s2 = document.createElement('span');
            s2.textContent = (it.lineCount || 0) + ' bileşen · ' + (it.createdBy || 'Bilinmiyor');
            btn.appendChild(b); btn.appendChild(s1); btn.appendChild(s2);
            btn.addEventListener('click', function () {
                Array.prototype.forEach.call(list.children, function (c) { c.classList.remove('is-active'); });
                btn.classList.add('is-active');
                loadRevDetail(it.id);
            });
            list.appendChild(btn);
        });

        loadRevDetail(items[0].id);
    }

    function loadRevDetail(revisionId) {
        var pane = $('keRevDetail');
        pane.innerHTML = '';
        var loading = document.createElement('div');
        loading.className = 'ikh-empty'; loading.textContent = 'Yükleniyor...';
        pane.appendChild(loading);

        fetch('/Logistics/KitRevisionDetail?id=' + revisionId, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { found: false }; })
            .then(function (d) {
                pane.innerHTML = '';
                if (!d || !d.found) {
                    var nf = document.createElement('div');
                    nf.className = 'ikh-empty'; nf.textContent = 'Revizyon bulunamadı.';
                    pane.appendChild(nf);
                    return;
                }

                var meta = document.createElement('div');
                meta.className = 'ikh-meta';
                meta.appendChild(metaItem('Revizyon', 'v' + d.revisionNo));
                meta.appendChild(metaItem('Tarih', fmtDateTime(d.createdAt)));
                meta.appendChild(metaItem('Kaydeden', d.createdBy || 'Bilinmiyor'));
                meta.appendChild(metaItem('Fiyat Modu', PRICE_MODE_LABELS[d.priceMode] || d.priceMode || '—'));
                if (d.priceMode === 'FixedPackage')
                    meta.appendChild(metaItem('Sabit Fiyat', fmtNum(d.fixedPrice)));
                if (d.description)
                    meta.appendChild(metaItem('Açıklama', d.description));
                pane.appendChild(meta);

                var linesArr = d.lines || [];
                if (!linesArr.length) {
                    var e = document.createElement('div');
                    e.className = 'ikh-empty'; e.textContent = 'Bu revizyonda bileşen yok.';
                    pane.appendChild(e);
                    return;
                }

                var isFixedComp = d.priceMode === 'FixedComponent';
                var table = document.createElement('table');
                table.className = 'ikh-table';
                var thead = document.createElement('thead');
                var htr = document.createElement('tr');
                var headers = ['Stok Kodu', 'Stok Adı', 'Kombinasyon', 'Miktar', 'Birim'];
                if (isFixedComp) headers.push('Birim Fiyat');
                headers.push('Açıklama');
                headers.forEach(function (h) {
                    var th = document.createElement('th'); th.textContent = h; htr.appendChild(th);
                });
                thead.appendChild(htr); table.appendChild(thead);

                var tbody = document.createElement('tbody');
                linesArr.forEach(function (l) {
                    var tr = document.createElement('tr');
                    function td(text, cls) {
                        var c = document.createElement('td');
                        if (cls) c.className = cls;
                        c.textContent = text;
                        tr.appendChild(c);
                    }
                    td(l.componentMaterialCode || '—', 'ikh-code');
                    td(l.componentMaterialName || '—');
                    td(l.componentConfigCode || '—');
                    td(fmtNum(l.quantity), 'ikh-num');
                    td(l.unit || '—');
                    if (isFixedComp) td(fmtNum(l.unitPrice), 'ikh-num');
                    td(l.note || '—');
                    tbody.appendChild(tr);
                });
                table.appendChild(tbody);
                pane.appendChild(table);
            })
            .catch(function () {
                pane.innerHTML = '';
                var err = document.createElement('div');
                err.className = 'ikh-empty'; err.textContent = 'Revizyon detayı yüklenemedi.';
                pane.appendChild(err);
            });
    }

    function closeRevisions() {
        $('keRevBackdrop').style.display = 'none';
        document.removeEventListener('keydown', revEscHandler);
    }
    function revEscHandler(e) { if (e.key === 'Escape') { e.preventDefault(); closeRevisions(); } }

    $('keHeaderVer').addEventListener('click', openRevisions);
    $('keHeaderVer').addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openRevisions(); }
    });
    $('keRevClose').addEventListener('click', closeRevisions);
    $('keRevBackdrop').addEventListener('click', function (e) {
        if (e.target === $('keRevBackdrop')) closeRevisions();
    });

    // ── Dışa açılan API (MaterialCardEdit kullanır) ──
    window.mceKitEditorInit = function (itemId, code, name) {
        KIT_ITEM_ID = parseInt(itemId, 10) || 0;
        KIT_CODE = code || '';
        KIT_NAME = name || '';
        return loadKit();
    };
    window.mceKitEditorIsDirty = function () { return !!dirty; };
    window.mceKitEditorSave = save;
    window.mceKitEditorLineCount = function () { return lines.length; };
})();
</script>
