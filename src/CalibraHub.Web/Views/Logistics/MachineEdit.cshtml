@model CalibraHub.Web.Models.Logistics.MachineEditViewModel
@{
    var isNew = Model.Id == null;
    ViewData["Title"] = isNew ? "Yeni Makine" : $"Makine: {Model.MachineName ?? Model.MachineCode}";
    ViewData["FormCode"] = "MACHINES";
    ViewData["BodyClass"] = "page-machine-edit workspace-frame-body";
}

<partial name="_ProductionDefsTabs" model='"machines"' />

@* PJAX wrapper *@
<div id="pdt-tab-content" data-pdt-key="machines" data-pdt-body-class="page-machine-edit">

@{
    var _colId = (Model.Id ?? 0) > 0 ? Model.Id!.Value.ToString() : $"new-{Guid.NewGuid():N}";
    var _colTitle = isNew ? "Yeni Makine" : $"Makine: {Model.MachineName ?? Model.MachineCode}";
}
<form class="integrator-form" style="display:none" aria-hidden="true"
      data-collaboration-record-type="MACHINE_EDIT"
      data-collaboration-record-id="@_colId"
      data-collaboration-record-title="@_colTitle"></form>

<div class="ux-edit-shell">
  @await Html.PartialAsync("_CalibraActionBar", new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
  {
      ["Title"]       = isNew ? "Yeni Makine" : ((Model.MachineName ?? "Makineyi Düzenle") + (Model.IsActive ? "" : " (Pasif)")),
      ["ListUrl"]     = "/Logistics/Machines",
      ["NewUrl"]      = "/Logistics/MachineEdit",
      ["SaveBtnId"]   = "me-save",
      ["DeleteBtnId"] = "me-delete",
      ["ShowDelete"]  = !isNew,
  })

  <div class="ux-edit-body">
    <aside class="ux-edit-nav" id="meNav">
      <button type="button" class="ux-edit-nav__tab is-active" data-tab="general">
        <svg class="ux-edit-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path stroke-linecap="round" d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
        <span>Genel Bilgiler</span>
      </button>
      <button type="button" class="ux-edit-nav__tab" data-tab="groups">
        <svg class="ux-edit-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <span>Gruplar</span>
      </button>
      <button type="button" class="ux-edit-nav__tab" data-tab="widgets" id="meNavWidgets" style="display:none;">
        <svg class="ux-edit-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10-10a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        <span>Ek Alanlar</span>
      </button>
    </aside>

    <section class="ux-edit-content">
      <div class="ux-edit-pane is-active" data-tab="general">
        <h2>Genel Bilgiler</h2>
        <div class="ux-edit-hint">Makine kimlik ve lokasyon bilgileri.</div>

        <input type="hidden" id="me-id"   value="@(Model.Id?.ToString() ?? "")" />
        <input type="hidden" id="me-code" value="@(Model.MachineCode ?? "")" />

        <div class="ux-field ux-field--wide">
          <label for="me-location">Lokasyon *</label>
          <div class="ux-picker-group">
            <input type="text" id="me-location" readonly autocomplete="off"
                   placeholder="Lokasyon seçmek için tıklayın…" />
            <input type="hidden" id="me-location-id" value="" />
            <button type="button" class="ux-picker-btn" id="me-location-pick" title="Lokasyon seç" aria-label="Lokasyon seç">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
          </div>
          <div class="ux-hint">Yalnızca Makine Parkuru olarak işaretli lokasyonlar listelenir.</div>
        </div>

        <div class="ux-field ux-field--wide">
          <label for="me-name">Makine Adı *</label>
          <input id="me-name" type="text" maxlength="150"
                 value="@(Model.MachineName ?? "")" placeholder="Orn: CNC Torna 1" />
        </div>

        <div class="ux-row2">
          <div class="ux-field">
            <label for="me-sort">Sıralama</label>
            <input id="me-sort" type="number" min="0" value="@Model.SortOrder" />
          </div>
          <div class="ux-field">
            <label>Durum</label>
            <div class="ux-switch-row">
              <label class="ux-switch">
                <input type="checkbox" id="me-active" @(Model.IsActive ? "checked" : "") />
                <span class="ux-switch-track"></span>
              </label>
              <span class="ux-switch-label" id="me-active-label">@(Model.IsActive ? "Aktif" : "Pasif")</span>
            </div>
          </div>
        </div>

        <div id="me-err" style="display:none;" class="ux-err"></div>
      </div>

      <div class="ux-edit-pane" data-tab="groups">
        <h2>Gruplar</h2>
        <div class="ux-edit-hint">Makineyi bir makine grubuna atayın. Gruplar; makine listesinde filtreleme ve organizasyon amacıyla kullanılır.</div>

        <div class="ux-field ux-field--wide">
          <label for="me-group">Makine Grubu</label>
          <select id="me-group">
            <option value="">Seçiniz</option>
          </select>
          <div class="ux-hint">Bir makine yalnızca tek bir gruba atanabilir.</div>
        </div>
      </div>

      <div class="ux-edit-pane" data-tab="widgets">
        <h2>Ek Alanlar</h2>
        <div class="ux-edit-hint">Admin → Widget Tanımları → MACHINES form'una eklenen ek alanlar.</div>
        <div class="ux-dyn-widgets">
          <div id="meDynamicWidgets"
               data-form-code="MACHINES"
               data-record-id="@(Model.Id?.ToString() ?? "")">
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

@if (!isNew)
{
  <div id="me-modal" class="ux-modal-backdrop" style="display:none;" onclick="meCloseModal()">
    <div class="ux-modal" onclick="event.stopPropagation()">
      <div class="ux-modal-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="ux-modal-title">Makineyi Sil</div>
      <div class="ux-modal-msg" id="me-modal-msg"></div>
      <div class="ux-modal-actions">
        <button class="ux-modal-cancel" onclick="meCloseModal()">Vazgeç</button>
        <button class="ux-modal-del" id="me-modal-del">Sil</button>
      </div>
    </div>
  </div>
}

@Html.AntiForgeryToken()

<script>
(function () {
    var idVal   = document.getElementById('me-id')?.value   || '';
    var codeVal = document.getElementById('me-code')?.value || '';
    var initLocId = @(Model.LocationId);

    function csrf() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
    function setErr(msg) {
        var el = document.getElementById('me-err');
        if (!el) return;
        if (msg) { el.textContent = msg; el.style.display = ''; activateTab('general'); }
        else el.style.display = 'none';
    }
    function shake(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('is-invalid'); void el.offsetWidth;
        el.classList.add('is-invalid');
        setTimeout(function () { el.classList.remove('is-invalid'); }, 1200);
    }

    // ── Tab switching ──
    function activateTab(key) {
        document.querySelectorAll('#meNav .ux-edit-nav__tab').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.tab === key);
        });
        document.querySelectorAll('.ux-edit-pane').forEach(function (p) {
            p.classList.toggle('is-active', p.dataset.tab === key);
        });
    }
    document.querySelectorAll('#meNav .ux-edit-nav__tab').forEach(function (b) {
        b.addEventListener('click', function () {
            if (b.disabled) return;
            activateTab(b.dataset.tab);
        });
    });

    var activeEl = document.getElementById('me-active');
    var activeLabel = document.getElementById('me-active-label');
    if (activeEl && activeLabel) {
        activeEl.addEventListener('change', function () {
            activeLabel.textContent = activeEl.checked ? 'Aktif' : 'Pasif';
        });
    }

    // ── Lokasyon seçici (PickerModal): düz, aranabilir liste — yalnızca AKTIF +
    // Makine Parkuru (IsMachinePark=1) lokasyonlar seçilebilir. Hiyerarşi/seviye
    // gösterimi kaldırıldı (PageComment Seq 42, 2026-07-26): kullanıcı doğrudan
    // lokasyon adı/kodu yazıp arayıp eşleştirir. /Logistics/GetAllLocations
    // paylaşımlı endpoint'i DEĞİŞMEDEN kullanılır — filtre burada client-side yapılır.
    var meAllLocations = [];   // aktif lokasyonlar — mevcut atamayı çözümlemek için (filtre dışı olsa da)

    function meLocationLabel(l) {
        if (!l) return '';
        return (l.locationCode || '') + (l.locationName ? ' · ' + l.locationName : '');
    }
    function meSetLocation(loc) {
        var id = loc ? loc.id : null;
        document.getElementById('me-location-id').value = id || '';
        document.getElementById('me-location').value = loc ? meLocationLabel(loc) : '';
    }

    async function loadLocations() {
        var r = await fetch('/Logistics/GetAllLocations', { credentials: 'same-origin' });
        var all = r.ok ? await r.json() : [];
        meAllLocations = (all || []).filter(function (l) { return l.isActive; });

        if (!initLocId) return;
        var current = meAllLocations.find(function (l) { return l.id === initLocId; });
        if (current) { meSetLocation(current); return; }

        // Kayıtlı lokasyon aktif listede yok (sonradan pasif/Makine Parkuru-dışı yapılmış
        // olabilir) — FK'yi BOZMADAN koru, etiketi tekil kayıttan ayrıca çek.
        document.getElementById('me-location-id').value = initLocId;
        try {
            var rr = await fetch('/Logistics/GetLocation?id=' + initLocId, { credentials: 'same-origin' });
            if (rr.ok) {
                var one = await rr.json();
                document.getElementById('me-location').value =
                    meLocationLabel({ locationCode: one.locationCode, locationName: one.locationName });
            }
        } catch (e) { /* sessizce devam — id zaten korunuyor, sadece etiket eksik kalır */ }
    }

    function meEscHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function meCloseLocationPicker() {
        var bd = document.getElementById('me-location-picker-bd');
        if (bd && bd.parentNode) bd.parentNode.removeChild(bd);
        document.removeEventListener('keydown', meLocationPickerKeydown);
    }
    function meLocationPickerKeydown(e) {
        if (e.key === 'Escape') meCloseLocationPicker();
    }
    function openLocationPicker() {
        // Sadece Makine Parkuru lokasyonları listelenir.
        var options = meAllLocations.filter(function (l) { return l.isMachinePark === true; });

        var bd = document.createElement('div');
        bd.id = 'me-location-picker-bd';
        bd.className = 'ux-modal-backdrop';
        bd.innerHTML =
            '<div class="ux-picker-modal">' +
              '<div class="ux-picker-head">' +
                '<span class="ux-picker-title">Lokasyon Seç</span>' +
                '<input type="text" class="ux-picker-search" placeholder="Ara… (kod, ad)" autocomplete="off" />' +
                '<button type="button" class="ux-picker-close" title="Kapat (Esc)">&times;</button>' +
              '</div>' +
              '<div class="ux-picker-list"></div>' +
            '</div>';

        function render(items) {
            var list = bd.querySelector('.ux-picker-list');
            if (!items.length) {
                list.innerHTML = '<div class="ux-picker-empty">Makine parkuru lokasyonu bulunamadı.</div>';
                return;
            }
            list.innerHTML = items.map(function (l, i) {
                return '<div class="ux-picker-row" data-idx="' + i + '">' +
                         '<span class="ux-picker-row-name">' + meEscHtml(l.locationCode || '') +
                            (l.locationName ? ' — ' + meEscHtml(l.locationName) : '') + '</span>' +
                         (l.locationTypeDisplayName ? '<span class="ux-picker-row-meta">' + meEscHtml(l.locationTypeDisplayName) + '</span>' : '') +
                       '</div>';
            }).join('');
            list.querySelectorAll('.ux-picker-row').forEach(function (row) {
                row.addEventListener('click', function () {
                    var idx = parseInt(row.getAttribute('data-idx'), 10);
                    meSetLocation(items[idx]);
                    meCloseLocationPicker();
                });
            });
        }

        bd.addEventListener('click', function (e) { if (e.target === bd) meCloseLocationPicker(); });
        document.body.appendChild(bd);
        render(options);

        var search = bd.querySelector('.ux-picker-search');
        search.addEventListener('input', function () {
            var q = (search.value || '').trim().toLowerCase();
            if (!q) { render(options); return; }
            render(options.filter(function (l) {
                return (l.locationCode || '').toLowerCase().indexOf(q) !== -1 ||
                       (l.locationName || '').toLowerCase().indexOf(q) !== -1;
            }));
        });
        bd.querySelector('.ux-picker-close').addEventListener('click', meCloseLocationPicker);
        document.addEventListener('keydown', meLocationPickerKeydown);
        setTimeout(function () { search.focus(); }, 30);
    }

    var meLocationInput = document.getElementById('me-location');
    var meLocationBtn   = document.getElementById('me-location-pick');
    if (meLocationInput) {
        meLocationInput.addEventListener('click', openLocationPicker);
        meLocationInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLocationPicker(); }
        });
    }
    if (meLocationBtn) meLocationBtn.addEventListener('click', openLocationPicker);

    loadLocations();

    // ── Gruplar (tek seviye: CardType=3 Makine, yalnızca Level 1) ──
    // Bir makine TEK bir makine grubuna atanabilir (PageComment Seq 43 kullanıcı
    // kararı). CardGroup altyapısı 5 seviyeli olsa da burada yalnızca Level 1
    // kullanılır — MaterialCardEdit'teki 5'li cascade'in aksine tek dropdown.
    // Kontrat (DefinitionsController, backend ile koordineli doğrulandı):
    //   GET  /Definitions/GetCardGroups?cardType=3&level=1
    //   GET  /Definitions/GetCardGroupMappings?entityType=3&entityId={machineId}
    //   POST /Definitions/SaveCardGroupMappings { entityType:3, entityId, levels:[{level:1, cardGroupId}] }
    //   (boş seçim → levels:[] gönderilir, mapping temizlenir)
    var meGroupSelEl = document.getElementById('me-group');
    var _meGroupsReady = null;

    function meGroupBuildOptions(items) {
        if (!meGroupSelEl) return;
        var prevValue = meGroupSelEl.value;
        var opts = '<option value="">Seçiniz</option>';
        (items || []).forEach(function (g) {
            opts += '<option value="' + g.id + '">' + (g.code || '') + (g.description ? ' — ' + g.description : '') + '</option>';
        });
        meGroupSelEl.innerHTML = opts;
        if (prevValue && Array.prototype.some.call(meGroupSelEl.options, function (o) { return o.value === prevValue; })) {
            meGroupSelEl.value = prevValue;
        }
    }

    function meGroupFetchOptions() {
        return fetch('/Definitions/GetCardGroups?cardType=3&level=1', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (data) {
                var items = Array.isArray(data) ? data : (data.items || []);
                meGroupBuildOptions(items);
                return items;
            })
            .catch(function (e) { console.error('[ME] grup listesi yuklenemedi:', e); return []; });
    }

    function meGroupLoadExistingMapping() {
        if (!idVal) return Promise.resolve();
        return fetch('/Definitions/GetCardGroupMappings?entityType=3&entityId=' + idVal, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (data) {
                var mappings = Array.isArray(data) ? data : (data.items || data.mappings || []);
                var lvl1 = mappings.find(function (m) { return m.level === 1; });
                if (meGroupSelEl && lvl1 && lvl1.cardGroupId) meGroupSelEl.value = String(lvl1.cardGroupId);
            })
            .catch(function (e) { console.error('[ME] grup atamasi yuklenemedi:', e); });
    }

    // Sayfa acilisinda hemen yuklenir (tab tiklanmasini beklemez — MaterialCardEdit'in
    // aksine tek dropdown oldugu icin lazy-load'a gerek yok). meGroupsSave da ayni
    // promise'i bekler; Kaydet erken tiklansa bile guncel secim uzerinden gonderilir
    // (yaris durumu / mevcut atamanin sessizce silinmesi riski yok).
    function meGroupsEnsureLoaded() {
        if (!_meGroupsReady) {
            _meGroupsReady = meGroupFetchOptions().then(function () {
                return meGroupLoadExistingMapping();
            });
        }
        return _meGroupsReady;
    }
    meGroupsEnsureLoaded();

    window.meGroupsSave = function (machineIdOverride) {
        var entityId = machineIdOverride || (idVal ? parseInt(idVal, 10) : 0);
        if (!entityId) return Promise.resolve({ success: true, skipped: true });
        return meGroupsEnsureLoaded().then(function () {
            var v = meGroupSelEl ? meGroupSelEl.value : '';
            var levels = v ? [{ level: 1, cardGroupId: parseInt(v, 10) }] : [];
            var payload = { entityType: 3, entityId: String(entityId), levels: levels };
            return fetch('/Definitions/SaveCardGroupMappings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf() },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            }).then(function (r) { return r.json().catch(function () { return { success: r.ok }; }); });
        }).catch(function (e) {
            console.error('[ME] grup kaydi hata:', e);
            return { success: false, message: e.message };
        });
    };

    // ── Save ──
    var saveBtn = document.getElementById('me-save');
    if (saveBtn) {
        saveBtn.addEventListener('click', function () {
            var locId = parseInt(document.getElementById('me-location-id').value, 10) || 0;
            var name  = (document.getElementById('me-name').value || '').trim();
            var invalid = false;
            if (!locId) { shake('me-location'); invalid = true; }
            if (!name)  { shake('me-name');     invalid = true; }
            if (invalid) { activateTab('general'); return; }

            var payload = {
                id:           idVal ? parseInt(idVal) : null,
                locationId:   locId,
                machineCode:  codeVal,
                machineName:  name,
                hourlyCapacity: null,
                sortOrder:    parseInt(document.getElementById('me-sort').value) || 0,
                isActive:     document.getElementById('me-active').checked
            };
            saveBtn.disabled = true;
            setErr('');
            fetch('/Logistics/SaveMachineJson', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf() },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.success) {
                    var newId = (d && d.id) || (idVal ? parseInt(idVal) : 0);
                    var dyn = window._meDynRenderer;
                    var widgetSavePromise = Promise.resolve();
                    if (dyn && typeof dyn.save === 'function' && newId > 0) {
                        try {
                            widgetSavePromise = Promise.resolve(dyn.save({ recordId: String(newId) }))
                                .catch(function (err) { console.warn('[ME] widget save hata:', err); });
                        } catch (e) { console.warn('[ME] widget save catch:', e); }
                    }
                    // ── Grup eslestirmesini de ayni save akisinda kaydet ──
                    // Not: basarisizlik "success:false" ile gelmeyebilir — 400 BadRequest
                    // {error:...} doner, 403 (yetki yok) {ok:false,message:...} doner
                    // (PermissionEnforcementFilter.MakeForbidResult). Bu yuzden basari
                    // yalnizca res.success === true ile teyit edilir, diger her durum loglanir.
                    var groupSavePromise = (typeof window.meGroupsSave === 'function' && newId > 0)
                        ? window.meGroupsSave(newId).then(function (res) {
                              if (res && !res.skipped && res.success !== true) {
                                  console.warn('[ME] grup eslestirme kaydi basarisiz:', (res.message || res.error || 'Bilinmeyen hata'));
                              }
                          }).catch(function (err) { console.warn('[ME] group save hatasi:', err); })
                        : Promise.resolve();
                    Promise.all([widgetSavePromise, groupSavePromise]).then(function () {
                        window.location.href = '/Logistics/Machines';
                    });
                } else {
                    setErr((d && d.message) || 'Kayıt başarısız.');
                    saveBtn.disabled = false;
                }
            })
            .catch(function () { setErr('Bağlantı hatası.'); saveBtn.disabled = false; });
        });
    }

    // ── Delete modal ──
    var deleteBtn = document.getElementById('me-delete');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', function () {
            var name = document.getElementById('me-name').value || codeVal;
            var msgEl = document.getElementById('me-modal-msg');
            if (msgEl) msgEl.innerHTML = '<strong>' + name + '</strong> makinesini silmek istediğinize emin misiniz?';
            document.getElementById('me-modal').style.display = 'flex';
            document.getElementById('me-modal-del').focus();
        });

        var modalDel = document.getElementById('me-modal-del');
        if (modalDel) {
            modalDel.addEventListener('click', function () {
                modalDel.disabled = true;
                modalDel.textContent = 'Siliniyor…';
                fetch('/Logistics/DeleteMachineJson?id=' + idVal, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': csrf() }
                })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d && d.success) {
                        window.location.href = '/Logistics/Machines';
                    } else {
                        meCloseModal();
                        setErr((d && d.message) || 'Silinemedi.');
                    }
                })
                .catch(function () { meCloseModal(); setErr('Bağlantı hatası.'); });
            });
        }
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') meCloseModal();
    });
})();

function meCloseModal() {
    var m = document.getElementById('me-modal');
    if (m) m.style.display = 'none';
    var btn = document.getElementById('me-modal-del');
    if (btn) { btn.disabled = false; btn.textContent = 'Sil'; }
}

// ── DynamicWidgetRenderer mount (stacked layout) ──
(function () {
    var el = document.getElementById('meDynamicWidgets');
    if (!el) return;
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountDynamicWidgetRenderer) return;
        try {
            window._meDynRenderer = window.CalibraHub.mountDynamicWidgetRenderer(el, {
                formCode:    el.getAttribute('data-form-code') || 'MACHINES',
                recordId:    el.getAttribute('data-record-id') || '',
                classPrefix: 'me',
                layout:      'stacked',
                onMounted:   function (handle) {
                    var attempts = 0;
                    var iv = setInterval(function () {
                        attempts++;
                        try {
                            if (handle && typeof handle.getHasWidgets === 'function' && handle.getHasWidgets()) {
                                var nav = document.getElementById('meNavWidgets');
                                if (nav) nav.style.display = '';
                                clearInterval(iv);
                                return;
                            }
                        } catch (_) {}
                        if (attempts > 25) clearInterval(iv);
                    }, 200);
                }
            });
        } catch (e) { console.warn('[ME] mountDynamicWidgetRenderer hatasi:', e); }
    }
    if (window.CalibraHub && window.CalibraHub.mountDynamicWidgetRenderer) {
        doMount();
    } else {
        var cssUrl = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
        var jsUrl  = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
        if (!document.querySelector('link[data-me-bundle]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet'; link.href = cssUrl;
            link.setAttribute('data-me-bundle', '1');
            document.head.appendChild(link);
        }
        if (!document.querySelector('script[data-me-bundle]')) {
            var script = document.createElement('script');
            script.src = jsUrl;
            script.setAttribute('data-me-bundle', '1');
            script.onload  = function () { setTimeout(doMount, 0); };
            script.onerror = function () { console.error('[ME] Bundle yuklenemedi'); };
            document.head.appendChild(script);
        }
    }
})();
</script>

</div>
@* /pdt-tab-content *@
