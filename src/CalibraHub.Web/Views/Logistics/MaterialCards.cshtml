@model CalibraHub.Web.Models.Logistics.MaterialCardsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Malzeme Kartlari";
    @* 2026-07-06: ITEMS → MATERIAL_CARD_EDIT — SmartBoard filtre paneli widget
       formCode'unu body data-form-code'dan okur; ITEMS formu artik seed edilmiyor. *@
    ViewData["FormCode"] = "MATERIAL_CARD_EDIT";
    ViewData["HelpKey"] = "material-cards";
    ViewData["BodyClass"] = "page-material-cards";
    ViewData["DbInfo"] = "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr style='border-bottom:1px solid #e2e8f0;'><td style='padding:6px 8px;font-weight:600;color:#2563eb;white-space:nowrap;'>Items</td><td style='padding:6px 8px;'>Malzeme karti master bilgileri</td></tr>"
        + "<tr style='border-bottom:1px solid #e2e8f0;'><td style='padding:6px 8px;font-weight:600;color:#2563eb;white-space:nowrap;'>dynamic_field_values</td><td style='padding:6px 8px;'>Dinamik alan degerleri</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;white-space:nowrap;'>material_combinations</td><td style='padding:6px 8px;'>Malzeme kombinasyonlari</td></tr>"
        + "</table>";

    // Inline JSON: SmartBoard config (server-side hazirlandi)
    var jsonOpts = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    };
    var boardConfigJson = Model.BoardConfig != null
        ? JsonSerializer.Serialize(Model.BoardConfig, jsonOpts)
        : "null";
}

@section Styles {
<style>
    /* ─────────────────────────────────────────────────────────────────────
       LISTE ACILIS ANIMASYONU (2026-08-26 — Malzeme Kartlari)

       Duzenleme ekraniyla AYNI kurumsal dil: ziplama yok, kisa mesafeden
       yerine oturma. Listeye ozgu fark, SATIRLARIN SIRAYLA belirmesidir.

       KRITIK TASARIM NOTU — neden `.mc-anim-intro` kapisi var:
       Satirlari React (SmartTable) render eder ve arama/filtre her tuslamada
       satirlari YENIDEN olusturur. Saf CSS ile animasyon, yeni olusan her
       satirda TEKRAR calisirdi -> kullanici filtrelerken liste surekli
       "yanip sonerdi". Bu yuzden satir animasyonu yalnizca gövdedeki
       `.mc-anim-intro` sinifi varken gecerlidir; sinif ilk cizimden ~900ms
       sonra JS ile kaldirilir (asagidaki Scripts bolumu). Boylece animasyon
       yalnizca SAYFA ACILISINDA bir kez calisir.

       Yalnizca opacity/transform animlenir -> layout kaymaz.
       ───────────────────────────────────────────────────────────────────── */
    @@keyframes mcEnterDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
    @@keyframes mcEnterUp   { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @@keyframes mcRowIn     { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    /* Board kabugu: baslik seridi + tablo govdesi */
    .page-material-cards.mc-anim-intro #reactSmartBoard > div > div:first-child {
        animation: mcEnterDown 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .page-material-cards.mc-anim-intro .cst-table {
        animation: mcEnterUp 300ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both;
    }

    /* Satirlar sirayla — ilk 12 satir kademeli, sonrasi ayni gecikmede
       (uzun listede bekleme hissi olusmasin; ekranda zaten ~15 satir gorunur). */
    .page-material-cards.mc-anim-intro .cst-row {
        animation: mcRowIn 220ms ease-out both;
    }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(1)  { animation-delay: 150ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(2)  { animation-delay: 175ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(3)  { animation-delay: 200ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(4)  { animation-delay: 222ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(5)  { animation-delay: 242ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(6)  { animation-delay: 260ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(7)  { animation-delay: 276ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(8)  { animation-delay: 290ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(9)  { animation-delay: 302ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(10) { animation-delay: 312ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(11) { animation-delay: 320ms; }
    .page-material-cards.mc-anim-intro .cst-row:nth-child(n+12) { animation-delay: 326ms; }

    @@media (prefers-reduced-motion: reduce) {
        .page-material-cards.mc-anim-intro #reactSmartBoard > div > div:first-child,
        .page-material-cards.mc-anim-intro .cst-table,
        .page-material-cards.mc-anim-intro .cst-row { animation: none !important; }
    }
    .page-material-cards .integrator-dashboard {
        height: 100% !important; min-height: 0 !important;
        padding: 0 !important; max-width: none !important;
        background: transparent !important; box-shadow: none !important;
        border: none !important; border-radius: 0 !important;
    }
    .page-material-cards .integrator-dashboard__content {
        display: flex !important; flex-direction: column !important;
        width: 100% !important; max-width: none !important;
        min-height: 0 !important; padding: 0 !important;
        margin: 0 !important; overflow: hidden !important;
    }
    .workspace-frame-body.page-material-cards .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column;
        overflow: hidden; padding: 0;
    }
    .workspace-frame-body.page-material-cards .integrator-dashboard {
        flex: 1 1 auto; min-height: 0; height: 100%;
    }

</style>
}

<section class="integrator-dashboard integrator-dashboard--wide integrator-dashboard--compact integrator-dashboard__content">
    <div id="reactSmartBoard" style="flex:1 1 auto;min-height:0;overflow:hidden;"></div>
</section>


@section Scripts {
<script>
    // Acilis animasyonu penceresi (2026-08-26): satir animasyonu YALNIZCA sayfa
    // acilisinda calissin. Sinif kaldirilinca sonraki render'lar (arama/filtre/
    // yenileme) animasyonsuz olur — aksi halde her tuslamada liste yanip sonerdi.
    (function () {
        var b = document.body;
        if (!b) return;
        b.classList.add('mc-anim-intro');
        window.setTimeout(function () { b.classList.remove('mc-anim-intro'); }, 900);
    })();
</script>
<script>
(function() {
    var BOARD_CONFIG = @Html.Raw(boardConfigJson);
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';

    var el = document.getElementById('reactSmartBoard');
    if (!el) { console.error('[MC] Mount element yok'); return; }

    function showError(msg) {
        el.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:400px;background:#0c0f1a;color:#f87171;font-size:14px;gap:12px;">'
            + '<div>' + msg + '</div>'
            + '<button onclick="location.reload()" style="padding:8px 20px;border-radius:8px;border:1px solid #4f46e5;background:#6366f1;color:#fff;cursor:pointer;font-size:13px;">Sayfayi Yenile</button>'
            + '</div>';
    }

    function doMount() {
        if (!BOARD_CONFIG) { showError('Board config bulunamadi'); return; }
        if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) {
            showError('SmartBoard mount fonksiyonu bulunamadi');
            return;
        }
        try {
            window.CalibraHub.mountSmartBoard(el, BOARD_CONFIG);
            console.log('[MC] SmartBoard mounted,', (BOARD_CONFIG.entities || []).length, 'entity');
        } catch (ex) {
            console.error('[MC] Mount exception:', ex);
            showError('Mount hatasi: ' + (ex.message || ex));
        }
    }

    // ── Dinamik CSS yukle (onceki link varsa kaldir) ─
    function loadCss() {
        var prev = document.querySelector('link[data-mc-smartboard]');
        if (prev) prev.parentNode.removeChild(prev);
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = CSS_URL;
        link.setAttribute('data-mc-smartboard', '1');
        document.head.appendChild(link);
    }

    // ── Dinamik JS bundle yukle ──────────────────
    function loadScript(cb) {
        var prev = document.querySelector('script[data-mc-smartboard]');
        if (prev) prev.parentNode.removeChild(prev);
        var script = document.createElement('script');
        script.src = BUNDLE_URL;
        script.setAttribute('data-mc-smartboard', '1');
        script.onload = function() {
            console.log('[MC] Bundle loaded, typeof window.CalibraHub =', typeof window.CalibraHub);
            setTimeout(cb, 0);
        };
        script.onerror = function() {
            console.error('[MC] Bundle script failed to load!');
            showError('Bundle yuklenemedi (network hatasi)');
        };
        document.head.appendChild(script);
    }

    loadCss();

    // Bundle zaten yuklu ise (ayni session ikinci ziyaret) hemen mount et
    if (window.CalibraHub && window.CalibraHub.mountSmartBoard) {
        console.log('[MC] Bundle already loaded, direct mount');
        doMount();
    } else {
        console.log('[MC] Bundle not ready, loading dynamically');
        loadScript(doMount);
    }

    // bfcache — geri dugmesi ile gelince reload
    window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
            console.log('[MC] bfcache detected, reloading');
            location.reload();
        }
    });

    // Alan Rehberi sayfasinda widget eklenince/silinince/aktif degisince
    // localStorage'a 'calibra:widget-schema-changed' yazilir + custom event
    // dispatch edilir. Hem ayni tab'daki workspace icindeki Alan Rehberi'nden
    // hem de farkli tab'lardan gelen invalidasyonu yakalar.
    function onWidgetSchemaChanged() {
        console.log('[MC] widget schema changed → reloading');
        location.reload();
    }
    window.addEventListener('storage', function(e) {
        if (e && e.key === 'calibra:widget-schema-changed') onWidgetSchemaChanged();
    });
    window.addEventListener('calibra:widget-schema-changed', onWidgetSchemaChanged);
})();

</script>
}
