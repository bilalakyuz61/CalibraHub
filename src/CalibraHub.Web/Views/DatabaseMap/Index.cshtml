@*
    Veritabanı Haritası — tablo ilişkilerinin gezilebilir görselleştirmesi.

    Erişim SystemAdmin-only (SetupDefinitions): ekran şemanın TAMAMINI — tablo adları,
    kolon adları, satır sayıları — açığa çıkarır. DatabaseMetadataController ve /ViewBuilder
    ile birebir aynı kapı (CLAUDE.md "DepartmentManager Rolü": SetupDefinitions dev/sistem
    kovasıdır, admin'e açılmaz).

    Veri /api/database/map ucundan gelir; ekran hiçbir şey yazmaz (salt okunur).
*@
@{
    ViewData["Title"] = "Veritabanı Haritası";
    ViewData["FormCode"] = "SETUP_DEFINITIONS";
    ViewData["HelpKey"] = "database-map";
    ViewData["BodyClass"] = "page-database-map";
    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>sys.tables</td><td style='padding:6px 8px;'>Düğümler — tablo adı, kolon sayısı, yaklaşık satır sayısı (sys.partitions)</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>sys.foreign_keys</td><td style='padding:6px 8px;'>Kesin ilişkiler — düz çizgi</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>sys.columns</td><td style='padding:6px 8px;'>Kısıtı olmayan &lt;Tablo&gt;Id kolonlarından çıkarılan ilişkiler — kesik çizgi</td></tr>"
        + "</table>";
}

@section Styles {
<style>
    .workspace-frame-body.page-database-map .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }
    #databaseMapRoot { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; }
</style>
}

<div id="databaseMapRoot"></div>

@section Scripts {
<script>
(function () {
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('databaseMapRoot');

    function showError(msg) { if (el) el.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:13px;">' + msg + '</div>'; }
    function loadCss() {
        if (document.querySelector('link[data-dbm-css]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL; link.setAttribute('data-dbm-css', '1');
        document.head.appendChild(link);
    }
    function loadScript(cb) {
        var prev = document.querySelector('script[data-dbm-js]');
        if (prev) { prev.addEventListener('load', cb); return; }
        var s = document.createElement('script');
        s.src = BUNDLE_URL; s.setAttribute('data-dbm-js', '1');
        s.onload = function () { setTimeout(cb, 0); };
        s.onerror = function () { showError('React bundle yüklenemedi.'); };
        document.head.appendChild(s);
    }
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountDatabaseMap) { showError('mountDatabaseMap bulunamadı.'); return; }
        window.CalibraHub.mountDatabaseMap(el);
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountDatabaseMap) doMount();
    else loadScript(doMount);
})();
</script>
}
