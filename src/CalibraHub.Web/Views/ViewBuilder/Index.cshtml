@{
    ViewData["Title"] = "SQL View Yönetimi";
    ViewData["FormCode"] = "SETUP_DEFINITIONS";
    ViewData["BodyClass"] = "page-view-builder";
    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>ViewDefinition</td><td style='padding:6px 8px;'>Aktif view başına tek override (filtered UNIQUE) — Kind (SystemExtend/Custom), DefinitionJson, GeneratedSql, IsRawMode</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>ViewDefinitionRevision</td><td style='padding:6px 8px;'>Her kaydetme/geri alma öncesi snapshot — Geri Al bu tablodaki son revizyonu tekrar uygular</td></tr>"
        + "</table>";
}

@section Styles {
<style>
    .workspace-frame-body.page-view-builder .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }
    #viewBuilderRoot { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; }
</style>
}

<div id="viewBuilderRoot"></div>

@section Scripts {
<script>
(function () {
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('viewBuilderRoot');

    function showError(msg) { if (el) el.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:13px;">' + msg + '</div>'; }
    function loadCss() {
        if (document.querySelector('link[data-vb-css]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL; link.setAttribute('data-vb-css', '1');
        document.head.appendChild(link);
    }
    function loadScript(cb) {
        var prev = document.querySelector('script[data-vb-js]');
        if (prev) { prev.addEventListener('load', cb); return; }
        var s = document.createElement('script');
        s.src = BUNDLE_URL; s.setAttribute('data-vb-js', '1');
        s.onload = function () { setTimeout(cb, 0); };
        s.onerror = function () { showError('React bundle yüklenemedi.'); };
        document.head.appendChild(s);
    }
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountViewBuilder) { showError('mountViewBuilder bulunamadı.'); return; }
        window.CalibraHub.mountViewBuilder(el, { apiBase: '/api/view-builder' });
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountViewBuilder) doMount();
    else loadScript(doMount);
})();
</script>
}
