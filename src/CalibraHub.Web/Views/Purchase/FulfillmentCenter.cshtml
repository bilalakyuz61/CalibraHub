@Html.AntiForgeryToken()

@* ── MERKEZ MODAL (4 alt aksiyon ortak) — ekran ortası, backdrop+card (CLAUDE.md silme-onay
     deseni). Tek `_lines` kaynağından beslenir; aksiyona göre yalnız kolon seti + onay-butonu +
     submit-hedefi değişir (bkz. Scripts bloğundaki FC_ACTIONS). ── *@
<div class="fc3-modal-backdrop" id="fc3ModalBackdrop" onclick="fc3ModalBackdropClick(event)">
    <div class="fc3-modal" id="fc3Modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
        <div class="fc3-modal-hd">
            <div class="fc3-modal-hd-icon" id="fc3ModalIcon"></div>
            <div class="fc3-modal-hd-tx">
                <strong id="fc3ModalTitle"></strong>
                <small id="fc3ModalSub"></small>
            </div>
            <button type="button" class="fc3-modal-close" onclick="fc3CloseModal()" title="Kapat (Esc)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="fc3-modal-body">

            @* Satın Alma paneli — Belge Tipi (Talep/Sipariş) toggle satırı, yalnız o aksiyon açıkken görünür *@
            <div class="fc3-pr-doctype-row" id="fc3ModalDocTypeRow" style="display:none;">
                <span class="fc3-pr-doctype-lbl">Belge Tipi</span>
                <span class="fc3-ms-chips" id="fc3ModalDocTypeChips">
                    <label class="fc3-ms-chip active" data-doctype="demand">
                        <input type="radio" name="fc3ModalPrDocType" value="demand" checked>
                        Satın Alma Talebi
                    </label>
                    <label class="fc3-ms-chip" data-doctype="order">
                        <input type="radio" name="fc3ModalPrDocType" value="order">
                        Satın Alma Siparişi
                    </label>
                </span>
            </div>

            @* Depodan Karşıla — opsiyonel kaynak depo override'ı (2026-07-25, PageComment Seq 26
               birleşimi). Boş bırakılırsa mevcut otomatik davranış (parametreden çözüm + talep
               deposu eşleşmeyen kalem reddi) AYNEN çalışır. Depo seçilirse TÜM seçili kalemler o
               depodan karşılanır ve eşleşme reddi bu çağrı için uygulanmaz — kaldırılan "Ambar
               Çıkış Fişi" aksiyonunun serbest depo seçimi yeteneğinin birebir karşılığı. Yalnız
               'fulfill' aksiyonu açıkken görünür (bkz. fc3RenderModal).
               PageComment Seq 48 (2026-07-29): depo seçilince "Durum" kolonu YALNIZ o depodaki
               bakiyeyi baz alarak uyarır — yetersizse UYAR ama İZİN VER (kısmi karşılama serbest,
               submit/buton hiçbir zaman bloklanmaz, bkz. fc3UpdateLocOverrideWarnings). *@
            <div class="fc3-pr-doctype-row" id="fc3ModalLocOverrideRow" style="display:none;">
                <span class="fc3-pr-doctype-lbl">Kaynak Depo (opsiyonel)</span>
                <select id="fc3ModalLocOverride" class="fc3-ts" style="max-width:220px;" onchange="fc3ModalLocOverrideChange(this)">
                    <option value="">— Otomatik (parametre) —</option>
                </select>
            </div>
            <div id="fc3ModalLocOverrideWarn" class="fc3-res fc3-res--warn" style="margin-bottom:9px;"></div>

            @* Depodan Karşıla — "Stokları Kümüle Et" (PageComment Seq 39, 2026-07-25): karşı fişte
               aynı malzeme/kaynak depo/kombinasyon/birime sahip kalemlerin tek satırda toplanıp
               toplanmayacağını kullanıcı her karşılamada seçer. Modal açılışındaki varsayılan durum
               STOCK_DOC_CONSOLIDATE şirket parametresinin GÜNCEL değerini yansıtır (bkz.
               fc3FetchCumulateDefault + fc3OpenModal) — switch'e hiç dokunulmazsa davranış bugünküyle
               birebir aynı kalır, bu yalnızca bir seçenek ekler. Karşılama defteri (İhtiyaç satırı
               bazlı kayıtlar) bu seçimden ETKİLENMEZ. Yalnız 'fulfill' aksiyonu açıkken görünür. *@
            <div class="fc3-pr-doctype-row" id="fc3ModalCumulateRow" style="display:none;">
                <span class="fc3-pr-doctype-lbl">Stokları Kümüle Et</span>
                <label class="fc3-switch">
                    <input type="checkbox" id="fc3ModalCumulate" onchange="fc3ModalCumulateToggle(this)">
                    <span class="fc3-switch-track" id="fc3ModalCumulateTrack">
                        <span class="fc3-switch-thumb"></span>
                    </span>
                    <span class="fc3-switch-label" id="fc3ModalCumulateLabel">Pasif</span>
                </label>
            </div>

            @* Tablo modu — Depodan Karşıla / Depo Transferi / Satın Alma *@
            <div class="fc3-modal-tablewrap" id="fc3ModalTableWrap">
                <table class="fc3-modal-tbl">
                    <thead><tr id="fc3ModalThead"></tr></thead>
                    <tbody id="fc3ModalTbody"></tbody>
                </table>
            </div>

            @* Basit metin modu — İhtiyacı Kapat (tablo yerine onay metni + çıkarılabilir isim listesi) *@
            <div id="fc3ModalSimpleText" style="display:none;"></div>

            <div id="fc3ModalNotesWrap">
                <label style="font-size:.73rem;color:#64748b;display:block;margin-bottom:3px;">Notlar</label>
                <textarea id="fc3ModalNotes" class="fc3-ti" rows="2" placeholder="Opsiyonel…"></textarea>
            </div>
        </div>
        <div class="fc3-modal-ft">
            <span class="fc3-res" id="fc3ModalMsg"></span>
            <div class="fc3-modal-ft-btns">
                <button type="button" class="fc3-btn fc3-btn--g" id="fc3ModalCancelBtn" onclick="fc3CloseModal()">Vazgeç</button>
                <button type="button" class="fc3-btn fc3-modal-ok" id="fc3ModalOkBtn" onclick="fc3ModalSubmit()"></button>
            </div>
        </div>
    </div>
</div>

@* ── SÜTUN AYARLARI DRAWER ── *@
<div class="fc3-col-drw-backdrop" id="fc3ColBackdrop" onclick="fc3CloseColPanel()"></div>
<div class="fc3-col-panel" id="fc3ColPanel" data-nodirty>
    <div class="fc3-drw-hd">
        <div class="fc3-drw-hd-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/>
                <circle cx="18" cy="12" r="2"/><line x1="4" y1="18" x2="11" y2="18"/><circle cx="15" cy="18" r="2"/>
            </svg>
        </div>
        <div class="fc3-drw-hd-tx">
            <strong>Sütun Ayarları</strong>
            <small>Görünürlük, sıralama ve biçim</small>
        </div>
        <button type="button" class="fc3-drw-close" onclick="fc3CloseColPanel()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
    <div id="fc3ColRows" class="fc3-col-rows-inner"></div>
</div>

@* ── DRAWER ── *@
<div class="fc3-drawer-backdrop" id="fc3Backdrop" onclick="fc3BackdropClick()"></div>
<div class="fc3-drawer" id="fc3Drawer" data-nodirty>

    <div class="fc3-drw-hd">
        <div class="fc3-drw-hd-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
        </div>
        <div class="fc3-drw-hd-tx">
            <strong>Filtreler</strong>
            <small id="fc3FiltDesc">Tüm kayıtlar görünüyor</small>
        </div>
        <button class="fc3-drw-close" onclick="fc3CloseDrawer()" title="Kapat (Esc)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>

    <div class="fc3-drw-body" id="fc3DrwBody">

        @* ── Filtre kartı ── *@
        <div class="fc3-filter-card">
            <div class="fc3-filter-hd">
                <span>Filtre Satırları</span>
                <button class="fc3-filter-reset" onclick="fc3ResetFilters()">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Temizle
                </button>
            </div>

            @* Metin ve sayı filtreleri *@
            <table class="fc3-ftbl">
                <tr data-field="docNo">
                    <td class="fc3-fl">Belge No</td>
                    <td class="fc3-fop-c">
                        <select class="fc3-fop">
                            <option value="contains">~ İçerir</option>
                            <option value="startsWith">⊏ Başlar</option>
                            <option value="eq">= Eşittir</option>
                        </select>
                    </td>
                    <td class="fc3-fv-c"><input type="text" class="fc3-fv" placeholder="Belge numarası..." maxlength="30" oninput="applyFilters()"></td>
                </tr>
                <tr data-field="date">
                    <td class="fc3-fl">Tarih</td>
                    <td class="fc3-fop-c">
                        <select class="fc3-fop" onchange="fc3DateOpChange(this)">
                            <option value="gte">≥ Sonra</option>
                            <option value="lte">≤ Önce</option>
                            <option value="eq">= Eşit</option>
                            <option value="between">↔ Arasında</option>
                        </select>
                    </td>
                    <td class="fc3-fv-c">
                        <div class="fc3-date-wrap">
                            <input type="date" class="fc3-fv fc3-date-1" onchange="applyFilters()">
                            <input type="date" class="fc3-fv fc3-date-2" style="display:none;" onchange="applyFilters()">
                        </div>
                    </td>
                </tr>

            </table>

            @* Talep Eden — dropdown accordion *@
            <div class="fc3-filt-dd" id="fc3DdReq">
                <div class="fc3-dd-trigger" onclick="fc3ToggleDd('fc3DdReq')">
                    <span class="fc3-dd-lbl">Talep Eden</span>
                    <span class="fc3-dd-val" id="fc3ReqLbl">herhangi biri</span>
                    <svg class="fc3-dd-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <div class="fc3-dd-body">
                    <input type="text" class="fc3-ms-search" id="fc3ReqSearch" placeholder="Kişi ara…" oninput="fc3FilterReqList(this.value)">
                    <div class="fc3-ms-list" id="fc3MsReqList">
                        <div class="fc3-ms-empty">Yükleniyor…</div>
                    </div>
                </div>
            </div>

            @* Durum — dropdown accordion *@
            <div class="fc3-filt-dd" id="fc3DdStat">
                <div class="fc3-dd-trigger" onclick="fc3ToggleDd('fc3DdStat')">
                    <span class="fc3-dd-lbl">Durum</span>
                    <span class="fc3-dd-val has-sel" id="fc3StatLbl">Onaylı</span>
                    <svg class="fc3-dd-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <div class="fc3-dd-body">
                    <div class="fc3-ms-list" id="fc3MsStatList"></div>
                </div>
            </div>

            @* Karşılama Durumu — chip toggle *@
            <div class="fc3-filt-sect">
                <div class="fc3-filt-sect-lbl">
                    Karşılama
                    <small id="fc3FulfillLbl">herhangi biri</small>
                </div>
                <div class="fc3-ms-chips" id="fc3MsFulfillChips">
                    <label class="fc3-ms-chip" data-val="pending">
                        <input type="checkbox" class="fc3-ms-cb-fulfill" value="pending" style="display:none;">
                        <span class="fc3-dot" style="background:#64748b"></span>Bekliyor
                    </label>
                    <label class="fc3-ms-chip" data-val="partial">
                        <input type="checkbox" class="fc3-ms-cb-fulfill" value="partial" style="display:none;">
                        <span class="fc3-dot" style="background:#fbbf24"></span>Kısmen
                    </label>
                    <label class="fc3-ms-chip" data-val="full">
                        <input type="checkbox" class="fc3-ms-cb-fulfill" value="full" style="display:none;">
                        <span class="fc3-dot" style="background:#34d399"></span>Tamamlandı
                    </label>
                </div>
            </div>

            @* Cari Grubu — chip toggle (dinamik, JS tarafında doldurulur) *@
            <div class="fc3-filt-sect" id="fc3CariGrpSect" style="display:none;">
                <div class="fc3-filt-sect-lbl">
                    Cari Grubu
                    <small id="fc3CgLbl">herhangi biri</small>
                </div>
                <div class="fc3-ms-chips" id="fc3MsCgChips"></div>
            </div>

            @* Kalem Grubu — chip toggle (dinamik, JS tarafında doldurulur) *@
            <div class="fc3-filt-sect" id="fc3KalemGrpSect" style="display:none;">
                <div class="fc3-filt-sect-lbl">
                    Kalem Grubu
                    <small id="fc3KgLbl">herhangi biri</small>
                </div>
                <div class="fc3-ms-chips" id="fc3MsKgChips"></div>
            </div>

            @* Malzeme Arama *@
            <div class="fc3-filt-sect">
                <div class="fc3-filt-sect-lbl">
                    Malzeme <small id="fc3MatLbl">herhangi biri</small>
                </div>
                <input type="text" class="fc3-ms-search" id="fc3MatSearch" placeholder="Malzeme kodu veya adı..." oninput="applyFilters()">
            </div>

            @* Widget filtreleri — JS init tarafından dinamik eklenir *@
            <div id="fc3WdgSects"></div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function() {
    var ALL  = @Html.Raw(requestsJson);
    var LOCS = @Html.Raw(locsJson);
    var PENDING_APPROVAL_IDS = new Set(@Html.Raw(pendingApprovalIdsJson));
    // Onay tetikleme açıksa yalnızca Onaylı belgeler seçilebilir; kapalıysa tümü.
    var APPROVAL_REQUIRED = @(approvalRequired ? "true" : "false");

    // Bir ihtiyaç belgesinin karşılama için seçilip seçilemeyeceği (tek karar noktası).
    function fc3DocCanSelect(r) {
        // Açık onay süreci varsa (parametre sonradan kapatılsa bile) belge önce onayını
        // tamamlamalı — her durumda seçilemez.
        if (PENDING_APPROVAL_IDS.has(r.id)) return false;
        if (APPROVAL_REQUIRED) {
            // Onay açık: yalnızca durumu Onaylı olan belgeler
            return r.status === 'Approved';
        }
        // Onay kapalı: iptal/kapatılan/reddedilen dışında tümü
        return r.status !== 'Rejected' && r.status !== 'Cancelled' && r.status !== 'Closed';
    }

    // ── Grup haritaları: contactId/docId → grup adı(ları) ───────────────────
    var CONTACT_GROUP_MAP = @Html.Raw(contactGroupMapJson);  // { "123": "Toptan" }
    var ITEM_GROUP_MAP    = @Html.Raw(itemGroupMapJson);     // { "5": ["Elektronik","A Grubu"] }

    // ── Widget tanımları + değerleri ─────────────────────────────────────────
    var WIDGET_DEFS  = @Html.Raw(widgetDefsJson);       // [{id,label,dataType,level}]
    var MASTER_WVAL  = @Html.Raw(masterWidgetValJson);  // {"42":{"w_dept":"Üretim",...}}
    var LINE_WVAL    = @Html.Raw(lineWidgetValJson);     // {"42":{"w_cat":["Elm","Mek"]}}
    var MATERIAL_MAP = @Html.Raw(materialMapJson);       // {"42":[{code,name,hasStock}]}

    // ALL kayıtlarına grup + widget bilgisini merge et
    ALL.forEach(function(r) {
        var k = String(r.id);
        if (r.contactId && CONTACT_GROUP_MAP) {
            var cg = CONTACT_GROUP_MAP[String(r.contactId)];
            if (cg) r.contactGroupName = cg;
        }
        if (ITEM_GROUP_MAP) {
            var ig = ITEM_GROUP_MAP[k];
            if (ig && ig.length) r.itemGroupNames = ig;
        }
        if (MASTER_WVAL && MASTER_WVAL[k]) r.mw = MASTER_WVAL[k];
        if (LINE_WVAL   && LINE_WVAL[k])   r.lw = LINE_WVAL[k];
        if (MATERIAL_MAP) {
            var mm = MATERIAL_MAP[k];
            if (mm && mm.length) r.materialItems = mm;
        }
    });

    // ── Widget değer çıkarma yardımcıları ────────────────────────────────────
    function wdgStrings(val) {
        // object? → string[] (WidgetRenderDto.Value çeşitleri: string, bool, number, string[])
        if (val == null) return [];
        if (Array.isArray(val)) return val.map(String).filter(Boolean);
        if (typeof val === 'boolean') return [val ? 'Evet' : 'Hayır'];
        var s = String(val).trim();
        return s ? [s] : [];
    }
    function wdgValuesForRecord(r, wd) {
        if (wd.level === 'master') return wdgStrings((r.mw || {})[wd.id]);
        return ((r.lw || {})[wd.id]) || [];
    }

    var S_DOT = { Draft:'#64748b', Sent:'#60a5fa', Approved:'#34d399',
                  Rejected:'#f87171', Cancelled:'#475569', Closed:'#818cf8' };

    var _vis = [], _lines = [], _stock = {}, _tmr = null;
    var _docLineCache   = {};  // { docId: [...] }   — kalemler
    var _globalStockMap = {};  // { itemId: [...] }  — stok
    var _lineSel        = {};  // { lineId: { docId, itemId } }
    var _collapsedGroups = {}; // { gpath: true }     — katlanmış grup yolları

    // ── Filtre Drawer aç/kapat ──────────────────────────────────────────────
    window.fc3OpenDrawer = function() {
        document.getElementById('fc3Backdrop').classList.add('open');
        document.getElementById('fc3Drawer').classList.add('open');
    };
    window.fc3CloseDrawer = function() {
        document.getElementById('fc3Drawer').classList.remove('open');
        document.getElementById('fc3Backdrop').classList.remove('open');
    };
    window.fc3BackdropClick = function() {
        document.getElementById('fc3Drawer').classList.remove('open');
        document.getElementById('fc3Backdrop').classList.remove('open');
    };
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') fc3CloseDrawer(); });

    // ── Dropdown accordion (Talep Eden / Durum) ───────────────────────────────
    window.fc3ToggleDd = function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.toggle('open');
    };

    // ── Tarih operatör değişimi ───────────────────────────────────────────────
    window.fc3DateOpChange = function(sel) {
        var row = sel.closest('tr');
        var d2  = row.querySelector('.fc3-date-2');
        var between = sel.value === 'between';
        if (d2) { d2.style.display = between ? '' : 'none'; if (!between) d2.value = ''; }
        applyFilters();
    };

    // ── Durum checkbox listesi ────────────────────────────────────────────────
    var STAT_ITEMS = [
        { val: 'Draft',     label: 'Taslak',          dot: '#64748b' },
        { val: 'Sent',      label: 'Onay Bekliyor',   dot: '#60a5fa' },
        { val: 'Approved',  label: 'Onaylı',           dot: '#34d399' },
        { val: 'Rejected',  label: 'Reddedildi',      dot: '#f87171' },
        { val: 'Cancelled', label: 'Kapatıldı / İptal', dot: '#475569' },
    ];

    function renderStatList(checkedArr) {
        var drop = document.getElementById('fc3MsStatList');
        if (!drop) return;
        var checked;
        if (checkedArr !== null && checkedArr !== undefined) {
            checked = new Set(checkedArr);
        } else {
            checked = new Set(
                Array.from(drop.querySelectorAll('.fc3-ms-cb-stat:checked'))
                    .map(function(cb) { return cb.value; })
                    .filter(function(v) { return v !== '__all__'; })
            );
        }
        var hasSpecific = STAT_ITEMS.some(function(s) { return checked.has(s.val); });
        var html = '<label class="fc3-ms-opt"><input type="checkbox" class="fc3-cb fc3-ms-cb-stat" value="__all__"'
            + (!hasSpecific ? ' checked' : '') + ' onchange="fc3StatChange(this)"> Tümü</label>';
        html += STAT_ITEMS.map(function(s) {
            return '<label class="fc3-ms-opt"><input type="checkbox" class="fc3-cb fc3-ms-cb-stat" value="' + s.val + '"'
                + (checked.has(s.val) ? ' checked' : '') + ' onchange="fc3StatChange(this)">'
                + ' <span class="fc3-dot" style="background:' + s.dot + '"></span>' + s.label + '</label>';
        }).join('');
        drop.innerHTML = html;
    }

    window.fc3StatChange = function(el) {
        if (el.value === '__all__') {
            document.querySelectorAll('.fc3-ms-cb-stat').forEach(function(cb) {
                cb.checked = (cb.value === '__all__');
            });
        } else {
            var allCb = document.querySelector('.fc3-ms-cb-stat[value="__all__"]');
            if (allCb) allCb.checked = false;
            var anySel = Array.from(document.querySelectorAll('.fc3-ms-cb-stat:checked'))
                .some(function(cb) { return cb.value !== '__all__'; });
            if (!anySel && allCb) allCb.checked = true;
        }
        _updateStatLbl();
        applyFilters();
    };

    function _updateStatLbl() {
        var sel = Array.from(document.querySelectorAll('.fc3-ms-cb-stat:checked'))
            .filter(function(cb) { return cb.value !== '__all__'; });
        var lbl = document.getElementById('fc3StatLbl');
        if (!lbl) return;
        if (sel.length === 0) {
            lbl.textContent = 'herhangi biri'; lbl.classList.remove('has-sel');
        } else if (sel.length === 1) {
            var item = STAT_ITEMS.find(function(s) { return s.val === sel[0].value; });
            lbl.textContent = item ? item.label : '1 seçili'; lbl.classList.add('has-sel');
        } else {
            lbl.textContent = sel.length + ' seçili'; lbl.classList.add('has-sel');
        }
    }

    // ── Karşılama chip toggle ─────────────────────────────────────────────────
    document.querySelectorAll('#fc3MsFulfillChips .fc3-ms-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var cb = chip.querySelector('.fc3-ms-cb-fulfill');
            if (!cb) return;
            cb.checked = !cb.checked;
            chip.classList.toggle('active', cb.checked);
            var sel = Array.from(document.querySelectorAll('.fc3-ms-cb-fulfill:checked'));
            var lbl = document.getElementById('fc3FulfillLbl');
            if (lbl) lbl.textContent = sel.length ? sel.length + ' seçili' : 'herhangi biri';
            applyFilters();
        });
    });

    // ── Talep eden listesi ────────────────────────────────────────────────────
    var _reqAll = (function() {
        var set = new Set();
        ALL.forEach(function(r) {
            var who = (r.requesterPersonnelName || r.contactName || '').trim();
            if (who) set.add(who);
        });
        return Array.from(set).sort(function(a, b) { return a.localeCompare(b, 'tr'); });
    })();

    function renderReqList(q) {
        var drop = document.getElementById('fc3MsReqList');
        if (!drop) return;
        var items = q ? _reqAll.filter(function(n) { return n.toLowerCase().indexOf(q.toLowerCase()) >= 0; }) : _reqAll;
        var checkedVals = new Set(
            Array.from(document.querySelectorAll('.fc3-ms-cb-req:checked'))
                .map(function(cb) { return cb.value; })
                .filter(function(v) { return v !== '__all__'; })
        );
        var hasSpecificReq = checkedVals.size > 0;
        // Tümü daima başta
        var html = '<label class="fc3-ms-opt"><input type="checkbox" class="fc3-cb fc3-ms-cb-req" value="__all__"'
            + (!hasSpecificReq ? ' checked' : '') + ' onchange="fc3ReqChange(this)"> Tümü</label>';
        if (!items.length) {
            html += '<div class="fc3-ms-empty">' + (q ? 'Eşleşme yok' : 'Talep eden bulunamadı') + '</div>';
        } else {
            html += items.map(function(name) {
                var safe = esc(name);
                return '<label class="fc3-ms-opt"><input type="checkbox" class="fc3-cb fc3-ms-cb-req" value="' + safe + '"'
                    + (checkedVals.has(name) ? ' checked' : '') + ' onchange="fc3ReqChange(this)"> ' + safe + '</label>';
            }).join('');
        }
        drop.innerHTML = html;
    }

    window.fc3FilterReqList = function(q) { renderReqList(q); };

    window.fc3ReqChange = function(el) {
        if (el && el.value === '__all__') {
            document.querySelectorAll('.fc3-ms-cb-req').forEach(function(cb) {
                cb.checked = (cb.value === '__all__');
            });
        } else if (el) {
            var allCb = document.querySelector('.fc3-ms-cb-req[value="__all__"]');
            if (allCb) allCb.checked = false;
            var anySel = Array.from(document.querySelectorAll('.fc3-ms-cb-req:checked'))
                .some(function(cb) { return cb.value !== '__all__'; });
            if (!anySel && allCb) allCb.checked = true;
        }
        var sel = Array.from(document.querySelectorAll('.fc3-ms-cb-req:checked'))
            .filter(function(cb) { return cb.value !== '__all__'; });
        var lbl = document.getElementById('fc3ReqLbl');
        if (lbl) {
            if (sel.length === 0) {
                lbl.textContent = 'herhangi biri'; lbl.classList.remove('has-sel');
            } else if (sel.length === 1) {
                lbl.textContent = sel[0].value; lbl.classList.add('has-sel');
            } else {
                lbl.textContent = sel.length + ' seçili'; lbl.classList.add('has-sel');
            }
        }
        applyFilters();
    };

    // ── Filtre okuma ─────────────────────────────────────────────────────────
    function readFilters() {
        var filters = [];
        document.querySelectorAll('.fc3-ftbl tr[data-field]').forEach(function(row) {
            var field = row.getAttribute('data-field');
            var opEl  = row.querySelector('.fc3-fop');
            var op    = opEl ? opEl.value : 'contains';

            if (field === 'date') {
                var d1El = row.querySelector('.fc3-date-1');
                var d2El = row.querySelector('.fc3-date-2');
                var v1   = d1El ? d1El.value.trim() : '';
                var v2   = d2El ? d2El.value.trim() : '';
                if (op === 'between') { if (v1 || v2) filters.push({ field:'date', op:'between', val:v1, val2:v2 }); }
                else                 { if (v1)        filters.push({ field:'date', op:op,        val:v1,  val2:'' }); }
                return;
            }

            var valEl = row.querySelector('.fc3-fv');
            var val   = valEl ? (valEl.value || '').trim() : '';
            if (val !== '') filters.push({ field:field, op:op, val:val, val2:'' });
        });
        return filters;
    }

    function fieldVal(r, field) {
        if (field === 'docNo')     return (r.documentNumber || '').toLowerCase();
        if (field === 'date')      return r.documentDate || '';

        return '';
    }

    function matchOp(rawVal, op, fv, fv2) {
        if (op === 'between') {
            var d  = new Date(rawVal);
            var d1 = fv  ? new Date(fv)              : null;
            var d2 = fv2 ? new Date(fv2 + 'T23:59:59') : null;
            if (isNaN(d.getTime())) return false;
            if (d1 && d < d1) return false;
            if (d2 && d > d2) return false;
            return d1 != null || d2 != null;
        }
        var v = rawVal.toLowerCase ? rawVal.toLowerCase() : String(rawVal);
        var f = fv ? (fv.toLowerCase ? fv.toLowerCase() : String(fv)) : '';
        if (op === 'contains')   return v.indexOf(f) >= 0;
        if (op === 'startsWith') return v.startsWith(f);
        if (op === 'eq')         return v === f;
        if (op === 'gte')        return new Date(rawVal) >= new Date(fv);
        if (op === 'lte')        return new Date(rawVal) <= new Date(fv + 'T23:59:59');
        return true;
    }

    // ── Filtre uygula ────────────────────────────────────────────────────────
    function fulfillCategory(r) {
        // pending=tüm satırlar bekliyor, full=tüm satırlar tamamlandı, partial=karışık
        if (!r.lineCount) return 'pending';
        if (r.fulfillFull === r.lineCount) return 'full';
        if ((r.fulfillFull || 0) > 0 || (r.fulfillPartial || 0) > 0) return 'partial';
        return 'pending';
    }

    // ── Karşılama filtresi KALEM seviyesinde (rozetle tutarlı: l.fulfillmentStatus) ──
    // Belge-seviyesi fulfillCategory karışık belgede 'partial' döndürüp tamamlanan
    // kalemi de gösteriyordu; artık her kalem kendi durumuna göre elenir.
    var _fulfillSel = [];
    // 3 = İhtiyacı Kapat ile kapatılmış kalem (CloseFulfillmentLines) — mevcut 3 filtre chip'inden
    // (pending/partial/full) hiçbirine karşılık gelmez; "full" gibi varsayılan filtrede görünmez,
    // yalnız "hepsi" (filtre boş) durumunda listelenir ve Kapatıldı rozetiyle gösterilir.
    var _LINE_FCAT = { 0: 'pending', 1: 'partial', 2: 'full', 3: 'closed' };
    function lineFulfillCat(l) { return (l && _LINE_FCAT[l.fulfillmentStatus]) || 'pending'; }
    function visibleLines(r) {
        var lines = _docLineCache[r.id] || [];
        if (!_fulfillSel.length) return lines;
        return lines.filter(function(l) { return _fulfillSel.indexOf(lineFulfillCat(l)) >= 0; });
    }
    // Belge, seçili kategorilerden en az bir kaleme sahipse listede kalır (agregat üzerinden;
    // kalemler henüz yüklenmemiş olabilir). Kalem elemesi render'da visibleLines ile yapılır.
    function docHasFulfillMatch(r, sel) {
        var full = r.fulfillFull || 0, part = r.fulfillPartial || 0;
        var pend = Math.max(0, (r.lineCount || 0) - full - part);
        return (sel.indexOf('full') >= 0 && full > 0)
            || (sel.indexOf('partial') >= 0 && part > 0)
            || (sel.indexOf('pending') >= 0 && pend > 0);
    }

    function effectiveStatus(r) {
        if (PENDING_APPROVAL_IDS.has(r.id)) return 'Sent';  // onay sürecinde → Onay Bekliyor filtresi
        if (r.status === 'Sent')            return 'Draft'; // onay yok → Taslak filtresi
        return r.status;
    }

    function applyFilters() {
        var qsEl    = document.getElementById('fc3QuickSearch');
        var qs      = qsEl ? (qsEl.value || '').trim().toLowerCase() : '';

        var textFilters  = readFilters();
        var reqSel       = Array.from(document.querySelectorAll('.fc3-ms-cb-req:checked')).map(function(cb) { return cb.value.toLowerCase(); }).filter(function(v) { return v !== '__all__'; });
        var statSel      = Array.from(document.querySelectorAll('.fc3-ms-cb-stat:checked')).map(function(cb) { return cb.value; }).filter(function(v) { return v !== '__all__'; });
        var fulfillSel   = Array.from(document.querySelectorAll('.fc3-ms-cb-fulfill:checked')).map(function(cb) { return cb.value; });
        _fulfillSel = fulfillSel;   // render'daki kalem elemesi için sakla
        var cariGrpSel   = Array.from(document.querySelectorAll('.fc3-ms-cb-cg:checked')).map(function(cb) { return cb.value; });
        var kalemGrpSel  = Array.from(document.querySelectorAll('.fc3-ms-cb-kg:checked')).map(function(cb) { return cb.value; });
        var matSearchEl  = document.getElementById('fc3MatSearch');
        var matSearch    = matSearchEl ? (matSearchEl.value || '').trim().toLowerCase() : '';

        _vis = ALL.filter(function(r) {
            if (qs) {
                var docNo  = (r.documentNumber || '').toLowerCase();
                var who    = ((r.requesterPersonnelName || r.contactName) || '').toLowerCase();
                var mats   = (r.materialItems || []).map(function(m) { return ((m.code || '') + ' ' + (m.name || '')).toLowerCase(); }).join(' ');
                if (docNo.indexOf(qs) < 0 && who.indexOf(qs) < 0 && mats.indexOf(qs) < 0) return false;
            }
            if (!textFilters.every(function(f) { return matchOp(fieldVal(r, f.field), f.op, f.val, f.val2); })) return false;
            if (reqSel.length > 0) {
                var who = (r.requesterPersonnelName || r.contactName || '').toLowerCase();
                if (!reqSel.some(function(s) { return who === s; })) return false;
            }
            if (statSel.length > 0) {
                if (statSel.indexOf(effectiveStatus(r)) === -1) return false;
            }
            if (fulfillSel.length > 0) {
                // Belge, seçili kategorilerden ≥1 kaleme sahipse kalır (kalem elemesi render'da)
                if (!docHasFulfillMatch(r, fulfillSel)) return false;
            }
            if (cariGrpSel.length > 0) {
                if (cariGrpSel.indexOf(r.contactGroupName || '') === -1) return false;
            }
            if (kalemGrpSel.length > 0) {
                var rGroups = r.itemGroupNames || [];
                if (!kalemGrpSel.some(function(g) { return rGroups.indexOf(g) >= 0; })) return false;
            }
            if (matSearch) {
                var mats = r.materialItems || [];
                if (!mats.some(function(m) {
                    return ((m.code || '').toLowerCase()).indexOf(matSearch) >= 0
                        || ((m.name || '').toLowerCase()).indexOf(matSearch) >= 0;
                })) return false;
            }
            // Widget filtreleri (her widget için OR, widgetlar arası AND)
            for (var _wi = 0; _wi < (WIDGET_DEFS || []).length; _wi++) {
                var _wd  = WIDGET_DEFS[_wi];
                var _sel = Array.from(document.querySelectorAll(
                    '.fc3-ms-cb-wdg[data-wdg="' + _wd.id + '"]:checked'
                )).map(function(cb) { return cb.value; });
                if (!_sel.length) continue;
                var _wvals = wdgValuesForRecord(r, _wd);
                if (!_sel.some(function(s) { return _wvals.indexOf(s) >= 0; })) return false;
            }
            return true;
        });

        var wdgActiveCount = (WIDGET_DEFS || []).filter(function(wd) {
            return document.querySelectorAll('.fc3-ms-cb-wdg[data-wdg="' + wd.id + '"]:checked').length > 0;
        }).length;

        var total = textFilters.length
            + (reqSel.length > 0 ? 1 : 0)
            + (statSel.length > 0 ? 1 : 0)
            + (fulfillSel.length > 0 ? 1 : 0)
            + (cariGrpSel.length > 0 ? 1 : 0)
            + (kalemGrpSel.length > 0 ? 1 : 0)
            + (matSearch ? 1 : 0)
            + wdgActiveCount;
        var btn   = document.getElementById('fc3FiltBtn');
        var badge = document.getElementById('fc3FiltBadge');
        var desc  = document.getElementById('fc3FiltDesc');
        if (btn)   btn.classList.toggle('has-filters', total > 0);
        if (badge) { badge.textContent = total || ''; badge.classList.toggle('show', total > 0); }
        if (desc)  desc.textContent = total
            ? total + ' filtre aktif · ' + _vis.length + ' kayıt'
            : 'Tüm kayıtlar görünüyor (' + ALL.length + ')';

        renderList();
    }

    window.fc3ResetFilters = function() {
        // Metin/sayı/tarih temizle
        document.querySelectorAll('.fc3-ftbl .fc3-fv').forEach(function(el) { el.value = ''; });
        document.querySelectorAll('.fc3-ftbl .fc3-fop').forEach(function(el) { el.selectedIndex = 0; });
        document.querySelectorAll('.fc3-date-2').forEach(function(el) { el.style.display = 'none'; el.value = ''; });
        // Durum → Tümü'ye sıfırla
        renderStatList([]);
        _updateStatLbl();
        // Karşılama chip
        document.querySelectorAll('.fc3-ms-cb-fulfill').forEach(function(cb) { cb.checked = false; });
        var fl = document.getElementById('fc3FulfillLbl'); if (fl) fl.textContent = 'herhangi biri';
        // Talep eden
        document.querySelectorAll('.fc3-ms-cb-req').forEach(function(cb) { cb.checked = false; });
        var rl = document.getElementById('fc3ReqLbl');  if (rl) { rl.textContent = 'herhangi biri'; rl.classList.remove('has-sel'); }
        var rs = document.getElementById('fc3ReqSearch'); if (rs) rs.value = '';
        renderReqList('');
        // Cari grubu
        document.querySelectorAll('.fc3-ms-cb-cg').forEach(function(cb) { cb.checked = false; });
        document.querySelectorAll('#fc3MsCgChips .fc3-ms-chip').forEach(function(c) { c.classList.remove('active'); });
        var cgl = document.getElementById('fc3CgLbl'); if (cgl) cgl.textContent = 'herhangi biri';
        // Kalem grubu
        document.querySelectorAll('.fc3-ms-cb-kg').forEach(function(cb) { cb.checked = false; });
        document.querySelectorAll('#fc3MsKgChips .fc3-ms-chip').forEach(function(c) { c.classList.remove('active'); });
        var kgl = document.getElementById('fc3KgLbl'); if (kgl) kgl.textContent = 'herhangi biri';
        // Widget filtreleri
        document.querySelectorAll('.fc3-ms-cb-wdg').forEach(function(cb) { cb.checked = false; });
        document.querySelectorAll('#fc3WdgSects .fc3-ms-chip').forEach(function(c) { c.classList.remove('active'); });
        Object.keys(_wdgLblIds).forEach(function(k) {
            var el = document.getElementById(_wdgLblIds[k]);
            if (el) el.textContent = 'herhangi biri';
        });
        // Malzeme arama
        var _ms = document.getElementById('fc3MatSearch'); if (_ms) _ms.value = '';
        var _ml = document.getElementById('fc3MatLbl');    if (_ml) _ml.textContent = 'herhangi biri';
        // Genel arama
        var _qs = document.getElementById('fc3QuickSearch'); if (_qs) _qs.value = '';
        applyFilters();
    };

    // ── Flat liste render ─────────────────────────────────────────────────────
    var FC3_EXTRA_COLS = @Html.Raw(extraColsJson);

    // widthStep (1-5, 3=Otomatik) → inline CSS genişlik stilini döner
    function getWidthStyle(c) {
        var ws = c.widthStep || 3;
        var fw = c.flexWeight || 0;
        switch (ws) {
            case 1: return 'flex:none;min-width:0;width:auto;max-width:58px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;';
            case 2: return 'flex:none;min-width:0;width:auto;max-width:96px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;';
            case 3: return fw > 0 ? 'flex:' + fw + ';' : '';          // Otomatik — CSS class doğal genişliği
            case 4: return 'flex:' + Math.max(fw + 1, 1) + ';min-width:0;width:auto;max-width:none;';
            case 5: return 'flex:' + Math.max(fw + 2, 2) + ';min-width:0;width:auto;max-width:none;';
            default: return fw > 0 ? 'flex:' + fw + ';' : '';
        }
    }

    // Görünür kolonlardan ortak grid şablonu üret — başlık ve satırlar aynı
    // şablonu kullanır, kolon genişliği içerikten bağımsız sabitlenir.
    function fc3GridTemplate(visCols) {
        var t = ['15px']; // checkbox
        visCols.forEach(function(c) {
            var ws = c.widthStep || 3;
            var fw = Math.max(c.flexWeight || 0, 0);
            var w;
            if (ws === 1)      w = '58px';
            else if (ws === 2) w = '96px';
            else if (ws === 4) w = 'minmax(70px,' + Math.max(fw + 1, 1) + 'fr)';
            else if (ws === 5) w = 'minmax(70px,' + Math.max(fw + 2, 2) + 'fr)';
            else {
                // Otomatik — kolon tipine göre deterministik genişlik
                if (c.key === 'num')                    w = '130px';
                else if (c.key === 'who')               w = 'minmax(80px,' + (fw || 1) + 'fr)';
                else if (c.key === 'dt')                w = '70px';
                else if (c.key === 'mat')               w = 'minmax(110px,' + (fw || 1) + 'fr)';
                else if (c.key === 'qty')               w = '72px';
                else if (c.key === 'stk')               w = 'minmax(110px,' + (fw || 1) + 'fr)';
                else if (c.key === 'remain')            w = '64px';
                else if (c.key === 'fst')               w = '100px';
                else if (c.key.indexOf('ext_') === 0)   w = '110px';
                else                                    w = 'minmax(60px,1fr)';
            }
            t.push(w);
            if (c.key === 'qty') t.push('30px'); // birim (unit) eki
        });
        return t.join(' ');
    }

    function renderFlatColHdr() {
        var el = document.getElementById('fc3FlatColHdr');
        if (!el) return;
        var visCols = _colDefs.filter(function(c) { return c.visible; });
        var tpl = fc3GridTemplate(visCols);
        el.style.gridTemplateColumns = tpl;
        var listEl = document.getElementById('fc3List');
        if (listEl) listEl.style.setProperty('--fc3-cols', tpl);
        var h = '<span class="fc3-fhdr__cb"></span>';
        visCols.forEach(function(c) {
            var align = c.align || 'left';
            var hStyle = getWidthStyle(c) + 'text-align:' + align;
            if (c.fontSize)   hStyle += ';font-size:'   + c.fontSize   + 'px';
            if (c.fontWeight) hStyle += ';font-weight:' + c.fontWeight;
            if (c.key === 'qty') {
                h += '<span class="fc3-fhdr__qty" style="' + hStyle + '">' + esc(c.label) + '</span>'
                   + '<span class="fc3-fhdr__unit"></span>';
            } else if (c.key === 'fst') {
                h += '<span class="fc3-fhdr__fst" style="' + hStyle + '">' + esc(c.label) + '</span>';
            } else if (c.key.indexOf('ext_') === 0) {
                h += '<span class="fc3-fhdr__ext" style="' + hStyle + '">' + esc(c.label) + '</span>';
            } else {
                h += '<span class="fc3-fhdr__' + c.key + '" style="' + hStyle + '">' + esc(c.label) + '</span>';
            }
        });
        el.innerHTML = h;
    }

    function loadAllLines() {
        var docIds = ALL.map(function(r) { return r.id; });
        if (!docIds.length) { renderList(); return; }
        var pending = docIds.filter(function(id) { return !_docLineCache[id]; });
        var promises = pending.map(function(id) {
            return fetch('/Purchase/RequestLines?requestIds=' + id)
                .then(function(res) { return res.json(); })
                .then(function(lines) { _docLineCache[id] = Array.isArray(lines) ? lines : []; })
                .catch(function() { _docLineCache[id] = []; });
        });
        Promise.all(promises).then(function() {
            var allItemIds = [];
            docIds.forEach(function(id) {
                (_docLineCache[id] || []).forEach(function(l) {
                    if (l.itemId && allItemIds.indexOf(l.itemId) < 0) allItemIds.push(l.itemId);
                });
            });
            if (!allItemIds.length) { _globalStockMap = {}; renderList(); return; }
            var qry = allItemIds.map(function(id) { return 'itemIds=' + id; }).join('&');
            fetch('/Purchase/StockBalances?' + qry)
                .then(function(r) { return r.json(); })
                .then(function(stockArr) {
                    _globalStockMap = {};
                    (stockArr || []).forEach(function(s) {
                        if (!_globalStockMap[s.itemId]) _globalStockMap[s.itemId] = [];
                        _globalStockMap[s.itemId].push(s);
                    });
                    renderList();
                })
                .catch(function() { _globalStockMap = {}; renderList(); });
        });
    }

    // ── Gruplama değeri (her kolon için) ─────────────────────────────────────
    function getGroupValue(r, l, key) {
        var FSL = { 0: 'Bekliyor', 1: 'Kısmen', 2: 'Tamam', 3: 'Kapatıldı' };
        switch (key) {
            case 'num':    return r.documentNumber || '—';
            case 'who':    return r.requesterPersonnelName || r.contactName || '—';
            case 'dt':     return fmtDate(r.documentDate);
            case 'mat':    return l.materialName || l.materialCode || '—';
            case 'fst':    return PENDING_APPROVAL_IDS.has(r.id) ? 'Onay Sürecinde' : (FSL[l.fulfillmentStatus] || 'Bekliyor');
            case 'stk': {
                var stkArr = _globalStockMap[l.itemId] || [];
                var stkTot = stkArr.reduce(function(a, s) { return a + (s.balance || 0); }, 0);
                var sRem = l.remaining != null ? l.remaining : Math.max(0, (l.quantity||0) - (l.fulfilledFromStock||0) - (l.fulfilledByPurchase||0));
                if (sRem <= 0) return 'Karşılandı';
                if (!stkArr.length) return 'Stok Yok';
                return stkTot >= sRem ? 'Stok Yeterli' : 'Stok Yetersiz';
            }
            default:
                if (key.indexOf('ext_') === 0) {
                    var xKey   = key.slice(4);
                    var xLabel = (FC3_EXTRA_COLS.find(function(ec) { return ec.key === xKey; }) || {}).label || '';
                    return l.extras && l.extras[xLabel] != null ? String(l.extras[xLabel]) : '—';
                }
                return '';
        }
    }

    function renderList() {
        renderFlatColHdr();
        var el = document.getElementById('fc3List');
        if (!el) return;
        var cnt = document.getElementById('fc3AllCnt');

        var allLoaded = _vis.every(function(r) { return _docLineCache[r.id] !== undefined; });
        if (!allLoaded) {
            if (cnt) cnt.textContent = _vis.length + ' belge';
            el.innerHTML = '<div class="fc3-empty-list">Kalemler yükleniyor…</div>';
            return;
        }

        var totalLines = _vis.reduce(function(s, r) { return s + visibleLines(r).length; }, 0);
        if (cnt) cnt.textContent = totalLines + ' kalem';

        if (totalLines === 0) {
            el.innerHTML = '<div class="fc3-empty-list">Filtre koşullarına uygun kayıt yok</div>';
            return;
        }

        var visCols = _colDefs.filter(function(c) { return c.visible; });
        var FS_CLASS = { 0: 'fm-fst--pending', 1: 'fm-fst--partial', 2: 'fm-fst--full', 3: 'fm-fst--cancelled' };
        var FS_LABEL = { 0: 'Bekliyor', 1: 'Kısmen', 2: 'Tamam', 3: 'Kapatıldı' };

        function buildRowHtml(r, l) {
            var who = r.requesterPersonnelName || r.contactName || '—';
            var docHasApproval = PENDING_APPROVAL_IDS.has(r.id);
            var qty     = l.quantity || 0;
            var fromStk = l.fulfilledFromStock || 0;
            var fromPur = l.fulfilledByPurchase || 0;
            var remain  = l.remaining != null ? l.remaining : Math.max(0, qty - fromStk - fromPur);
            var stocks  = _globalStockMap[l.itemId] || [];
            var totalStk = stocks.reduce(function(a, s) { return a + (s.balance || 0); }, 0);

            var stkHtml;
            if (!stocks.length) {
                stkHtml = '<span class="fc3-sk fc3-sk--zero" title="Stok kaydı yok">Stok yok</span>';
            } else {
                var show = stocks.slice(0, 4);
                stkHtml = show.map(function(s) {
                    var bal = s.balance || 0;
                    var cls = bal >= remain && remain > 0 ? 'fc3-sk--ok'
                            : bal > 0 ? 'fc3-sk--warn'
                            : 'fc3-sk--none';
                    return '<span class="fc3-sk ' + cls + '" title="' + esc((s.locationName || '') + ': ' + fmtN(bal) + ' ' + (l.unitCode || '')) + '">'
                        + esc(s.locationName || 'Depo') + ':&thinsp;' + fmtN(bal) + '</span>';
                }).join('');
                if (stocks.length > 4) stkHtml += '<span class="fc3-sk fc3-sk--zero">+' + (stocks.length - 4) + '</span>';
            }

            var remainColor = remain <= 0 ? '#34d399' : (totalStk >= remain ? '#fbbf24' : '#f87171');
            var canSelect = fc3DocCanSelect(r);
            var fstClass, fstLabel;
            if (docHasApproval) {
                fstClass = 'fm-fst--approval'; fstLabel = 'Onay Sürecinde';
            } else if (r.status === 'Rejected') {
                fstClass = 'fm-fst--rejected'; fstLabel = 'Reddedildi';
            } else if (r.status === 'Cancelled' || r.status === 'Closed') {
                fstClass = 'fm-fst--cancelled'; fstLabel = 'Kapatıldı / İptal';
            } else if (canSelect) {
                // İşlem yapılabilir belge → karşılama durumunu göster
                fstClass = FS_CLASS[l.fulfillmentStatus] || FS_CLASS[0];
                fstLabel = FS_LABEL[l.fulfillmentStatus] || FS_LABEL[0];
            } else {
                // Onay açık ama belge henüz onaylanmamış → bilgi amaçlı, seçilemez
                fstClass = 'fm-fst--draft'; fstLabel = 'Taslak';
            }

            var isLineSel = canSelect && !!_lineSel[l.lineId];
            var cbOnClick = 'event.stopPropagation();fc3LineCheck(' + l.lineId + ',' + r.id + ',' + (l.itemId||0) + ')';

            var cells = visCols.map(function(c) {
                var al = c.align || 'left';
                switch(c.key) {
                    case 'num':
                        return '<a class="fc3-flat-num fc3-num-link" href="/Purchase/Edit?type=purchase_request&id=' + r.id + '" style="' + getWidthStyle(c) + 'text-align:' + al + '" onclick="fc3OpenDocTab(event,\'/Purchase/Edit?type=purchase_request&id=' + r.id + '\');return false;">' + esc(r.documentNumber || '') + '</a>';
                    case 'who':
                        return '<span class="fc3-flat-who" style="' + getWidthStyle(c) + 'text-align:' + al + '" title="' + esc(who) + '">' + esc(who) + '</span>';
                    case 'dt':
                        return '<span class="fc3-flat-dt" style="' + getWidthStyle(c) + 'text-align:' + al + '">' + fmtDate(r.documentDate) + '</span>';
                    case 'mat':
                        return '<span class="fc3-sub-mat" style="' + getWidthStyle(c) + 'text-align:' + al + '" title="' + esc(l.materialName || l.materialCode || '') + '">'
                            + esc(l.materialName || l.materialCode || '—') + '</span>';
                    case 'qty':
                        return '<span class="fc3-sub-qty" style="' + getWidthStyle(c) + 'text-align:' + al + '">' + fmtN(qty) + '</span>'
                            + '<span class="fc3-sub-unit">' + esc(l.unitCode || '') + '</span>';
                    case 'stk':
                        return '<span class="fc3-sub-stk" style="' + getWidthStyle(c) + '">' + stkHtml + '</span>';
                    case 'remain':
                        return '<span class="fc3-sub-remain" style="' + getWidthStyle(c) + 'color:' + remainColor + ';text-align:' + al + '" title="Kalan: ' + fmtN(remain) + '">'
                            + fmtN(Math.max(0, remain)) + '</span>';
                    case 'fst':
                        return '<span class="fc3-sub-fst ' + fstClass + '" style="' + getWidthStyle(c) + 'text-align:' + al + '">' + fstLabel + '</span>';
                    default:
                        if (c.key.indexOf('ext_') === 0) {
                            var extKey   = c.key.slice(4);
                            var extLabel = (FC3_EXTRA_COLS.find(function(ec) { return ec.key === extKey; }) || {}).label || '';
                            var val = (l.extras && l.extras[extLabel] != null) ? l.extras[extLabel] : '';
                            return '<span class="fc3-sub-ext fc3-sub-ext-' + extKey + '" style="' + getWidthStyle(c) + '" title="' + esc(val) + '">' + esc(val) + '</span>';
                        }
                        return '';
                }
            }).join('');

            var cbDisableTitle = docHasApproval ? 'Onay sürecinde — önce onay tamamlanmalı'
                               : (r.status === 'Rejected') ? 'Reddedilmiş — seçilemez'
                               : (r.status === 'Cancelled' || r.status === 'Closed') ? 'Kapatılmış — seçilemez'
                               : 'Yalnızca onaylı belgeler seçilebilir';
            return '<div class="fc3-flat-row" data-doc-id="' + r.id + '" data-line-id="' + l.lineId + '">'
                + '<input type="checkbox" class="fc3-sub-cb" data-line-id="' + l.lineId + '"'
                + (!canSelect ? ' disabled title="' + cbDisableTitle + '"' : '')
                + (isLineSel ? ' checked' : '')
                + (canSelect ? ' onclick="' + cbOnClick + '"' : '')
                + '>'
                + cells
                + '</div>';
        }

        // Aktif grup kolonları (sıraya göre)
        var groupCols = _colDefs.filter(function(c) { return c.groupBy && c.visible; })
                                .sort(function(a, b) { return a.groupOrder - b.groupOrder; });

        // Tümünü aç/kapat bar'ı
        var grpCtrl = document.getElementById('fc3GrpCtrl');
        if (grpCtrl) grpCtrl.style.display = groupCols.length > 0 ? 'flex' : 'none';

        if (groupCols.length > 0) {
            // Tüm (belge, kalem) çiftlerini düzleştir + sırala
            var allPairs = [];
            _vis.forEach(function(r) {
                visibleLines(r).forEach(function(l) { allPairs.push({ r: r, l: l }); });
            });
            allPairs.sort(function(a, b) {
                for (var gi = 0; gi < groupCols.length; gi++) {
                    var ga = getGroupValue(a.r, a.l, groupCols[gi].key);
                    var gb = getGroupValue(b.r, b.l, groupCols[gi].key);
                    if (ga < gb) return -1; if (ga > gb) return 1;
                }
                return 0;
            });

            // Ön hesaplama: her gpath için pair listesi (aggregate + select-all için)
            var groupMeta = {}; // gpath → { pairs:[], lineIds:[] }
            allPairs.forEach(function(p) {
                var curVals = groupCols.map(function(gc) { return getGroupValue(p.r, p.l, gc.key); });
                for (var depth = 0; depth < groupCols.length; depth++) {
                    var gpath = groupCols.slice(0, depth + 1).map(function(gc2, di) { return gc2.key + ':' + curVals[di]; }).join('§§');
                    if (!groupMeta[gpath]) groupMeta[gpath] = { pairs: [], lineIds: [] };
                    groupMeta[gpath].pairs.push(p);
                    groupMeta[gpath].lineIds.push(p.l.lineId);
                }
            });

            // Aggregate hesaplama
            function getNumVal(r, l, key) {
                if (key === 'qty')    return l.quantity || 0;
                if (key === 'remain') return l.remaining != null ? l.remaining : Math.max(0, (l.quantity||0) - (l.fulfilledFromStock||0) - (l.fulfilledByPurchase||0));
                return null;
            }
            function calcAgg(pairs, colKey, func) {
                var vals = pairs.map(function(p) { return getNumVal(p.r, p.l, colKey); }).filter(function(v) { return v !== null; });
                if (!vals.length) return null;
                switch(func) {
                    case 'sum': return vals.reduce(function(a,b){return a+b;}, 0);
                    case 'avg': return Math.round((vals.reduce(function(a,b){return a+b;},0)/vals.length)*100)/100;
                    case 'min': return Math.min.apply(null, vals);
                    case 'max': return Math.max.apply(null, vals);
                    default:    return null;
                }
            }
            var aggCols = _colDefs.filter(function(c) { return c.aggregateFunc && c.aggregateFunc !== ''; });

            // Grup özet satırı — aggregate değerleri veri satırlarıyla aynı sütun hizasında
            function buildAggRowHtml(localVisCols, pairs, localAggCols, indent) {
                var aggMap = {};
                localAggCols.forEach(function(c) {
                    var v = calcAgg(pairs, c.key, c.aggregateFunc);
                    if (v !== null) aggMap[c.key] = v;
                });
                if (!Object.keys(aggMap).length) return '';

                var cells = localVisCols.map(function(c) {
                    var al = c.align || 'left';
                    var hasV = aggMap.hasOwnProperty(c.key);
                    switch(c.key) {
                        case 'num':
                            return '<span class="fc3-flat-num" style="text-align:' + al + '"></span>';
                        case 'who':
                            return '<span class="fc3-flat-who" style="' + getWidthStyle(c) + 'text-align:' + al + '"></span>';
                        case 'dt':
                            return '<span class="fc3-flat-dt" style="' + getWidthStyle(c) + '"></span>';
                        case 'mat':
                            return '<span class="fc3-sub-mat" style="' + getWidthStyle(c) + '"></span>';
                        case 'qty':
                            return '<span class="fc3-sub-qty" style="' + getWidthStyle(c) + 'text-align:right">'
                                + (hasV ? fmtN(aggMap[c.key]) : '') + '</span>'
                                + '<span class="fc3-sub-unit"></span>';
                        case 'stk':
                            return '<span class="fc3-sub-stk" style="' + getWidthStyle(c) + '"></span>';
                        case 'remain':
                            return '<span class="fc3-sub-remain" style="' + getWidthStyle(c) + 'text-align:right">'
                                + (hasV ? fmtN(aggMap[c.key]) : '') + '</span>';
                        case 'fst':
                            return '<span class="fc3-sub-fst" style="' + getWidthStyle(c) + '"></span>'
                                + '<span class="fc3-sub-suf"></span>';
                        default:
                            if (c.key.indexOf('ext_') === 0) {
                                return '<span class="fc3-sub-ext" style="' + getWidthStyle(c) + '"></span>';
                            }
                            return '';
                    }
                }).join('');

                return '<div class="fc3-agg-row" style="padding-left:' + (12 + indent) + 'px">'
                    + '<span class="fc3-agg-cb"></span>'
                    + cells
                    + '</div>';
            }

            // Render
            var chevDown = '<svg viewBox="0 0 10 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polyline points="1,2 5,6 9,2"/></svg>';
            var sentinelKeys = groupCols.map(function() { return '\x00'; });
            var gHtml = '';

            allPairs.forEach(function(p) {
                var curVals = groupCols.map(function(gc) { return getGroupValue(p.r, p.l, gc.key); });

                for (var gi = 0; gi < groupCols.length; gi++) {
                    var gv = curVals[gi];
                    if (gv !== sentinelKeys[gi]) {
                        for (var ri = gi; ri < groupCols.length; ri++) sentinelKeys[ri] = '\x00';
                        sentinelKeys[gi] = gv;

                        var gpath = groupCols.slice(0, gi + 1).map(function(gc2, di) { return gc2.key + ':' + curVals[di]; }).join('§§');

                        // Ebeveyn katlanmış mı?
                        var parentCollapsed = false;
                        for (var di = 0; di < gi; di++) {
                            var anc = groupCols.slice(0, di + 1).map(function(gc3, ddi) { return gc3.key + ':' + curVals[ddi]; }).join('§§');
                            if (_collapsedGroups[anc]) { parentCollapsed = true; break; }
                        }
                        if (parentCollapsed) continue;

                        var isCollapsed = !!_collapsedGroups[gpath];
                        var meta = groupMeta[gpath] || { pairs: [], lineIds: [] };
                        var rowCount = meta.pairs.length;

                        // Özet değerleri hesapla
                        var aggMapHdr = {};
                        aggCols.forEach(function(ac) {
                            var v = calcAgg(meta.pairs, ac.key, ac.aggregateFunc);
                            if (v !== null) aggMapHdr[ac.key] = v;
                        });
                        // Kimlik bölümünün flex/min-width hesabı: sütun hizalaması için
                        var hdrFixedW = 0, hdrFlex = 0;
                        visCols.forEach(function(vc) {
                            if (vc.key === 'num')                          hdrFixedW += 130;
                            else if (vc.key === 'dt')                      hdrFixedW += 55;
                            else if (vc.key === 'who' || vc.key === 'mat') hdrFlex += (vc.flexWeight || 1);
                        });
                        if (hdrFlex === 0) hdrFlex = 1;
                        // Sağ taraf (sayısal) sütun hücreleri
                        var hdrRightCells = visCols.map(function(vc) {
                            if (vc.key === 'num' || vc.key === 'who' || vc.key === 'dt' || vc.key === 'mat') return '';
                            var hasV = aggMapHdr.hasOwnProperty(vc.key);
                            switch(vc.key) {
                                case 'qty':    return '<span class="fc3-sub-qty" style="text-align:right">' + (hasV ? fmtN(aggMapHdr[vc.key]) : '') + '</span><span class="fc3-sub-unit"></span>';
                                case 'stk':    return '<span class="fc3-sub-stk" style="' + getWidthStyle(vc) + '"></span>';
                                case 'remain': return '<span class="fc3-sub-remain" style="' + getWidthStyle(vc) + 'text-align:right">' + (hasV ? fmtN(aggMapHdr[vc.key]) : '') + '</span>';
                                case 'fst':    return '<span class="fc3-sub-fst" style="' + getWidthStyle(vc) + '"></span><span class="fc3-sub-suf"></span>';
                                default:       return vc.key.indexOf('ext_') === 0 ? '<span class="fc3-sub-ext" style="' + getWidthStyle(vc) + '"></span>' : '';
                            }
                        }).join('');

                        var indent = gi * 16;
                        gHtml += '<div class="fc3-group-hdr' + (isCollapsed ? ' collapsed' : '') + '" style="padding-left:' + (12 + indent) + 'px">'
                            + '<span class="fc3-grp-identity" style="flex:' + hdrFlex + ';min-width:' + hdrFixedW + 'px">'
                            +   '<label class="fc3-grp-selall" title="Tümünü seç / kaldır"><input type="checkbox" class="fc3-grp-cb" data-gpath="' + esc(gpath) + '"></label>'
                            +   '<button type="button" class="fc3-grp-tog" data-gpath="' + esc(gpath) + '">' + chevDown + '</button>'
                            +   '<span class="fc3-group-hdr__dim">' + esc(groupCols[gi].label) + '</span>'
                            +   '<span class="fc3-group-hdr__sep"> › </span>'
                            +   '<span class="fc3-group-hdr__val">' + esc(gv || '—') + '</span>'
                            +   '<span class="fc3-grp-cnt">' + rowCount + ' kalem</span>'
                            + '</span>'
                            + hdrRightCells
                            + '</div>';
                    }
                }

                // Herhangi bir ata katlanmışsa satırı gizle
                var anyCollapsed = groupCols.some(function(gc2, depth) {
                    var cp = groupCols.slice(0, depth + 1).map(function(gc3, di) { return gc3.key + ':' + curVals[di]; }).join('§§');
                    return !!_collapsedGroups[cp];
                });
                if (!anyCollapsed) gHtml += buildRowHtml(p.r, p.l);
            });

            el.innerHTML = gHtml;

            // Grup katlama toggle
            el.querySelectorAll('.fc3-grp-tog').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    var gpath = btn.getAttribute('data-gpath');
                    if (_collapsedGroups[gpath]) delete _collapsedGroups[gpath];
                    else _collapsedGroups[gpath] = true;
                    renderList();
                });
            });

            // Grup select-all / deselect-all
            el.querySelectorAll('.fc3-grp-cb').forEach(function(cb) {
                cb.addEventListener('change', function(e) {
                    e.stopPropagation();
                    var gpath = cb.getAttribute('data-gpath');
                    var meta = groupMeta[gpath] || { pairs: [] };
                    meta.pairs.forEach(function(p) {
                        if (!fc3DocCanSelect(p.r)) return;
                        if (cb.checked) _lineSel[p.l.lineId] = { docId: p.r.id, itemId: p.l.itemId };
                        else delete _lineSel[p.l.lineId];
                        var domCb = el.querySelector('.fc3-sub-cb[data-line-id="' + p.l.lineId + '"]');
                        if (domCb) domCb.checked = cb.checked;
                    });
                    fc3UpdateFulfillBar(); onLineSel();
                });
            });
        } else {
            // Düz liste (mevcut davranış)
            el.innerHTML = _vis.map(function(r) {
                return visibleLines(r).map(function(l) { return buildRowHtml(r, l); }).join('');
            }).join('');
        }
    }

    // ── Satır seçimi (Depodan Karşıla) ────────────────────────────────────────
    window.fc3LineCheck = function(lineId, docId, itemId) {
        var cb = document.querySelector('.fc3-sub-cb[data-line-id="' + lineId + '"]');
        if (!cb) return;
        if (cb.checked) {
            _lineSel[lineId] = { docId: docId, itemId: itemId };
        } else {
            delete _lineSel[lineId];
        }
        fc3UpdateFulfillBar(); onLineSel();
    };

    window.fc3LineSelClear = function() {
        _lineSel = {};
        document.querySelectorAll('.fc3-sub-cb').forEach(function(cb) { cb.checked = false; });
        fc3UpdateFulfillBar(); onLineSel();
    };

    window.fc3CollapseAll = function() {
        document.querySelectorAll('#fc3List .fc3-grp-tog').forEach(function(btn) {
            var gp = btn.getAttribute('data-gpath');
            if (gp) _collapsedGroups[gp] = true;
        });
        renderList();
    };
    window.fc3ExpandAll = function() { _collapsedGroups = {}; renderList(); };

    function fc3UpdateFulfillBar() {
        var bar = document.getElementById('fc3FulfillBar');
        if (!bar) return;
        var vals = Object.values(_lineSel);
        bar.classList.toggle('show', vals.length > 0);
        var cnt = document.getElementById('fc3FbCnt');
        if (cnt) cnt.textContent = vals.length + ' kalem seçili';
        var chips = document.getElementById('fc3FbChips');
        if (chips) {
            var uniqueItems = new Set(vals.map(function(v) { return v.itemId; })).size;
            var uniqueDocs  = new Set(vals.map(function(v) { return v.docId;  })).size;
            var html = '';
            if (uniqueItems > 0) html += '<span class="fc3-fb-chip">' + uniqueItems + ' malzeme</span>';
            if (uniqueDocs  > 0) html += '<span class="fc3-fb-chip">' + uniqueDocs  + ' ihtiyaç</span>';
            chips.innerHTML = html;
        }
        // Not: modal artık _lineSel'e bağımlı değil (açılışta _modalLines'a snapshot alır), bu
        // yüzden seçim boşalınca modalı kapatmaya gerek yok — kullanıcı sonucu görüp kendi kapatır.
    }

    function fc3Csrf() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    // Header "Yenile" — liste verisi sunucu tarafında gömülü olduğundan tam sayfa yenilenir
    window.fc3RefreshPage = function(btn) {
        if (btn) btn.classList.add('fc3-spin');
        window.location.reload();
    };

    // ── Kalem seçimi → merkez modal beslemesi ─────────────────────────────────
    function buildSelectedLines() {
        var result = [];
        Object.keys(_lineSel).forEach(function(lineId) {
            var info = _lineSel[lineId];
            var docLines = _docLineCache[info.docId] || [];
            var line = docLines.find(function(l) { return l.lineId === parseInt(lineId, 10); });
            if (line) result.push(line);
        });
        return result;
    }

    // Seçili kalemlerin ait olduğu belgeler _docLineCache'te henüz yoksa (cache boşsa) önce
    // eksik belgeleri /Purchase/RequestLines'tan yükler, sonra _lines'ı günceller. Hem checkbox
    // seçiminde (onLineSel — arka planda cache'i ısıtır, render YOK) hem merkez modal açılışında
    // (fc3OpenModal — render öncesi await edilir) TEK bu fonksiyondan geçer. Eskiden burada
    // renderTf/renderSf/renderPr/renderLines de çağrılıyordu (alt-çekmece canlı senkron
    // gerektiriyordu); merkez modal açılışta TEK seferlik snapshot aldığı için (bkz. _modalLines)
    // render artık modalın kendi işi — Promise döner, çağıran .then() ile render'ı tetikler.
    function fc3RefreshSelectedLinesUI() {
        var missingDocIds = Array.from(new Set(
            Object.keys(_lineSel)
                .map(function(lineId) { return _lineSel[lineId].docId; })
                .filter(function(docId) { return !_docLineCache[docId]; })
        ));
        if (!missingDocIds.length) {
            _lines = buildSelectedLines();
            return Promise.resolve();
        }
        var promises = missingDocIds.map(function(docId) {
            return fetch('/Purchase/RequestLines?requestIds=' + docId)
                .then(function(res) { return res.json(); })
                .then(function(lines) { _docLineCache[docId] = Array.isArray(lines) ? lines : []; })
                .catch(function() { _docLineCache[docId] = []; });
        });
        return Promise.all(promises).then(function() {
            _lines = buildSelectedLines();
        });
    }

    function onLineSel() {
        var lineIds = Object.keys(_lineSel);
        var sc = document.getElementById('fc3SelCnt');
        if (sc) { sc.textContent = lineIds.length ? lineIds.length + ' kalem seçili' : ''; sc.classList.toggle('show', lineIds.length > 0); }
        if (!lineIds.length) return;
        fc3RefreshSelectedLinesUI();
    }

    // ── Sütun yapılandırması ──────────────────────────────────────────────────
    var DEFAULT_DEFS = [
        { key: 'num',    label: 'Belge No',    visible: true, align: 'left',   fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 0, widthStep: 3, aggregateFunc: '' },
        { key: 'who',    label: 'Talep Eden',  visible: true, align: 'left',   fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 2, widthStep: 3, aggregateFunc: '' },
        { key: 'dt',     label: 'Tarih',       visible: true, align: 'right',  fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 0, widthStep: 3, aggregateFunc: '' },
        { key: 'mat',    label: 'Malzeme',     visible: true, align: 'left',   fixed: true,  fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 2, widthStep: 3, aggregateFunc: '' },
        { key: 'qty',    label: 'Miktar',      visible: true, align: 'right',  fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 0, widthStep: 3, aggregateFunc: 'sum' },
        { key: 'stk',    label: 'Stok',        visible: true, align: 'left',   fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 2, widthStep: 3, aggregateFunc: '' },
        { key: 'remain', label: 'Kalan',       visible: true, align: 'right',  fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 0, widthStep: 3, aggregateFunc: 'sum' },
        { key: 'fst',    label: 'Karşılama',   visible: true, align: 'center', fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 0, widthStep: 3, aggregateFunc: '' },
    ];

    function _makeDefaultDefs() {
        var d = DEFAULT_DEFS.map(function(x) { return Object.assign({}, x); });
        FC3_EXTRA_COLS.forEach(function(c) {
            d.push({ key: 'ext_' + c.key, label: c.label, visible: true, align: 'left', fixed: false, fontSize: 0, fontWeight: 0, groupBy: false, groupOrder: 0, flexWeight: 2, widthStep: 3, aggregateFunc: '' });
        });
        return d;
    }

    var _colDefs = _makeDefaultDefs();

    function _applyColSaved(saved) {
        if (!Array.isArray(saved)) return;
        saved.forEach(function(s) {
            var def = _colDefs.find(function(d) { return d.key === s.key; });
            if (!def) return;
            if (s.label      !== undefined) def.label      = s.label;
            if (s.align      !== undefined) def.align      = s.align;
            if (s.fontSize   !== undefined) def.fontSize   = s.fontSize   || 0;
            if (s.fontWeight !== undefined) def.fontWeight = s.fontWeight || 0;
            if (s.visible    !== undefined && !def.fixed) def.visible = s.visible;
            if (s.groupBy       !== undefined) def.groupBy       = !!s.groupBy;
            if (s.groupOrder    !== undefined) def.groupOrder    = s.groupOrder || 0;
            if (s.flexWeight    !== undefined && def.flexWeight > 0) def.flexWeight = Math.max(1, Math.min(4, s.flexWeight || 2));
            if (s.widthStep     !== undefined) def.widthStep = Math.max(1, Math.min(5, s.widthStep || 3));
            else if (s.flexWeight !== undefined && def.flexWeight > 0) {
                // Eski kayıt migrasyonu: flexWeight 1-4 → widthStep 2-5 (eski default 2 → yeni default 3)
                def.widthStep = Math.max(1, Math.min(5, s.flexWeight + 1));
            }
            if (s.aggregateFunc !== undefined) def.aggregateFunc = s.aggregateFunc || '';
        });
        var order = saved.map(function(s) { return s.key; });
        _colDefs.sort(function(a, b) {
            var ia = order.indexOf(a.key), ib = order.indexOf(b.key);
            if (ia < 0) return 1; if (ib < 0) return -1;
            return ia - ib;
        });
    }

    (function loadFromStorage() {
        try {
            var json = localStorage.getItem('fc3-col-flat-v3');
            if (json) _applyColSaved(JSON.parse(json));
        } catch(e) {}
    })();

    function _serializeDefs() {
        return JSON.stringify(_colDefs.map(function(c) {
            return { key: c.key, visible: c.visible, align: c.align, label: c.label, fontSize: c.fontSize || 0, fontWeight: c.fontWeight || 0, groupBy: c.groupBy || false, groupOrder: c.groupOrder || 0, flexWeight: c.flexWeight || 0, widthStep: c.widthStep || 3, aggregateFunc: c.aggregateFunc || '' };
        }));
    }
    function _saveColDefs() {
        var json = _serializeDefs();
        try { localStorage.setItem('fc3-col-flat-v3', json); } catch(e) {}
        var csrfEl = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('/Purchase/SaveFlatColConfig', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfEl ? csrfEl.value : '' },
            body: JSON.stringify({ config: json })
        }).catch(function() {});
    }

