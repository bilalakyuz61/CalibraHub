        <button type="button" id="fc3BtnP" class="fc3-atab fc3-atab--p" onclick="fc3OpenModal('purchase')">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            Satın Alma Talebi
        </button>
        <button type="button" class="fc3-atab fc3-atab--close" id="fc3BtnCloseLines" onclick="fc3OpenModal('closeLines')" title="Karşılanmamış miktarı kapatır: hiç karşılama yapılmadıysa ihtiyacın tamamı, kısmen karşılandıysa yalnız kalan kısmı kapanır — belgenin diğer kalemlerine dokunmaz">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            İhtiyacı Kapat
        </button>
        <span class="fc3-fb-sep"></span>
        <button type="button" class="fc3-fb-cancel" onclick="fc3LineSelClear()">İptal</button>
