        transition:transform 260ms cubic-bezier(.23,1,.32,1);
    }
    .fc3-fulfill-bar.show { transform:translateY(0); }
    .fc3-fb-left  { display:flex; align-items:center; gap:8px; flex:1; min-width:0; overflow:hidden; }
    .fc3-fb-right { display:flex; align-items:center; gap:5px; flex-shrink:0; }
