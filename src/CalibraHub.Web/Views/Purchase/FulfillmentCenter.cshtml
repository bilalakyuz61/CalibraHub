                    '<button type="button" class="fc3-cfg-eye' + (!c.visible ? ' fc3-eye-off' : '') + '" data-key="' + c.key + '">' + (c.visible ? _EYE : _EYEOFF) + '</button>' +
                    '<span class="fc3-cfg-label">' + esc(c.label) + '</span>' +
                    '<button type="button" class="fc3-cfg-grp-btn' + (c.groupBy ? ' active' : '') + '" data-key="' + c.key + '" title="' + (c.groupBy ? '#' + c.groupOrder + ' — Gruplamayı kaldır' : 'Grupla') + '">' +
                        (c.groupBy ? '<span class="fc3-cfg-grp-ord">' + c.groupOrder + '</span>' : _GRP) +
                    '</button>' +
                    '<button type="button" class="fc3-cfg-exp' + oc + '" data-key="' + c.key + '" title="Detay ayarları">' + _CHEV + '</button>' +
                '</div>' +
                '<div class="fc3-cfg-detail' + oc + '" data-key="' + c.key + '">' +
                    '<div class="fc3-cfg-field-row">' +
                        '<span class="fc3-cfg-field-label">Başlık</span>' +
                        '<input type="text" class="fc3-cfg-field-input" data-key="' + c.key + '" data-field="label" value="' + esc(c.label) + '">' +
                    '</div>' +
                    '<div class="fc3-cfg-field-row">' +
                        '<span class="fc3-cfg-field-label">Hizalama</span>' +
                        '<span class="fc3-cfg-align">' +
                            '<button type="button" class="fc3-cfg-align-btn' + (c.align === 'left'   ? ' fc3-align-active' : '') + '" data-key="' + c.key + '" data-align="left"   title="Sola">'   + _ALIGN_ICONS.left   + '</button>' +
                            '<button type="button" class="fc3-cfg-align-btn' + (c.align === 'center' ? ' fc3-align-active' : '') + '" data-key="' + c.key + '" data-align="center" title="Orta">'   + _ALIGN_ICONS.center + '</button>' +
                            '<button type="button" class="fc3-cfg-align-btn' + (c.align === 'right'  ? ' fc3-align-active' : '') + '" data-key="' + c.key + '" data-align="right"  title="Sağa">'  + _ALIGN_ICONS.right  + '</button>' +
                        '</span>' +
                    '</div>' +
                    '<div class="fc3-cfg-field-row">' +
                        '<span class="fc3-cfg-field-label">Boyut</span>' +
                        '<span class="fc3-cfg-icon-row">' +
                            '<button type="button" class="fc3-cfg-chip' + (c.fontSize === 10    ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontSize" data-val="10"  title="Küçük">'    + _BOYUT_ICONS[10] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.fontSize === 12    ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontSize" data-val="12"  title="Orta">'     + _BOYUT_ICONS[12] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (!c.fontSize || c.fontSize === 15 ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontSize" data-val="15"  title="Standart (Büyük)">' + _BOYUT_ICONS[15] + '</button>' +
                        '</span>' +
                    '</div>' +
                    '<div class="fc3-cfg-field-row">' +
                        '<span class="fc3-cfg-field-label">Stil</span>' +
                        '<span class="fc3-cfg-icon-row">' +
                            '<button type="button" class="fc3-cfg-chip' + (!c.fontWeight         ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontWeight" data-val="0"   title="Normal (400)">'     + _STIL_ICONS[0]   + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.fontWeight === 500  ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontWeight" data-val="500" title="Orta (500)">'       + _STIL_ICONS[500] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.fontWeight === 700  ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontWeight" data-val="700" title="Kalın (700)">'      + _STIL_ICONS[700] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.fontWeight === 900  ? ' active' : '') + '" data-key="' + c.key + '" data-field="fontWeight" data-val="900" title="Çok Kalın (900)">'  + _STIL_ICONS[900] + '</button>' +
                        '</span>' +
                    '</div>' +
                    '<div class="fc3-cfg-field-row">' +
                        '<span class="fc3-cfg-field-label">Özet</span>' +
                        '<span class="fc3-cfg-icon-row">' +
                            '<button type="button" class="fc3-cfg-chip' + (!c.aggregateFunc       ? ' active' : '') + '" data-key="' + c.key + '" data-field="aggregateFunc" data-val=""    title="Yok">'          + _AGG_ICONS['']    + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.aggregateFunc==='sum'  ? ' active' : '') + '" data-key="' + c.key + '" data-field="aggregateFunc" data-val="sum" title="Toplam (Σ)">'  + _AGG_ICONS['sum'] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.aggregateFunc==='avg'  ? ' active' : '') + '" data-key="' + c.key + '" data-field="aggregateFunc" data-val="avg" title="Ortalama">'   + _AGG_ICONS['avg'] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.aggregateFunc==='min'  ? ' active' : '') + '" data-key="' + c.key + '" data-field="aggregateFunc" data-val="min" title="Minimum">'    + _AGG_ICONS['min'] + '</button>' +
                            '<button type="button" class="fc3-cfg-chip' + (c.aggregateFunc==='max'  ? ' active' : '') + '" data-key="' + c.key + '" data-field="aggregateFunc" data-val="max" title="Maksimum">'   + _AGG_ICONS['max'] + '</button>' +
                        '</span>' +
                    '</div>' +
                    (function() {
                        var ws = c.widthStep || 3;
                        return '<div class="fc3-cfg-field-row">' +
                            '<span class="fc3-cfg-field-label">Genişlik</span>' +
                            '<span class="fc3-cfg-stepper">' +
                                '<button type="button" class="fc3-cfg-step-btn" data-key="' + c.key + '" data-dir="-1"' + (ws <= 1 ? ' disabled' : '') + '>−</button>' +
                                '<span class="fc3-step-dots">' +
                                    [1,2,3,4,5].map(function(i) {
                                        var active = i === ws;
                                        var isAuto = i === 3;
                                        return '<span class="fc3-step-dot' + (active ? ' on' : '') + (isAuto ? ' auto-mark' : '') + '" title="' + (i===1?'Çok Dar':i===2?'Dar':i===3?'Otomatik':i===4?'Geniş':'Çok Geniş') + '"></span>';
                                    }).join('') +
                                '</span>' +
                                '<button type="button" class="fc3-cfg-step-btn" data-key="' + c.key + '" data-dir="1"' + (ws >= 5 ? ' disabled' : '') + '>+</button>' +
                            '</span>' +
                        '</div>';
                    })() +
                '</div>';
        });
        rowsEl.innerHTML = html;

        // Göz toggle
        rowsEl.querySelectorAll('.fc3-cfg-eye').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key = btn.getAttribute('data-key');
                var def = _colDefs.find(function(d) { return d.key === key; });
                if (!def || def.fixed) return;
                def.visible = !def.visible;
                _saveColDefs();
                _renderColPanel();
                renderList();
            });
        });

        // Hizalama
        rowsEl.querySelectorAll('.fc3-cfg-align-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key   = btn.getAttribute('data-key');
                var align = btn.getAttribute('data-align');
                var def   = _colDefs.find(function(d) { return d.key === key; });
                if (!def) return;
                def.align = align;
                _saveColDefs();
                _renderColPanel();
                renderList();
            });
        });

        // Başlık düzenleme
        rowsEl.querySelectorAll('input[data-field="label"]').forEach(function(inp) {
            inp.addEventListener('input', function(e) {
                e.stopPropagation();
                var key = inp.getAttribute('data-key');
                var def = _colDefs.find(function(d) { return d.key === key; });
                if (!def) return;
                def.label = inp.value;
                _saveColDefs();
                var span = rowsEl.querySelector('.fc3-cfg-row[data-key="' + key + '"] .fc3-cfg-label');
                if (span) span.textContent = def.label;
                renderList();
            });
        });

        // Boyut + Stil + Özet chip seçimleri
        rowsEl.querySelectorAll('.fc3-cfg-chip').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key   = btn.getAttribute('data-key');
                var field = btn.getAttribute('data-field');
                var rawVal = btn.getAttribute('data-val');
                var def   = _colDefs.find(function(d) { return d.key === key; });
                if (!def) return;
                // aggregateFunc string, diğerleri int
                def[field] = (field === 'aggregateFunc') ? (rawVal || '') : (parseInt(rawVal, 10) || 0);
                _saveColDefs();
                if (field === 'aggregateFunc') { renderList(); } else { renderFlatColHdr(); }
                _renderColPanel();
            });
        });

        // Genişlik stepper
        rowsEl.querySelectorAll('.fc3-cfg-step-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key = btn.getAttribute('data-key');
                var dir = parseInt(btn.getAttribute('data-dir'), 10);
                var def = _colDefs.find(function(d) { return d.key === key; });
                if (!def) return;
                def.widthStep = Math.max(1, Math.min(5, (def.widthStep || 3) + dir));
                _saveColDefs();
                _renderColPanel();
                renderList();
            });
        });

        // Grupla toggle (ana satır)
        rowsEl.querySelectorAll('.fc3-cfg-grp-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key = btn.getAttribute('data-key');
                var def = _colDefs.find(function(d) { return d.key === key; });
                if (!def) return;
                if (def.groupBy) {
                    def.groupBy = false;
                    def.groupOrder = 0;
                    // Kalan grupları yeniden numaralandır
                    _colDefs.filter(function(d) { return d.groupBy; })
                            .sort(function(a, b) { return a.groupOrder - b.groupOrder; })
                            .forEach(function(d, i) { d.groupOrder = i + 1; });
                } else {
                    var maxOrd = _colDefs.reduce(function(m, d) { return d.groupBy ? Math.max(m, d.groupOrder) : m; }, 0);
                    def.groupBy = true;
                    def.groupOrder = maxOrd + 1;
                }
                _saveColDefs();
                _renderColPanel();
                renderList();
            });
        });

        // Expand/collapse
        rowsEl.querySelectorAll('.fc3-cfg-exp').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var key = btn.getAttribute('data-key');
                if (_expandedKeys.has(key)) _expandedKeys.delete(key); else _expandedKeys.add(key);
                _renderColPanel();
            });
        });

        // Drag-and-drop sıralama
        var dragSrcIdx = null;
        rowsEl.querySelectorAll('.fc3-cfg-row:not(.is-fixed)').forEach(function(row) {
            row.addEventListener('dragstart', function(e) {
                dragSrcIdx = parseInt(row.getAttribute('data-idx'), 10);
                e.dataTransfer.effectAllowed = 'copyMove';
                setTimeout(function() { row.classList.add('fc3-cfg-dragging'); }, 0);
            });
            row.addEventListener('dragend', function() {
                dragSrcIdx = null;
                rowsEl.querySelectorAll('.fc3-cfg-row').forEach(function(r) { r.classList.remove('fc3-cfg-dragging', 'drag-over'); });
            });
            row.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                rowsEl.querySelectorAll('.fc3-cfg-row').forEach(function(r) { r.classList.remove('drag-over'); });
                row.classList.add('drag-over');
            });
            row.addEventListener('drop', function(e) {
                e.preventDefault();
                if (dragSrcIdx === null) return;
                var tgtIdx = parseInt(row.getAttribute('data-idx'), 10);
                if (isNaN(tgtIdx) || dragSrcIdx === tgtIdx) return;
                if (_colDefs[tgtIdx] && _colDefs[tgtIdx].fixed) return;
                var moved = _colDefs.splice(dragSrcIdx, 1)[0];
                _colDefs.splice(tgtIdx, 0, moved);
                _saveColDefs();
                _renderColPanel();
                renderList();
            });
        });

        var panelEl = document.getElementById('fc3ColPanel');
        if (panelEl) panelEl.ondragover = function(e2) { e2.preventDefault(); };
    }

    window.fc3ToggleColPanel = function(e) {
        if (e) e.stopPropagation();
        var panel    = document.getElementById('fc3ColPanel');
        var backdrop = document.getElementById('fc3ColBackdrop');
        if (!panel) return;
        if (panel.classList.contains('open')) {
            panel.classList.remove('open');
            if (backdrop) backdrop.classList.remove('open');
        } else {
            panel.classList.add('open');
            if (backdrop) backdrop.classList.add('open');
            _renderColPanel();
        }
    };
    window.fc3CloseColPanel = function() {
        var panel    = document.getElementById('fc3ColPanel');
        var backdrop = document.getElementById('fc3ColBackdrop');
        if (panel)    panel.classList.remove('open');
        if (backdrop) backdrop.classList.remove('open');
    };

    // Async: server'dan yükle, farklıysa yeniden render
    fetch('/Purchase/GetFlatColConfig')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data || !data.config) return;
            var localJson = localStorage.getItem('fc3-col-flat-v3');
            if (data.config === localJson) return;
            _colDefs = _makeDefaultDefs();
            try { _applyColSaved(JSON.parse(data.config)); } catch(e) {}
            renderList();
        }).catch(function() {});

    // ── Merkez Modal — 4 alt aksiyon TEK modal (backdrop+card, CLAUDE.md silme-onay deseni).
    // Eskiden her aksiyon ya doğrudan fetch (Depodan Karşıla), ya alt-çekmece panel (Transfer/
    // Ambar Çıkış/Satın Alma — renderTf/renderSf/renderPr + fc3TogglePanel, üç fonksiyon neredeyse
    // birebir kopyaydı), ya da showConfirm (İhtiyacı Kapat) kullanıyordu. Artık TEK modal + TEK
    // tablo render'ı (fc3RenderModalTable) var; kolon seti FC_ACTIONS'tan türer (DRY). ──────────
    var _modalAction = null;   // aktif FC_ACTIONS girdisi
    var _modalLines  = [];     // bu modal oturumuna özel çalışma kopyası — satır çıkarma (✕)
                                // _lineSel'i BOZMAZ, yalnız bu diziden çıkarır (bkz. fc3ModalRemoveRow).
    var _modalCumulateDefault = false; // "Stokları Kümüle Et" switch'inin açılıştaki varsayılanı —
                                        // STOCK_DOC_CONSOLIDATE parametresinden (bkz. fc3OpenModal).

    // ── Satın Alma paneli: Belge Tipi (Talep / Sipariş) toggle ────────────────────────────────
    // demand → satin_alma_talebi (CreatePurchaseDemand)
    // order  → alis_siparisi     (CreatePurchaseOrderFromIhtiyac, tedarikçisiz sipariş taslağı)
    var _prDocType = 'demand'; // 'demand' | 'order'
    var _PR_DOC_TYPE_META = {
        demand: { panelTitle: 'Satın Alma Talebi',   submitLabel: 'Satın Alma Talebi Oluştur',   qtyColLabel: 'Talep Miktarı',   okPrefix: 'Satın alma talebi oluşturuldu',   editType: 'purchase_demand' },
        order:  { panelTitle: 'Satın Alma Siparişi', submitLabel: 'Satın Alma Siparişi Oluştur', qtyColLabel: 'Sipariş Miktarı', okPrefix: 'Satın alma siparişi oluşturuldu', editType: 'purchase_order'  },
    };

    // Kalan miktar — eski renderPr'deki orijinal hesap. Sunucunun ham `remaining` alanı (negatife
    // düşebilir) yerine burada da 0 tabanlı clamp uygulanır; fulfill'in varsayılan miktarı için de
    // aynı formül kullanılır (tek yardımcı, iki çağıran).
    function fc3Remain(l) {
        return Math.max(0, l.quantity - (l.fulfilledFromStock || 0) - (l.fulfilledByPurchase || 0));
    }
    function fc3LocSelect(l, cls) {
        var opts = LOCS.map(function(loc) { return '<option value="' + loc.id + '">' + esc(loc.name) + '</option>'; }).join('');
        return '<select class="fc3-ts ' + cls + '" data-line-id="' + l.lineId + '" style="min-width:130px;"><option value="">— Depo Seçin —</option>' + opts + '</select>';
    }

    // ── Aksiyon konfigürasyonu — TEK kaynak: modal başlık/ikon/renk, sabit+özel kolonlar,
    // varsayılan miktar ve submit fonksiyonu buradan türer. Yeni bir aksiyon eklemek için yalnız
    // burada yeni bir girdi + bir submit fonksiyonu yeterli, modal iskeleti sabit kalır. Sabit
    // kolonlar (TÜM aksiyonlarda): [✕] Malzeme(+belge no) · İhtiyaç(readonly) · Miktar(editable) ·
    // Birim — bkz. fc3RenderModalTable. extraCols aksiyona özel ek kolonlardır.
    var FC_ACTIONS = {
        fulfill: {
            key: 'fulfill', mode: 'table', accent: 'fulfill', hasLocOverride: true, hasCumulateToggle: true,
            icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
            title: function() { return 'Depodan Karşıla'; },
            okLabel: function() { return 'Depodan Karşıla'; },
            defaultQty: fc3Remain,
            extraCols: [
                { key: 'loc', label: 'Talep Deposu', align: 'left', render: function(l) { return esc(l.locationName || '—'); } },
                { key: 'match', label: 'Durum', align: 'left', render: function(l) { return '<span id="fc3ModalMatch_' + l.lineId + '" class="fc3-sk fc3-sk--zero">bekliyor</span>'; } },
            ],
            submit: function() { fc3ModalSubmitFulfill(); },
        },
        transfer: {
            key: 'transfer', mode: 'table', accent: 't',
            icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>',
            title: function() { return 'Depo Transferi'; },
            okLabel: function() { return 'Transfer Belgesi Oluştur'; },
            defaultQty: function(l) { return l.quantity; },
            extraCols: [
                { key: 'srcLoc', label: 'Kaynak Depo', align: 'left', render: function(l) { return fc3LocSelect(l, 'fc3-mod-loc'); } },
            ],
            submit: function() { fc3ModalSubmitTransfer(); },
        },
        purchase: {
            key: 'purchase', mode: 'table', accent: 'pr', hasDocType: true,
            icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>',
            title: function() { return _PR_DOC_TYPE_META[_prDocType].panelTitle; },
            okLabel: function() { return _PR_DOC_TYPE_META[_prDocType].submitLabel; },
            qtyLabel: function() { return _PR_DOC_TYPE_META[_prDocType].qtyColLabel; },
            defaultQty: fc3Remain,
            extraCols: [
                { key: 'remain', label: 'Kalan', align: 'right', render: function(l) {
                    var r = fc3Remain(l);
                    return '<span style="color:' + (r > 0 ? '#fbbf24' : '#34d399') + ';font-weight:600;">' + fmtN(r) + '</span>';
                } },
                { key: 'note', label: 'Not', align: 'left', render: function(l) {
                    return '<input type="text" class="fc3-ti fc3-mod-note" data-line-id="' + l.lineId + '" placeholder="Not…">';
                } },
            ],
            submit: function() { fc3ModalSubmitPurchase(); },
        },
        closeLines: {
            key: 'closeLines', mode: 'simple', accent: 'close',
            icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
            title: function() { return 'İhtiyacı Kapat'; },
            okLabel: function() { return 'Kapat'; },
            submit: function() { fc3ModalSubmitCloseLines(); },
        },
    };

    // "Stokları Kümüle Et" switch'inin varsayılanı — GET /Purchase/FulfillmentLocationConfig
    // zaten consolidateLines alanını döner (Admin/Parameters.cshtml'in kullandığı aynı uç); burada
    // yeniden okunur ki modal açılışında güncel parametre değeri yansısın. Ağ hatasında güvenli
    // varsayılan (false = mevcut/kapalı davranış) döner — sessizce yutulmaz, yalnız zararsız fallback.
    function fc3FetchCumulateDefault() {
        return fetch('/Purchase/FulfillmentLocationConfig')
            .then(function(r) { return r.json(); })
            .then(function(d) { return !!(d && d.consolidateLines); })
            .catch(function() { return false; });
    }

    // ── Aç / Kapat ─────────────────────────────────────────────────────────────────────────
    window.fc3OpenModal = function(actionKey) {
        var cfg = FC_ACTIONS[actionKey];
        if (!cfg) return;
        var ids = Object.keys(_lineSel).map(Number);
        if (!ids.length) return;
        _modalAction = cfg;
        // Seçili kalemlerin DOLU olduğunu garanti et (İş 1 fix'inin devamı) — onLineSel() zaten
        // çağırmış olsa bile burada tekrar await etmek zararsız (idempotent) ve modalın render'ını
        // checkbox seçim akışına bağımlı olmaktan kurtarır.
        var tasks = [fc3RefreshSelectedLinesUI()];
        if (cfg.hasCumulateToggle) {
            tasks.push(fc3FetchCumulateDefault().then(function(v) { _modalCumulateDefault = v; }));
        }
        Promise.all(tasks).then(function() {
            _modalLines = _lines.slice();
            fc3RenderModal();
        });
    };
    window.fc3CloseModal = function() {
        var backdrop = document.getElementById('fc3ModalBackdrop');
        if (backdrop) backdrop.classList.remove('open');
        document.removeEventListener('keydown', fc3ModalKeyHandler);
        _modalAction = null;
        _modalLines  = [];
    };
    window.fc3ModalBackdropClick = function(e) {
        if (e && e.target && e.target.id === 'fc3ModalBackdrop') fc3CloseModal();
    };
    function fc3ModalKeyHandler(e) {
        if (e.key === 'Escape') { fc3CloseModal(); return; }
        if (e.key === 'Enter') {
            var tag = (e.target && e.target.tagName) || '';
            if (tag === 'TEXTAREA' || tag === 'SELECT') return;  // metin/depo seçiminde Enter submit tetiklemesin
            e.preventDefault();
            window.fc3ModalSubmit();
        }
    }
    function fc3ShowModal() {
        var backdrop = document.getElementById('fc3ModalBackdrop');
        if (!backdrop) return;
        backdrop.classList.add('open');
        document.addEventListener('keydown', fc3ModalKeyHandler);
        setTimeout(function() {
            var okBtn = document.getElementById('fc3ModalOkBtn');
            if (okBtn) okBtn.focus();
        }, 50);
    }

    // ── Render — header/doctype/tablo|basit-metin/footer TEK yerden ─────────────────────────
    function fc3RenderModal() {
        var cfg = _modalAction;
        if (!cfg) return;

        var iconWrap = document.getElementById('fc3ModalIcon');
        if (iconWrap) { iconWrap.className = 'fc3-modal-hd-icon fc3-modal-hd-icon--' + cfg.accent; iconWrap.innerHTML = cfg.icon; }
        var titleEl = document.getElementById('fc3ModalTitle');
        if (titleEl) titleEl.textContent = cfg.title();
        var subEl = document.getElementById('fc3ModalSub');
        if (subEl) subEl.textContent = _modalLines.length + ' kalem seçili';

        var dtRow = document.getElementById('fc3ModalDocTypeRow');
        if (dtRow) dtRow.style.display = cfg.hasDocType ? '' : 'none';
        if (cfg.hasDocType) {
            document.querySelectorAll('#fc3ModalDocTypeChips .fc3-ms-chip').forEach(function(chip) {
                var active = chip.getAttribute('data-doctype') === _prDocType;
                chip.classList.toggle('active', active);
                var input = chip.querySelector('input');
                if (input) input.checked = active;
            });
        }

        // Kaynak Depo override satırı (yalnız 'fulfill') — her açılışta seçim sıfırlanır, seçenekler
        // LOCS'tan (aynı liste Transfer/eski Ambar Çıkış'ın kullandığı depo listesi) yeniden kurulur.
        var locOvrRow = document.getElementById('fc3ModalLocOverrideRow');
        if (locOvrRow) locOvrRow.style.display = cfg.hasLocOverride ? '' : 'none';
        var locOvrSel = document.getElementById('fc3ModalLocOverride');
        if (locOvrSel && cfg.hasLocOverride) {
            var ovrOpts = LOCS.map(function(loc) { return '<option value="' + loc.id + '">' + esc(loc.name) + '</option>'; }).join('');
            locOvrSel.innerHTML = '<option value="">— Otomatik (parametre) —</option>' + ovrOpts;
            locOvrSel.value = '';
        }
        var locOvrWarn = document.getElementById('fc3ModalLocOverrideWarn');
        if (locOvrWarn) { locOvrWarn.style.display = 'none'; locOvrWarn.textContent = ''; }

        // "Stokları Kümüle Et" switch satırı (yalnız 'fulfill') — her açılışta varsayılan
        // _modalCumulateDefault'a (STOCK_DOC_CONSOLIDATE parametresi, fc3OpenModal'da önceden
        // çekildi) sıfırlanır; kullanıcı bu oturumda değiştirebilir.
        var cumRow = document.getElementById('fc3ModalCumulateRow');
        if (cumRow) cumRow.style.display = cfg.hasCumulateToggle ? '' : 'none';
        if (cfg.hasCumulateToggle) fc3SetCumulateSwitch(_modalCumulateDefault);

        var tableWrap  = document.getElementById('fc3ModalTableWrap');
        var simpleWrap = document.getElementById('fc3ModalSimpleText');
        if (cfg.mode === 'simple') {
            if (tableWrap)  tableWrap.style.display  = 'none';
            if (simpleWrap) { simpleWrap.style.display = ''; fc3RenderModalSimple(); }
        } else {
            if (simpleWrap) simpleWrap.style.display = 'none';
            if (tableWrap)  { tableWrap.style.display  = ''; fc3RenderModalTable(); }
        }

        var notesWrap = document.getElementById('fc3ModalNotesWrap');
        if (notesWrap) notesWrap.style.display = cfg.mode === 'simple' ? 'none' : '';
        var notesTa = document.getElementById('fc3ModalNotes');
        if (notesTa) notesTa.value = '';

        var okBtn = document.getElementById('fc3ModalOkBtn');
        if (okBtn) {
            okBtn.className   = 'fc3-btn fc3-modal-ok fc3-modal-ok--' + cfg.accent;
            okBtn.textContent = cfg.okLabel();
            okBtn.disabled    = false;
        }
        fc3ModalShowMsg('', '');
        fc3ShowModal();
    }

    // "Stokları Kümüle Et" switch — checkbox durumu + görsel (track/label) tek yerden senkron.
    function fc3SetCumulateSwitch(on) {
        var cb = document.getElementById('fc3ModalCumulate');
        if (cb) cb.checked = !!on;
        fc3UpdateCumulateVisual(!!on);
    }
    function fc3UpdateCumulateVisual(on) {
        var track = document.getElementById('fc3ModalCumulateTrack');
        if (track) track.classList.toggle('is-on', on);
        var lbl = document.getElementById('fc3ModalCumulateLabel');
        if (lbl) { lbl.textContent = on ? 'Aktif' : 'Pasif'; lbl.classList.toggle('is-on', on); }
    }
    window.fc3ModalCumulateToggle = function(el) {
        fc3UpdateCumulateVisual(!!(el && el.checked));
    };

    function fc3RenderModalTable() {
        var cfg   = _modalAction;
        var thead = document.getElementById('fc3ModalThead');
        var tbody = document.getElementById('fc3ModalTbody');
        if (!thead || !tbody) return;

        var qtyLabel  = cfg.qtyLabel ? cfg.qtyLabel() : 'Miktar';
        var headCells = ['', 'Malzeme', 'İhtiyaç', qtyLabel, 'Birim'].concat(cfg.extraCols.map(function(c) { return c.label; }));
        thead.innerHTML = headCells.map(function(h, i) {
            return '<th' + (i === 2 || i === 3 ? ' style="text-align:right;"' : '') + '>' + esc(h) + '</th>';
        }).join('');

        if (!_modalLines.length) {
            tbody.innerHTML = '<tr><td colspan="' + headCells.length + '" style="padding:16px;text-align:center;color:#475569;font-size:.8rem;">Kalem kalmadı.</td></tr>';
            return;
        }

        tbody.innerHTML = _modalLines.map(function(l) {
            var defQty   = cfg.defaultQty(l);
            var extraTds = cfg.extraCols.map(function(c) {
                return '<td' + (c.align === 'right' ? ' style="text-align:right;"' : '') + '>' + c.render(l) + '</td>';
            }).join('');
            return '<tr data-row-id="' + l.lineId + '">'
                + '<td><button type="button" class="fc3-modal-rm" onclick="fc3ModalRemoveRow(' + l.lineId + ')" title="Bu kalemi çıkar">'
                +   '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
                + '</button></td>'
                + '<td class="fc3-modal-mat">' + esc(l.materialName || l.materialCode || '—') + '<small>' + esc(l.requestNumber || '') + '</small></td>'
                + '<td style="text-align:right;color:#94a3b8;">' + fmtN(l.quantity) + '</td>'
                + '<td><input type="number" class="fc3-ti fc3-mod-qty" data-line-id="' + l.lineId + '" value="' + defQty.toFixed(2) + '" min="0.01" step="0.01" style="min-width:70px;text-align:right;"></td>'
                + '<td style="color:#64748b;">' + esc(l.unitCode || '') + '</td>'
                + extraTds
                + '</tr>';
        }).join('');
    }

    // ── Kaynak Depo override — depo-bazlı stok uyarısı (PageComment Seq 48, 2026-07-29) ─────────
    // Depo seçilince "sadece o depoyu baz al": her satırın Durum kolonu SEÇİLİ depodaki bakiyeye
    // göre boyanır (yeterli/kısmi/yok). Bu SADECE görsel bir uyarıdır — submit/OK butonu HİÇBİR
    // zaman kilitlenmez, kullanıcı yetersiz depoyla da kısmi karşılayabilir (kullanıcı kararı: UYAR
    // ama İZİN VER, BLOKLAMA). _globalStockMap zaten sayfa yüklenirken tek sefer çekilmiştir — yeni
    // fetch YOK, yalnız locationId'ye göre filtrelenir.
    // Dönüş: null = bilinmiyor (map hiç yüklenmemiş VEYA bu item map'te hiç yok) — bu durumda
    // "0 stok" varsayıp kırmızı basmayız, nötr geçeriz.
    function fc3LocOverrideBalance(itemId, locId) {
        var arr = _globalStockMap[itemId];
        if (!arr) return null;
        var sum = 0;
        arr.forEach(function(s) { if (s.locationId === locId) sum += (s.balance || 0); });
        return sum;
    }
    function fc3UpdateLocOverrideWarnings() {
        var cfg = _modalAction;
        var sel = document.getElementById('fc3ModalLocOverride');
        var banner = document.getElementById('fc3ModalLocOverrideWarn');
        if (!cfg || !cfg.hasLocOverride || !sel) return;
        var locId = sel.value ? parseInt(sel.value, 10) : null;
        var mapLoaded = Object.keys(_globalStockMap).length > 0;
        var shortCount = 0;
        _modalLines.forEach(function(l) {
            var cell = document.getElementById('fc3ModalMatch_' + l.lineId);
            if (!cell) return;
            if (!locId || !mapLoaded) {
                // Otomatik (parametre) seçili veya harita henüz yok → nötr varsayılana dön.
                cell.className = 'fc3-sk fc3-sk--zero';
                cell.textContent = 'bekliyor';
                cell.title = '';
                return;
            }
            var bal = fc3LocOverrideBalance(l.itemId, locId);
            if (bal === null) {
                // Bu item için hiç stok kaydı yok (bilinmiyor) — yanlış uyarmamak için nötr geç.
                cell.className = 'fc3-sk fc3-sk--zero';
                cell.textContent = 'bekliyor';
                cell.title = 'Seçili depoda stok bilgisi yok';
                return;
            }
            var inp = document.querySelector('.fc3-mod-qty[data-line-id="' + l.lineId + '"]');
            var needed = inp ? parseFloat((inp.value || '0').replace(',', '.')) : NaN;
            if (!(needed > 0)) needed = cfg.defaultQty(l);
            if (bal >= needed && needed > 0) {
                cell.className = 'fc3-sk fc3-sk--ok';
                cell.textContent = '✓ Depoda ' + fmtN(bal);
                cell.title = 'Seçili depoda yeterli stok var';
            } else if (bal > 0) {
                cell.className = 'fc3-sk fc3-sk--warn';
                cell.textContent = 'Depoda ' + fmtN(bal) + ' / ' + fmtN(needed) + ' — kısmi';
                cell.title = 'Seçili depoda ihtiyacı tam karşılamıyor; kısmi karşılanacak';
                shortCount++;
            } else {
                cell.className = 'fc3-sk fc3-sk--none';
                cell.textContent = '✕ Depoda stok yok (0 / ' + fmtN(needed) + ')';
                cell.title = 'Seçili depoda bu malzemeden stok yok; kısmi/hiç karşılanamayabilir';
                shortCount++;
            }
        });
        if (!banner) return;
        if (locId && mapLoaded && shortCount > 0) {
            banner.textContent = '⚠ Seçili depoda ' + shortCount + ' kalem için stok yetersiz — kısmi karşılanacak, yine de devam edebilirsiniz.';
            banner.style.display = 'block';
        } else {
            banner.textContent = '';
            banner.style.display = 'none';
        }
    }
    // Select'in onchange'i — "— Otomatik (parametre) —" seçilince uyarılar temizlenir, mevcut
    // (parametre bazlı, depo-agnostik) davranışa geri döner.
    window.fc3ModalLocOverrideChange = function(sel) {
        fc3UpdateLocOverrideWarnings();
    };

    function fc3RenderModalSimple() {
        var wrap = document.getElementById('fc3ModalSimpleText');
        if (!wrap) return;
        var chips = _modalLines.map(function(l) {
            return '<span class="fc3-modal-chip" data-row-id="' + l.lineId + '">' + esc(l.materialName || l.materialCode || ('#' + l.lineId))
                + '<button type="button" class="fc3-modal-chip-x" onclick="fc3ModalRemoveRow(' + l.lineId + ')" title="Çıkar">'
                +   '<svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
                + '</button></span>';
        }).join('');
        wrap.innerHTML =
              '<div class="fc3-modal-simple">'
            +   'Seçili <strong>' + _modalLines.length + '</strong> kalemin karşılanmamış kalan miktarı kapatılacak. '
            +   'Karşılanan miktarlar korunur, yalnızca kalan kısımdan vazgeçilir (hiç karşılama yapılmadıysa ihtiyacın '
            +   'tamamından vazgeçilmiş olur).<br><strong>Bu işlem geri alınamaz.</strong>'
            +   '<div class="fc3-modal-chiplist">' + chips + '</div>'
            + '</div>';
    }

    window.fc3ModalRemoveRow = function(lineId) {
        if (_modalLines.length <= 1) { fc3ModalShowMsg('En az bir kalem kalmalı.', 'err'); return; }
        _modalLines = _modalLines.filter(function(l) { return l.lineId !== lineId; });
        var subEl = document.getElementById('fc3ModalSub');
        if (subEl) subEl.textContent = _modalLines.length + ' kalem seçili';
        if (_modalAction && _modalAction.mode === 'simple') fc3RenderModalSimple();
        else { fc3RenderModalTable(); fc3UpdateLocOverrideWarnings(); }
    };

    // ── Belge Tipi (Talep/Sipariş) toggle — yalnız etiketleri günceller, tabloyu YENİDEN ÇİZMEZ
    // (iki tip de aynı varsayılan miktarı — kalan — kullandığından satırlar zaten aynıdır;
    // re-render kullanıcının satır bazında girdiği miktar/notu sıfırlardı). ───────────────────
    window.fc3PrDocTypeChange = function(value) {
        _prDocType = value === 'order' ? 'order' : 'demand';
        var meta = _PR_DOC_TYPE_META[_prDocType];
        document.querySelectorAll('#fc3ModalDocTypeChips .fc3-ms-chip').forEach(function(chip) {
            var active = chip.getAttribute('data-doctype') === _prDocType;
            chip.classList.toggle('active', active);
            var input = chip.querySelector('input');
            if (input) input.checked = active;
        });
        if (!_modalAction || _modalAction.key !== 'purchase') return;
        var titleEl = document.getElementById('fc3ModalTitle'); if (titleEl) titleEl.textContent = meta.panelTitle;
        var qtyHdr  = document.querySelector('#fc3ModalThead th:nth-child(4)'); if (qtyHdr) qtyHdr.textContent = meta.qtyColLabel;
        var okBtn   = document.getElementById('fc3ModalOkBtn'); if (okBtn) okBtn.textContent = meta.submitLabel;
        fc3ModalShowMsg('', '');
    };
    document.querySelectorAll('#fc3ModalDocTypeChips .fc3-ms-chip').forEach(function(chip) {
        chip.addEventListener('click', function() { fc3PrDocTypeChange(chip.getAttribute('data-doctype')); });
    });

    // ── Footer yardımcıları ────────────────────────────────────────────────────────────────
    function fc3ModalSetBusy(busy) {
        var okBtn = document.getElementById('fc3ModalOkBtn');
        var cnBtn = document.getElementById('fc3ModalCancelBtn');
        if (okBtn) okBtn.disabled = busy;
        if (cnBtn) cnBtn.disabled = busy;
    }
    function fc3ModalShowMsg(text, kind) {
        var el = document.getElementById('fc3ModalMsg');
        if (!el) return;
        if (!text) { el.style.display = 'none'; el.textContent = ''; el.className = 'fc3-res'; return; }
        el.textContent   = text;
        el.className     = 'fc3-res ' + (kind === 'ok' ? 'fc3-res--ok' : 'fc3-res--err');
        el.style.display = 'block';
    }
    window.fc3ModalSubmit = function() {
        if (!_modalAction || !_modalLines.length) return;
        _modalAction.submit();
    };

    // ── Submit — Depodan Karşıla ──────────────────────────────────────────────────────────────
    // POST /Purchase/FulfillFromStock  body { lines:[{lineId,qty}], notes, overrideLocationId, cumulateItems }
    // response { ok, docNo, approvalStarted, results:[{lineId, matched, fulfilled, reason}] }
    // overrideLocationId (2026-07-25, PageComment Seq 26 birleşimi): boş/null ise mevcut otomatik
    // (parametre) davranış AYNEN çalışır; dolu ise TÜM seçili kalemler o depodan karşılanır ve
    // sunucu depo-eşleşme reddini bu çağrı için uygulamaz (bkz. fc3ModalLocOverrideRow + backend
    // PurchaseController.FulfillFromStock XML doc'u).
    // cumulateItems (2026-07-25, PageComment Seq 39): fc3ModalCumulate switch'inin o anki durumu —
    // her zaman true/false gönderilir (switch açılışta parametre değerine set edildiği için "boş
    // bırakma" diye bir hal yok; kontrol DOM'da bulunamazsa null gider, backend parametreye düşer).
    function fc3ModalSubmitFulfill() {
        var lines = [];
        _modalLines.forEach(function(l) {
            var inp = document.querySelector('.fc3-mod-qty[data-line-id="' + l.lineId + '"]');
            var q   = inp ? parseFloat((inp.value || '0').replace(',', '.')) : 0;
            if (q > 0) lines.push({ lineId: l.lineId, qty: q });
        });
        if (!lines.length) { fc3ModalShowMsg('Lütfen en az bir kalem için miktar girin.', 'err'); return; }
        fc3ModalSetBusy(true);
        fc3ModalShowMsg('', '');
        var notes  = (document.getElementById('fc3ModalNotes') || {}).value || null;
        var ovrSel = document.getElementById('fc3ModalLocOverride');
        var overrideLocationId = (ovrSel && ovrSel.value) ? parseInt(ovrSel.value, 10) : null;
        var cumCb  = document.getElementById('fc3ModalCumulate');
        var cumulateItems = cumCb ? !!cumCb.checked : null;
        fetch('/Purchase/FulfillFromStock', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': fc3Csrf() },
            body: JSON.stringify({ lines: lines, notes: notes, overrideLocationId: overrideLocationId, cumulateItems: cumulateItems }),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            fc3ModalSetBusy(false);
            if (d.ok) {
                (d.results || []).forEach(function(r) {
                    var cell = document.getElementById('fc3ModalMatch_' + r.lineId);
                    if (!cell) return;
                    if (r.matched) {
                        cell.className   = 'fc3-sk fc3-sk--ok';
                        cell.textContent = '✓ Karşılandı' + (r.fulfilled ? ' (' + fmtN(r.fulfilled) + ')' : '');
                    } else {
                        cell.className   = 'fc3-sk fc3-sk--none';
                        cell.textContent = '✕ ' + (r.reason || 'Eşleşmedi');
                        cell.title       = r.reason || '';
                    }
                });
                if (d.docNo) {
                    fc3ModalShowMsg('✔ ' + d.docNo + ' fişi oluşturuldu' + (d.approvalStarted ? ' · onaya gönderildi' : ''), 'ok');
                } else {
                    // Hiç kalem eşleşmedi (docNo yok, belge oluşmadı) — yanıltıcı yeşil yerine uyarı (review LOW-4).
                    fc3ModalShowMsg('⚠ Hiçbir kalem karşılanamadı — satırlardaki sebeplere bakın.', 'err');
                }
                var okBtn = document.getElementById('fc3ModalOkBtn'); if (okBtn) okBtn.disabled = true;  // sonuç görüntülendi, tekrar gönderme kapalı
                // Arka plandaki liste + seçim tazelenir; sonucu görebilmesi için modal açık kalır (kullanıcı kapatır).
                fc3PostSubmitCleanup();
            } else {
                fc3ModalShowMsg('✖ ' + (d.error || 'Hata'), 'err');
            }
        })
        .catch(function() { fc3ModalSetBusy(false); fc3ModalShowMsg('✖ Bağlantı hatası', 'err'); });
    }

    // Başarılı bir aksiyon sonrası ORTAK temizlik: seçim + cache sıfırla, fulfill-bar'ı kapat,
    // listeyi tazele. Aksi halde işlenmiş kalemler seçili kalır → kullanıcı aynı kaleme ikinci
    // aksiyon uygulayıp aşırı-karşılama yapabilir (review LOW-5).
    function fc3PostSubmitCleanup() {
        _lineSel = {}; _docLineCache = {}; _globalStockMap = {};
        document.querySelectorAll('.fc3-sub-cb').forEach(function(cb) { cb.checked = false; });
        fc3UpdateFulfillBar();
        loadAllLines();
    }

    // ── Submit — Depo Transferi (mevcut payload korunur) ─────────────────────────────────────
    function fc3ModalSubmitTransfer() {
        var lines = [];
        _modalLines.forEach(function(l) {
            var sel = document.querySelector('.fc3-mod-loc[data-line-id="' + l.lineId + '"]');
            var inp = document.querySelector('.fc3-mod-qty[data-line-id="' + l.lineId + '"]');
            var loc = sel ? parseInt(sel.value, 10) : 0;
            var q   = inp ? parseFloat((inp.value || '0').replace(',', '.')) : 0;
            if (!loc || q <= 0) return;
            lines.push({ itemId: l.itemId, unitId: l.unitId || null, qty: q,
                         fromLocationId: loc, toLocationId: l.locationId || null,
                         combinationId: l.combinationId || null, notes: null,
                         requestLineId: l.lineId || null });
        });
        if (!lines.length) { fc3ModalShowMsg('Lütfen en az bir kalem için kaynak depo ve miktar girin.', 'err'); return; }
        // requestIds MODALDAKİ (✕ ile çıkarılmış olabilecek) kalan satırlardan türetilir — çıkarılan
        // bir kalemin belgesi ne onay guard'ına ne soyağacı linkine karışır (bkz. görev raporu).
        var requestIds = Array.from(new Set(_modalLines.map(function(l) { return l.requestId; }).filter(Boolean)));
        fc3ModalSetBusy(true);
        fc3ModalShowMsg('', '');
        fetch('/Purchase/CreateTransfer', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': fc3Csrf() },
            body: JSON.stringify({ requestIds: requestIds, notes: (document.getElementById('fc3ModalNotes') || {}).value || null, lines: lines }),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            fc3ModalSetBusy(false);
            if (d.ok) {
                fc3ModalShowMsg('✔ Transfer oluşturuldu: ' + d.docNo, 'ok');
                var okBtn = document.getElementById('fc3ModalOkBtn'); if (okBtn) okBtn.disabled = true;
                fc3PostSubmitCleanup();
            } else {
                fc3ModalShowMsg('✖ ' + (d.error || 'Hata'), 'err');
            }
        })
        .catch(function() { fc3ModalSetBusy(false); fc3ModalShowMsg('✖ Bağlantı hatası', 'err'); });
    }

    // ── Submit — Satın Alma Talebi/Siparişi (mevcut payload'lar korunur, toggle'a göre uç değişir) ─
    function fc3ModalSubmitPurchase() {
        var picked = [];
        _modalLines.forEach(function(l) {
            var inp  = document.querySelector('.fc3-mod-qty[data-line-id="' + l.lineId + '"]');
            var note = document.querySelector('.fc3-mod-note[data-line-id="' + l.lineId + '"]');
            var q    = inp ? parseFloat((inp.value || '0').replace(',', '.')) : 0;
            if (q <= 0) return;
            picked.push({ l: l, qty: q, notes: (note ? note.value : null) || null });
        });
        if (!picked.length) { fc3ModalShowMsg('Lütfen en az bir kalem için miktar girin.', 'err'); return; }

        var meta         = _PR_DOC_TYPE_META[_prDocType];
        var notesGeneral = (document.getElementById('fc3ModalNotes') || {}).value || null;
        var url, body;
        if (_prDocType === 'order') {
            // alis_siparisi — tedarikçi (contactId) burada seçilmiyor, belge sonradan düzenlenebilir.
            var requestIds = Array.from(new Set(_modalLines.map(function(l) { return l.requestId; }).filter(Boolean)));
            url  = '/Purchase/CreatePurchaseOrderFromIhtiyac';
            body = {
                requestIds: requestIds, notes: notesGeneral, contactId: null,
                lines: picked.map(function(x) {
                    return { itemId: x.l.itemId, unitId: x.l.unitId || null, qty: x.qty,
                             combinationId: x.l.combinationId || null, notes: x.notes,
                             requestLineId: x.l.lineId || null };
                }),
            };
        } else {
            // satin_alma_talebi (DocumentSource bağlantılı) — requestIds gerekmez, backend her
            // lineId'nin sahibi belgeyi kendisi çözer (bkz. CreatePurchaseDemand).
            url  = '/Purchase/CreatePurchaseDemand';
            body = { notes: notesGeneral, lines: picked.map(function(x) { return { lineId: x.l.lineId, qty: x.qty, notes: x.notes }; }) };
        }

        fc3ModalSetBusy(true);
        fc3ModalShowMsg('', '');
        fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': fc3Csrf() },
            body: JSON.stringify(body),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            fc3ModalSetBusy(false);
            if (d.ok) {
                var msgEl = document.getElementById('fc3ModalMsg');
                if (msgEl) {
                    msgEl.innerHTML     = '✔ ' + meta.okPrefix + ': <a href="/Purchase/Edit?type=' + meta.editType + '&id=' + d.docId + '" target="_blank" style="color:inherit;text-decoration:underline;">' + esc(d.docNo) + '</a>';
                    msgEl.className     = 'fc3-res fc3-res--ok';
                    msgEl.style.display = 'block';
                }
                var okBtn = document.getElementById('fc3ModalOkBtn'); if (okBtn) okBtn.disabled = true;
                fc3PostSubmitCleanup();
            } else {
                fc3ModalShowMsg('✖ ' + (d.error || 'Hata'), 'err');
            }
        })
        .catch(function() { fc3ModalSetBusy(false); fc3ModalShowMsg('✖ Bağlantı hatası', 'err'); });
    }

    // ── Submit — İhtiyacı Kapat (mevcut payload korunur; modal AÇILIŞI zaten onay adımı, ayrıca
    // showConfirm sarmalamaya gerek yok — bkz. görev raporu). Seçili KALEMLERİN karşılanmamış
    // kalan miktarını kapatır (FulfillmentStatus=3). Hiç karşılama yapılmamış bir kalemde "kalan
    // miktar" = miktarın tamamı olduğundan bu TEK uç hem "ihtiyacı tamamen kapat" hem "kısmi
    // karşılamadan sonra kalanı kapat" senaryosunu aynı şekilde kapsar. Yalnız verilen satırlar
    // etkilenir; aynı belgedeki diğer kalemlere ve belge (header) Status'üne dokunulmaz. ────────
    function fc3ModalSubmitCloseLines() {
        var ids = _modalLines.map(function(l) { return l.lineId; });
        if (!ids.length) return;
        fc3ModalSetBusy(true);
        fc3ModalShowMsg('', '');
        fetch('/Purchase/CloseFulfillmentLines', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': fc3Csrf() },
            body: JSON.stringify({ lineIds: ids }),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            fc3ModalSetBusy(false);
            if (d.ok) {
                fc3CloseModal();
                CalibraAlert.show((d.closed || 0) + ' kalemin kalanı kapatıldı.', { type: 'success', autoDismissMs: 2500 });
                _lineSel = {};
                document.querySelectorAll('.fc3-sub-cb').forEach(function(cb) { cb.checked = false; });
                fc3UpdateFulfillBar();
                invalidateDocCache();
            } else {
                fc3ModalShowMsg('✖ ' + (d.error || 'Hata'), 'err');
            }
        })
        .catch(function() { fc3ModalSetBusy(false); fc3ModalShowMsg('✖ Bağlantı hatası', 'err'); });
    }

    function invalidateDocCache() {
        _docLineCache   = {};
        _globalStockMap = {};
        loadAllLines();
    }

    // ── Yardımcılar ──────────────────────────────────────────────────────────
    function fmtN(n) { return parseFloat(n||0).toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        return d.getDate().toString().padStart(2,'0')+'.'+(d.getMonth()+1).toString().padStart(2,'0')+'.'+d.getFullYear();
    }
    function esc(s) {
        return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Belge numarasına tıklanınca parent shell'de yeni workspace sekmesi açar.
    // Aynı URL için zaten açık sekme varsa ona geçiş yapar (upsert davranışı).
    window.fc3OpenDocTab = function(event, url) {
        event.preventDefault();
        event.stopPropagation();
        var parent = window.parent;
        if (parent && parent !== window && typeof parent.calibraOpenWorkspaceTab === 'function') {
            parent.calibraOpenWorkspaceTab(url, 'İhtiyaç Kaydı');
        } else {
            window.location.href = url;
        }
    };

    // ── Widget labelId haritası (reset için) ─────────────────────────────────
    var _wdgLblIds = {};  // { widgetId → lblElementId }

    // ── Grup chip yardımcı: dinamik chip oluştur + click handler bağla ───────
    function renderGrpChips(containerId, values, cbClass, lblId) {
        var cont = document.getElementById(containerId);
        if (!cont || !values.length) return;
        cont.innerHTML = values.map(function(name) {
            var safe = esc(name);
            return '<label class="fc3-ms-chip" data-val="' + safe + '">'
                + '<input type="checkbox" class="fc3-ms-cb ' + cbClass + '" value="' + safe + '" style="display:none;">'
                + safe + '</label>';
        }).join('');
        cont.querySelectorAll('.fc3-ms-chip').forEach(function(chip) {
            chip.addEventListener('click', function() {
                var cb = chip.querySelector('input');
                if (!cb) return;
                cb.checked = !cb.checked;
                chip.classList.toggle('active', cb.checked);
                var sel = document.querySelectorAll('.' + cbClass + ':checked');
                var lbl = document.getElementById(lblId);
                if (lbl) lbl.textContent = sel.length ? sel.length + ' seçili' : 'herhangi biri';
                applyFilters();
            });
        });
    }

    // ── Init ─────────────────────────────────────────────────────────────────
    // Metin/sayı/tarih filtrelerinde event
    document.querySelectorAll('.fc3-ftbl .fc3-fv,.fc3-ftbl .fc3-fop').forEach(function(el) {
        el.addEventListener('input',  applyFilters);
        el.addEventListener('change', applyFilters);
    });

    renderReqList('');             // Talep eden listesi ilk yükleme
    // Durum varsayılanı: onay açıkken "Onaylı" (işlem yapılabilirler öne çıkar, diğerleri
    // filtreden görünür); onay kapalıyken filtre yok (tüm belgeler zaten seçilebilir).
    renderStatList(APPROVAL_REQUIRED ? ['Approved'] : []);
    _updateStatLbl();

    // Karşılama: Bekliyor + Kısmen varsayılan seçili (tamamlananlar gizli)
    (function() {
        var defaults = ['pending', 'partial'];
        document.querySelectorAll('#fc3MsFulfillChips .fc3-ms-chip').forEach(function(chip) {
            var cb = chip.querySelector('.fc3-ms-cb-fulfill');
            if (!cb) return;
            if (defaults.indexOf(cb.value) !== -1) {
                cb.checked = true;
                chip.classList.add('active');
            }
        });
        var lbl = document.getElementById('fc3FulfillLbl');
        if (lbl) lbl.textContent = defaults.length + ' seçili';
        applyFilters();
    })();

    // Cari grubu chip'leri — veri varsa section'ı göster
    var _cariGrpAll = (function() {
        var set = new Set();
        ALL.forEach(function(r) { if (r.contactGroupName) set.add(r.contactGroupName); });
        return Array.from(set).sort(function(a, b) { return a.localeCompare(b, 'tr'); });
    })();
    if (_cariGrpAll.length) {
        var cgSect = document.getElementById('fc3CariGrpSect');
        if (cgSect) cgSect.style.display = '';
        renderGrpChips('fc3MsCgChips', _cariGrpAll, 'fc3-ms-cb-cg', 'fc3CgLbl');
    }

    // Kalem grubu chip'leri — veri varsa section'ı göster
    var _kalemGrpAll = (function() {
        var set = new Set();
        ALL.forEach(function(r) { (r.itemGroupNames || []).forEach(function(g) { set.add(g); }); });
        return Array.from(set).sort(function(a, b) { return a.localeCompare(b, 'tr'); });
    })();
    if (_kalemGrpAll.length) {
        var kgSect = document.getElementById('fc3KalemGrpSect');
        if (kgSect) kgSect.style.display = '';
        renderGrpChips('fc3MsKgChips', _kalemGrpAll, 'fc3-ms-cb-kg', 'fc3KgLbl');
    }

    // ── Stok durumu chip click ────────────────────────────────────────────────
    document.querySelectorAll('#fc3StockChips .fc3-ms-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var cb = chip.querySelector('.fc3-ms-cb-stock');
            if (!cb) return;
            cb.checked = !cb.checked;
            chip.classList.toggle('active', cb.checked);
            var sel = Array.from(document.querySelectorAll('.fc3-ms-cb-stock:checked'));
            var lbl = document.getElementById('fc3StockLbl');
            if (lbl) lbl.textContent = sel.length ? sel.length + ' seçili' : 'herhangi biri';
            applyFilters();
        });
    });

    // ── Widget filtre section'ları (dinamik) ─────────────────────────────────
    var _wdgContainer = document.getElementById('fc3WdgSects');
    if (_wdgContainer) {
        (WIDGET_DEFS || []).forEach(function(wd) {
            // Bu widget için tüm kayıtlardan benzersiz değerleri topla
            var valueSet = new Set();
            ALL.forEach(function(r) {
                wdgValuesForRecord(r, wd).forEach(function(v) { if (v) valueSet.add(v); });
            });
            var values = Array.from(valueSet).sort(function(a, b) { return a.localeCompare(b, 'tr'); });
            if (!values.length) return;  // Bu widget için veri yok, section ekleme

            // Benzersiz element id'leri
            var safeId  = wd.id.replace(/[^a-zA-Z0-9_-]/g, '_');
            var secId   = 'fc3WdgSect_'  + safeId;
            var lblId   = 'fc3WdgLbl_'   + safeId;
            var chpId   = 'fc3WdgChp_'   + safeId;
            var levelTx = wd.level === 'line' ? ' <span style="font-size:.65rem;padding:1px 5px;border-radius:999px;background:rgba(99,102,241,.15);color:#818cf8;font-weight:400;letter-spacing:0;text-transform:none;">kalem</span>' : '';

            _wdgLblIds[wd.id] = lblId;  // reset için kaydet

            var sect = document.createElement('div');
            sect.className = 'fc3-filt-sect';
            sect.id = secId;
            sect.innerHTML =
                '<div class="fc3-filt-sect-lbl">'
                    + '<span>' + esc(wd.label) + levelTx + '</span>'
                    + '<small id="' + lblId + '">herhangi biri</small>'
                + '</div>'
                + '<div class="fc3-ms-chips" id="' + chpId + '"></div>';
            _wdgContainer.appendChild(sect);

            // Chip'leri doldur + click handler
            var chipCont = document.getElementById(chpId);
            if (!chipCont) return;
            chipCont.innerHTML = values.map(function(name) {
                var safe = esc(name);
                return '<label class="fc3-ms-chip">'
                    + '<input type="checkbox" class="fc3-ms-cb fc3-ms-cb-wdg" data-wdg="' + esc(wd.id) + '" value="' + safe + '" style="display:none;">'
                    + safe + '</label>';
            }).join('');
            chipCont.querySelectorAll('.fc3-ms-chip').forEach(function(chip) {
                chip.addEventListener('click', function() {
                    var cb = chip.querySelector('input');
                    if (!cb) return;
                    cb.checked = !cb.checked;
                    chip.classList.toggle('active', cb.checked);
                    var sel = chipCont.querySelectorAll('.fc3-ms-cb-wdg:checked');
                    var lbl = document.getElementById(lblId);
                    if (lbl) lbl.textContent = sel.length ? sel.length + ' seçili' : 'herhangi biri';
                    applyFilters();
                });
            });
        });
    }

    applyFilters();    // İlk render (filtre state'ini _vis'e yaz)
    loadAllLines();    // Tüm kalemleri paralel fetch et, sonra renderList()
})();
</script>
}
