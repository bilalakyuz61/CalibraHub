    /* ── Seçim Aksiyon Bar ── */
    .fc3-fulfill-bar {
        position:fixed; bottom:0; left:0; right:0; z-index:9970;
        display:flex; align-items:center; gap:10px;
        padding:9px 18px;
        background:rgba(13,18,34,.97); border-top:1px solid rgba(99,102,241,.3);
