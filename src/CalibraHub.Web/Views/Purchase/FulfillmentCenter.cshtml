        background:rgba(99,102,241,.15); color:#a5b4fc; white-space:nowrap;
        border:1px solid rgba(99,102,241,.28);
    }
    .fc3-fb-sep   { width:1px; height:20px; background:rgba(255,255,255,.12); flex-shrink:0; margin:0 2px; }
    .fc3-fb-cancel {
        padding:5px 11px; border-radius:7px; font-size:.78rem;
        background:none; border:1px solid rgba(255,255,255,.12); color:#64748b; cursor:pointer;
        transition:all .12s; flex-shrink:0;
    }
    .fc3-fb-cancel:hover { background:rgba(255,255,255,.06); color:#94a3b8; }
    /* ── Merkez Modal (4 alt aksiyon ortak) — backdrop + ortalanmış kart, CLAUDE.md silme-onay
       deseni: backdrop+card, Vazgeç(ghost)+aksiyon butonu, Esc/backdrop=iptal, Enter=onay, ok
       butonu varsayılan focus'ta. Eski alt-çekmece (fc3-action-sheet/fc3-as-*) 2026-07-21'de bunun
       yerine geçti — Depodan Karşıla/Transfer/Satın Alma/İhtiyacı Kapat hepsi buradan açılır (bkz.
       FC_ACTIONS script bloğu). 2026-07-25 (PageComment Seq 26): ayrı "Ambar Çıkış Fişi" aksiyonu
       kaldırıldı — Depodan Karşıla ile defter/stok düzeyinde birebir aynıydı; serbest kaynak-depo
       yeteneği "Depodan Karşıla" modaline opsiyonel override olarak taşındı (bkz. fulfill.extraCols
       + fc3ModalSubmitFulfill). ── */
    .fc3-modal-backdrop {
        position:fixed; inset:0; z-index:99990;
        display:flex; align-items:center; justify-content:center; padding:20px;
        background:rgba(2,6,16,.62); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);
        opacity:0; pointer-events:none; transition:opacity 140ms;
    }
    .fc3-modal-backdrop.open { opacity:1; pointer-events:auto; }
    .fc3-modal {
        width:min(760px,100%); max-height:min(84vh,760px);
        background:rgba(13,18,34,.98); border:1px solid rgba(255,255,255,.1);
        border-radius:16px; box-shadow:0 32px 80px rgba(0,0,0,.5);
        display:flex; flex-direction:column; overflow:hidden;
        transform:translateY(10px) scale(.98); opacity:0;
        transition:transform 180ms cubic-bezier(.23,1,.32,1), opacity 180ms;
    }
    .fc3-modal-backdrop.open .fc3-modal { transform:translateY(0) scale(1); opacity:1; }
    .fc3-modal-hd {
        display:flex; align-items:center; gap:11px; padding:16px 18px; flex-shrink:0;
        border-bottom:1px solid rgba(255,255,255,.08);
    }
    .fc3-modal-hd-icon { width:36px; height:36px; border-radius:10px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
    .fc3-modal-hd-icon--fulfill { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; }
    .fc3-modal-hd-icon--t       { background:rgba(99,102,241,.16); border:1px solid rgba(99,102,241,.3); color:#a5b4fc; }
    .fc3-modal-hd-icon--pr      { background:rgba(16,185,129,.16); border:1px solid rgba(16,185,129,.3); color:#6ee7b7; }
    .fc3-modal-hd-icon--close   { background:rgba(239,68,68,.15);  border:1px solid rgba(239,68,68,.32); color:#fca5a5; }
    .fc3-modal-hd-tx   { flex:1; min-width:0; }
    .fc3-modal-hd-tx strong { display:block; font-size:.95rem; font-weight:700; color:#e2e8f0; }
    .fc3-modal-hd-tx small  { font-size:.74rem; color:#64748b; }
    .fc3-modal-close {
        padding:5px; border-radius:7px; background:none; flex-shrink:0;
        border:1px solid rgba(255,255,255,.07); color:#475569;
        cursor:pointer; transition:all .12s; display:flex; align-items:center;
    }
    .fc3-modal-close:hover { background:rgba(255,255,255,.07); color:#94a3b8; }
    .fc3-modal-body {
        flex:1; overflow-y:auto; padding:14px 18px;
        display:flex; flex-direction:column; gap:12px;
    }
    .fc3-modal-body::-webkit-scrollbar { width:5px; }
    .fc3-modal-body::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1); border-radius:3px; }
    .fc3-modal-tablewrap { border:1px solid rgba(255,255,255,.07); border-radius:10px; overflow:hidden; }
    .fc3-modal-tbl { width:100%; border-collapse:collapse; font-size:.8rem; }
    .fc3-modal-tbl thead th {
        text-align:left; padding:7px 8px; font-size:.68rem; font-weight:700; letter-spacing:.02em;
        color:#64748b; background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.08); white-space:nowrap;
    }
    .fc3-modal-tbl tbody td { padding:6px 8px; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:middle; }
    .fc3-modal-tbl tbody tr:last-child td { border-bottom:none; }
    .fc3-modal-mat { color:#cbd5e1; font-size:.79rem; }
    .fc3-modal-mat small { display:block; font-family:ui-monospace, Menlo, Consolas, monospace; font-size:.68rem; color:#818cf8; margin-top:1px; }
    .fc3-modal-rm {
        width:22px; height:22px; padding:0; border-radius:6px;
        border:1px solid rgba(239,68,68,.25); background:rgba(239,68,68,.08); color:#f87171;
        cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .12s;
    }
    .fc3-modal-rm:hover { background:rgba(239,68,68,.18); border-color:rgba(239,68,68,.4); color:#fca5a5; }
    .fc3-modal-simple {
        font-size:.85rem; color:#94a3b8; line-height:1.6;
        background:rgba(255,255,255,.02); border:1px solid rgba(255,255,255,.07); border-radius:10px; padding:14px 16px;
    }
