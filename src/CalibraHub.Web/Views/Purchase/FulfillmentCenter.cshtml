        <span class="fc3-fb-ico">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
        </span>
        <span id="fc3FbCnt" class="fc3-fb-cnt"></span>
        <span class="fc3-fb-chips" id="fc3FbChips"></span>
    </div>
    <div class="fc3-fb-right">
        <button type="button" class="fc3-btn fc3-btn--p" id="fc3FbBtn" onclick="fc3OpenModal('fulfill')">
