        </button>
    </div>

    @* ── Liste ── *@
    <div class="fc3-body">
        <div class="fc3-left">
            <div class="fc3-list-bar">
                <span id="fc3GrpCtrl" class="fc3-grp-ctrl">
                    <button type="button" class="fc3-grp-ctrl-btn" onclick="fc3ExpandAll()" title="Tüm grupları aç">
