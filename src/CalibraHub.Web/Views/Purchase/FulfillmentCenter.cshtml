    body.app-theme-light .fc3-fb-cnt   { color:#4338ca; }
    body.app-theme-light .fc3-fb-chip  { background:rgba(99,102,241,.09); color:#4338ca; border-color:rgba(99,102,241,.22); }
    body.app-theme-light .fc3-fb-sep   { background:rgba(0,0,0,.12); }
    body.app-theme-light .fc3-fb-cancel { border-color:#e2e8f0; color:#64748b; }
    body.app-theme-light .fc3-fb-cancel:hover { background:#f1f5f9; color:#0f172a; }

    body.app-theme-light .fc3-modal-backdrop { background:rgba(15,23,42,.32); }
    body.app-theme-light .fc3-modal { background:#ffffff; border-color:#e2e8f0; box-shadow:0 32px 80px rgba(15,23,42,.2); }
    body.app-theme-light .fc3-modal-hd { border-bottom-color:#e2e8f0; }
    body.app-theme-light .fc3-modal-hd-tx strong { color:#0f172a; }
    body.app-theme-light .fc3-modal-hd-tx small  { color:#64748b; }
    body.app-theme-light .fc3-modal-close { border-color:#e2e8f0; color:#64748b; }
    body.app-theme-light .fc3-modal-close:hover { background:#f1f5f9; color:#0f172a; }
    body.app-theme-light .fc3-modal-body::-webkit-scrollbar-thumb { background:#cbd5e1; }
    body.app-theme-light .fc3-modal-tablewrap { border-color:#e2e8f0; }
    body.app-theme-light .fc3-modal-tbl thead th { color:#64748b; background:#f8fafc; border-bottom-color:#e2e8f0; }
    body.app-theme-light .fc3-modal-tbl tbody td { border-bottom-color:#f1f5f9; }
    body.app-theme-light .fc3-modal-mat { color:#334155; }
    body.app-theme-light .fc3-modal-rm { background:rgba(239,68,68,.06); border-color:rgba(239,68,68,.22); color:#dc2626; }
    body.app-theme-light .fc3-modal-rm:hover { background:rgba(239,68,68,.12); }
    body.app-theme-light .fc3-modal-simple { background:#f8fafc; border-color:#e2e8f0; color:#475569; }
    body.app-theme-light .fc3-modal-simple strong { color:#0f172a; }
    body.app-theme-light .fc3-modal-chip { background:rgba(239,68,68,.06); border-color:rgba(239,68,68,.22); color:#b91c1c; }
    body.app-theme-light .fc3-modal-ft { border-top-color:#e2e8f0; }
    body.app-theme-light .fc3-modal-ok--pr { color:#022c22; }

    /* ── Flat liste (tek katmanlı kalem satırları) ────────────────
       Başlık + satırlar AYNI grid şablonunu (--fc3-cols, JS üretir) kullanır:
       kolon genişlikleri içerikten bağımsız sabitlenir, başlık/içerik hizası
       hiçbir içerik uzunluğunda kaymaz. */
    .fc3-flat-hdr {
        display:grid; grid-template-columns:var(--fc3-cols, none);
        align-items:center; gap:8px;
        padding:3px 16px 3px 12px; flex-shrink:0;
        font-size:.78rem; font-weight:700; letter-spacing:.03em;
        color:#475569; border-bottom:1px solid rgba(255,255,255,.06);
        background:rgba(255,255,255,.02);
    }
    body.app-theme-light .fc3-flat-hdr { color:#94a3b8; border-bottom-color:#f1f5f9; background:#f8fafc; }
    .fc3-flat-row {
        display:grid; grid-template-columns:var(--fc3-cols, none);
        align-items:center; gap:8px;
        padding:5px 12px; border-bottom:1px solid rgba(255,255,255,.03);
        font-size:.76rem; cursor:default; transition:background .1s;
    }
    .fc3-flat-row:hover { background:rgba(255,255,255,.025); }
    body.app-theme-light .fc3-flat-row { border-bottom-color:#f1f5f9; }
    body.app-theme-light .fc3-flat-row:hover { background:#f8fafc; }
    /* Belge sütun hücreleri (flat row içinde) */
    .fc3-flat-num { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:.78rem; font-weight:700; color:#c7d2fe; min-width:130px; flex-shrink:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .fc3-flat-who { color:#94a3b8; min-width:80px; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .fc3-flat-dt  { color:#475569; font-size:.72rem; min-width:55px; text-align:right; flex-shrink:0; white-space:nowrap; }
    body.app-theme-light .fc3-flat-num { color:#4338ca; }
    body.app-theme-light .fc3-flat-who { color:#0f172a; }
    body.app-theme-light .fc3-flat-dt  { color:#64748b; }
    /* Başlık spacer'ları — hücre genişlikleriyle eşleşir */
    .fc3-fhdr__cb     { width:15px; flex-shrink:0; }
    .fc3-fhdr__num    { min-width:130px; flex-shrink:0; }
    .fc3-fhdr__who    { min-width:80px; flex:1; }
    .fc3-fhdr__dt     { min-width:55px; text-align:right; flex-shrink:0; }
    .fc3-fhdr__mat    { flex:1; min-width:0; overflow:hidden; }
    .fc3-fhdr__qty    { min-width:54px; text-align:right; flex-shrink:0; }
    .fc3-fhdr__unit   { min-width:28px; flex-shrink:0; }
    .fc3-fhdr__stk    { flex:1; min-width:0; }
    .fc3-fhdr__remain { min-width:52px; text-align:right; flex-shrink:0; }
    .fc3-fhdr__fst    { width:100px; min-width:100px; max-width:100px; text-align:center; flex-shrink:0; }
    .fc3-fhdr__suf    { min-width:18px; flex-shrink:0; }
    .fc3-fhdr__ext    { min-width:80px; max-width:140px; flex-shrink:0; }
    /* Grid hücre disiplini: hücre track genişliğine uyar, taşan metin kesilir.
       min-width sıfırlanmazsa grid item'ın auto min-size'ı track'i genişletip
       başlık/satır hizasını bozar. */
    .fc3-flat-hdr > span, .fc3-flat-row > * { min-width:0; }
    .fc3-flat-hdr > span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .fc3-flat-row .fc3-flat-dt,
    .fc3-flat-row .fc3-sub-qty,
    .fc3-flat-row .fc3-sub-remain,
    .fc3-flat-row .fc3-sub-unit { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

    /* ── Yenile butonu spin animasyonu ── */
    @@keyframes fc3spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .fc3-hd-icon-btn.fc3-spin svg { animation: fc3spin .8s linear infinite; }
</style>
}

<section class="integrator-dashboard integrator-dashboard--wide integrator-dashboard__content">
