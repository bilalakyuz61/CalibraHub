@{
    ViewData["Title"] = "Kaynak Bağlantıları";
    ViewData["FormCode"] = "DB_DATA_IMPORT";
    ViewData["HelpKey"] = "db-data-import-connections";
    ViewData["BodyClass"] = "page-db-import";
    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>ExternalDbConnection</td><td style='padding:6px 8px;'>Harici SQL Server kaynak bağlantıları — parola DPAPI ile şifreli saklanır, istemciye dönülmez</td></tr>"
        + "</table>";
}

@section Styles {
<style>
    .workspace-frame-body.page-db-import .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }
    #reactDbImportConnections { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; }
</style>
}

<div id="reactDbImportConnections"></div>

@section Scripts {
<script>
(function () {
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('reactDbImportConnections');

    function showError(msg) { if (el) el.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:13px;">' + msg + '</div>'; }
    function loadCss() {
        if (document.querySelector('link[data-dbi-conn]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL; link.setAttribute('data-dbi-conn', '1');
        document.head.appendChild(link);
    }
    function loadScript(cb) {
        var prev = document.querySelector('script[data-dbi-conn]');
        if (prev) { prev.addEventListener('load', cb); return; }
        var s = document.createElement('script');
        s.src = BUNDLE_URL; s.setAttribute('data-dbi-conn', '1');
        s.onload = function () { setTimeout(cb, 0); };
        s.onerror = function () { showError('React bundle yüklenemedi.'); };
        document.head.appendChild(s);
    }
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountDbImportConnections) { showError('mountDbImportConnections bulunamadı.'); return; }
        window.CalibraHub.mountDbImportConnections(el);
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountDbImportConnections) doMount();
    else loadScript(doMount);
})();
</script>
}
