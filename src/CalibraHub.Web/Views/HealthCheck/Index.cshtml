@{
    ViewData["Title"] = "Sistem Sağlık Kontrolü";
    ViewData["HelpKey"] = "health-check";
    ViewData["BodyClass"] = "page-hc";
}

@section Styles {
<style>
    /* 2026-08-22 (kullanici istegi: "tam ekran yap, bazi yazilar sigmiyor"):
       Sayfa kabinin padding/max-width kisitlari sifirlanir — ShipmentPlanningCenter
       (.page-sp) ile ayni iskelet. */
    .page-hc .integrator-dashboard {
        padding: 0 !important; background: transparent !important;
        box-shadow: none !important; border: none !important; max-width: none !important;
    }
    .page-hc .integrator-dashboard__content { width: 100% !important; max-width: none !important; padding: 0 !important; }

    .hc-wrap {
        padding: 16px 20px;
        /* 1400px tavani genis ekranda sagda genis bir bosluk birakiyor ve uzun
           yollar/hata metinleri dar sutuna sikisiyordu — tavan kaldirildi. */
        max-width: none;
        margin: 0;
        height: calc(100vh - var(--app-header-height, 64px) - var(--app-tabs-height, 48px));
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .hc-toolbar { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; flex: 0 0 auto; }

    /* Buton */
    .hc-btn {
        padding: 9px 18px; border-radius: 8px; border: none;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff; font-weight: 600; font-size: 13px; cursor: pointer;
        display: inline-flex; align-items: center; gap: 8px;
        transition: transform .12s, opacity .12s;
    }
    .hc-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .hc-btn:disabled { opacity: .5; cursor: not-allowed; }

    /* Özet pill'leri */
    .hc-summary { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .hc-pill {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 20px; font-size: 12px; font-weight: 600;
        background: rgba(148,163,184,.15);
    }
    .hc-pill.ok       { background: rgba(16,185,129,.18); color: #10b981; }
    .hc-pill.error    { background: rgba(239,68,68,.18);  color: #ef4444; }
    .hc-pill.warn     { background: rgba(245,158,11,.18); color: #f59e0b; }
    .hc-pill.redirect { background: rgba(59,130,246,.18); color: #3b82f6; }

    /* Switch */
    .hc-switch-label { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
    .hc-switch-track {
        position: relative; width: 36px; height: 20px;
        border-radius: 10px; background: rgba(148,163,184,.3);
        transition: background .18s; flex-shrink: 0;
    }
    .hc-switch-input { position: absolute; opacity: 0; width: 0; height: 0; }
    .hc-switch-thumb {
        position: absolute; top: 3px; left: 3px;
        width: 14px; height: 14px; border-radius: 50%;
        background: #fff; transition: transform .18s;
        box-shadow: 0 1px 3px rgba(0,0,0,.25);
    }
    .hc-switch-input:checked ~ .hc-switch-thumb { transform: translateX(16px); }
    .hc-switch-label:has(.hc-switch-input:checked) .hc-switch-track { background: #6366f1; }
    .hc-switch-text { font-size: 13px; color: #475569; }
    body.app-theme-dark .hc-switch-text { color: #94a3b8; }

    /* Spinner */
    .hc-spinner {
        width: 14px; height: 14px;
        border: 2px solid currentColor;
        border-top-color: transparent;
        border-radius: 50%;
        animation: hc-spin 0.7s linear infinite;
        display: inline-block;
    }
    @@keyframes hc-spin { to { transform: rotate(360deg); } }

    /* ── Adım listesi (accordion) ──────────────────────────────────────── */
    .hc-step-list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-bottom: 16px;
    }

    .hc-step-item {
        background: var(--app-surface, #fff);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 10px;
        overflow: hidden;
    }
    body.app-theme-dark .hc-step-item {
        background: rgba(30,41,59,.55);
        border-color: rgba(255,255,255,.07);
    }

    .hc-step-header {
        display: flex; align-items: center; gap: 12px;
        padding: 13px 16px;
        cursor: pointer; user-select: none;
        transition: background .1s;
    }
    .hc-step-header:hover { background: rgba(148,163,184,.06); }

    /* Status badge — küçük renkli kare */
    .hc-step-badge {
        flex: 0 0 auto; width: 28px; height: 28px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 700;
    }
    .hc-step-badge.pending { background: rgba(148,163,184,.15); color: #94a3b8; }
    .hc-step-badge.running { background: rgba(99,102,241,.12);  color: #6366f1; }
    .hc-step-badge.ok      { background: rgba(16,185,129,.14);  color: #10b981; }
    .hc-step-badge.error   { background: rgba(239,68,68,.14);   color: #ef4444; }
    .hc-step-badge.warn    { background: rgba(245,158,11,.14);  color: #f59e0b; }

    .hc-step-title { font-weight: 600; font-size: 13.5px; flex: 0 0 auto; }
    body.app-theme-dark .hc-step-title { color: #f1f5f9; }

    .hc-step-meta { font-size: 11.5px; color: #94a3b8; flex: 1 1 auto; padding-left: 4px; }

    .hc-step-chevron {
        flex: 0 0 auto; width: 20px; text-align: center;
        color: #94a3b8; font-size: 10px;
        transition: transform .2s;
    }
    .hc-step-item.expanded .hc-step-chevron { transform: rotate(90deg); }

    /* Body — gizli; expanded sınıfıyla gösterilir */
    .hc-step-body {
        display: none;
        border-top: 1px solid rgba(148,163,184,.1);
    }
    body.app-theme-dark .hc-step-body { border-top-color: rgba(255,255,255,.05); }
    .hc-step-item.expanded .hc-step-body { display: block; }

    /* ── Kurulum alt adımları ─────────────────────────────────────────── */
    .hc-substep-list { padding: 12px 16px; display: flex; flex-direction: column; gap: 7px; }
    .hc-substep-row  { display: flex; align-items: center; gap: 10px; font-size: 13px; }
    .hc-substep-icon { flex: 0 0 20px; text-align: center; font-size: 13px; }
    .hc-substep-row.pending { color: #94a3b8; }
    .hc-substep-row.running { color: #6366f1; font-weight: 500; }
    .hc-substep-row.ok      { color: #10b981; }
    .hc-substep-row.error   { color: #ef4444; }
    .hc-substep-info {
        margin-top: 8px; padding: 0 16px 12px;
        font-size: 11.5px; color: #64748b;
        font-family: ui-monospace, Menlo, Consolas, monospace;
    }
    body.app-theme-dark .hc-substep-info { color: #94a3b8; }

    /* ── Form kontrol canlı ilerleme ───────────────────────────────────── */
    .hc-form-live {
        padding: 14px 16px;
    }
    .hc-form-live-row {
        font-size: 13px; margin-bottom: 4px;
    }
    .hc-form-live-path {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 11px; color: #64748b;
    }
    body.app-theme-dark .hc-form-live-path { color: #94a3b8; }
    .hc-progress-bar {
        margin-top: 8px; height: 4px; border-radius: 2px;
        background: rgba(148,163,184,.18); overflow: hidden;
    }
    .hc-progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        transition: width .25s ease;
    }

    /* ── Form sonuç tablosu (adım detayı içinde) ───────────────────────── */
    .hc-mini-table {
        width: 100%; border-collapse: separate; border-spacing: 0;
        font-size: 12px;
    }
    .hc-mini-table th {
        text-align: left; padding: 8px 12px;
        background: rgba(241,245,249,1);
        font-weight: 600; font-size: 11px; color: #64748b;
        letter-spacing: .04em;
        border-bottom: 1px solid rgba(148,163,184,.1);
        position: sticky; top: 0; z-index: 2;
    }
    body.app-theme-dark .hc-mini-table th { background: rgba(15,23,42,.9); color: #64748b; }
    .hc-mini-table td {
        padding: 8px 12px;
        border-bottom: 1px solid rgba(148,163,184,.07);
        vertical-align: top;
    }
    body.app-theme-dark .hc-mini-table td { border-bottom-color: rgba(255,255,255,.04); }
    .hc-mini-table tr:last-child td { border-bottom: none; }
    .hc-mini-table tr.row-error     { background: rgba(239,68,68,.05); }
    .hc-mini-table tr.row-exception { background: rgba(239,68,68,.08); }
    .hc-mini-table tr.row-warn      { background: rgba(245,158,11,.04); }

    /* Durum rozeti (tablo içi) */
    .hc-status {
        display: inline-flex; align-items: center;
        padding: 2px 8px; border-radius: 5px;
        font-weight: 700; font-size: 10.5px; text-transform: uppercase;
        letter-spacing: .04em; min-width: 56px; justify-content: center;
    }
    .hc-status.ok        { background: rgba(16,185,129,.16); color: #10b981; }
    .hc-status.error,
    .hc-status.exception { background: rgba(239,68,68,.16);  color: #ef4444; }
    .hc-status.warn      { background: rgba(245,158,11,.16); color: #f59e0b; }
    .hc-status.redirect  { background: rgba(59,130,246,.16); color: #3b82f6; }
    .hc-status.pending   { background: rgba(148,163,184,.18); color: #94a3b8; }

    .hc-path   { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; color: #64748b; }
    body.app-theme-dark .hc-path { color: #94a3b8; }
    .hc-parent { font-size: 11px; color: #94a3b8; }
    .hc-duration { color: #94a3b8; font-size: 11px; text-align: right; white-space: nowrap; }
    .hc-error-snippet {
        font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px;
        background: rgba(239,68,68,.10); padding: 5px 8px; border-radius: 4px;
        color: #ef4444; margin-top: 3px;
        /* max-width: 500px KALDIRILDI (2026-08-22) — uzun hata/uyari metinleri
           dar bir sutuna sikisip okunmaz oluyordu; artik satirin tam genisligini
           kullanir, tasan kisim yine sarilir. */
        max-width: none;
        white-space: pre-wrap; word-break: break-word;
    }

    /* ── İki bölüm (Sayfa Kontrolleri / Fonksiyon Testleri) ────────────── */
    .hc-block {
        flex: 1 1 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .hc-divider {
        height: 1px;
        background: rgba(148,163,184,.18);
        margin: 18px 0;
        flex: 0 0 auto;
    }
    body.app-theme-dark .hc-divider { background: rgba(255,255,255,.08); }

    .hc-section-title { font-size: 16px; font-weight: 700; margin: 0 0 4px; }
    body.app-theme-dark .hc-section-title { color: #f1f5f9; }
    .hc-section-sub { font-size: 12.5px; color: #64748b; margin: 0 0 16px; }
    body.app-theme-dark .hc-section-sub { color: #94a3b8; }

    /* ── Sol sekme rayi + sag icerik (2026-08-22, kullanici istegi:
       "gruplamalar solda tabsheet olsun, detaylar sagda tabsheet bazinda").
       Proje sekmeli-form dili: sol dar ray, secili sekmede dolu nokta + glow. ── */
    .hc-shell { display: flex; gap: 16px; flex: 1 1 auto; min-height: 0; }
    .hc-nav {
        flex: 0 0 210px; width: 210px;
        display: flex; flex-direction: column; gap: 4px;
        padding-right: 14px;
        border-right: 1px solid rgba(148,163,184,.18);
        overflow-y: auto;
    }
    body.app-theme-dark .hc-nav { border-right-color: rgba(255,255,255,.08); }
    .hc-nav__tab {
        display: flex; align-items: center; gap: 9px;
        padding: 9px 11px; border-radius: 9px;
        font-size: 13px; font-weight: 600; color: #64748b;
        background: transparent; border: 1px solid transparent;
        cursor: pointer; text-align: left; width: 100%;
        transition: background .12s, color .12s, border-color .12s;
    }
    body.app-theme-dark .hc-nav__tab { color: #94a3b8; }
    .hc-nav__tab:hover { background: rgba(148,163,184,.10); }
    .hc-nav__tab.is-active {
        background: rgba(99,102,241,.10); color: #4f46e5;
        border-color: rgba(99,102,241,.22);
    }
    body.app-theme-dark .hc-nav__tab.is-active { color: #a5b4fc; background: rgba(99,102,241,.16); }
    /* Nokta: pasifken halka, aktifken dolu + glow (Malzeme Karti standardi) */
    .hc-nav__dot {
        width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
        border: 1.5px solid currentColor; background: transparent;
    }
    .hc-nav__tab.is-active .hc-nav__dot {
        background: currentColor; border-color: currentColor;
        box-shadow: 0 0 0 3px rgba(99,102,241,.18);
    }
    /* Sekme durum rozeti — o gruptaki en kotu sonuc (calisma bitince JS boyar) */
    .hc-nav__badge {
        margin-left: auto; flex-shrink: 0;
        font-size: 10px; font-weight: 700; letter-spacing: .03em;
        padding: 1px 7px; border-radius: 999px;
        background: rgba(148,163,184,.18); color: #94a3b8;
    }
    .hc-nav__badge.ok    { background: rgba(16,185,129,.18); color: #10b981; }
    .hc-nav__badge.warn  { background: rgba(245,158,11,.18); color: #f59e0b; }
    .hc-nav__badge.error { background: rgba(239,68,68,.18);  color: #ef4444; }
    .hc-nav__badge:empty { display: none; }

    .hc-panes { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
    .hc-pane { display: none; flex: 1 1 auto; min-height: 0; }
    .hc-pane.is-active { display: flex; flex-direction: column; }

    .hc-fn-toolbar { flex-wrap: wrap; row-gap: 8px; }
    .hc-fn-hint { font-size: 12px; color: #f59e0b; font-weight: 600; }

    /* Fonksiyon testleri — çalışma başlamadıysa (fn_error) uyarı bandı */
    .hc-fn-error-banner {
        padding: 14px 16px;
        border-radius: 10px;
        background: rgba(239,68,68,.10);
        border: 1px solid rgba(239,68,68,.25);
        color: #ef4444;
        font-size: 13px;
        font-weight: 600;
    }
    body.app-theme-dark .hc-fn-error-banner {
        background: rgba(239,68,68,.16);
        border-color: rgba(239,68,68,.32);
    }
</style>
}

<div class="hc-wrap">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0 0 12px; flex: 0 0 auto;">Sistem Sağlık Kontrolü</h1>

    <div class="hc-shell">
        <nav class="hc-nav" role="tablist" aria-label="Sağlık kontrolü grupları">
            <button type="button" class="hc-nav__tab is-active" role="tab" data-hc-tab="pages" aria-selected="true">
                <span class="hc-nav__dot"></span>
                <span>Sayfa Kontrolleri</span>
                <span class="hc-nav__badge" id="hcTabBadgePages"></span>
            </button>
            <button type="button" class="hc-nav__tab" role="tab" data-hc-tab="fn" aria-selected="false">
                <span class="hc-nav__dot"></span>
                <span>Fonksiyon Testleri</span>
                <span class="hc-nav__badge" id="hcTabBadgeFn"></span>
            </button>
        </nav>

        <div class="hc-panes">
    <div class="hc-block hc-pane is-active" data-hc-pane="pages">
        <p style="font-size: 13px; color: #64748b; margin: 0 0 16px;">
            Tüm menü ekranlarına otomatik HTTP isteği gönderilir. 200 OK alamayan sayfalar listelenir.
        </p>

        <div class="hc-toolbar">
            <button id="hcRunBtn" class="hc-btn" type="button">
                <span id="hcRunIcon">▶</span>
                <span id="hcRunLabel">Kontrolleri Çalıştır</span>
            </button>
            <label class="hc-switch-label" title="Etkinleştirilirse mevcut sunucuda yeni bir test DB'si oluşturulur, içi sıfırdan doldurulur">
                <span class="hc-switch-track">
                    <input type="checkbox" id="hcNewDb" class="hc-switch-input">
                    <span class="hc-switch-thumb"></span>
                </span>
                <span class="hc-switch-text">Yeni veritabanı oluştur</span>
            </label>
            <div id="hcSummary" class="hc-summary"></div>
        </div>

        <div id="hcResults" style="flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;"></div>
    </div>

    <div class="hc-block hc-pane" data-hc-pane="fn">
        <p class="hc-section-sub">
            Test şirketi üzerinde uçtan uca iş senaryoları (sipariş, üretim, kalite vb.) çalıştırılır ve adım adım doğrulanır.
        </p>

        <div class="hc-toolbar hc-fn-toolbar">
            <button id="hcFnRunBtn" class="hc-btn" type="button">
                <span id="hcFnRunIcon">▶</span>
                <span id="hcFnRunLabel">Testleri Çalıştır</span>
            </button>
            <label class="hc-switch-label">
                <span class="hc-switch-track">
                    <input type="checkbox" id="hcFnGroupTicari" class="hc-switch-input" checked>
                    <span class="hc-switch-thumb"></span>
                </span>
                <span class="hc-switch-text">Ticari</span>
            </label>
            <label class="hc-switch-label">
                <span class="hc-switch-track">
                    <input type="checkbox" id="hcFnGroupUretim" class="hc-switch-input" checked>
                    <span class="hc-switch-thumb"></span>
                </span>
                <span class="hc-switch-text">Üretim</span>
            </label>
            <label class="hc-switch-label">
                <span class="hc-switch-track">
                    <input type="checkbox" id="hcFnGroupKalite" class="hc-switch-input" checked>
                    <span class="hc-switch-thumb"></span>
                </span>
                <span class="hc-switch-text">Kalite</span>
            </label>
            <span id="hcFnHint" class="hc-fn-hint"></span>
            <div id="hcFnSummary" class="hc-summary"></div>
        </div>

        <div id="hcFnResults" style="flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;"></div>
    </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
/* ── Sol sekme rayi (2026-08-22) ─────────────────────────────────────────
   Gruplar solda, secili grubun detayi sagda. Bagimsiz IIFE — asagidaki
   calistirma mantigina hic dokunmaz; yalnizca gorunurluk degistirir.
   Sekme rozetleri: her grup kendi ozetini yayinlar (hcSetTabBadge), boylece
   kullanici digerine gecmeden hangi grupta sorun oldugunu gorur. */
(function () {
    var tabs  = Array.prototype.slice.call(document.querySelectorAll('[data-hc-tab]'));
    var panes = Array.prototype.slice.call(document.querySelectorAll('[data-hc-pane]'));
    function activate(key) {
        tabs.forEach(function (t) {
            var on = t.getAttribute('data-hc-tab') === key;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panes.forEach(function (p) {
            p.classList.toggle('is-active', p.getAttribute('data-hc-pane') === key);
        });
    }
    tabs.forEach(function (t) {
        t.addEventListener('click', function () { activate(t.getAttribute('data-hc-tab')); });
    });

    /* Rozet: { ok, warn, error } sayilarindan EN KOTU durumu gosterir.
       Hicbiri yoksa rozet gizlenir (:empty). */
    window.hcSetTabBadge = function (key, counts) {
        var el = document.getElementById(key === 'fn' ? 'hcTabBadgeFn' : 'hcTabBadgePages');
        if (!el) return;
        counts = counts || {};
        var err = Number(counts.error || 0), warn = Number(counts.warn || 0), ok = Number(counts.ok || 0);
        el.classList.remove('ok', 'warn', 'error');
        if (err > 0)       { el.classList.add('error'); el.textContent = err; }
        else if (warn > 0) { el.classList.add('warn');  el.textContent = warn; }
        else if (ok > 0)   { el.classList.add('ok');    el.textContent = ok; }
        else               { el.textContent = ''; }
    };
})();

(function() {
    const btn       = document.getElementById('hcRunBtn');
    const icon      = document.getElementById('hcRunIcon');
    const label     = document.getElementById('hcRunLabel');
    const summaryEl = document.getElementById('hcSummary');
    const resultsEl = document.getElementById('hcResults');

    // Fonksiyon Testleri bölümü referansları
    const fnBtn       = document.getElementById('hcFnRunBtn');
    const fnIcon      = document.getElementById('hcFnRunIcon');
    const fnLabel     = document.getElementById('hcFnRunLabel');
    const fnSummaryEl = document.getElementById('hcFnSummary');
    const fnResultsEl = document.getElementById('hcFnResults');
    const fnHintEl    = document.getElementById('hcFnHint');

    // ── Yardımcılar ─────────────────────────────────────────────────────

    function getCsrf() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function escapeHtml(s) {
        if (!s) return '';
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // ── Accordion step list ──────────────────────────────────────────────
    function initStepList() {
        resultsEl.innerHTML = '<div class="hc-step-list" id="hcStepList"></div>';
    }
    function getList() { return document.getElementById('hcStepList'); }

    // Yeni adım satırı oluştur ve listeye ekle
    function createStep(id, title, statusCls) {
        const list = getList(); if (!list) return;
        const item = document.createElement('div');
        item.className = 'hc-step-item';
        item.id = 'hcs-' + id;
        item.innerHTML =
            '<div class="hc-step-header" onclick="hcToggle(\'' + id + '\')">'
          +   '<div class="hc-step-badge ' + statusCls + '" id="hcb-' + id + '">' + badgeInner(statusCls) + '</div>'
          +   '<div class="hc-step-title">' + escapeHtml(title) + '</div>'
          +   '<div class="hc-step-meta" id="hcm-' + id + '"></div>'
          +   '<div class="hc-step-chevron" id="hcc-' + id + '">▶</div>'
          + '</div>'
          + '<div class="hc-step-body" id="hcbd-' + id + '"></div>';
        list.appendChild(item);
    }

    function badgeInner(cls) {
        if (cls === 'running') return '<span class="hc-spinner" style="width:12px;height:12px;border-width:2px;"></span>';
        return { ok:'✓', error:'✗', warn:'⚠', pending:'·' }[cls] || '·';
    }

    function stepStatus(id, cls, meta) {
        const b = document.getElementById('hcb-' + id);
        const m = document.getElementById('hcm-' + id);
        if (b) { b.className = 'hc-step-badge ' + cls; b.innerHTML = badgeInner(cls); }
        if (m && meta != null) m.textContent = meta;
    }

    function stepExpand(id, open) {
        const item = document.getElementById('hcs-' + id);
        const chev = document.getElementById('hcc-' + id);
        if (!item) return;
        item.classList.toggle('expanded', open);
        if (chev) chev.textContent = open ? '▼' : '▶';
    }

    function stepBody(id, html) {
        const b = document.getElementById('hcbd-' + id); if (b) b.innerHTML = html;
    }

    // Tıklama handler'ı — global çünkü onclick string içinde
    window.hcToggle = function(id) {
        const item = document.getElementById('hcs-' + id);
        const chev = document.getElementById('hcc-' + id);
        if (!item) return;
        const open = item.classList.toggle('expanded');
        if (chev) chev.textContent = open ? '▼' : '▶';
    };

    // ── Özet pill satırı ─────────────────────────────────────────────────
    function summaryHtml(s, extra) {
        return '<span class="hc-pill ok">✓ ' + s.ok + ' OK</span>'
            + (s.redirect > 0 ? '<span class="hc-pill redirect">↻ ' + s.redirect + '</span>' : '')
            + (s.warn > 0      ? '<span class="hc-pill warn">⚠ '    + s.warn      + '</span>' : '')
            + (s.error > 0     ? '<span class="hc-pill error">✗ '   + s.error     + ' Hata</span>'  : '')
            + (s.exception > 0 ? '<span class="hc-pill error">⚡ '  + s.exception + ' Exception</span>' : '')
            + '<span class="hc-pill">⏱ ' + s.durationMs + 'ms</span>'
            + '<span class="hc-pill">' + s.total + ' toplam</span>'
            + (extra || '');
    }

    // ── Form sonuç tablosu ───────────────────────────────────────────────
    function buildFormTable(results) {
        const order = { exception:0, error:1, warn:2, redirect:3, ok:4 };
        const sorted = [...results].sort((a, b) => (order[a.status] ?? 5) - (order[b.status] ?? 5));
        const lbl = s => ({ ok:'OK', error:'HATA', exception:'CRASH', warn:'UYARI', redirect:'REDIR', pending:'...' })[s] || s.toUpperCase();

        let h = '<table class="hc-mini-table"><thead><tr>'
              + '<th style="width:68px">Durum</th><th>Ekran</th><th>URL</th>'
              + '<th style="width:52px">HTTP</th>'
              + '<th style="width:90px">Şema</th>'
              + '<th style="width:68px;text-align:right">Süre</th>'
              + '</tr></thead><tbody>';

        sorted.forEach(r => {
            const sp = r.schemaProbe;
            const rowErr = (r.status === 'error' || r.status === 'exception')
                        || (sp && (sp.status === 'error' || sp.status === 'exception'));
            const rowCls = rowErr ? 'row-error' : (r.status === 'warn' ? 'row-warn' : '');

            let schemaCell = '<td style="color:#94a3b8;text-align:center">—</td>';
            if (sp) {
                if (sp.status === 'ok') {
                    schemaCell = '<td><span class="hc-status ok" title="Tablo: ' + escapeHtml(sp.table) + '">ŞEMA OK</span></td>';
                } else {
                    const el = sp.status === 'exception' ? 'CRASH' : 'HATA';
                    const em = sp.errorMessage ? '#' + (sp.errorNumber||'?') + ' ' + sp.errorMessage : 'Bilinmeyen hata';
                    schemaCell = '<td><span class="hc-status ' + sp.status + '" title="' + escapeHtml(em) + '">' + el + '</span></td>';
                }
            }

            h += '<tr class="' + rowCls + '">'
               + '<td><span class="hc-status ' + r.status + '">' + lbl(r.status) + '</span></td>'
               + '<td><div style="font-weight:600">' + escapeHtml(r.label) + '</div>'
               +   (r.parentLabel ? '<div class="hc-parent">' + escapeHtml(r.parentLabel) + '</div>' : '')
               +   (r.errorSnippet ? '<div class="hc-error-snippet">' + escapeHtml(r.errorSnippet) + '</div>' : '')
               +   (sp && sp.errorMessage ? '<div class="hc-error-snippet">[ŞEMA #' + (sp.errorNumber||'?') + '] ' + escapeHtml(sp.errorMessage) + '</div>' : '')
               + '</td>'
               + '<td class="hc-path">' + escapeHtml(r.path) + '</td>'
               + '<td>' + (r.statusCode || '—') + '</td>'
               + schemaCell
               + '<td class="hc-duration">' + r.durationMs + 'ms</td>'
               + '</tr>';
        });
        return h + '</tbody></table>';
    }

    // ── Form kontrol live progress HTML'i ───────────────────────────────
    function formLiveHtml(index, total, lbl, parentLabel, path) {
        const pct = total > 0 ? Math.round((index - 1) / total * 100) : 0;
        return '<div class="hc-form-live" id="hcFormLive">'
             + '<div class="hc-form-live-row">'
             +   '<span style="color:#6366f1;font-weight:700">' + index + '/' + total + '</span> kontrol ediliyor: '
             +   '<b>' + escapeHtml(lbl) + '</b>'
             +   (parentLabel ? ' <span class="hc-parent">· ' + escapeHtml(parentLabel) + '</span>' : '')
             + '</div>'
             + '<div class="hc-form-live-path">' + escapeHtml(path) + '</div>'
             + '<div class="hc-progress-bar"><div class="hc-progress-bar-fill" id="hcFill" style="width:' + pct + '%"></div></div>'
             + '</div>';
    }

    function updateFormLive(index, total, lbl, parentLabel, path) {
        const el = document.getElementById('hcFormLive');
        if (!el) return;
        const pct = total > 0 ? Math.round((index - 1) / total * 100) : 0;
        el.innerHTML =
            '<div class="hc-form-live-row">'
          +   '<span style="color:#6366f1;font-weight:700">' + index + '/' + total + '</span> kontrol ediliyor: '
          +   '<b>' + escapeHtml(lbl) + '</b>'
          +   (parentLabel ? ' <span class="hc-parent">· ' + escapeHtml(parentLabel) + '</span>' : '')
          + '</div>'
          + '<div class="hc-form-live-path">' + escapeHtml(path) + '</div>'
          + '<div class="hc-progress-bar"><div class="hc-progress-bar-fill" style="width:' + pct + '%"></div></div>';
    }

    // ── Setup alt adımları HTML'i ────────────────────────────────────────
    const SETUP_LABELS = ['Test şirketi oluşturuluyor', 'Test kullanıcısı oluşturuluyor', 'Test oturumu başlatılıyor'];

    function setupBodyHtml(currentStep, errorMsg, labels) {
        const list = labels || SETUP_LABELS;
        let h = '<div class="hc-substep-list">';
        list.forEach((lbl, i) => {
            const n = i + 1;
            let cls = 'pending', sym = '·';
            if (errorMsg && n === currentStep) { cls = 'error';   sym = '✗'; }
            else if (n < currentStep)          { cls = 'ok';      sym = '✓'; }
            else if (n === currentStep)        { cls = 'running'; sym = '<span class="hc-spinner" style="width:11px;height:11px;border-width:2px;"></span>'; }
            h += '<div class="hc-substep-row ' + cls + '"><span class="hc-substep-icon">' + sym + '</span>' + escapeHtml(lbl) + '</div>';
        });
        h += '</div>';
        if (errorMsg) h += '<div class="hc-substep-list" style="padding-top:0"><div class="hc-error-snippet">⚠ ' + escapeHtml(errorMsg) + '</div></div>';
        return h;
    }

    // ── Buton durumu ─────────────────────────────────────────────────────
    function setBtnRunning(running) {
        btn.disabled = running;
        if (running) { icon.innerHTML = '<span class="hc-spinner"></span>'; label.textContent = 'Çalıştırılıyor...'; }
        else         { icon.textContent = '▶'; label.textContent = 'Tekrar Çalıştır'; }
    }

    // ── Test company stream ──────────────────────────────────────────────
    const tst = { results: [], total: 0, setupStep: 0 };

    function handleTestFrame(frame) {
        switch (frame.type) {
            case 'setup_start':
                tst.setupStep = 1;
                tst.setupLabels = frame.labels || SETUP_LABELS;
                stepStatus('setup', 'running', tst.setupLabels[0]);
                stepExpand('setup', true);
                stepBody('setup', setupBodyHtml(1, null, tst.setupLabels));
                break;
            case 'setup_step':
                tst.setupStep = frame.step;
                stepStatus('setup', 'running', frame.message || ((tst.setupLabels || SETUP_LABELS)[frame.step - 1]) || ('Adım ' + frame.step));
                stepBody('setup', setupBodyHtml(frame.step, null, tst.setupLabels));
                break;
            case 'setup_done':
                tst.companyName = frame.companyName;
                stepStatus('setup', 'ok', frame.companyName + ' · ' + frame.userEmail);
                stepBody('setup',
                    setupBodyHtml((tst.setupLabels || SETUP_LABELS).length + 1, null, tst.setupLabels)
                  + '<div class="hc-substep-info">Şirket: <b>' + escapeHtml(frame.companyName) + '</b> · Kullanıcı: <b>' + escapeHtml(frame.userEmail) + '</b></div>');
                stepExpand('setup', false);
                break;
            case 'setup_error':
                stepStatus('setup', 'error', 'Hata');
                stepBody('setup', setupBodyHtml(tst.setupStep, frame.message, tst.setupLabels));
                break;

            // Form test frameleri
            case 'start':
                tst.results = []; tst.total = frame.total;
                stepStatus('forms', 'running', frame.total + ' form sırada');
                stepExpand('forms', true);
                stepBody('forms', formLiveHtml(0, frame.total, 'Başlatılıyor...', null, ''));
                break;
            case 'checking':
                updateFormLive(frame.index, frame.total, frame.label, frame.parentLabel, frame.path);
                stepStatus('forms', 'running', (frame.index - 1) + ' / ' + frame.total + ' tamamlandı');
                summaryEl.innerHTML = (tst.companyName ? '<span class="hc-pill" style="background:rgba(16,185,129,.15);color:#10b981;">' + escapeHtml(tst.companyName) + '</span> ' : '')
                    + '<span class="hc-pill">' + (frame.index - 1) + ' / ' + frame.total + ' kontrol edildi</span>';
                break;
            case 'result':
                tst.results.push(frame.result);
                break;
            case 'done': {
                const s = frame.summary;
                const hasErr = s.error > 0 || s.exception > 0;
                const cls = hasErr ? 'error' : (s.warn > 0 ? 'warn' : 'ok');
                const meta = s.total + ' form · ✓ ' + s.ok + (s.warn > 0 ? ' · ⚠ ' + s.warn : '') + (s.error > 0 ? ' · ✗ ' + s.error + ' HATA' : '') + (s.exception > 0 ? ' · ⚡ ' + s.exception : '') + ' · ' + s.durationMs + 'ms';
                stepStatus('forms', cls, meta);
                stepBody('forms', buildFormTable(tst.results));
                stepExpand('forms', hasErr);
                const extra = s.testCompanyName ? ' <span class="hc-pill" style="background:rgba(16,185,129,.15);color:#10b981;">Şirket: ' + escapeHtml(s.testCompanyName) + '</span>' : '';
                summaryEl.innerHTML = summaryHtml(s, extra);
                if (window.hcSetTabBadge) window.hcSetTabBadge('pages', {
                    ok: s.ok || 0, warn: s.warn || 0,
                    error: (s.error || 0) + (s.exception || 0),
                });
                break;
            }
        }
    }

    async function runTestStream() {
        setBtnRunning(true);
        summaryEl.innerHTML = '';
        initStepList();
        // Tüm adımlar baştan görünür — durum güncellemeleri yerinde yapılır
        createStep('setup', 'Test Ortamı Hazırlama', 'pending');
        createStep('forms', 'Form Kontrolleri', 'pending');
        tst.results = []; tst.setupStep = 0; tst.setupLabels = null;
        const createNewDb = document.getElementById('hcNewDb')?.checked ? 'true' : 'false';
        try {
            const resp = await fetch('/Admin/HealthCheck/StreamTestCompany?createNewDb=' + createNewDb, { method:'POST', credentials:'same-origin', headers:{ 'RequestVerificationToken': getCsrf() } });
            if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
            await readStream(resp.body, handleTestFrame);
        } catch (err) {
            resultsEl.innerHTML = '<div style="padding:20px;color:#ef4444;">İstek hatası: ' + escapeHtml(err.message) + '</div>';
        } finally { setBtnRunning(false); }
    }

    // ── NDJSON stream okuyucu (her iki flow için ortak) ──────────────────
    async function readStream(body, onFrame) {
        const reader  = body.getReader();
        const decoder = new TextDecoder('utf-8');
        let buffer = '';
        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            let nl;
            while ((nl = buffer.indexOf('\n')) >= 0) {
                const line = buffer.slice(0, nl).trim();
                buffer = buffer.slice(nl + 1);
                if (!line) continue;
                try { onFrame(JSON.parse(line)); } catch { /* parse hatası atla */ }
            }
        }
    }

    btn.addEventListener('click', runTestStream);

    // ── Fonksiyon Testleri ──────────────────────────────────────────────
    const FN_GROUP_LABELS_DEFAULT = { ticari: 'Ticari', uretim: 'Üretim', kalite: 'Kalite' };
    const fn = { total: 0, groupLabels: {} };

    function fnGroupLabel(key) {
        return (fn.groupLabels && fn.groupLabels[key]) || FN_GROUP_LABELS_DEFAULT[key] || key || '';
    }

    function fnSelectedGroups() {
        const keys = [];
        if (document.getElementById('hcFnGroupTicari')?.checked) keys.push('ticari');
        if (document.getElementById('hcFnGroupUretim')?.checked) keys.push('uretim');
        if (document.getElementById('hcFnGroupKalite')?.checked) keys.push('kalite');
        return keys;
    }

    function setFnBtnRunning(running) {
        fnBtn.disabled = running;
        if (running) { fnIcon.innerHTML = '<span class="hc-spinner"></span>'; fnLabel.textContent = 'Çalıştırılıyor...'; }
        else         { fnIcon.textContent = '▶'; fnLabel.textContent = 'Tekrar Çalıştır'; }
    }

    // Üstte sabit duran "şu an çalışıyor" göstergesi (satır listesi ayrı kayar)
    function fnLiveHtml(index, total, lbl, groupLbl) {
        const pct = total > 0 ? Math.round(Math.max(0, index - 1) / total * 100) : 0;
        return '<div class="hc-form-live" id="hcFnLive">'
             + '<div class="hc-form-live-row">'
             +   '<span style="color:#6366f1;font-weight:700">' + index + '/' + total + '</span> çalıştırılıyor: '
             +   '<b>' + escapeHtml(lbl) + '</b>'
             +   (groupLbl ? ' <span class="hc-parent">· ' + escapeHtml(groupLbl) + '</span>' : '')
             + '</div>'
             + '<div class="hc-progress-bar"><div class="hc-progress-bar-fill" style="width:' + pct + '%"></div></div>'
             + '</div>';
    }

    function fnUpdateLive(index, total, lbl, groupLbl) {
        const el = document.getElementById('hcFnLive');
        if (!el) return;
        const pct = total > 0 ? Math.round(Math.max(0, index - 1) / total * 100) : 0;
        el.innerHTML =
            '<div class="hc-form-live-row">'
          +   '<span style="color:#6366f1;font-weight:700">' + index + '/' + total + '</span> çalıştırılıyor: '
          +   '<b>' + escapeHtml(lbl) + '</b>'
          +   (groupLbl ? ' <span class="hc-parent">· ' + escapeHtml(groupLbl) + '</span>' : '')
          + '</div>'
          + '<div class="hc-progress-bar"><div class="hc-progress-bar-fill" style="width:' + pct + '%"></div></div>';
    }

    // Senaryo adımları — hangi adımda kırıldığı görünür (accordion içi liste)
    function fnStepsHtml(steps) {
        if (!steps || !steps.length) {
            return '<div class="hc-substep-list"><div class="hc-substep-row pending">Adım ayrıntısı yok</div></div>';
        }
        let h = '<div class="hc-substep-list">';
        steps.forEach(st => {
            const cls  = st.ok ? 'ok' : 'error';
            const icon = st.ok ? '✓' : '✗';
            h += '<div class="hc-substep-row ' + cls + '"><span class="hc-substep-icon">' + icon + '</span>' + escapeHtml(st.label) + '</div>';
            if (!st.ok && st.message) h += '<div class="hc-error-snippet">' + escapeHtml(st.message) + '</div>';
        });
        h += '</div>';
        return h;
    }

    function fnRowMeta(r) {
        const parts = [];
        const groupLbl = fnGroupLabel(r.group);
        if (groupLbl) parts.push(groupLbl);
        if (r.skipped)      parts.push('Atlandı' + (r.message ? ': ' + r.message : ''));
        else if (!r.ok)     parts.push('Başarısız' + (r.message ? ': ' + r.message : ''));
        else                parts.push('Başarılı');
        parts.push((r.durationMs != null ? r.durationMs : 0) + 'ms');
        return parts.join(' · ');
    }

    // Sonuç satırı — kendi adım listesiyle genişleyen accordion satırı (hc-step-item yeniden kullanılıyor)
    function fnAddResultRow(r) {
        const list = document.getElementById('hcFnList');
        if (!list) return;
        const cls  = r.skipped ? 'warn' : (r.ok ? 'ok' : 'error');
        const rid  = 'fnr-' + r.index;
        const open = cls === 'error';
        const item = document.createElement('div');
        item.className = 'hc-step-item' + (open ? ' expanded' : '');
        item.id = 'hcs-' + rid;
        item.innerHTML =
            '<div class="hc-step-header" onclick="hcToggle(\'' + rid + '\')">'
          +   '<div class="hc-step-badge ' + cls + '">' + badgeInner(cls) + '</div>'
          +   '<div class="hc-step-title">' + escapeHtml(r.label) + '</div>'
          +   '<div class="hc-step-meta">' + escapeHtml(fnRowMeta(r)) + '</div>'
          +   '<div class="hc-step-chevron" id="hcc-' + rid + '">' + (open ? '▼' : '▶') + '</div>'
          + '</div>'
          + '<div class="hc-step-body" id="hcbd-' + rid + '">' + fnStepsHtml(r.steps) + '</div>';
        list.appendChild(item);
    }

    function fnSummaryHtml(s) {
        return '<span class="hc-pill ok">✓ ' + s.passed + ' Geçti</span>'
            + (s.failed > 0  ? '<span class="hc-pill error">✗ ' + s.failed  + ' Başarısız</span>' : '')
            + (s.skipped > 0 ? '<span class="hc-pill warn">⚠ '  + s.skipped + ' Atlandı</span>'   : '');
    }

    function handleFnFrame(frame) {
        switch (frame.type) {
            case 'fn_start':
                fn.total = frame.total;
                fn.groupLabels = {};
                (frame.groups || []).forEach(g => { fn.groupLabels[g.key] = g.label; });
                fnResultsEl.innerHTML = '<div id="hcFnLive"></div><div class="hc-step-list" id="hcFnList"></div>';
                document.getElementById('hcFnLive').innerHTML = fnLiveHtml(0, frame.total, 'Başlatılıyor...', '');
                break;
            case 'fn_step':
                fnUpdateLive(frame.index, frame.total, frame.label, fnGroupLabel(frame.group));
                break;
            case 'fn_result':
                fnAddResultRow(frame);
                break;
            case 'fn_done': {
                fnSummaryEl.innerHTML = fnSummaryHtml({ passed: frame.passed, failed: frame.failed, skipped: frame.skipped });
                if (window.hcSetTabBadge) window.hcSetTabBadge('fn', {
                    ok: frame.passed || 0, warn: frame.skipped || 0, error: frame.failed || 0,
                });
                const live = document.getElementById('hcFnLive');
                if (live) live.innerHTML = '';
                break;
            }
            case 'fn_error':
                fnResultsEl.innerHTML = '<div class="hc-fn-error-banner">⚠ ' + escapeHtml(frame.message || 'Fonksiyon testleri başlatılamadı.') + '</div>';
                fnSummaryEl.innerHTML = '';
                break;
        }
    }

    async function runFnTests() {
        const groups = fnSelectedGroups();
        if (groups.length === 0) {
            fnHintEl.textContent = 'En az bir grup seçmelisiniz.';
            return;
        }
        fnHintEl.textContent = '';
        setFnBtnRunning(true);
        fnSummaryEl.innerHTML = '';
        fnResultsEl.innerHTML = '<div style="padding:16px;color:#64748b;font-size:13px;">Başlatılıyor…</div>';
        try {
            const resp = await fetch('/Admin/HealthCheck/StreamFunctionalTests?groups=' + encodeURIComponent(groups.join(',')), { method:'POST', credentials:'same-origin', headers:{ 'RequestVerificationToken': getCsrf() } });
            if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
            await readStream(resp.body, handleFnFrame);
        } catch (err) {
            fnResultsEl.innerHTML = '<div class="hc-fn-error-banner">İstek hatası: ' + escapeHtml(err.message) + '</div>';
        } finally { setFnBtnRunning(false); }
    }

    fnBtn.addEventListener('click', runFnTests);
})();
</script>
}
