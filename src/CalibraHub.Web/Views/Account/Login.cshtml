                    <text class="rig-badge-text" x="58" y="34.5">Kalibrasyon Sürüyor</text>
                </g>
                <text class="rig-caption" x="29" y="64">Komparatör · Salgı (Runout) Ölçümü</text>

                @* Zemin ışığı + granit tabla *@
                <ellipse cx="205" cy="424" rx="178" ry="26" fill="url(#rigFloor)" />
                <path class="rig-vblock" d="M162 392 V350 H193 L250 386 L307 350 H338 V392 Z" />
                <rect x="30" y="392" width="330" height="30" rx="5" fill="url(#rigGranite)" />
                <rect x="30" y="392" width="330" height="2.6" rx="1.3" fill="rgba(226,232,240,.22)" />
                <rect x="40" y="422" width="310" height="6" rx="3" fill="rgba(2,6,23,.6)" />

                @* Sütun + taban bloğu + ince ayar kolu *@
                <rect x="52" y="366" width="60" height="28" rx="4" fill="url(#rigSteelV)" />
                <rect x="70" y="120" width="22" height="248" rx="3" fill="url(#rigSteel)" />
                <g class="rig-col-scale" id="rigColScale"></g>
                <circle cx="81" cy="304" r="13" fill="url(#rigBezel)" />
                <circle cx="81" cy="304" r="5" fill="#334155" />

                @* Kol + kelepçe (kadranın gövdesini taşır) *@
                <rect x="88" y="224" width="132" height="16" rx="4" fill="url(#rigSteelV)" />
                <rect x="244" y="208" width="12" height="50" rx="3" fill="url(#rigSteel)" />

                @* Pinol (temas ucu) — JS ile dikey ötelenir *@
                <g id="rigPlunger">
                    <rect x="247" y="246" width="6" height="31" rx="3" fill="#cbd5e1" />
                    <circle cx="250" cy="277" r="5" fill="#eef2f7" stroke="rgba(15,23,42,.45)" stroke-width="1" />
                </g>

                <rect x="212" y="212" width="52" height="42" rx="7" fill="url(#rigSteelV)" />
                <circle cx="238" cy="206" r="5" fill="#94a3b8" stroke="rgba(15,23,42,.4)" stroke-width="1" />

                @* Ölçülen parça — V-blok içinde dönen eksantrik disk.
                   Disk merkezi (255,330), dönme ekseni (250,330): 5 px'lik eksantriklik
                   dönerken tepe noktasını sinüzoidal olarak oynatır = gerçek salgı. *@
                <g id="rigPartSpin">
                    <circle cx="255" cy="330" r="48" fill="url(#rigPartG)" stroke="rgba(15,23,42,.55)" stroke-width="1.2" />
                    <circle cx="255" cy="330" r="41" fill="none" stroke="rgba(15,23,42,.18)" stroke-width="1" />
                    <g id="rigPartNotches"></g>
                    <circle cx="255" cy="330" r="13" fill="#1b2637" stroke="rgba(226,232,240,.32)" stroke-width="1.2" />
                    <rect x="251" y="309" width="8" height="9" rx="1.5" fill="#1b2637" />
                    <circle cx="255" cy="300" r="3" fill="#e11d48" />
                </g>

                @* Komparatör gövdesi *@
                <rect x="242" y="76" width="16" height="12" rx="2.5" fill="url(#rigSteelV)" />
                <circle cx="250" cy="150" r="66" fill="url(#rigBezel)" />
                <circle cx="250" cy="150" r="60" fill="none" stroke="rgba(15,23,42,.35)" stroke-width="1.2" />
                <circle cx="250" cy="150" r="58" fill="url(#rigFace)" />
                <path class="rig-tol-ok" d="M208.74 180 A51 51 0 1 1 291.26 180" />
                <path class="rig-tol-out" d="M291.26 180 A51 51 0 0 1 208.74 180" />
                <g id="rigDialTicks"></g>
                <g id="rigDialNums"></g>
                <text class="rig-face-brand" x="250" y="118">CALIBRA</text>
                <text class="rig-face-unit" x="250" y="131">0,001 mm</text>

                @* Tur sayacı (küçük kadran) *@
