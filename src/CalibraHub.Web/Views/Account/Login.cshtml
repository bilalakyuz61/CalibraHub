    <section class="login-panel">
        <div class="login-card">
            <h1>CalibraHub</h1>

            @* Kimlik kalibrasyon kadranı v3 — 3 iğneli (yelkovan) analog gösterge. Şifre
               karakterine bağlı round-robin iğne rotasyonu (yalnız bir iğne/tuş) + sunucu
               onayına bağlı çözülme mantığı sayfa sonundaki script'te (window.CalibraLoginDial). *@
            <div class="cald-wrap" id="caldDial">
                <div class="cald-stage" id="caldStage" aria-hidden="true">
                    <svg class="cald-svg" viewBox="0 0 200 200">
                        <circle class="cald-track" cx="100" cy="100" r="88" />
                        <g class="cald-ticks" id="caldTicks"></g>
                        @* Basılı ölçek rakamları (4 ana çentik) — JS ile konumlanır (bkz. buildScale). *@
                        <g class="cald-scale" id="caldScale"></g>
                        @* İç kadran 1 (dış, r=60) — 8 çentik; büyük iğnelerden bağımsız, tuş
                           başına rastgele döner (bkz. script spinInnerRandom). *@
                        <circle class="cald-inner-track" cx="100" cy="100" r="60" />
                        <g class="cald-inner-grp" id="caldInner1">
                            <g id="caldInner1Ticks"></g>
                            <circle class="cald-inner-mark cald-inner-mark-1" cx="100" cy="40" r="2.2" />
                        </g>
                        @* İç kadran 2 (iç, r=34) — 6 çentik; aynı şekilde bağımsız/rastgele. *@
                        <circle class="cald-inner-track" cx="100" cy="100" r="34" />
                        <g class="cald-inner-grp" id="caldInner2">
                            <g id="caldInner2Ticks"></g>
                            <circle class="cald-inner-mark cald-inner-mark-2" cx="100" cy="66" r="1.8" />
                        </g>
                        <g class="cald-needle-grp" id="caldNeedle3">
                            <line class="cald-needle n3" x1="100" y1="100" x2="100" y2="62" />
                        </g>
                        <g class="cald-needle-grp" id="caldNeedle2">
                            <line class="cald-needle n2" x1="100" y1="100" x2="100" y2="48" />
                        </g>
                        <g class="cald-needle-grp" id="caldNeedle1">
                            <line class="cald-needle n1" x1="100" y1="108" x2="100" y2="32" />
                            <circle class="cald-tail" cx="100" cy="108" r="3" />
                        </g>
                        <circle class="cald-hub-ring" cx="100" cy="100" r="8" />
                        <circle class="cald-hub" cx="100" cy="100" r="4.2" />
                        @* Dijital okuma penceresi (alt-orta) — iğnelerin ÜSTÜNDE, okunur kalsın.
                           İçerik JS ile sürülür (scrambleReadout / runCalcSequence). *@
                        <rect class="cald-readout-box" x="59" y="121" width="82" height="18" rx="4" ry="4" />
                        <text class="cald-readout-text" id="caldReadout" x="100" y="130.5">----</text>
                    </svg>
                </div>
                <div class="cald-status" id="caldStatus">Giriş yapmaya hazır</div>
            </div>

            <form asp-action="Login" method="post" autocomplete="off" id="loginForm">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <input type="hidden" name="ThemeCode" id="loginThemeInput" value="" />

                <div class="form-floating login-field mb-3">
                    @* a11y (rapor §6.6): autofocus + required + aria-required + class="cb-field-error" *@
                    <input asp-for="Email" class="form-control" autocomplete="email"
                           placeholder=" " autofocus required aria-required="true" />
                    <label asp-for="Email" class="cb-field-required">@ui.Text("email")</label>
                    <span asp-validation-for="Email" class="cb-field-error"></span>
                </div>

                <div class="form-floating login-field mb-3">
