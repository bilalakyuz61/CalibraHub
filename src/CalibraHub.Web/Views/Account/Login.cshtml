<script>
    (function () {
        const companyPlaceholderText = @Html.Raw(JsonSerializer.Serialize(ui.Text("company_placeholder")));
        const emailInput = document.getElementById("Email");
        const companySelect = document.getElementById("CompanyId");
        if (!emailInput || !companySelect) {
            return;
        }

        const endpoint = '@Url.Action("CompaniesForUser", "Account")';

        function renderCompanies(items) {
            const currentValue = companySelect.value;
            companySelect.innerHTML = "";

            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = companyPlaceholderText;
            companySelect.appendChild(placeholder);

            let hasCurrent = false;
            items.forEach(function (item) {
                const option = document.createElement("option");
                option.value = item.id;
                option.textContent = item.name;
                if (item.id === currentValue) {
                    option.selected = true;
                    hasCurrent = true;
                }

                companySelect.appendChild(option);
            });

            if (!hasCurrent) {
                companySelect.value = "";
            }
        }

        async function loadCompanies() {
            const email = emailInput.value.trim();
            if (!email) {
                renderCompanies([]);
                return;
            }

            try {
                const response = await fetch(endpoint + "?email=" + encodeURIComponent(email), {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    renderCompanies([]);
                    return;
                }

                const data = await response.json();
                renderCompanies(Array.isArray(data) ? data : []);
            } catch {
                renderCompanies([]);
            }
        }

        emailInput.addEventListener("blur", loadCompanies);
        emailInput.addEventListener("change", loadCompanies);

        if (emailInput.value.trim().length > 0) {
            loadCompanies();
        }

        // Beni hatırla switch
        var rememberToggle = document.getElementById("rememberToggle");
        var rememberLabel = document.querySelector(".login-remember-label");
        var remembered = localStorage.getItem("calibra_login_remember") === "1";

        if (rememberToggle) {
            rememberToggle.checked = remembered;

            // Önceki oturumdan hatırlanan bilgileri yükle
            if (remembered && !emailInput.value) {
                var savedEmail = localStorage.getItem("calibra_login_email");
                var savedCompany = localStorage.getItem("calibra_login_company");
                if (savedEmail) {
                    emailInput.value = savedEmail;
                    loadCompanies().then(function () {
                        if (savedCompany && companySelect) {
                            companySelect.value = savedCompany;
                        }
                    });
                }
            }

            if (rememberLabel) {
                rememberLabel.addEventListener("click", function () {
                    rememberToggle.checked = !rememberToggle.checked;
                });
            }
        }

        var loginForm = emailInput.closest("form");
        if (loginForm) {
            var pwInput = document.getElementById("Password");
            var pwWrap  = pwInput ? pwInput.closest(".login-field") : null;

            loginForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                // Tema hidden input'u güncelle
                var themeInput = document.getElementById("loginThemeInput");
                if (themeInput) themeInput.value = document.body.classList.contains("app-theme-dark") ? "dark" : "light";

                // Beni hatırla
                if (rememberToggle && rememberToggle.checked) {
                    localStorage.setItem("calibra_login_remember", "1");
                    localStorage.setItem("calibra_login_email", emailInput.value.trim());
                    if (companySelect.value) localStorage.setItem("calibra_login_company", companySelect.value);
                } else {
                    localStorage.removeItem("calibra_login_remember");
                    localStorage.removeItem("calibra_login_email");
                    localStorage.removeItem("calibra_login_company");
                }

                // Kilit bulmacası: sunucu doğrulaması başladı
                if (window.CalibraLoginDial) window.CalibraLoginDial.begin();

                // AJAX submit
                try {
                    var resp = await fetch(loginForm.action || window.location.href, {
                        method: "POST",
                        body: new FormData(loginForm),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    var json = await resp.json();

                    if (json.ok) {
                        // Doğru giriş — 3 iğne ortak faza (yukarı) oturup hizalanır (yeşil), sonra login
                        if (window.CalibraLoginDial) window.CalibraLoginDial.success(function () { window.location.href = json.redirect; });
                        else window.location.href = json.redirect;
                        return;
                    }

                    // Giriş başarısız — iğneler hizasız kalır + shake + kırmızı tint (kanonik v3 spec)
                    if (json.error === "locked") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Hesap kilitli');
                        if (pwInput) {
                            pwInput.value = "";
                            pwInput.disabled = true;
                            setTimeout(function () { pwInput.disabled = false; }, 5000);
                        }
                    } else if (json.error === "validation") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Alanları doldurun');
                    } else {   // credentials
                        var rem = (typeof json.remaining === "number") ? json.remaining : -1;
                        var det = rem > 0 ? ("Şifreniz hatalı, " + rem + " deneme kaldı") : "Şifreniz hatalı";
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail("Giriş başarısız", det);
                        if (pwInput) { pwInput.value = ""; pwInput.focus(); }
                    }
                } catch {
                    // Network hatası: normal submit
                    loginForm.submit();
                }
            });
        }
    })();
</script>
<script>
    /* ── Kimlik kalibrasyon kadranı v3 — 3 iğneli (yelkovan) analog gösterge ──
       Merkezden (hub) çıkan 3 iğne (indigo n1 / cyan n2 / violet n3), farklı uzunluk +
       kalınlıkta (n1 en uzun/kalın = "ana" şifre iğnesi). 12 çentikli (30°'lik) kadranda
       idle'da üç iğne SABİT, birbirinden 120° ayrık dinlenme açısındadır (çentik 1/5/9).

       Şifre her karakterinde SADECE BİR iğne bir çentik ilerler — round-robin (n. tuş →
       n%3. iğne), sonra oturur; TÜM iğneler DEĞİL, SÜREKLİ DEĞİL. [KRİTİK — 2026-07-16
       kullanıcı geri bildirimi]: önceki sürümde "tüm yelkovanlar sürekli hareket ediyor"
       şikayeti alınmıştı — bu ASLA tekrarlanmayacak: needleSteps(len, r) yalnızca [r]
       iğnesinin SIRASI geldiğinde (len'in üçe bölümünde kendi kalanına denk geldiğinde)
       artar, diğer iki iğnenin hedefi DEĞİŞMEZ — dolayısıyla toTyping() her tuşta 3
       iğne için de animateNeedleStepped çağırsa da, hedefi değişmeyen 2 iğne görsel
       olarak KIPIRDAMAZ (aynı hedefe animasyon no-op'tur, delta≈0 erken çıkış). Silme
       aynı adımları geri sarar (adım sayısı parola uzunluğundan türetilir, tuş
       yönünden bağımsızdır).

       Çözülme YALNIZ sunucu login onayıyla (window.CalibraLoginDial.success) tetiklenir
       — client parola doğrulamaz. Solved'de her iğne kendi en yakın 360° katına "klik"
       diye oturur (mod 360 ≡ 0 olduğundan üçü de aynı mutlak açıda/yukarıda çakışır).

       Görsel zenginleştirme eki (2026-07-17 — SOLVE MANTIĞI DEĞİŞMEDİ, round-robin/
       server-truth kuralı yukarıdaki paragraflar AYNEN geçerli, yalnız çizim/animasyon):
       (a) toTyping() artık animateNeedle yerine animateNeedleStepped kullanır — hedef
       açıya tek parça glide değil, N=4 mini-adımlı "dura-dura" (detent) hareketle gider
       (her mini-adım: hızlı hareket + kısa duraklama, bkz. NEEDLE_STEP_* sabitleri).
       Toplam süre eskisinden (220ms) biraz daha yavaş (~288ms: 4 hareket + aradaki 3
       duraklama) ama yine hızlı/akıcı — sürünme yok.
       (b) Ana kadranın içine 2 eş-merkezli İÇ KADRAN eklendi (caldInner1/caldInner2,
       r=60 cyan + r=34 violet, çentikli halka + dönen işaret noktası, bkz. buildInnerTicks).
       (c) İç kadranlar spinInnerRandom() ile her tuş vuruşunda (pwEl 'input') büyük
       iğnelerin hedefli hareketinden BAĞIMSIZ, rastgele yön (cw/ccw) + rastgele küçük
       açı (14°-52°) ile serbestçe döner — needleSteps/typingTarget/round-robin
       mantığına dokunulmadı. */
    (function () {
        var dial = document.getElementById('caldDial');
        if (!dial) return;
        var statusEl = document.getElementById('caldStatus');
        var ticksG   = document.getElementById('caldTicks');
        var innerTicksG1 = document.getElementById('caldInner1Ticks');   // iç kadran 1 (r=60) çentik konteyneri
        var innerTicksG2 = document.getElementById('caldInner2Ticks');   // iç kadran 2 (r=34) çentik konteyneri
        var NS = 'http://www.w3.org/2000/svg';
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var SLOTS    = 12;
        var SLOT_DEG = 360 / SLOTS;   // 30°

        // 3 iğne: taban dinlenme açısı (çentik 1/5/9 — birbirinden tam 120° ayrık), yön
        // (yalnız kozmetik — hangi yöne "ilerlediğini" belirler) ve <g> sarmalayıcı id'si.
        var NEEDLES = [
            { base: 1 * SLOT_DEG, dir: +1, id: 'caldNeedle1' },   // n1 — indigo, ana (şifre) iğnesi
            { base: 5 * SLOT_DEG, dir: -1, id: 'caldNeedle2' },   // n2 — cyan
            { base: 9 * SLOT_DEG, dir: +1, id: 'caldNeedle3' }    // n3 — violet
        ];

        var groups = NEEDLES.map(function (n) { return document.getElementById(n.id); });
        var ndlDeg = NEEDLES.map(function (n) { return n.base; });   // sürekli (unwrap) açı — hiç mod alınmaz
        var ndlRaf = [null, null, null];

        // ── Çentik (tick) halkası — 12 çentik; her 3.'sü (0/90/180/270) belirgin ──
        for (var i = 0; i < SLOTS; i++) {
            var tDeg  = i * SLOT_DEG;
            var tRad  = (tDeg - 90) * Math.PI / 180;
            var major = (i % 3 === 0);
            var rOuter = 88, rInner = major ? 76 : 81;
            var ln = document.createElementNS(NS, 'line');
            ln.setAttribute('x1', (100 + rOuter * Math.cos(tRad)).toFixed(2));
            ln.setAttribute('y1', (100 + rOuter * Math.sin(tRad)).toFixed(2));
            ln.setAttribute('x2', (100 + rInner * Math.cos(tRad)).toFixed(2));
            ln.setAttribute('y2', (100 + rInner * Math.sin(tRad)).toFixed(2));
            ln.setAttribute('class', 'cald-tick' + (major ? ' maj' : ''));
            ticksG.appendChild(ln);
        }

        // ── İç kadranlar — çentik üretimi (dış tick döngüsüyle aynı trigonometri, tek
        //    fark: major/minor ayrımı yok, tek tip çentik). Halkanın kendisi <g> içine
        //    KONMAZ (dairesel simetrik, rotasyona gerek yok) — yalnız çentikler + işaret
        //    noktası ilgili caldInnerN <g>'sinin içine konur ki spinInnerRandom() onları
        //    birlikte döndürebilsin. ──
        function buildInnerTicks(container, count, r, len, cls) {
            for (var i = 0; i < count; i++) {
                var tDeg = i * (360 / count);
                var tRad = (tDeg - 90) * Math.PI / 180;
                var ro = r, ri = r - len;
                var ln = document.createElementNS(NS, 'line');
                ln.setAttribute('x1', (100 + ro * Math.cos(tRad)).toFixed(2));
                ln.setAttribute('y1', (100 + ro * Math.sin(tRad)).toFixed(2));
                ln.setAttribute('x2', (100 + ri * Math.cos(tRad)).toFixed(2));
                ln.setAttribute('y2', (100 + ri * Math.sin(tRad)).toFixed(2));
                ln.setAttribute('class', cls);
                container.appendChild(ln);
            }
        }
        buildInnerTicks(innerTicksG1, 8, 60, 7, 'cald-inner-tick i1');
        buildInnerTicks(innerTicksG2, 6, 34, 5, 'cald-inner-tick i2');

        // İğne açısı doğrudan SVG rotate(deg, 100, 100) transform'u — 0°=yukarı (12 yönü),
        // saat yönünde artar. Trigonometri gerekmez (harf-yerleşimi versiyonunun aksine).
        function placeNeedle(r, deg) {
            groups[r].setAttribute('transform', 'rotate(' + deg.toFixed(2) + ' 100 100)');
        }

        function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
        function easeOutBack(t) { var c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2); }

        function cancelNeedle(r) { if (ndlRaf[r]) { cancelAnimationFrame(ndlRaf[r]); ndlRaf[r] = null; } }
        function animateNeedle(r, target, durationMs, ease, onDone) {
            cancelNeedle(r);
            if (reduce) { ndlDeg[r] = target; placeNeedle(r, target); if (onDone) onDone(); return; }
            var start = ndlDeg[r], delta = target - start, t0 = null;
            function step(ts) {
                if (t0 === null) t0 = ts;
                var t = Math.min(1, (ts - t0) / durationMs);
                ndlDeg[r] = start + delta * (ease ? ease(t) : t);
                placeNeedle(r, ndlDeg[r]);
                if (t < 1) { ndlRaf[r] = requestAnimationFrame(step); }
                else { ndlDeg[r] = target; placeNeedle(r, target); ndlRaf[r] = null; if (onDone) onDone(); }
            }
            ndlRaf[r] = requestAnimationFrame(step);
        }

        // ── Büyük iğnelerin tuş-başı hareketi — "dura-dura" (detent/stepped) ──
        // toTyping() bunu çağırır (animateNeedle DEĞİL): 30°'lik hedef adımı tek parça
        // glide yerine N=4 mini-adıma böler, her mini-adımda hızlı hareket + kısa
        // duraklama (mekanik kadran/kasa kilidi hissi). Toplam süre = 4 hareket + aradaki
        // 3 duraklama (son adımdan sonra bekleme YOK — hedefe varır varmaz biter):
        // 4×(80×.6) + 3×(80×.4) = 192+96 = 288ms — eskisinden (220ms) biraz daha yavaş,
        // yine de akıcı/hızlı (sürünme yok). delta≈0 olan (bu tuşta sırası gelmeyen)
        // iğneler için anında çıkar — gereksiz rAF döngüsü çalışmaz.
        var NEEDLE_STEP_COUNT     = 4;      // 30°'lik adım kaç mini-adıma bölünüyor
        var NEEDLE_STEP_MS        = 80;     // mini-adım başına toplam süre (hareket+duraklama)
        var NEEDLE_STEP_MOVE_FRAC = 0.6;    // mini-adım süresinin hareket kısmı (kalanı duraklama)
        function animateNeedleStepped(r, target) {
            cancelNeedle(r);
            var start = ndlDeg[r], delta = target - start;
            if (reduce || Math.abs(delta) < 0.001) { ndlDeg[r] = target; placeNeedle(r, target); return; }
            var moveMs  = NEEDLE_STEP_MS * NEEDLE_STEP_MOVE_FRAC;
            var pauseMs = NEEDLE_STEP_MS - moveMs;
            function stepBoundary(i) { return i >= NEEDLE_STEP_COUNT ? target : start + delta * i / NEEDLE_STEP_COUNT; }
            var step = 0, phase = 'move', phaseStart = null;
            var phaseFrom = start, phaseTo = stepBoundary(1);
            function frame(ts) {
                if (phaseStart === null) phaseStart = ts;
                var elapsed = ts - phaseStart;
                if (phase === 'move') {
                    var t = Math.min(1, elapsed / moveMs);
                    var v = phaseFrom + (phaseTo - phaseFrom) * easeOutCubic(t);
                    ndlDeg[r] = v; placeNeedle(r, v);
                    if (t >= 1) {
                        ndlDeg[r] = phaseTo; placeNeedle(r, phaseTo);
                        step++;
                        if (step >= NEEDLE_STEP_COUNT) { ndlRaf[r] = null; return; }
                        phase = 'pause'; phaseStart = null;
                    }
                } else if (elapsed >= pauseMs) {
                    phase = 'move'; phaseStart = null;
                    phaseFrom = phaseTo; phaseTo = stepBoundary(step + 1);
                }
                ndlRaf[r] = requestAnimationFrame(frame);
            }
            ndlRaf[r] = requestAnimationFrame(frame);
        }

        // ── İç kadranlar — büyük iğnelerden bağımsız, salt dekoratif rotasyon katmanı.
        //    Needle motoruyla birebir aynı desende (start→target rAF interpolasyonu),
        //    ayrı state dizileriyle çalışır — needle mantığına hiç dokunmaz. ──
        var innerGroups = [document.getElementById('caldInner1'), document.getElementById('caldInner2')];
        var innerDeg    = [0, 0];
        var innerRaf    = [null, null];
        var INNER_SPIN_MIN = 14, INNER_SPIN_MAX = 52;   // derece — "rastgele küçük açı"
        var INNER_SPIN_MS  = [340, 260];                // idx0 (r=60) biraz daha ağır, idx1 (r=34) daha çevik
        function placeInner(idx, deg) { innerGroups[idx].setAttribute('transform', 'rotate(' + deg.toFixed(2) + ' 100 100)'); }
        function cancelInner(idx) { if (innerRaf[idx]) { cancelAnimationFrame(innerRaf[idx]); innerRaf[idx] = null; } }
        function animateInner(idx, target, durationMs) {
            cancelInner(idx);
            if (reduce) { innerDeg[idx] = target; placeInner(idx, target); return; }
            var start = innerDeg[idx], delta = target - start, t0 = null;
            function step(ts) {
                if (t0 === null) t0 = ts;
                var t = Math.min(1, (ts - t0) / durationMs);
                innerDeg[idx] = start + delta * easeOutBack(t);
                placeInner(idx, innerDeg[idx]);
                if (t < 1) { innerRaf[idx] = requestAnimationFrame(step); }
                else { innerDeg[idx] = target; placeInner(idx, target); innerRaf[idx] = null; }
            }
            innerRaf[idx] = requestAnimationFrame(step);
        }
        // Her tuş vuruşunda çağrılır (bkz. pwEl 'input'): 2 iç kadranın HER BİRİ kendi
        // mevcut açısından, rastgele yön (cw/ccw) + rastgele küçük açıyla yeni bir hedefe
        // döner — büyük iğnelerin round-robin/hedefli mantığıyla HİÇBİR bağı yok.
        function spinInnerRandom() {
            for (var idx = 0; idx < 2; idx++) {
                var dir    = Math.random() < 0.5 ? -1 : 1;
                var amount = INNER_SPIN_MIN + Math.random() * (INNER_SPIN_MAX - INNER_SPIN_MIN);
                animateInner(idx, innerDeg[idx] + dir * amount, INNER_SPIN_MS[idx]);
            }
        }

        // n. tuş vuruşu iğneleri döngüsel gezer (1.→n1, 2.→n2, 3.→n3, 4.→n1…): [r]
        // iğnesinin parola [len] uzunluğundayken almış olduğu toplam adım sayısı.
        // Uzunluktan türetildiği için silme otomatik olarak aynı adımları geri sarar.
        function needleSteps(len, r) {
            if (len <= 0) return 0;
            var c = 0;
            for (var k = 1; k <= len; k++) { if ((k - 1) % 3 === r) c++; }
            return c;
        }
        function typingTarget(len, r) {
            var N = NEEDLES[r];
            return N.base + N.dir * SLOT_DEG * needleSteps(len, r);
        }

        var mode = 'idle';   // idle | typing | measuring | solved | fail
        function setStatus(t) { if (statusEl) statusEl.textContent = t; }
        function setMode(m, cls) {
            mode = m;
            dial.classList.remove('is-typing', 'is-measuring', 'is-solved', 'is-fail');
            if (cls) dial.classList.add(cls);
        }
        function toTyping(len) {
            for (var r = 0; r < 3; r++) animateNeedleStepped(r, typingTarget(len, r));
        }

        // ── Kalibrasyon okuma katmanı — salt dekoratif "mühendislik hesabı" hissi ──
        // (a) Basılı ölçek rakamları: 4 ana çentikte (0/90/180/270) sabit skala değerleri
        //     — gerçek bir enstrüman kadranı gibi iğnelerin "gösterdiği" rakamlar.
        // (b) Dijital okuma penceresi: monospace ölçüm değeri; her tuşta hızla değişip
        //     oturur (hesaplanıyor hissi), doğrulama fazında kanal-kanal hızlı sekans.
        // Bu katmanın needle/solve mantığıyla HİÇBİR bağı yoktur (server-truth korunur).
        (function buildScale() {
            var scaleG = document.getElementById('caldScale');
            if (!scaleG) return;
            // Saat yönünde tepeden: 0 → 25 → 50 → 75 (basılı skala), r=68'de yerleşir.
            var SC = [{ deg: 0, txt: '0' }, { deg: 90, txt: '25' }, { deg: 180, txt: '50' }, { deg: 270, txt: '75' }];
            SC.forEach(function (s) {
                var rad = (s.deg - 90) * Math.PI / 180;
                var t = document.createElementNS(NS, 'text');
                t.setAttribute('x', (100 + 68 * Math.cos(rad)).toFixed(2));
                t.setAttribute('y', (100 + 68 * Math.sin(rad)).toFixed(2));
                t.setAttribute('class', 'cald-scale-num');
                t.textContent = s.txt;
                scaleG.appendChild(t);
            });
        })();

        // Ölçüm kanalları — ASCII birimler (mojibake güvenli, bkz. Türkçe/encoding kuralı).
        var READ_CH = [
            { unit: 'mm',  dec: 4, min: 0.001, max: 0.098 },
            { unit: 'Hz',  dec: 1, min: 40,    max: 260 },
            { unit: 'V',   dec: 3, min: 3.00,  max: 5.20 },
            { unit: 'Nm',  dec: 2, min: 1.5,   max: 48 },
            { unit: 'mV',  dec: 1, min: 5,     max: 240 },
            { unit: 'kPa', dec: 2, min: 96,    max: 104 }
        ];
        var readoutEl = document.getElementById('caldReadout');
        var readoutRaf = null;
        var seqTimer = null;
        function fmtRead(ch, v) { return v.toFixed(ch.dec) + ' ' + ch.unit; }
        function stopReadoutAnims() {
            if (readoutRaf) { cancelAnimationFrame(readoutRaf); readoutRaf = null; }
            if (seqTimer) { clearTimeout(seqTimer); seqTimer = null; }
        }
        // Bir değere doğru "hesaplanıp oturan" haneler: jitter ~1'den 0'a söner.
        function scrambleReadout(ch, finalV, durMs) {
            if (!readoutEl) return;
            if (readoutRaf) { cancelAnimationFrame(readoutRaf); readoutRaf = null; }
            if (reduce) { readoutEl.textContent = fmtRead(ch, finalV); return; }
            var span = (ch.max - ch.min) * 0.5, t0 = null;
            function frame(ts) {
                if (t0 === null) t0 = ts;
                var t = Math.min(1, (ts - t0) / durMs);
                var v = finalV + (Math.random() * 2 - 1) * span * (1 - t);
                if (v < ch.min) v = ch.min + (ch.min - v) * 0.3;
                readoutEl.textContent = fmtRead(ch, v);
                if (t < 1) { readoutRaf = requestAnimationFrame(frame); }
                else { readoutEl.textContent = fmtRead(ch, finalV); readoutRaf = null; }
            }
            readoutRaf = requestAnimationFrame(frame);
        }
        // Doğrulama fazı: kanal-kanal hızlı hesap sekansı (durana kadar döner).
        function runCalcSequence() {
            stopReadoutAnims();
            if (reduce) { if (readoutEl) readoutEl.textContent = 'CALC...'; return; }
            var i = 0;
            (function tick() {
                var ch = READ_CH[i % READ_CH.length];
                scrambleReadout(ch, ch.min + Math.random() * (ch.max - ch.min), 170);
                i++;
                seqTimer = setTimeout(tick, 200);
            })();
        }

        // ── Şifre alanı: her karakter SADECE bir iğneyi bir çentik döndürür (round-robin),
        //    silme geri sarar. Kullanıcı adı/şirket alanları iğneleri OYNATMAZ. ──
        var pwEl = document.getElementById('Password');
        if (pwEl) {
            pwEl.addEventListener('input', function () {
                if (mode === 'measuring' || mode === 'solved') return;   // aktif akışla çakışma
                var len = pwEl.value.length;
                setMode(len > 0 ? 'typing' : 'idle', len > 0 ? 'is-typing' : null);
                setStatus(len > 0 ? 'Şifre giriliyor…' : 'Giriş yapmaya hazır');
                toTyping(len);
                spinInnerRandom();   // iç kadranlar — büyük iğnelerden bağımsız rastgele dönüş
                // Okuma penceresi — her tuşta hesaplanıp oturan ölçüm değeri (uzunluğa bağlı,
                // deterministik-ish → tuşa tepki verir ama tahmin edilebilir değildir).
                if (len > 0) {
                    var ch = READ_CH[(len - 1) % READ_CH.length];
                    var frac = ((len * 37) % 100) / 100;
                    scrambleReadout(ch, ch.min + frac * (ch.max - ch.min), 240);
                } else {
                    stopReadoutAnims();
                    if (readoutEl) readoutEl.textContent = '----';
                }
            });
        }

        // ── Dış API — submit handler çağırır (bkz. loginForm AJAX submit script'i) ──
        window.CalibraLoginDial = {
            begin: function () {
                setMode('measuring', 'is-measuring');
                setStatus('Doğrulanıyor…');
                runCalcSequence();   // okuma penceresi — kanal-kanal hızlı hesap sekansı
                // Kısa "oturma/arama" sekmesi (bir kerelik) — her iğne mevcut konumundan
                // ufak bir kick alıp yaylı (spring) dönüşle AYNI konuma geri oturur; client
                // parola doğrulamaz, yalnızca "işleniyor" hissi verir. Kick bitince iğneler
                // durur — yalnız stage'in caldPulse nabzı sürer (sürekli iğne hareketi YOK).
                for (var r = 0; r < 3; r++) {
                    (function (r) {
                        var cur  = ndlDeg[r];
                        var kick = (r % 2 === 0 ? 1 : -1) * (14 + r * 4);
                        animateNeedle(r, cur + kick, 200, easeOutCubic, function () {
                            animateNeedle(r, cur, 320, easeOutBack);
                        });
                    })(r);
                }
            },
            success: function (done) {
                setMode('solved', 'is-solved');
                setStatus('Giriş başarılı');
                stopReadoutAnims();
                if (readoutEl) readoutEl.textContent = '100.0 %';   // kalibrasyon tamam
                // Kilit açılışı: her iğne SIRAYLA en yakın ORTAK faza (360°'nin tam katı,
                // yani mod 360 ≡ 0 → yukarı/12 yönü) "klik" diye oturur — üçü de aynı mutlak
                // açıya geldiği için tam hizalanır → "kilit açıldı" hissi + yeşil parıltı.
                NEEDLES.forEach(function (n, r) {
                    setTimeout(function () {
                        var target = Math.round(ndlDeg[r] / 360) * 360;
                        animateNeedle(r, target, 560, easeOutBack);
                    }, r * 150);
                });
                setTimeout(function () { if (done) done(); }, 1300);
            },
            fail: function (label, detail) {
                setMode('fail', 'is-fail');
                setStatus(label || 'Giriş başarısız');
                stopReadoutAnims();
                if (readoutEl) readoutEl.textContent = 'ERR';   // kalibrasyon başarısız
                dial.classList.remove('cald-shake');
                void dial.offsetWidth;   // reflow — animasyonu yeniden tetikler
                dial.classList.add('cald-shake');
                // Reddetme tepkisi: her iğne kısa bir "sekme" (kick + yaylı geri dönüş) yapar
                // — hizalanma OLMAZ, iğne kendi (hizasız) konumuna geri oturur; kırmızı tint +
                // kadran sarsılması (cald-shake) yeterli "kalibre edilemedi" sinyalini verir.
                for (var r = 0; r < 3; r++) {
                    (function (r) {
                        var cur  = ndlDeg[r];
                        var kick = (r % 2 === 0 ? -1 : 1) * (9 + r * 3);
                        animateNeedle(r, cur + kick, 90, easeOutCubic, function () {
                            animateNeedle(r, cur, 260, easeOutBack);
                        });
                    })(r);
                }
                if (detail) setTimeout(function () { if (mode === 'fail') setStatus(detail); }, 900);
            }
        };

        // ── İlk render ──
        NEEDLES.forEach(function (n, r) { placeNeedle(r, ndlDeg[r]); });
        innerGroups.forEach(function (g, idx) { placeInner(idx, innerDeg[idx]); });

        // Tam-sayfa POST fallback'i (fetch/network istisnası) sunucu tarafında ModelState
        // hatasıyla yeniden render edildiyse kadran ilk açılışta hizasız/kırmızı başlar.
        var serverHadError = @(ViewData.ModelState.IsValid ? "false" : "true");
        if (serverHadError) window.CalibraLoginDial.fail('Giriş başarısız');
    })();
</script>
<script>
    /* ── Sol hero: canlı kalibrasyon düzenekleri — CİHAZ SEÇİMLİ (2026-08-05) ──
       Üç sahne: komp (komparatör/salgı), mik (mikrometre/dış çap), man (manometre/
       basınç). Soldaki ray sahneler arasında geçiş yapar; her sahnenin KENDİ fizik
       state'i vardır ve yalnız AKTİF sahne tick alır — pasif sahne donuk kalır,
       dönülünce kaldığı yerden sürer. Ortak hız barı + fare etkileşimi (hit alanı)
       sahne geçişinde yeniden hedeflenir. Her sahnede tüm görsel öğeler tek fizik
       değerinden türetilir (senkron asla bozulmaz, CSS keyframe yok).
       Salt dekoratif: login/kadran (CalibraLoginDial) mantığıyla hiçbir bağı yoktur.
       prefers-reduced-motion'da sahne başına tek sabit poz; sekme arka plana düşünce
       döngü durur (visibilitychange). */
    (function () {
        var rigRoot = document.querySelector('.login-rig');
        if (!rigRoot) return;

        var NS = 'http://www.w3.org/2000/svg';
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function mkLine(parent, x1, y1, x2, y2, cls) {
            var ln = document.createElementNS(NS, 'line');
            ln.setAttribute('x1', x1.toFixed(2)); ln.setAttribute('y1', y1.toFixed(2));
            ln.setAttribute('x2', x2.toFixed(2)); ln.setAttribute('y2', y2.toFixed(2));
            if (cls) ln.setAttribute('class', cls);
            parent.appendChild(ln);
        }
        // Kutupsal yardımcı: 0° = yukarı, saat yönünde artar.
        function polar(cx, cy, r, deg) {
            var a = (deg - 90) * Math.PI / 180;
            return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
        }
        function fmt(v, dec) { return v.toFixed(dec).replace('.', ','); }
        // Ekran koordinatını ilgili SVG'nin viewBox koordinatına çevirir
        // (gizli/display:none sahnede CTM null olur — null dönüşü çağıran ele alır).
        function svgPointOf(svg, evt) {
            var m = svg.getScreenCTM();
            if (!m) return null;
            var pt = svg.createSVGPoint();
            pt.x = evt.clientX; pt.y = evt.clientY;
            return pt.matrixTransform(m.inverse());
        }

        var scenes = {}, active = null;

        /* ════ Sahne 1: Komparatör — salgı (runout) ölçümü ════
           th (parça açısı) → d_px = ECC*sin(th) → ibre/uç/HUD/trend hep bu değerden. */
        scenes.komp = (function () {
            var svg = document.getElementById('rigSvg');
            var ECC_PX = 5, MM_PER_PX = 0.024 / 5, REV_PER_MM = 0.1;
            var TRACE_N = 64, TRACE_MS = 60, TRACE_X0 = 252, TRACE_X1 = 378, TRACE_Y = 471, TRACE_AMP = 20;

            // Kadran: 100 bölme (0,001 mm/bölme), her 10.'su uzun + rakamlı
            var ticks = document.getElementById('rigDialTicks');
            var nums  = document.getElementById('rigDialNums');
            for (var i = 0; i < 100; i++) {
                var deg = i * 3.6, major = (i % 10 === 0);
                var o = polar(250, 150, 55, deg), n = polar(250, 150, major ? 45 : 50, deg);
                mkLine(ticks, o[0], o[1], n[0], n[1], 'rig-dial-tick' + (major ? ' maj' : ''));
                if (major) {
                    var p = polar(250, 150, 36, deg);
                    var t = document.createElementNS(NS, 'text');
                    t.setAttribute('x', p[0].toFixed(2)); t.setAttribute('y', p[1].toFixed(2));
                    t.setAttribute('class', 'rig-dial-num');
                    t.textContent = String(i);
                    nums.appendChild(t);
                }
            }
            var ct = document.getElementById('rigCounterTicks');
            for (var k = 0; k < 10; k++) {
                var a = polar(250, 192, 14, k * 36), b = polar(250, 192, 11, k * 36);
                mkLine(ct, a[0], a[1], b[0], b[1], 'rig-counter-tick');
            }
            var cs = document.getElementById('rigColScale');
            for (var y = 140; y <= 350; y += 12) {
                var lng = ((y - 140) % 60 === 0);
                mkLine(cs, 92, y, lng ? 101 : 97, y, 'rig-col-tick' + (lng ? ' maj' : ''));
            }
            var pn = document.getElementById('rigPartNotches');
            for (var j = 0; j < 12; j++) {
                var q1 = polar(255, 330, 48, j * 30), q2 = polar(255, 330, 42, j * 30);
                mkLine(pn, q1[0], q1[1], q2[0], q2[1], 'rig-part-notch');
            }

            var spinEl    = document.getElementById('rigPartSpin');
            var plungerEl = document.getElementById('rigPlunger');
            var needleEl  = document.getElementById('rigNeedle');
            var counterEl = document.getElementById('rigCounter');
            var devEl     = document.getElementById('rigDev');
            var tirEl     = document.getElementById('rigTir');
            var traceEl   = document.getElementById('rigTrace');

            var th = 40, lastTh = 40, spd = 17;
            var trace = [], tirMin = 0, tirMax = 0, tirShown = 0, sampleAcc = 0, revAcc = 0;
            var drag = { on: false, ang: null };

            function render() {
                var dPx = ECC_PX * Math.sin(th * Math.PI / 180), dMm = dPx * MM_PER_PX;
                spinEl.setAttribute('transform', 'rotate(' + th.toFixed(2) + ' 250 330)');
                plungerEl.setAttribute('transform', 'translate(0 ' + dPx.toFixed(2) + ')');
                needleEl.setAttribute('transform', 'rotate(' + (dMm / REV_PER_MM * 360).toFixed(2) + ' 250 150)');
                counterEl.setAttribute('transform', 'rotate(' + (dMm * 360).toFixed(2) + ' 250 192)');
                devEl.textContent = (dMm >= 0 ? '+' : '−') + fmt(Math.abs(dMm), 3) + ' mm';
                tirEl.textContent = fmt(tirShown, 3) + ' mm';
                if (trace.length > 1) {
                    var step = (TRACE_X1 - TRACE_X0) / (TRACE_N - 1), pts = '';
                    for (var q = 0; q < trace.length; q++) {
                        var x = TRACE_X0 + (TRACE_N - trace.length + q) * step;
                        var yy = TRACE_Y - (trace[q] / (ECC_PX * MM_PER_PX)) * TRACE_AMP;
                        pts += x.toFixed(1) + ',' + yy.toFixed(1) + ' ';
                    }
                    traceEl.setAttribute('points', pts.trim());
                }
            }
            function tick(dt) {
                if (!drag.on) th += (spd / 60) * 360 * dt;   // sürüklerken oto dönüş askıda
                var dMm = ECC_PX * Math.sin(th * Math.PI / 180) * MM_PER_PX;
                // TIR = 2 turda bir kilitlenip sıfırlanan tepe-tepe (oto + sürükleme dahil)
                if (dMm < tirMin) tirMin = dMm;
                if (dMm > tirMax) tirMax = dMm;
                tirShown = tirMax - tirMin;
                revAcc += Math.abs(th - lastTh) / 360;
                lastTh = th;
                if (revAcc >= 2) { revAcc = 0; tirMin = dMm; tirMax = dMm; }
                sampleAcc += dt * 1000;
                if (sampleAcc >= TRACE_MS) {
                    sampleAcc = 0;
                    trace.push(dMm);
                    if (trace.length > TRACE_N) trace.shift();
                }
                render();
            }

            var hit = document.getElementById('rigPartHit');
            function ptrAng(evt) {
                var p = svgPointOf(svg, evt);
                return p ? Math.atan2(p.y - 330, p.x - 255) * 180 / Math.PI : null;
            }
            if (hit && !reduce) {
                hit.addEventListener('pointerdown', function (e) {
                    var a = ptrAng(e); if (a === null) return;
                    drag.on = true; drag.ang = a;
                    try { hit.setPointerCapture(e.pointerId); } catch (err) {}
                    e.preventDefault();
                });
                hit.addEventListener('pointermove', function (e) {
                    if (!drag.on) return;
                    var a = ptrAng(e); if (a === null) return;
                    var d = a - drag.ang;
                    if (d > 180) d -= 360; else if (d < -180) d += 360;   // ±180° sarma
                    th += d; drag.ang = a;
                });
                var end = function () { drag.on = false; drag.ang = null; };
                hit.addEventListener('pointerup', end);
                hit.addEventListener('pointercancel', end);
            }

            if (reduce) tirShown = 2 * ECC_PX * MM_PER_PX;
            render();   // ilk / statik poz
            return {
                el: svg, hint: 'Parçayı fareyle sürükleyip çevirebilirsiniz',
                speed: { label: 'Devir', unit: ' dev/dk', min: 0, max: 60, val: 17 },
                setSpeed: function (v) { spd = v; }, tick: tick
            };
        })();

        /* ════ Sahne 2: Mikrometre — dış çap ölçümü ════
           gap (mil-parça açıklığı, mm) tek state: mil/tambur ötelenmesi, tambur
           çizgi kaydırması (0,5 mm hatve) ve okuma (D+gap) hep ondan türetilir.
           Çevrim: yaklaş → otur (settle) → beklet (sapma raporu) → geri çek → yeni parça. */
        scenes.mik = (function () {
            var svg = document.getElementById('rigSvgMik');
            var PXMM = 4, GAP0 = 5, NOM = 17.45;

            var slG = document.getElementById('mikSleeveTicks');
            for (var i = 0; i <= 12; i++) {
                var x = 258 + i * 4.6;
                mkLine(slG, x, 250, x, (i % 2 === 0) ? 243 : 245.5, 'rig-mik-sltick');
            }
            var thT = document.getElementById('mikThimbleTicks');
            for (var y = 212; y <= 292; y += 7) mkLine(thT, 318, y, 350, y, '');

            var moveEl = document.getElementById('mikMove');
            var readEl = document.getElementById('mikRead');
            var devEl  = document.getElementById('mikDevi');

            var D = NOM, gap = GAP0, phase = 'advance', phT = 0, spd = 40;
            var reading = D + gap, sap = null;
            var drag = { on: false, x: 0 };
            function newPart() { D = NOM + (Math.random() * 2 - 1) * 0.06; }
            newPart();

            function render() {
                var gpx = gap * PXMM;
                moveEl.setAttribute('transform', 'translate(' + gpx.toFixed(2) + ' 0)');
                var scroll = ((GAP0 - gap) / 0.5 * 7) % 7;   // 0,5 mm hatve → 7 px desen
                thT.setAttribute('transform', 'translate(0 ' + scroll.toFixed(2) + ')');
                readEl.textContent = fmt(reading, 3) + ' mm';
                devEl.textContent = (sap === null) ? '—'
                    : ((sap >= 0 ? '+' : '−') + fmt(Math.abs(sap), 3) + ' mm');
            }
            function tick(dt) {
                if (drag.on) { reading = D + gap; sap = null; render(); return; }
                var rate = 0.8 + spd / 100 * 3.6;   // mm/sn
                if (phase === 'advance') {
                    gap -= rate * dt; sap = null;
                    if (gap <= 0) { gap = 0; phase = 'settle'; phT = 0; }
                    reading = D + gap;
                } else if (phase === 'settle') {
                    phT += dt;
                    reading = D + (Math.random() * 2 - 1) * 0.004 * Math.max(0, 1 - phT / 0.8);
                    if (phT >= 0.8) { reading = D; sap = D - NOM; phase = 'hold'; phT = 0; }
                } else if (phase === 'hold') {
                    phT += dt;
                    if (phT >= 1.5) phase = 'retract';
                } else {   // retract
                    gap += rate * 1.7 * dt; sap = null;
                    if (gap >= GAP0) { gap = GAP0; newPart(); phase = 'advance'; }
                    reading = D + gap;
                }
                render();
            }

            var hit = document.getElementById('mikHit');
            if (hit && !reduce) {
                hit.addEventListener('pointerdown', function (e) {
                    var p = svgPointOf(svg, e); if (!p) return;
                    drag.on = true; drag.x = p.x;
                    try { hit.setPointerCapture(e.pointerId); } catch (err) {}
                    e.preventDefault();
                });
                hit.addEventListener('pointermove', function (e) {
                    if (!drag.on) return;
                    var p = svgPointOf(svg, e); if (!p) return;
                    gap = Math.max(0, Math.min(GAP0, gap + (p.x - drag.x) / PXMM));
                    drag.x = p.x;
                });
                var end = function () {
                    if (!drag.on) return;
                    drag.on = false;
                    // Bırakılan yerden akışa dön: temasta ise ölçümü otursun, değilse yaklaşsın
                    if (gap <= 0) { phase = 'settle'; phT = 0; }
                    else { phase = 'advance'; sap = null; }
                };
                hit.addEventListener('pointerup', end);
                hit.addEventListener('pointercancel', end);
            }

            if (reduce) { gap = 1.4; reading = D + gap; }
            render();
            return {
                el: svg, hint: 'Tamburu sürükleyerek mili ilerletebilirsiniz',
                speed: { label: 'Hız', unit: ' %', min: 0, max: 100, val: 40 },
                setSpeed: function (v) { spd = v; }, tick: tick
            };
        })();

        /* ════ Sahne 3: Manometre — basınç kalibrasyonu ════
           P (bar) tek state: iğne açısı, Ref/Cihaz okumaları ve pompa kolu ondan
           türetilir. Otomatik akış kalibrasyon noktalarını (0/25/50/75/100) yaylı
           (hafif overshoot) rampalarla gezer; her noktada durup hata raporlar. */
        scenes.man = (function () {
            var svg = document.getElementById('rigSvgMan');
            var CX = 210, CY = 190, A0 = -135, SWEEP = 270, PMAX = 100;

            // Tolerans yayları: 0-80 bar yeşil, 80-100 amber (r=70)
            var arcs = document.getElementById('manArcs');
            function arc(a1, a2, cls) {
                var p1 = polar(CX, CY, 70, a1), p2 = polar(CX, CY, 70, a2);
                var path = document.createElementNS(NS, 'path');
                path.setAttribute('d', 'M' + p1[0].toFixed(1) + ' ' + p1[1].toFixed(1) +
                    ' A70 70 0 ' + ((a2 - a1) > 180 ? 1 : 0) + ' 1 ' + p2[0].toFixed(1) + ' ' + p2[1].toFixed(1));
                path.setAttribute('class', cls);
                arcs.appendChild(path);
            }
            arc(A0, A0 + 0.8 * SWEEP, 'rig-tol-ok');
            arc(A0 + 0.8 * SWEEP, A0 + SWEEP, 'rig-tol-out');

            // Çentikler: 5 bar aralık, 25 bar majör + rakam
            var ticks = document.getElementById('manTicks');
            var nums  = document.getElementById('manNums');
            for (var i = 0; i <= 20; i++) {
                var deg = A0 + i * (SWEEP / 20), maj = (i % 5 === 0);
                var o = polar(CX, CY, 82, deg), n = polar(CX, CY, maj ? 72 : 77, deg);
                mkLine(ticks, o[0], o[1], n[0], n[1], 'rig-dial-tick' + (maj ? ' maj' : ''));
                if (maj) {
                    var p = polar(CX, CY, 61, deg);
                    var t = document.createElementNS(NS, 'text');
                    t.setAttribute('x', p[0].toFixed(1)); t.setAttribute('y', p[1].toFixed(1));
                    t.setAttribute('class', 'rig-dial-num');
                    t.textContent = String(i / 5 * 25);
                    nums.appendChild(t);
                }
            }

            var needle = document.getElementById('manNeedle');
            var lever  = document.getElementById('manLever');
            var refEl  = document.getElementById('manRef');
            var dutEl  = document.getElementById('manDut');
            var errEl  = document.getElementById('manErr');

            var SEQ = [0, 25, 50, 75, 100, 0], si = 1;
            var P = 0, vel = 0, phase = 'ramp', ht = 0, spd = 40, bias = 0, tAcc = 0;
            var drag = { on: false };
            function nextBias() { bias = (Math.random() * 2 - 1) * 0.4; }
            nextBias();

            function render() {
                needle.setAttribute('transform', 'rotate(' + (A0 + P / PMAX * SWEEP).toFixed(2) + ' ' + CX + ' ' + CY + ')');
                var dut = Math.max(0, P + bias * (P / PMAX));   // cihaz hatası basınçla ölçeklenir
                refEl.textContent = fmt(P, 1) + ' bar';
                dutEl.textContent = fmt(dut, 1) + ' bar';
                errEl.textContent = (phase === 'hold')
                    ? ((dut - P >= 0 ? '+' : '−') + fmt(Math.abs(dut - P), 2) + ' bar') : '—';
                // Pompa kolu — basınç değişirken sallanır, sabitken durur
                var bob = Math.min(1, Math.abs(vel) / 25) * Math.sin(tAcc * 14) * 9;
                lever.setAttribute('transform', 'rotate(' + bob.toFixed(2) + ' 271 348)');
            }
            function tick(dt) {
                tAcc += dt;
                if (!drag.on) {
                    var T = SEQ[si], s = 0.4 + spd / 100 * 1.6;
                    vel += ((T - P) * 12 * s - vel * 5.2) * dt;   // yaylı yaklaşım (hafif overshoot)
                    P += vel * dt;
                    if (P < 0) { P = 0; vel = 0; }
                    if (P > PMAX + 3) { P = PMAX + 3; vel = 0; }
                    if (phase === 'ramp' && Math.abs(T - P) < 0.2 && Math.abs(vel) < 0.5) {
                        phase = 'hold'; ht = 0; P = T; vel = 0;
                    } else if (phase === 'hold') {
                        ht += dt;
                        if (ht >= 1.4) { si = (si + 1) % SEQ.length; nextBias(); phase = 'ramp'; }
                    }
                }
                render();
            }

            var hit = document.getElementById('manHit');
            function angToP(evt) {
                var p = svgPointOf(svg, evt); if (!p) return null;
                var a = Math.atan2(p.y - CY, p.x - CX) * 180 / Math.PI + 90;   // 0° = yukarı
                if (a > 180) a -= 360;
                if (a > 135) a = 135;          // alt sağ ölü bölge → üst sınıra kilitle
                if (a < A0) a = A0;            // alt sol ölü bölge → alt sınıra kilitle
                return (a - A0) / SWEEP * PMAX;
            }
            if (hit && !reduce) {
                hit.addEventListener('pointerdown', function (e) {
                    var v = angToP(e); if (v === null) return;
                    drag.on = true; P = v; vel = 0; phase = 'ramp';
                    try { hit.setPointerCapture(e.pointerId); } catch (err) {}
                    e.preventDefault();
                });
                hit.addEventListener('pointermove', function (e) {
                    if (!drag.on) return;
                    var v = angToP(e); if (v !== null) P = v;
                });
                var end = function () { drag.on = false; vel = 0; phase = 'ramp'; };
                hit.addEventListener('pointerup', end);
                hit.addEventListener('pointercancel', end);
            }

            if (reduce) P = 50;
            render();
            return {
                el: svg, hint: 'Kadran üzerinde sürükleyerek basıncı ayarlayabilirsiniz',
                speed: { label: 'Hız', unit: ' %', min: 0, max: 100, val: 40 },
                setSpeed: function (v) { spd = v; }, tick: tick
            };
        })();

        /* ── Ortak kontrol: cihaz rayı + hız barı + ipucu ── */
        var speedEl      = document.getElementById('rigSpeed');
        var speedValEl   = document.getElementById('rigSpeedVal');
        var speedLabelEl = document.getElementById('rigSpeedLabel');
        var hintEl       = document.getElementById('rigHint');

        function setSpeedUi(s) {
            if (!speedEl) return;
            if (speedLabelEl) speedLabelEl.textContent = s.speed.label;
            speedEl.min = s.speed.min; speedEl.max = s.speed.max; speedEl.value = s.speed.val;
            if (speedValEl) speedValEl.textContent = Math.round(s.speed.val) + s.speed.unit;
        }
        function activate(key) {
            Object.keys(scenes).forEach(function (k) {
                scenes[k].el.classList.toggle('is-active', k === key);
            });
            Array.prototype.forEach.call(rigRoot.querySelectorAll('.rig-dev-btn'), function (b) {
                b.classList.toggle('is-active', b.getAttribute('data-rig') === key);
            });
            active = scenes[key];
            setSpeedUi(active);
            if (hintEl) hintEl.textContent = active.hint;
        }
        Array.prototype.forEach.call(rigRoot.querySelectorAll('.rig-dev-btn'), function (b) {
            b.addEventListener('click', function () { activate(b.getAttribute('data-rig')); });
        });
        if (speedEl) {
            speedEl.addEventListener('input', function () {
                var v = parseFloat(speedEl.value) || 0;
                if (!active) return;
                active.speed.val = v;
                active.setSpeed(v);
                if (speedValEl) speedValEl.textContent = Math.round(v) + active.speed.unit;
            });
        }
        activate('komp');

        if (reduce) return;   // statik pozlar çizildi; döngü ve sürükleme yok

        var last = null, raf = null;
        function frame(ts) {
            if (last === null) last = ts;
            var dt = Math.min(0.05, (ts - last) / 1000); last = ts;
            if (active) active.tick(dt);
            raf = requestAnimationFrame(frame);
        }
        function start() { if (raf === null) { last = null; raf = requestAnimationFrame(frame); } }
        function stop()  { if (raf !== null) { cancelAnimationFrame(raf); raf = null; } }
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) stop(); else start();
        });
        start();
    })();
</script>
</body>
</html>

