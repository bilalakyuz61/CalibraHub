<script>
    (function () {
        const companyPlaceholderText = @Html.Raw(JsonSerializer.Serialize(ui.Text("company_placeholder")));
        const emailInput = document.getElementById("Email");
        const companySelect = document.getElementById("CompanyId");
        if (!emailInput || !companySelect) {
            return;
        }

        const endpoint = '@Url.Action("CompaniesForUser", "Account")';

        function renderCompanies(items) {
            const currentValue = companySelect.value;
            companySelect.innerHTML = "";

            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = companyPlaceholderText;
            companySelect.appendChild(placeholder);

            let hasCurrent = false;
            items.forEach(function (item) {
                const option = document.createElement("option");
                option.value = item.id;
                option.textContent = item.name;
                if (item.id === currentValue) {
                    option.selected = true;
                    hasCurrent = true;
                }

                companySelect.appendChild(option);
            });

            if (!hasCurrent) {
                companySelect.value = "";
            }
        }

        async function loadCompanies() {
            const email = emailInput.value.trim();
            if (!email) {
                renderCompanies([]);
                return;
            }

            try {
                const response = await fetch(endpoint + "?email=" + encodeURIComponent(email), {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    renderCompanies([]);
                    return;
                }

                const data = await response.json();
                renderCompanies(Array.isArray(data) ? data : []);
            } catch {
                renderCompanies([]);
            }
        }

        emailInput.addEventListener("blur", loadCompanies);
        emailInput.addEventListener("change", loadCompanies);

        if (emailInput.value.trim().length > 0) {
            loadCompanies();
        }

        // Beni hatırla switch
        var rememberToggle = document.getElementById("rememberToggle");
        var rememberLabel = document.querySelector(".login-remember-label");
        var remembered = localStorage.getItem("calibra_login_remember") === "1";

        if (rememberToggle) {
            rememberToggle.checked = remembered;

            // Önceki oturumdan hatırlanan bilgileri yükle
            if (remembered && !emailInput.value) {
                var savedEmail = localStorage.getItem("calibra_login_email");
                var savedCompany = localStorage.getItem("calibra_login_company");
                if (savedEmail) {
                    emailInput.value = savedEmail;
                    loadCompanies().then(function () {
                        if (savedCompany && companySelect) {
                            companySelect.value = savedCompany;
                        }
                    });
                }
            }

            if (rememberLabel) {
                rememberLabel.addEventListener("click", function () {
                    rememberToggle.checked = !rememberToggle.checked;
                });
            }
        }

        var loginForm = emailInput.closest("form");
        if (loginForm) {
            var pwInput = document.getElementById("Password");
            var pwWrap  = pwInput ? pwInput.closest(".login-field") : null;

            loginForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                // Tema hidden input'u güncelle
                var themeInput = document.getElementById("loginThemeInput");
                if (themeInput) themeInput.value = document.body.classList.contains("app-theme-dark") ? "dark" : "light";

                // Beni hatırla
                if (rememberToggle && rememberToggle.checked) {
                    localStorage.setItem("calibra_login_remember", "1");
                    localStorage.setItem("calibra_login_email", emailInput.value.trim());
                    if (companySelect.value) localStorage.setItem("calibra_login_company", companySelect.value);
                } else {
                    localStorage.removeItem("calibra_login_remember");
                    localStorage.removeItem("calibra_login_email");
                    localStorage.removeItem("calibra_login_company");
                }

                // Kilit bulmacası: sunucu doğrulaması başladı
                if (window.CalibraLoginDial) window.CalibraLoginDial.begin();

                // AJAX submit
                try {
                    var resp = await fetch(loginForm.action || window.location.href, {
                        method: "POST",
                        body: new FormData(loginForm),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    var json = await resp.json();

                    if (json.ok) {
                        // Doğru giriş — 3 iğne ortak faza (yukarı) oturup hizalanır (yeşil), sonra login
                        if (window.CalibraLoginDial) window.CalibraLoginDial.success(function () { window.location.href = json.redirect; });
                        else window.location.href = json.redirect;
                        return;
                    }

                    // Giriş başarısız — iğneler hizasız kalır + shake + kırmızı tint (kanonik v3 spec)
                    if (json.error === "locked") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Hesap kilitli');
                        if (pwInput) {
                            pwInput.value = "";
                            pwInput.disabled = true;
                            setTimeout(function () { pwInput.disabled = false; }, 5000);
                        }
                    } else if (json.error === "validation") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Alanları doldurun');
                    } else {   // credentials
                        var rem = (typeof json.remaining === "number") ? json.remaining : -1;
                        var det = rem > 0 ? ("Şifreniz hatalı, " + rem + " deneme kaldı") : "Şifreniz hatalı";
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail("Giriş başarısız", det);
                        if (pwInput) { pwInput.value = ""; pwInput.focus(); }
                    }
                } catch {
                    // Network hatası: normal submit
                    loginForm.submit();
                }
            });
        }
    })();
</script>
<script>
    /* ── Kalibrasyon göstergesi v5.1 (2026-08-17) — sayfadaki TEK animasyon ──────────
       Üç kol v3'teki gibi geri geldi (v4 tek iğneye inmişti) ve okuma yine CANLI oynuyor
       — ama v3'ün rastgeleliği geri gelmedi. v3 Math.random() ile her tuşta rastgele yön
       ve açı üretiyordu; v5.1 aynı canlı hissi girdinin İMZASINDAN türetir, dolayısıyla
       deterministiktir: aynı metin her zaman aynı okumayı verir.

       ÖLÇÜM  metin = e-posta + şifre  (v4 yalnız şifreyi dinliyordu → e-posta ölüydü)
              n     = karakter sayısı
              prog  = 1 − e^(−n/PCT_TAU)                    · tekdüze doluluk
              sig   = PCT_MAX·prog + (h−0.5)·2·spread       · h = FNV-1a imzası
              spread= SPREAD_MAX·(1−prog) + SPREAD_MIN      · veri arttıkça daralır
              Sonuç: az veriyle iğne geniş salınır, veri arttıkça yakınsayıp oturur —
              gerçek bir ölçümün davranışı. v5'te sig yalnız n'e bağlıydı: hep ileri,
              tekdüze. v4'te ayrıca 12 karakterde tavan vardı; artık tavan yok.

       İĞNELER (üç ayrı davranış, hepsi aynı ölçümden)
         ana   = sig × 3.6°          · oynak; iki yöne de gider, tam tur = tam skala
         devir = PCT_MAX·prog × 0.36°· tekdüze birikir, hiç geri gitmez (akrep)
         hızlı = fastBase + n × 24°  · tuş başına SABİT çentik, sarmalanmaz → her tuşta
                 mutlaka görünür hareket; doğrulamada fastBase +360 ile son bir tur atar

       FİZİK  TEK requestAnimationFrame döngüsünde yay-sönüm entegrasyonu; hedefe oturunca
              döngü durur (idle'da 0 CPU). Katsayılar v4'e göre KASITLI yavaşlatıldı —
              v4 fazla çevikti. Ölçülen değerler makeSpring satırlarında.

       Çözülme YALNIZ sunucu onayıyla (success) tetiklenir — istemci parola doğrulaması
       YOKTUR. Dışa açık sözleşme değişmedi: begin() / success(done) / fail(label, detail). */
    (function () {
        var wrap = document.getElementById('caldDial');
        var gMain = document.getElementById('caldNeedleMain');
        var gRev = document.getElementById('caldNeedleRev');
        var gFast = document.getElementById('caldNeedleFast');
        var arcEl = document.getElementById('caldArc');
        var readoutEl = document.getElementById('caldReadout');
        var ticksG = document.getElementById('caldTicks');
        var numsG = document.getElementById('caldNums');
        var statusEl = document.getElementById('caldStatus');
        if (!wrap || !gMain || !gRev || !gFast || !arcEl || !readoutEl) return;

        var SVGNS = 'http://www.w3.org/2000/svg';
        var ARC_LEN = 2 * Math.PI * 94;
        var PCT_MAX = 92;        // okumaların yakınsadığı tavan; %100 yalnız sunucu onayıyla
        var PCT_TAU = 10;        // yakınsama sabiti (karakter) — sapma bu hızla daralır
        var SPREAD_MAX = 46;     // ilk karakterlerde okuma sapmasının genliği (yüzde puanı)
        var SPREAD_MIN = 2;      // sapma tabanı — iğne asla tamamen donuklaşmasın
        var FAST_STEP = 24;      // hızlı iğnenin tuş başına derecesi
        var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

        /* ── Skala (statik, bir kez) — 50 çentik, her 5.'si kalın, rakam her 10.'da ── */
        (function buildScale() {
            var R_OUT = 86, R_MIN = 80, R_MAJ = 74, R_NUM = 63;
            for (var i = 0; i < 50; i++) {
                var isMajor = (i % 5 === 0);
                var rad = (i * 7.2 - 90) * Math.PI / 180;
                var cos = Math.cos(rad), sin = Math.sin(rad);
                var ri = isMajor ? R_MAJ : R_MIN;
                var ln = document.createElementNS(SVGNS, 'line');
                ln.setAttribute('x1', (100 + cos * ri).toFixed(2));
                ln.setAttribute('y1', (100 + sin * ri).toFixed(2));
                ln.setAttribute('x2', (100 + cos * R_OUT).toFixed(2));
                ln.setAttribute('y2', (100 + sin * R_OUT).toFixed(2));
                ln.setAttribute('class', isMajor ? 'cald-tick maj' : 'cald-tick');
                ticksG.appendChild(ln);
                if (i % 10 === 0) {
                    var tx = document.createElementNS(SVGNS, 'text');
                    tx.setAttribute('class', 'cald-num');
                    tx.setAttribute('x', (100 + cos * R_NUM).toFixed(2));
                    tx.setAttribute('y', (100 + sin * R_NUM).toFixed(2));
                    tx.textContent = String(i * 2);
                    numsG.appendChild(tx);
                }
            }
        })();

        /* ── Yay-sönüm entegratörü:  a = (hedef − x)·k − v·c ,  ζ = c / (2√k) ── */
        function makeSpring(k, c, eps) { return { x: 0, v: 0, target: 0, k: k, c: c, eps: eps }; }
        function stepSpring(s, dt) {
            if (s.x === s.target && s.v === 0) return false;
            s.v += ((s.target - s.x) * s.k - s.v * s.c) * dt;
            s.x += s.v * dt;
            if (Math.abs(s.target - s.x) < s.eps && Math.abs(s.v) < s.eps * 6) {
                s.x = s.target; s.v = 0; return false;
            }
            return true;
        }
        // Katsayılar 60 fps entegrasyonla ölçülerek seçildi (v4'ün ~2 katı süre = daha ağır his):
        //   ana ζ0.76 · devir ζ0.81 (en ağır) · hızlı ζ0.69 (tek çevik kol) · yay/pencere ζ≈1 (aşımsız)
        var sMain = makeSpring(80, 13.5, 0.08);     // derece
        var sRev = makeSpring(65, 13, 0.05);        // derece
        var sFast = makeSpring(150, 17, 0.12);      // derece
        var sArc = makeSpring(75, 17, 0.001);       // 0..1
        var sReadout = makeSpring(70, 17, 0.05);    // 0..100

        var readoutOverride = null;
        var onSettle = null;
        var rafId = 0, lastTs = 0;

        function render() {
            gMain.setAttribute('transform', 'rotate(' + sMain.x.toFixed(2) + ' 100 100)');
            gRev.setAttribute('transform', 'rotate(' + sRev.x.toFixed(2) + ' 100 100)');
            gFast.setAttribute('transform', 'rotate(' + sFast.x.toFixed(2) + ' 100 100)');
            var frac = Math.max(0, Math.min(1, sArc.x));
            arcEl.setAttribute('stroke-dasharray', (ARC_LEN * frac).toFixed(2) + ' ' + ARC_LEN.toFixed(2));
            readoutEl.textContent = readoutOverride !== null
                ? readoutOverride
                : (sReadout.x.toFixed(1) + ' %');
        }
        function fireSettle() { if (onSettle) { var fn = onSettle; onSettle = null; fn(); } }
        function frame(ts) {
            // Sekme arkaplandayken biriken dev dt yayı patlatır → 1/30 s'ye kırp.
            var dt = lastTs ? Math.min((ts - lastTs) / 1000, 1 / 30) : 1 / 60;
            lastTs = ts;
            var moving = false;
            if (stepSpring(sMain, dt)) moving = true;
            if (stepSpring(sRev, dt)) moving = true;
            if (stepSpring(sFast, dt)) moving = true;
            if (stepSpring(sArc, dt)) moving = true;
            if (stepSpring(sReadout, dt)) moving = true;
            render();
            if (moving) { rafId = requestAnimationFrame(frame); return; }
            rafId = 0; lastTs = 0; fireSettle();
        }
        function kick() {
            if (reduceMotion) {
                [sMain, sRev, sFast, sArc, sReadout].forEach(function (s) { s.x = s.target; s.v = 0; });
                render(); fireSettle(); return;
            }
            if (!rafId) { lastTs = 0; rafId = requestAnimationFrame(frame); }
        }

        /* ── Ölçüm modeli: yakınsayan gösterge (v5.1) ────────────────────────────────
           v5'te iğne yalnız karakter SAYISINA bakıyordu → her tuşta hep ileri, tekdüze.
           Gerçek bir ölçü aleti böyle davranmaz: az veriyle okuma oynaktır, veri arttıkça
           sapma daralır ve okuma oturur. v5.1 bunu modelliyor — rastgelelik KULLANMADAN:

             prog   = 1 − e^(−n/PCT_TAU)              · veri doluluğu (tekdüze artar)
             center = PCT_MAX · prog                  · okumaların yakınsadığı merkez
             spread = SPREAD_MAX·(1−prog) + SPREAD_MIN· sapma genliği (daralır, sıfırlanmaz)
             sig    = center + (h − 0.5)·2·spread     · h = yazılan metnin imzası (FNV-1a)

           h girdinin İMZASI olduğu için okuma her tuşta ileri/geri oynar (v3'ün istenen
           canlı hissi) ama Math.random() yoktur: aynı metin her zaman aynı okumayı verir.
           Ölçüm tekrarlanabilirdir — bir aletin yapması gerektiği gibi. Ayrıca imza tüm
           metinden türediği için karakter EKLEMEK kadar SİLMEK de iğneyi oynatır.

           Üç kol üç ayrı davranış gösterir (hepsi deterministik):
             ana   = sig   → oynak, iki yöne de gider
             devir = prog  → tekdüze birikir, hiç geri gitmez
             hızlı = n     → tuş başına sabit çentik, hep ileri */
        var fastBase = 0;
        function hash01(str) {
            var h = 2166136261;                        // FNV-1a, 32-bit
            for (var i = 0; i < str.length; i++) {
                h ^= str.charCodeAt(i);
                h = (h * 16777619) >>> 0;
            }
            return (h >>> 8) / 16777216;               // 0..1
        }
        function apply(sig, prog, charCount) {
            sig = Math.max(0, Math.min(100, sig));
            sMain.target = sig * 3.6;                  // oynak okuma
            sRev.target = PCT_MAX * prog * 0.36;       // tekdüze birikim
            sFast.target = fastBase + charCount * FAST_STEP;
            sArc.target = prog;                        // gerçek ilerleme (geri gitmez)
            sReadout.target = sig;
            kick();
        }
        function setMode(mode) {
            wrap.classList.remove('is-measuring', 'is-solved', 'is-fail');
            if (mode) wrap.classList.add('is-' + mode);
        }
        function setStatus(text, detail) {
            if (!statusEl) return;
            statusEl.textContent = text;
            if (detail) statusEl.title = detail; else statusEl.removeAttribute('title');
        }

        /* ── Alanlar kadranı sürer: e-posta + şifre birlikte ── */
        var locked = false;
        var emailEl = document.getElementById('Email') || document.querySelector('input[type="email"]');
        var pwdEl = document.getElementById('Password') || document.querySelector('input[type="password"]');
        var lastText = null;
        function fieldText() {
            // \u0001 ayıracı: "ab"+"c" ile "a"+"bc" farklı imza üretsin.
            return ((emailEl && emailEl.value) || '') + '\u0001' + ((pwdEl && pwdEl.value) || '');
        }
        function charCount() {
            return ((emailEl && emailEl.value) || '').length + ((pwdEl && pwdEl.value) || '').length;
        }
        function syncFields() {
            if (locked) return;
            var txt = fieldText();
            if (txt === lastText) return;   // içerik değişmediyse döngüyü uyandırma
            lastText = txt;
            var n = charCount();
            readoutOverride = null;
            setMode(n > 0 ? 'measuring' : null);
            setStatus(n > 0 ? 'Kimlik ölçülüyor' : 'Giriş yapmaya hazır');
            if (n === 0) { apply(0, 0, 0); return; }
            var prog = 1 - Math.exp(-n / PCT_TAU);
            var spread = SPREAD_MAX * (1 - prog) + SPREAD_MIN;
            apply(PCT_MAX * prog + (hash01(txt) - 0.5) * 2 * spread, prog, n);
        }
        [emailEl, pwdEl].forEach(function (el) {
            if (!el) return;
            el.addEventListener('input', syncFields);
            el.addEventListener('change', syncFields);   // tarayıcı otomatik doldurması
        });
        // Otomatik doldurma yükleme sonrası gelebilir → birkaç kez yokla (input olayı gelmez).
        syncFields();
        setTimeout(syncFields, 250);
        setTimeout(syncFields, 900);

        render();

        window.CalibraLoginDial = {
            /* Sunucuya istek gitti — iğneler tam skalaya, hızlı iğne bir tur daha atar. */
            begin: function () {
                locked = true;
                onSettle = null;
                readoutOverride = null;
                fastBase += 360;
                setMode('measuring');
                setStatus('Doğrulanıyor');
                apply(100, 1, charCount());
            },
            /* Sunucu onayladı — tam skalada yeşile oturur, oturunca done() çağrılır. */
            success: function (done) {
                locked = true;
                readoutOverride = null;
                setMode('solved');
                setStatus('Kalibrasyon tamam');
                onSettle = function () { if (typeof done === 'function') setTimeout(done, 320); };
                // kick() hareket olmasa bile bir kare çalıştırır → onSettle her hâlükârda gelir.
                apply(100, 1, charCount());
            },
            /* Sunucu reddetti — ölçüm geçersiz: ana/devir sıfıra, okuma bastırılır.
               Hızlı iğne YERİNDE kalır: o bir tuş sayacıdır, hata onu sıfırlamaz
               (ve kullanıcı yazmaya devam edince kaldığı yerden ilerler). */
            fail: function (label, detail) {
                locked = false;
                lastText = null;                 // sonraki tuşta syncFields kesin çalışsın
                onSettle = null;
                readoutOverride = '--- %';
                setMode('fail');
                setStatus(label || 'Giriş başarısız', detail);
                sMain.target = 0; sRev.target = 0; sArc.target = 0; sReadout.target = 0;
                kick();
            }
        };

        // Sunucu tarafı (non-AJAX) doğrulama hatasıyla dönüldüyse kadranı hata durumuna al.
        var serverHadError = @(ViewData.ModelState.IsValid ? "false" : "true");
        if (serverHadError) window.CalibraLoginDial.fail('Giriş başarısız');
    })();
</script>
