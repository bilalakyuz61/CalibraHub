@using System.Text.Json
@model CalibraHub.Web.Models.Account.LoginInputModel
@inject CalibraHub.Web.Infrastructure.Ui.IUiTextService UiText
@{
    Layout = null;
    var runtime = await UiText.GetRuntimeAsync();
    var ui = await UiText.GetFormAsync("account.login");
}
<!DOCTYPE html>
<html lang="@runtime.LanguageCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ui.Text("title") - CalibraHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ── Login sayfasi tema toggle butonu (sag ust) ─────────────── */
        .login-theme-toggle {
            position: fixed; top: 16px; right: 18px; z-index: 1050;
            width: 38px; height: 38px;
            border: 1px solid rgba(148, 163, 184, 0.32);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.85);
            color: #475569;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            transition: background-color .18s, color .18s, border-color .18s, transform .18s;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .login-theme-toggle:hover { transform: scale(1.08); background: rgba(241, 245, 249, 0.95); }
        .login-theme-toggle .icon-sun  { display: none;  }
        .login-theme-toggle .icon-moon { display: block; }
        body.app-theme-dark .login-theme-toggle {
            background: rgba(15, 23, 42, 0.72);
            border-color: rgba(148, 163, 184, 0.30);
            color: #e2e8f0;
        }
        body.app-theme-dark .login-theme-toggle:hover { background: rgba(30, 41, 59, 0.95); }
        body.app-theme-dark .login-theme-toggle .icon-sun  { display: block; }
        body.app-theme-dark .login-theme-toggle .icon-moon { display: none;  }

        /* ── Dark tema overrides — login sayfasi icin ───────────────── */
        body.app-theme-dark.login-page {
            background: #0a0d17 !important;
        }
        body.app-theme-dark .login-panel {
            background: linear-gradient(145deg, #0f172a, #0a0d17) !important;
        }
        body.app-theme-dark .login-hero {
            background: #0a0d17;
        }
        body.app-theme-dark .login-hero img {
            filter: saturate(1.05) brightness(0.92);
        }
        body.app-theme-dark .login-card {
            background: rgba(15, 23, 42, 0.88) !important;
            border: 1px solid rgba(148, 163, 184, 0.14) !important;
            box-shadow: 0 18px 48px rgba(0, 0, 0, 0.55) !important;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            color: #e2e8f0 !important;
        }
        body.app-theme-dark .login-card h1 { color: #f1f5f9 !important; }
        body.app-theme-dark .login-card .form-label,
        body.app-theme-dark .login-card label,
        body.app-theme-dark .login-field > label {
            color: #94a3b8 !important;
        }
        body.app-theme-dark .login-card .form-control,
        body.app-theme-dark .login-card .form-select,
        body.app-theme-dark .login-field .form-control,
        body.app-theme-dark .login-field .form-select {
            background-color: rgba(30, 41, 59, 0.65) !important;
            border-color: rgba(148, 163, 184, 0.22) !important;
            color: #e2e8f0 !important;
        }
        body.app-theme-dark .login-card .form-control:focus,
        body.app-theme-dark .login-card .form-select:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18) !important;
        }
        body.app-theme-dark .login-card .form-select option {
            background: #0c0f1a; color: #e2e8f0;
        }
        body.app-theme-dark .login-card .btn-primary {
            background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
            border: none !important;
        }
        body.app-theme-dark .login-remember-label { color: #cbd5e1 !important; }
        body.app-theme-dark .login-card .text-muted { color: #94a3b8 !important; }
        body.app-theme-dark .login-card .border-top { border-color: rgba(148, 163, 184, 0.18) !important; }

        .login-error-msg {
            min-height: 46px;
            margin-bottom: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: .875rem;
            font-weight: 500;
            background: rgba(239,68,68,.10);
            border: 1px solid rgba(239,68,68,.35);
            color: #dc2626;
            display: flex;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s;
        }
        .login-error-msg.is-visible {
            opacity: 1;
            pointer-events: auto;
        }
        body.app-theme-dark .login-error-msg {
            background: rgba(239,68,68,.14);
            border-color: rgba(248,113,113,.35);
            color: #f87171;
        }

        @@keyframes loginShake {
            0%, 100% { transform: translateX(0); }
            15%  { transform: translateX(-7px); }
            30%  { transform: translateX(7px); }
            45%  { transform: translateX(-5px); }
            60%  { transform: translateX(5px); }
            75%  { transform: translateX(-2px); }
        }
        .login-pw-error .form-control {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 3px rgba(239,68,68,.18) !important;
        }
        body.app-theme-dark .login-pw-error .form-control {
            border-color: #f87171 !important;
            box-shadow: 0 0 0 3px rgba(248,113,113,.18) !important;
        }
        .login-pw-shake {
            animation: loginShake .42s cubic-bezier(.36,.07,.19,.97) both;
        }

        /* ── Kalibrasyon göstergesi v4 (2026-08-15) — sayfadaki TEK animasyon ────────
           v3'ün "oyuncak" hisleri bilinçli olarak kaldırıldı: rastgele yön/açıyla dönen
           iç kadranlar, zıplayan easeOutBack, titreyen (scramble) rakamlar, hatada kadran
           sarsılması (shake) ve idle'da nefes alan parlaklık. Yerine gerçek bir komparatör
           (dial indicator) disiplini kondu — HER hareket bir şey ölçer, hiçbiri rastgele
           değildir:
             • İğne açısı    = kalibrasyon yüzdesi (0-100 → 0-360°, tam tur = tam skala)
             • İlerleme yayı = aynı yüzde (kenarda çevresel okuma)
             • Okuma penceresi = aynı yüzde, sayılarak oturur (jitter/scramble YOK)
           Hareket fiziği: TEK rAF döngüsünde kritik-sönümlü yay (galvanometre gibi tek
           küçük aşım + oturma). Durağanken döngü tamamen durur — idle'da CPU harcanmaz.
           Palet: tek vurgu rengi (indigo) + nötr çentikler; yeşil/kırmızı yalnız DURUM
           belirtir (v3'teki indigo+cyan+violet üçlüsü kaldırıldı).
           Çözülme YALNIZ sunucu onayıyla (server-truth) tetiklenir — client parola
           doğrulamaz; bu mantık v3'ten aynen korundu. */
        .cald-wrap {
            width: 152px; margin: 2px auto 20px; position: relative;
            color-scheme: light;
            --cald-face-a: #ffffff;
            --cald-face-b: #e6eaf2;
            --cald-bezel: rgba(100,116,139,.34);
            --cald-tick: rgba(100,116,139,.55);
            --cald-tick-maj: rgba(51,65,85,.85);
            --cald-num: rgba(71,85,105,.75);
            --cald-accent: #4f46e5;
            --cald-arc-bg: rgba(100,116,139,.16);
            --cald-hub: #334155;
            --cald-readout: #334155;
            --cald-readout-bg: rgba(148,163,184,.13);
            --cald-success: #059669;
            --cald-danger: #e11d48;
            --cald-status: #64748b;
        }
        body.app-theme-dark .cald-wrap {
            color-scheme: dark;
            --cald-face-a: #131c30;
            --cald-face-b: #070b14;
            --cald-bezel: rgba(148,163,184,.28);
            --cald-tick: rgba(148,163,184,.5);
            --cald-tick-maj: rgba(226,232,240,.82);
            --cald-num: rgba(203,213,225,.72);
            --cald-accent: #818cf8;
            --cald-arc-bg: rgba(148,163,184,.14);
            --cald-hub: #cbd5e1;
            --cald-readout: #e2e8f0;
            --cald-readout-bg: rgba(2,6,23,.45);
            --cald-success: #34d399;
            --cald-danger: #fb7185;
            --cald-status: #94a3b8;
        }
        /* Kadran gövdesi — bezel + cam. Statik: idle'da hiçbir animasyon yok
           (v3'teki caldIdleBreathe kaldırıldı; ölçü aleti dururken durur). */
        .cald-stage {
            position: relative; width: 152px; height: 152px; margin: 0 auto;
            border-radius: 50%;
            background: radial-gradient(120% 120% at 32% 24%, var(--cald-face-a), var(--cald-face-b) 78%);
            box-shadow:
                inset 0 0 0 1px var(--cald-bezel),
                inset 0 1px 2px rgba(255,255,255,.55),
                inset 0 -10px 22px rgba(15,23,42,.07),
                0 10px 24px -12px rgba(15,23,42,.42);
            transition: box-shadow .45s ease;
        }
        body.app-theme-dark .cald-stage {
            box-shadow:
                inset 0 0 0 1px var(--cald-bezel),
                inset 0 1px 2px rgba(226,232,240,.14),
                inset 0 -10px 24px rgba(0,0,0,.55),
                0 14px 30px -14px rgba(0,0,0,.7);
        }
        /* Durum halkası — parıltı değil, ölçülü bir çerçeve vurgusu. */
        .cald-wrap.is-solved .cald-stage {
            box-shadow:
                inset 0 0 0 1px rgba(5,150,105,.55),
                inset 0 1px 2px rgba(255,255,255,.55),
                inset 0 -10px 22px rgba(5,150,105,.10),
                0 10px 24px -12px rgba(15,23,42,.42),
                0 0 0 3px rgba(5,150,105,.14);
        }
        .cald-wrap.is-fail .cald-stage {
            box-shadow:
                inset 0 0 0 1px rgba(225,29,72,.55),
                inset 0 1px 2px rgba(255,255,255,.55),
                inset 0 -10px 22px rgba(225,29,72,.10),
                0 10px 24px -12px rgba(15,23,42,.42),
                0 0 0 3px rgba(225,29,72,.14);
        }
        .cald-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; display: block; }

        /* Skala — 50 ince + 10 kalın çentik (tam skala = 100 bölme, komparatör standardı) */
        .cald-tick { stroke: var(--cald-tick); stroke-width: 1; }
        .cald-tick.maj { stroke: var(--cald-tick-maj); stroke-width: 1.9; }
        .cald-num {
            fill: var(--cald-num);
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 10px; font-weight: 600;
            text-anchor: middle; dominant-baseline: middle;
        }

        /* İlerleme yayı — iğneyle AYNI değeri gösterir (dekoratif değil, yedek okuma) */
        .cald-arc-bg { fill: none; stroke: var(--cald-arc-bg); stroke-width: 3; }
        .cald-arc {
            fill: none; stroke: var(--cald-accent); stroke-width: 3; stroke-linecap: round;
            transition: stroke .4s ease;
        }
        .cald-wrap.is-solved .cald-arc { stroke: var(--cald-success); }
        .cald-wrap.is-fail .cald-arc { stroke: var(--cald-danger); }

        /* Ana iğne — sivrilen bıçak + karşı ağırlık (tek renk, tek iğne) */
        .cald-needle {
            fill: var(--cald-accent);
            transition: fill .4s ease;
        }
        .cald-counterweight { fill: var(--cald-accent); transition: fill .4s ease; }
        .cald-wrap.is-solved .cald-needle,
        .cald-wrap.is-solved .cald-counterweight { fill: var(--cald-success); }
        .cald-wrap.is-fail .cald-needle,
        .cald-wrap.is-fail .cald-counterweight { fill: var(--cald-danger); }
        .cald-hub-ring { fill: var(--cald-face-a); stroke: var(--cald-bezel); stroke-width: 1; }
        .cald-hub { fill: var(--cald-hub); }

        /* Okuma penceresi — sayarak oturan değer (jitter yok) */
        .cald-readout-box { fill: var(--cald-readout-bg); stroke: var(--cald-bezel); stroke-width: .8; }
        .cald-readout-text {
            fill: var(--cald-readout);
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 10.5px; font-weight: 600; letter-spacing: .3px;
            text-anchor: middle; dominant-baseline: middle;
            transition: fill .4s ease;
        }
        .cald-wrap.is-solved .cald-readout-text { fill: var(--cald-success); }
        .cald-wrap.is-fail .cald-readout-text { fill: var(--cald-danger); }

        /* Cam yansıması — statik, tek ince parlama (hareketli parıltı yok) */
        .cald-glass { fill: rgba(255,255,255,.34); pointer-events: none; }
        body.app-theme-dark .cald-glass { fill: rgba(226,232,240,.06); }

        .cald-status {
            margin-top: 14px; text-align: center; font-size: .86rem; font-weight: 600;
            min-height: 1.2em; white-space: nowrap; color: var(--cald-status);
            transition: color .35s ease;
        }
        .cald-wrap.is-measuring .cald-status { color: var(--cald-accent); }
        .cald-wrap.is-solved .cald-status { color: var(--cald-success); }
        .cald-wrap.is-fail .cald-status { color: var(--cald-danger); }

        @@media (prefers-reduced-motion: reduce) {
            .cald-stage, .cald-arc, .cald-needle, .cald-counterweight,
            .cald-readout-text, .cald-status { transition: none; }
        }

    </style>
</head>
<body class="login-page app-theme-@runtime.ThemeCode"
      data-reset-workspace-tabs="1">
<!-- Tema toggle — sag ust kose -->
<button type="button" id="btnThemeToggle" class="login-theme-toggle" title="Tema değiştir" aria-label="Tema değiştir">
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
</button>
<script>
    (function () {
        var TK = 'calibra_theme';
        var body = document.body;
        var btn  = document.getElementById('btnThemeToggle');
        var themeInput = document.getElementById('loginThemeInput');
        var form = document.getElementById('loginForm');

        // localStorage tercihini hem UI'a hem hidden input'a uygula
        function applyTheme(t) {
            body.classList.remove('app-theme-light', 'app-theme-dark');
            body.classList.add('app-theme-' + t);
            if (themeInput) themeInput.value = t;
            try { localStorage.setItem(TK, t); } catch (e) {}
        }

        var saved = null;
        try { saved = localStorage.getItem(TK); } catch (e) {}
        if (saved === 'dark' || saved === 'light') { applyTheme(saved); }
        else if (themeInput) { themeInput.value = body.classList.contains('app-theme-dark') ? 'dark' : 'light'; }

        function currentTheme() {
            return body.classList.contains('app-theme-dark') ? 'dark' : 'light';
        }
        btn.addEventListener('click', function () {
            applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
        });
    })();
</script>
<div class="login-shell">
    <section class="login-hero" aria-hidden="true">
        @* CalibraHub Software marka görseli. Frame overflow:hidden + img object-fit:cover
           ile panel tamamen kaplanır, sağ-alt sparkle filigranı doğal olarak kırpılır. *@
        <div class="login-hero-frame">
            <img src="~/Document/CalibraHubLoginLogo.png" alt="CalibraHub Software" />
        </div>

    </section>

    <section class="login-panel">
        <div class="login-card">
            <h1>CalibraHub</h1>

            @* Kalibrasyon göstergesi v4 — komparatör (dial indicator) disiplini.
               ÜÇ öğe, hepsi AYNI ölçülen değeri gösterir (rastgele hareket yoktur):
               ana iğne (skala üzerinde), kenar ilerleme yayı, dijital okuma penceresi.
               v3'teki iki dekoratif iç kadran kaldırıldı — ana iğneyle çakışıyor ve
               yayla aynı bilgiyi tekrarlıyorlardı. Skala JS ile üretilir. *@
            <div class="cald-wrap" id="caldDial">
                <div class="cald-stage" id="caldStage" aria-hidden="true">
                    <svg class="cald-svg" viewBox="0 0 200 200">
                        @* Skala: 50 çentik (her 2 bölmede bir), her 5.'si kalın; tam tur = 100 bölme *@
                        <g class="cald-ticks" id="caldTicks"></g>
                        <g class="cald-nums" id="caldNums"></g>

                        @* Kenar ilerleme yayı — iğneyle aynı yüzde, çevresel okuma *@
                        <circle class="cald-arc-bg" cx="100" cy="100" r="94" />
                        <circle class="cald-arc" id="caldArc" cx="100" cy="100" r="94"
                                transform="rotate(-90 100 100)" stroke-dasharray="0 591" />

                        @* Ana iğne — sivrilen bıçak + karşı ağırlık, tek parça döner *@
                        <g id="caldNeedle">
                            <polygon class="cald-needle" points="98.5,103 100,32 101.5,103" />
                            <circle class="cald-counterweight" cx="100" cy="108" r="4.4" />
                        </g>
                        <circle class="cald-hub-ring" cx="100" cy="100" r="6.5" />
                        <circle class="cald-hub" cx="100" cy="100" r="2.6" />

                        @* Okuma penceresi — iğnenin ÜSTÜNDE çizilir ki üzerinden geçtiğinde okunur kalsın *@
                        <rect class="cald-readout-box" x="66" y="130" width="68" height="16" rx="3" ry="3" />
                        <text class="cald-readout-text" id="caldReadout" x="100" y="138.5">0.0 %</text>

                        @* Cam — statik tek parlama (hareketli parıltı yok) *@
                        <path class="cald-glass" d="M100 10 A90 90 0 0 0 26 142 A122 122 0 0 1 100 10 Z" />
                    </svg>
                </div>
                <div class="cald-status" id="caldStatus">Giriş yapmaya hazır</div>
            </div>

            <form asp-action="Login" method="post" autocomplete="off" id="loginForm">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <input type="hidden" name="ThemeCode" id="loginThemeInput" value="" />

                <div class="form-floating login-field mb-3">
                    @* a11y (rapor §6.6): autofocus + required + aria-required + class="cb-field-error" *@
                    <input asp-for="Email" class="form-control" autocomplete="email"
                           placeholder=" " autofocus required aria-required="true" />
                    <label asp-for="Email" class="cb-field-required">@ui.Text("email")</label>
                    <span asp-validation-for="Email" class="cb-field-error"></span>
                </div>

                <div class="form-floating login-field mb-3">
                    <select asp-for="CompanyId" asp-items="Model.CompanyOptions" class="form-select">
                        <option value="">@ui.Text("company_placeholder")</option>
                    </select>
                    <label asp-for="CompanyId">@ui.Text("company")</label>
                    <span asp-validation-for="CompanyId"></span>
                </div>

                <div class="form-floating login-field mb-3">
                    <input asp-for="Password" type="password" class="form-control"
                           autocomplete="current-password" placeholder=" " required aria-required="true" />
                    <label asp-for="Password" class="cb-field-required">@ui.Text("password")</label>
                    <span asp-validation-for="Password" class="cb-field-error"></span>
                </div>

                <div class="login-remember-row mb-3">
                    <label class="login-switch" for="rememberToggle">
                        <input type="checkbox" id="rememberToggle" />
                        <span class="login-switch-track"></span>
                    </label>
                    <span class="login-remember-label">Beni hatırla</span>
                </div>

                <button type="submit" class="btn btn-primary w-100">@ui.Text("submit")</button>

                <div class="text-center mt-3">
                    <a href="@Url.Action("ForgotPassword", "Account")" class="text-muted small"
                       style="text-decoration:none;opacity:.75;transition:opacity .15s"
                       onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='.75'">
                        Şifremi Unuttum
                    </a>
                </div>
            </form>

            @if (ViewBag.ShowSetupLink == true)
            {
                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-2">Sistemde henüz şirket tanımlanmamış.</p>
                    <a href="/Gate" class="btn btn-outline-secondary btn-sm">
                        İlk Kurulumu Yap
                    </a>
                </div>
            }


        </div>
    </section>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    (function () {
        const companyPlaceholderText = @Html.Raw(JsonSerializer.Serialize(ui.Text("company_placeholder")));
        const emailInput = document.getElementById("Email");
        const companySelect = document.getElementById("CompanyId");
        if (!emailInput || !companySelect) {
            return;
        }

        const endpoint = '@Url.Action("CompaniesForUser", "Account")';

        function renderCompanies(items) {
            const currentValue = companySelect.value;
            companySelect.innerHTML = "";

            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = companyPlaceholderText;
            companySelect.appendChild(placeholder);

            let hasCurrent = false;
            items.forEach(function (item) {
                const option = document.createElement("option");
                option.value = item.id;
                option.textContent = item.name;
                if (item.id === currentValue) {
                    option.selected = true;
                    hasCurrent = true;
                }

                companySelect.appendChild(option);
            });

            if (!hasCurrent) {
                companySelect.value = "";
            }
        }

        async function loadCompanies() {
            const email = emailInput.value.trim();
            if (!email) {
                renderCompanies([]);
                return;
            }

            try {
                const response = await fetch(endpoint + "?email=" + encodeURIComponent(email), {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    renderCompanies([]);
                    return;
                }

                const data = await response.json();
                renderCompanies(Array.isArray(data) ? data : []);
            } catch {
                renderCompanies([]);
            }
        }

        emailInput.addEventListener("blur", loadCompanies);
        emailInput.addEventListener("change", loadCompanies);

        if (emailInput.value.trim().length > 0) {
            loadCompanies();
        }

        // Beni hatırla switch
        var rememberToggle = document.getElementById("rememberToggle");
        var rememberLabel = document.querySelector(".login-remember-label");
        var remembered = localStorage.getItem("calibra_login_remember") === "1";

        if (rememberToggle) {
            rememberToggle.checked = remembered;

            // Önceki oturumdan hatırlanan bilgileri yükle
            if (remembered && !emailInput.value) {
                var savedEmail = localStorage.getItem("calibra_login_email");
                var savedCompany = localStorage.getItem("calibra_login_company");
                if (savedEmail) {
                    emailInput.value = savedEmail;
                    loadCompanies().then(function () {
                        if (savedCompany && companySelect) {
                            companySelect.value = savedCompany;
                        }
                    });
                }
            }

            if (rememberLabel) {
                rememberLabel.addEventListener("click", function () {
                    rememberToggle.checked = !rememberToggle.checked;
                });
            }
        }

        var loginForm = emailInput.closest("form");
        if (loginForm) {
            var pwInput = document.getElementById("Password");
            var pwWrap  = pwInput ? pwInput.closest(".login-field") : null;

            loginForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                // Tema hidden input'u güncelle
                var themeInput = document.getElementById("loginThemeInput");
                if (themeInput) themeInput.value = document.body.classList.contains("app-theme-dark") ? "dark" : "light";

                // Beni hatırla
                if (rememberToggle && rememberToggle.checked) {
                    localStorage.setItem("calibra_login_remember", "1");
                    localStorage.setItem("calibra_login_email", emailInput.value.trim());
                    if (companySelect.value) localStorage.setItem("calibra_login_company", companySelect.value);
                } else {
                    localStorage.removeItem("calibra_login_remember");
                    localStorage.removeItem("calibra_login_email");
                    localStorage.removeItem("calibra_login_company");
                }

                // Kilit bulmacası: sunucu doğrulaması başladı
                if (window.CalibraLoginDial) window.CalibraLoginDial.begin();

                // AJAX submit
                try {
                    var resp = await fetch(loginForm.action || window.location.href, {
                        method: "POST",
                        body: new FormData(loginForm),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    var json = await resp.json();

                    if (json.ok) {
                        // Doğru giriş — 3 iğne ortak faza (yukarı) oturup hizalanır (yeşil), sonra login
                        if (window.CalibraLoginDial) window.CalibraLoginDial.success(function () { window.location.href = json.redirect; });
                        else window.location.href = json.redirect;
                        return;
                    }

                    // Giriş başarısız — iğneler hizasız kalır + shake + kırmızı tint (kanonik v3 spec)
                    if (json.error === "locked") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Hesap kilitli');
                        if (pwInput) {
                            pwInput.value = "";
                            pwInput.disabled = true;
                            setTimeout(function () { pwInput.disabled = false; }, 5000);
                        }
                    } else if (json.error === "validation") {
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail('Alanları doldurun');
                    } else {   // credentials
                        var rem = (typeof json.remaining === "number") ? json.remaining : -1;
                        var det = rem > 0 ? ("Şifreniz hatalı, " + rem + " deneme kaldı") : "Şifreniz hatalı";
                        if (window.CalibraLoginDial) window.CalibraLoginDial.fail("Giriş başarısız", det);
                        if (pwInput) { pwInput.value = ""; pwInput.focus(); }
                    }
                } catch {
                    // Network hatası: normal submit
                    loginForm.submit();
                }
            });
        }
    })();
</script>
<script>
    /* ── Kalibrasyon göstergesi v4 (2026-08-15) — sayfadaki TEK animasyon ────────────
       v3'ün rastgelelikleri bilinçli olarak kaldırıldı (spinInnerRandom, scrambleReadout,
       runCalcSequence'ın rastgele birim/değer döngüsü, caldShake, easeOutBack zıplaması).
       Yerine ölçü aleti disiplini: gösterilen HER değer tek bir ölçümden türer.

         ölçüm  = kimlik kalibrasyon yüzdesi
                  · yazarken : şifre uzunluğundan (12 karakter = %92 — tam skalaya
                    KASITLI olarak ulaşmaz; %100 yalnız sunucu onayıyla gelir, böylece
                    doğrulama anında her zaman görünür bir son süpürme olur)
                  · doğrularken/başarıda : %100
                  · hatada : %0 (iğne sıfıra döner, okuma "--- %" ile geçersizlenir)
         iğne   = ölçüm × 3.6°   (tam tur = tam skala, 100 bölme)
         yay    = ölçüm          (kenarda çevresel okuma)
         pencere= ölçüm          (sayılarak oturur; jitter yok)

       Fizik: TEK requestAnimationFrame döngüsünde yay-sönüm entegrasyonu.
         · iğne  ζ≈0.68 → galvanometre gibi tek küçük aşım + oturma
         · yay/pencere ζ≈1 → aşımsız, temiz oturma
       Döngü yalnız hareket varken çalışır; her şey hedefine oturunca durdurulur
       (idle'da 0 CPU — v3'teki sürekli "nefes alan" parlaklık kalktı).

       Çözülme YALNIZ sunucu login onayıyla (window.CalibraLoginDial.success) tetiklenir —
       istemci parola doğrulaması YOKTUR. Bu güvenlik kuralı v3'ten aynen korundu.
       Dışa açık sözleşme değişmedi: begin() / success(done) / fail(label, detail). */
    (function () {
        var wrap = document.getElementById('caldDial');
        var needleG = document.getElementById('caldNeedle');
        var arcEl = document.getElementById('caldArc');
        var readoutEl = document.getElementById('caldReadout');
        var ticksG = document.getElementById('caldTicks');
        var numsG = document.getElementById('caldNums');
        var statusEl = document.getElementById('caldStatus');
        if (!wrap || !needleG || !arcEl || !readoutEl) return;

        var SVGNS = 'http://www.w3.org/2000/svg';
        var ARC_LEN = 2 * Math.PI * 94;      // kenar yayının çevresi (r=94)
        var CHAR_FULL = 12;                  // 12 karakter → yazma tavanı
        var TYPE_CAP = 92;                   // yazarken ulaşılabilen en yüksek yüzde
        var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

        /* ── Skala (statik, bir kez üretilir) ────────────────────────────────────────
           50 çentik = her 2 bölmede bir; her 5.'si kalın (= her 10 bölme);
           rakamlar her 10. çentikte (0/20/40/60/80) — komparatör kadranı düzeni. */
        (function buildScale() {
            var R_OUT = 86, R_MIN = 80, R_MAJ = 74, R_NUM = 63;
            for (var i = 0; i < 50; i++) {
                var isMajor = (i % 5 === 0);
                var rad = (i * 7.2 - 90) * Math.PI / 180;
                var cos = Math.cos(rad), sin = Math.sin(rad);
                var ri = isMajor ? R_MAJ : R_MIN;
                var ln = document.createElementNS(SVGNS, 'line');
                ln.setAttribute('x1', (100 + cos * ri).toFixed(2));
                ln.setAttribute('y1', (100 + sin * ri).toFixed(2));
                ln.setAttribute('x2', (100 + cos * R_OUT).toFixed(2));
                ln.setAttribute('y2', (100 + sin * R_OUT).toFixed(2));
                ln.setAttribute('class', isMajor ? 'cald-tick maj' : 'cald-tick');
                ticksG.appendChild(ln);
                if (i % 10 === 0) {
                    var tx = document.createElementNS(SVGNS, 'text');
                    tx.setAttribute('class', 'cald-num');
                    tx.setAttribute('x', (100 + cos * R_NUM).toFixed(2));
                    tx.setAttribute('y', (100 + sin * R_NUM).toFixed(2));
                    tx.textContent = String(i * 2);
                    numsG.appendChild(tx);
                }
            }
        })();

        /* ── Yay-sönüm entegratörü ───────────────────────────────────────────────────
           a = (hedef - x)·k - v·c   →   ζ = c / (2√k)
           k/c seçimi: iğne hafif aşımlı (canlı ama ölçülü), yay ve okuma aşımsız. */
        function makeSpring(k, c, eps) { return { x: 0, v: 0, target: 0, k: k, c: c, eps: eps }; }
        function stepSpring(s, dt) {
            if (s.x === s.target && s.v === 0) return false;
            s.v += ((s.target - s.x) * s.k - s.v * s.c) * dt;
            s.x += s.v * dt;
            if (Math.abs(s.target - s.x) < s.eps && Math.abs(s.v) < s.eps * 6) {
                s.x = s.target; s.v = 0; return false;
            }
            return true;
        }
        // Katsayılar ölçülerek seçildi (60 fps entegrasyon, hedefe oturma süresi + aşım):
        //   iğne    ζ0.68 → tam süpürmede ~9° sıçrama, tuş başına ~0.8° (fark edilmez), 667 ms
        //   yay     ζ1.01 → aşımsız, 783 ms
        //   pencere ζ1.02 → aşımsız sayarak oturur, 883 ms
        var sNeedle = makeSpring(300, 23.5, 0.08);      // derece
        var sArc = makeSpring(250, 32, 0.001);          // 0..1
        var sReadout = makeSpring(230, 31, 0.05);       // 0..100

        var readoutOverride = null;   // geçersiz ölçümde ("--- %") sayısal okumayı bastırır
        var onSettle = null;          // hareket bittiğinde bir kez çalışır
        var rafId = 0, lastTs = 0;

        function render() {
            needleG.setAttribute('transform', 'rotate(' + sNeedle.x.toFixed(2) + ' 100 100)');
            var frac = Math.max(0, Math.min(1, sArc.x));
            arcEl.setAttribute('stroke-dasharray', (ARC_LEN * frac).toFixed(2) + ' ' + ARC_LEN.toFixed(2));
            readoutEl.textContent = readoutOverride !== null
                ? readoutOverride
                : (sReadout.x.toFixed(1) + ' %');
        }
        function fireSettle() {
            if (!onSettle) return;
            var fn = onSettle; onSettle = null; fn();
        }
        function frame(ts) {
            // Sekme arkaplandayken biriken dev dt yayı patlatır → 1/30 s'ye kırp.
            var dt = lastTs ? Math.min((ts - lastTs) / 1000, 1 / 30) : 1 / 60;
            lastTs = ts;
            var moving = false;
            if (stepSpring(sNeedle, dt)) moving = true;
            if (stepSpring(sArc, dt)) moving = true;
            if (stepSpring(sReadout, dt)) moving = true;
            render();
            if (moving) { rafId = requestAnimationFrame(frame); return; }
            rafId = 0; lastTs = 0; fireSettle();
        }
        function kick() {
            if (reduceMotion) {
                sNeedle.x = sNeedle.target; sNeedle.v = 0;
                sArc.x = sArc.target; sArc.v = 0;
                sReadout.x = sReadout.target; sReadout.v = 0;
                render(); fireSettle(); return;
            }
            if (!rafId) { lastTs = 0; rafId = requestAnimationFrame(frame); }
        }

        /* Tek giriş noktası: üç göstergenin hedefi de aynı ölçümden gelir. */
        function setMeasurement(pct) {
            pct = Math.max(0, Math.min(100, pct));
            sNeedle.target = pct * 3.6;
            sArc.target = pct / 100;
            sReadout.target = pct;
            kick();
        }
        function setMode(mode) {
            wrap.classList.remove('is-measuring', 'is-solved', 'is-fail');
            if (mode) wrap.classList.add('is-' + mode);
        }
        function setStatus(text, detail) {
            if (!statusEl) return;
            statusEl.textContent = text;
            if (detail) statusEl.title = detail; else statusEl.removeAttribute('title');
        }

        /* ── Şifre girişi kadranı sürer (doğrulama başlayınca kilitlenir) ──────────── */
        var locked = false;
        var pwdInput = document.querySelector('.cb-form input[type="password"]')
                    || document.querySelector('input[type="password"]');
        function onPasswordInput() {
            if (locked) return;
            var n = pwdInput ? pwdInput.value.length : 0;
            readoutOverride = null;
            setMode(n > 0 ? 'measuring' : null);
            setStatus(n > 0 ? 'Kimlik ölçülüyor' : 'Giriş yapmaya hazır');
            setMeasurement(Math.min(TYPE_CAP, (n / CHAR_FULL) * TYPE_CAP));
        }
        if (pwdInput) pwdInput.addEventListener('input', onPasswordInput);

        render();

        window.CalibraLoginDial = {
            /* Sunucuya istek gitti — iğne tam skalaya süpürülür. */
            begin: function () {
                locked = true;
                onSettle = null;
                readoutOverride = null;
                setMode('measuring');
                setStatus('Doğrulanıyor');
                setMeasurement(100);
            },
            /* Sunucu onayladı — tam skalada yeşile oturur, oturunca done() çağrılır. */
            success: function (done) {
                locked = true;
                readoutOverride = null;
                setMode('solved');
                setStatus('Kalibrasyon tamam');
                onSettle = function () {
                    if (typeof done === 'function') setTimeout(done, 320);
                };
                // kick() hareket olmasa bile bir kare çalıştırır → onSettle her hâlükârda gelir.
                setMeasurement(100);
            },
            /* Sunucu reddetti — ölçüm geçersiz: iğne sıfıra döner, okuma bastırılır. */
            fail: function (label, detail) {
                locked = false;
                onSettle = null;
                readoutOverride = '--- %';
                setMode('fail');
                setStatus(label || 'Giriş başarısız', detail);
                setMeasurement(0);
            }
        };

        // Sunucu tarafı (non-AJAX) doğrulama hatasıyla dönüldüyse kadranı hata durumuna al.
        var serverHadError = @(ViewData.ModelState.IsValid ? "false" : "true");
        if (serverHadError) window.CalibraLoginDial.fail('Giriş başarısız');
    })();
</script>
</body>
</html>

