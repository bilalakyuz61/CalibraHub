@using System.Text.Json
@model CalibraHub.Web.Models.Account.LoginInputModel
@inject CalibraHub.Web.Infrastructure.Ui.IUiTextService UiText
@{
    Layout = null;
    var runtime = await UiText.GetRuntimeAsync();
    var ui = await UiText.GetFormAsync("account.login");
}
<!DOCTYPE html>
<html lang="@runtime.LanguageCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ui.Text("title") - CalibraHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ── Login sayfasi tema toggle butonu (sag ust) ─────────────── */
        .login-theme-toggle {
            position: fixed; top: 16px; right: 18px; z-index: 1050;
            width: 38px; height: 38px;
            border: 1px solid rgba(148, 163, 184, 0.32);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.85);
            color: #475569;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            transition: background-color .18s, color .18s, border-color .18s, transform .18s;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .login-theme-toggle:hover { transform: scale(1.08); background: rgba(241, 245, 249, 0.95); }
        .login-theme-toggle .icon-sun  { display: none;  }
        .login-theme-toggle .icon-moon { display: block; }
        body.app-theme-dark .login-theme-toggle {
            background: rgba(15, 23, 42, 0.72);
            border-color: rgba(148, 163, 184, 0.30);
            color: #e2e8f0;
        }
        body.app-theme-dark .login-theme-toggle:hover { background: rgba(30, 41, 59, 0.95); }
        body.app-theme-dark .login-theme-toggle .icon-sun  { display: block; }
        body.app-theme-dark .login-theme-toggle .icon-moon { display: none;  }

        /* ── Dark tema overrides — login sayfasi icin ───────────────── */
        body.app-theme-dark.login-page {
            background: #0a0d17 !important;
        }
        body.app-theme-dark .login-panel {
            background: linear-gradient(145deg, #0f172a, #0a0d17) !important;
        }
        body.app-theme-dark .login-hero {
            background: #0a0d17;
        }
        body.app-theme-dark .login-hero img {
            filter: saturate(1.05) brightness(0.92);
        }
        body.app-theme-dark .login-card {
            background: rgba(15, 23, 42, 0.88) !important;
            border: 1px solid rgba(148, 163, 184, 0.14) !important;
            box-shadow: 0 18px 48px rgba(0, 0, 0, 0.55) !important;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            color: #e2e8f0 !important;
        }
        body.app-theme-dark .login-card h1 { color: #f1f5f9 !important; }
        body.app-theme-dark .login-card .form-label,
        body.app-theme-dark .login-card label,
        body.app-theme-dark .login-field > label {
            color: #94a3b8 !important;
        }
        body.app-theme-dark .login-card .form-control,
        body.app-theme-dark .login-card .form-select,
        body.app-theme-dark .login-field .form-control,
        body.app-theme-dark .login-field .form-select {
            background-color: rgba(30, 41, 59, 0.65) !important;
            border-color: rgba(148, 163, 184, 0.22) !important;
            color: #e2e8f0 !important;
        }
        body.app-theme-dark .login-card .form-control:focus,
        body.app-theme-dark .login-card .form-select:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18) !important;
        }
        body.app-theme-dark .login-card .form-select option {
            background: #0c0f1a; color: #e2e8f0;
        }
        body.app-theme-dark .login-card .btn-primary {
            background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
            border: none !important;
        }
        body.app-theme-dark .login-remember-label { color: #cbd5e1 !important; }
        body.app-theme-dark .login-card .text-muted { color: #94a3b8 !important; }
        body.app-theme-dark .login-card .border-top { border-color: rgba(148, 163, 184, 0.18) !important; }

        .login-error-msg {
            min-height: 46px;
            margin-bottom: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: .875rem;
            font-weight: 500;
            background: rgba(239,68,68,.10);
            border: 1px solid rgba(239,68,68,.35);
            color: #dc2626;
            display: flex;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s;
        }
        .login-error-msg.is-visible {
            opacity: 1;
            pointer-events: auto;
        }
        body.app-theme-dark .login-error-msg {
            background: rgba(239,68,68,.14);
            border-color: rgba(248,113,113,.35);
            color: #f87171;
        }

        @@keyframes loginShake {
            0%, 100% { transform: translateX(0); }
            15%  { transform: translateX(-7px); }
            30%  { transform: translateX(7px); }
            45%  { transform: translateX(-5px); }
            60%  { transform: translateX(5px); }
            75%  { transform: translateX(-2px); }
        }
        .login-pw-error .form-control {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 3px rgba(239,68,68,.18) !important;
        }
        body.app-theme-dark .login-pw-error .form-control {
            border-color: #f87171 !important;
            box-shadow: 0 0 0 3px rgba(248,113,113,.18) !important;
        }
        .login-pw-shake {
            animation: loginShake .42s cubic-bezier(.36,.07,.19,.97) both;
        }

        /* ── Kimlik kalibrasyon kadranı v3 — 3 iğneli (yelkovan) analog gösterge ──
           Harf-bulmacalı kilit kadranı (v2) yerine dönüldü: merkezden çıkan 3 iğne
           (indigo #6366f1 / cyan #06b6d4 / violet #8b5cf6), farklı uzunluk + kalınlıkta
           (n1 en uzun/kalın = "ana" şifre iğnesi, n3 en kısa/ince). İdle'da üç iğne 12
           çentikli (30°'lik) kadranda birbirinden 120° ayrık, SABİT dinlenme açılarındadır
           (çok ince bir "nabız" dışında hareket YOK). Şifre her karakterinde SADECE bir
           iğne bir çentik ilerler — round-robin (n. tuş → n%3. iğne), sonra oturur; TÜM
           iğneler DEĞİL, SÜREKLİ DEĞİL (2026-07-16 kullanıcı geri bildirimi: "tüm
           yelkovanlar sürekli hareket ediyor" şikayeti — bir daha tekrarlanmaz, bkz.
           sayfa sonundaki script yorumu). Çözülme YALNIZ sunucu login onayında
           (server-truth) tetiklenir — client parola doğrulamaz. Glass-stage mimarisi +
           is-solved/is-fail durum CSS'i v2'den bilinçli olarak korundu; mobil (Compose
           Canvas) ile birebir aynı kanonik tasarım/renk paleti.

           Görsel zenginleştirme eki (2026-07-17, kullanıcı "çok sade" geri bildirimi —
           SOLVE MANTIĞI DEĞİŞMEDİ, yalnız çizim/animasyon): (a) ana kadranın içine 2
           eş-merkezli İÇ KADRAN eklendi — r=60/8-çentik cyan + r=34/6-çentik violet,
           salt dekoratif katman (bkz. .cald-inner-* kuralları + script buildInnerTicks/
           spinInnerRandom). (b) büyük iğnelerin tuş-başı 30°'lik hareketi artık tek parça
           glide değil, N=4 mini-adımlı "dura-dura" (detent/stepped) hareket — bkz. script
           animateNeedleStepped. (c) iç kadranlar her tuş vuruşunda büyük iğnelerin
           hedefli/round-robin hareketinden BAĞIMSIZ, rastgele yön+açı ile döner — bkz.
           script spinInnerRandom. */
        .cald-wrap {
            width: 148px; margin: 2px auto 20px; position: relative;
            color-scheme: light;
            --cald-glass-a: rgba(255,255,255,.95);
            --cald-glass-b: rgba(148,163,184,.18);
            --cald-ring: rgba(148,163,184,.30);
            --cald-n1: #6366f1;   /* indigo — ana (şifre) iğnesi, en uzun/kalın */
            --cald-n2: #06b6d4;   /* cyan   — ikincil iğne */
            --cald-n3: #8b5cf6;   /* violet — üçüncül iğne */
            --cald-tick: rgba(100,116,139,.45);
            --cald-tick-major: rgba(71,85,105,.65);
            --cald-inner1: rgba(6,182,212,.42);        /* iç kadran 1 (r=60) çentik rengi — cyan ton */
            --cald-inner1-mark: rgba(6,182,212,.95);   /* iç kadran 1 işaret noktası */
            --cald-inner2: rgba(139,92,246,.40);       /* iç kadran 2 (r=34) çentik rengi — violet ton */
            --cald-inner2-mark: rgba(139,92,246,.95);  /* iç kadran 2 işaret noktası */
            --cald-hub: #6366f1;
            --cald-success: #059669;
            --cald-danger: #e11d48;
            --cald-status: #64748b;
        }
        body.app-theme-dark .cald-wrap {
            color-scheme: dark;
            --cald-glass-a: rgba(148,163,184,.16);
            --cald-glass-b: rgba(2,6,23,.35);
            --cald-ring: rgba(148,163,184,.22);
            --cald-n1: #818cf8;
            --cald-n2: #22d3ee;
            --cald-n3: #a78bfa;
            --cald-tick: rgba(148,163,184,.4);
            --cald-tick-major: rgba(203,213,225,.55);
            --cald-inner1: rgba(34,211,238,.42);
            --cald-inner1-mark: rgba(34,211,238,.95);
            --cald-inner2: rgba(167,139,250,.40);
            --cald-inner2-mark: rgba(167,139,250,.95);
            --cald-hub: #818cf8;
            --cald-success: #34d399;
            --cald-danger: #fb7185;
            --cald-status: #94a3b8;
        }
        .cald-stage {
            position: relative; width: 148px; height: 148px; margin: 0 auto; border-radius: 50%; overflow: hidden;
            background:
                radial-gradient(118% 118% at 30% 22%, var(--cald-glass-a), rgba(226,232,240,.06) 56%, var(--cald-glass-b) 100%),
                radial-gradient(90% 90% at 50% 128%, rgba(99,102,241,.14), transparent 62%);
            box-shadow:
                inset 0 2px 6px rgba(255,255,255,.9),
                inset 0 -12px 24px rgba(79,70,229,.12),
                inset 0 0 0 1px var(--cald-ring),
                0 14px 28px -12px rgba(30,41,59,.36),
                0 4px 12px -6px rgba(99,102,241,.3);
            transition: box-shadow .5s ease;
            animation: caldIdleBreathe 4.4s ease-in-out infinite;
        }
        body.app-theme-dark .cald-stage {
            box-shadow:
                inset 0 2px 6px rgba(226,232,240,.24),
                inset 0 -12px 26px rgba(2,6,23,.58),
                inset 0 0 0 1px var(--cald-ring),
                0 18px 34px -14px rgba(0,0,0,.66),
                0 4px 14px -6px rgba(139,92,246,.36);
        }
        .cald-wrap.is-solved .cald-stage {
            box-shadow:
                inset 0 2px 6px rgba(255,255,255,.9), inset 0 -12px 24px rgba(16,185,129,.16),
                inset 0 0 0 1px rgba(52,211,153,.5),
                0 14px 28px -12px rgba(30,41,59,.36), 0 0 0 4px rgba(52,211,153,.16), 0 0 22px rgba(52,211,153,.42);
        }
        body.app-theme-dark .cald-wrap.is-solved .cald-stage {
            box-shadow:
                inset 0 2px 6px rgba(226,232,240,.24), inset 0 -12px 26px rgba(2,6,23,.58),
                inset 0 0 0 1px rgba(52,211,153,.5),
                0 18px 34px -14px rgba(0,0,0,.66), 0 0 0 4px rgba(16,185,129,.2), 0 0 24px rgba(16,185,129,.5);
        }
        .cald-wrap.is-fail .cald-stage {
            box-shadow:
                inset 0 2px 6px rgba(255,255,255,.9), inset 0 -12px 24px rgba(244,63,94,.16),
                inset 0 0 0 1px rgba(251,113,133,.5),
                0 14px 28px -12px rgba(30,41,59,.36), 0 0 0 4px rgba(251,113,133,.16), 0 0 22px rgba(244,63,94,.42);
        }
        body.app-theme-dark .cald-wrap.is-fail .cald-stage {
            box-shadow:
                inset 0 2px 6px rgba(226,232,240,.24), inset 0 -12px 26px rgba(2,6,23,.58),
                inset 0 0 0 1px rgba(251,113,133,.5),
                0 18px 34px -14px rgba(0,0,0,.66), 0 0 0 4px rgba(244,63,94,.2), 0 0 24px rgba(244,63,94,.5);
        }
        .cald-wrap.is-solved .cald-stage,
        .cald-wrap.is-fail .cald-stage { animation: none; }
        .cald-wrap.is-measuring .cald-stage { animation: caldPulse 1.1s ease-in-out infinite; }
        .cald-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; display: block; }
        .cald-track { fill: none; stroke: var(--cald-ring); stroke-width: 1.4; }
        /* Çentik (tick) halkası — 12 çentik / 30°'lik adım; her 3.'sü (0/90/180/270,
           kadranın kuzey/doğu/güney/batısı) belirgin (maj) çizilir. */
        .cald-tick { stroke: var(--cald-tick); stroke-width: 1.4; }
        .cald-tick.maj { stroke: var(--cald-tick-major); stroke-width: 2.2; }
        /* İç kadranlar (2 adet, iç içe: r=60 cyan + r=34 violet) — büyük iğnelerden
           bağımsız, her tuş vuruşunda rastgele yön/açıyla dönen dekoratif katman (bkz.
           script spinInnerRandom). Sınır halkası ince/sabit görünür; asıl "dönüyor"
           hissini rotasyona giren çentik grubu + işaret noktası verir. */
        .cald-inner-track { fill: none; stroke: var(--cald-ring); stroke-width: 1; opacity: .65; }
        .cald-inner-grp { transition: none; }
        .cald-inner-tick { stroke-linecap: round; stroke-width: 1.15; }
        .cald-inner-tick.i1 { stroke: var(--cald-inner1); }
        .cald-inner-tick.i2 { stroke: var(--cald-inner2); stroke-width: 1.05; }
        .cald-inner-mark-1 { fill: var(--cald-inner1-mark); filter: drop-shadow(0 0 2px var(--cald-inner1-mark)); }
        .cald-inner-mark-2 { fill: var(--cald-inner2-mark); filter: drop-shadow(0 0 1.6px var(--cald-inner2-mark)); }
        /* 3 iğne — hub'dan (merkez) çıkar, farklı uzunluk/kalınlık/renkte (saat ibresi
           hiyerarşisi: n1 en uzun+kalın=ana/şifre iğnesi, n3 en kısa+ince). Açı doğrudan
           <g> sarmalayıcısının SVG rotate() transform'uyla sürülür (bkz. script placeNeedle). */
        .cald-needle-grp { transition: filter .3s ease; }
        .cald-needle {
            stroke-linecap: round;
            transition: stroke .3s ease, filter .3s ease, opacity .3s ease;
        }
        .cald-needle.n1 { stroke: var(--cald-n1); stroke-width: 3.2; filter: drop-shadow(0 0 2.5px rgba(99,102,241,.45)); }
        .cald-needle.n2 { stroke: var(--cald-n2); stroke-width: 2.4; }
        .cald-needle.n3 { stroke: var(--cald-n3); stroke-width: 1.9; opacity: .92; }
        .cald-tail { fill: var(--cald-n1); transition: fill .3s ease; }
        .cald-wrap.is-solved .cald-needle,
        .cald-wrap.is-solved .cald-tail {
            stroke: var(--cald-success) !important; fill: var(--cald-success) !important;
            opacity: 1; filter: drop-shadow(0 0 3px rgba(16,185,129,.5));
        }
        .cald-wrap.is-fail .cald-needle,
        .cald-wrap.is-fail .cald-tail {
            stroke: var(--cald-danger) !important; fill: var(--cald-danger) !important;
            filter: drop-shadow(0 0 3px rgba(244,63,94,.45));
        }
        .cald-hub-ring { fill: none; stroke: var(--cald-ring); stroke-width: 1.6; }
        .cald-hub { fill: var(--cald-hub); transition: fill .3s ease; }
        .cald-wrap.is-solved .cald-hub { fill: var(--cald-success); }
        .cald-wrap.is-fail .cald-hub { fill: var(--cald-danger); }
        /* 2026-07-23 kullanıcı geri bildirimi: kadran içinde beliren onay tiki (.cald-check
           path'i) yelkovanlarla üst üste binip kötü görünüyordu — kaldırıldı. Başarı hissi
           kadranın kalan öğeleriyle veriliyor: iğneler+hub yeşile döner (yukarıdaki
           .cald-wrap.is-solved kuralları), stage glow'u (.cald-wrap.is-solved .cald-stage,
           bkz. yukarı) ve durum metni rengi (.cald-wrap.is-solved .cald-status, aşağıda). */
        .cald-status {
            margin-top: 16px; text-align: center; font-size: .86rem; font-weight: 600;
            min-height: 1.2em; white-space: nowrap; color: var(--cald-status); transition: color .3s;
        }
        .cald-wrap.is-measuring .cald-status { color: var(--cald-n1); }
        .cald-wrap.is-solved .cald-status { color: var(--cald-success); }
        .cald-wrap.is-fail .cald-status { color: var(--cald-danger); }
        @@keyframes caldIdleBreathe { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(1.035); } }
        @@keyframes caldPulse { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(1.14); } }
        @@keyframes caldShake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(6px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(3px)} }
        .cald-wrap.cald-shake .cald-stage { animation: caldShake .5s ease; }

        /* ── Kalibrasyon okuma katmanı — "havalı mühendislik hesabı" hissi (2026-08-03) ──
           SOLVE MANTIĞI DEĞİŞMEDİ (round-robin iğne + server-truth çözülme aynen geçerli).
           Yalnız dekoratif iki katman: (a) dış kadranda 4 ana çentikte BASILI ölçek rakamları
           (.cald-scale-num) — idle'da çok soluk, şifre girişinde/doğrulamada belirginleşir
           (iğnelerin "gösterdiği" skala hissi). (b) alt-orta dijital okuma penceresi
           (.cald-readout*) — monospace, her tuşta hesaplanıp oturan ölçüm değeri; doğrulama
           fazında kanal-kanal hızlı hesap sekansı. Kullanıcının 2026-07-16 "iğneler sürekli
           hareket etmesin" geri bildirimine dokunulmaz — bu katman sayısal, iğne değil. */
        .cald-scale-num {
            fill: var(--cald-status);
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 11px; font-weight: 600;
            text-anchor: middle; dominant-baseline: middle;
            opacity: .22; transition: opacity .35s ease, fill .3s ease;
        }
        .cald-wrap.is-typing .cald-scale-num { opacity: .60; }
        .cald-wrap.is-measuring .cald-scale-num { opacity: .78; }
        .cald-wrap.is-solved .cald-scale-num { fill: var(--cald-success); opacity: .55; }
        .cald-wrap.is-fail .cald-scale-num { fill: var(--cald-danger); opacity: .55; }

        .cald-readout-box {
            fill: var(--cald-glass-b); stroke: var(--cald-ring); stroke-width: 1;
            opacity: 0; transition: opacity .35s ease;
        }
        .cald-readout-text {
            fill: var(--cald-n1);
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 11px; font-weight: 600; letter-spacing: .2px;
            text-anchor: middle; dominant-baseline: middle;
            opacity: 0; transition: opacity .35s ease, fill .3s ease;
        }
        .cald-wrap.is-typing .cald-readout-box,
        .cald-wrap.is-measuring .cald-readout-box,
        .cald-wrap.is-solved .cald-readout-box,
        .cald-wrap.is-fail .cald-readout-box { opacity: .92; }
        .cald-wrap.is-typing .cald-readout-text,
        .cald-wrap.is-measuring .cald-readout-text,
        .cald-wrap.is-solved .cald-readout-text,
        .cald-wrap.is-fail .cald-readout-text { opacity: 1; }
        .cald-wrap.is-measuring .cald-readout-text { fill: var(--cald-n2); }
        .cald-wrap.is-solved .cald-readout-text { fill: var(--cald-success); }
        .cald-wrap.is-fail .cald-readout-text { fill: var(--cald-danger); }

        @@media (prefers-reduced-motion: reduce) {
            .cald-needle, .cald-stage { transition: none; }
            .cald-stage,
            .cald-wrap.is-measuring .cald-stage { animation: none; }
            .cald-wrap.cald-shake .cald-stage { animation: none; }
        }

        /* ── Sol hero: canlı kalibrasyon düzeneği (komparatör + salgı ölçümü) ──────
           Hero görseli her iki temada da koyu (#0a0d17 zemin) olduğundan düzenek
           doğrudan koyu zemine göre renklendirilir — body tema sınıfından bağımsız.
           .login-hero-blur: arka plan görselinin SOL bölgesini backdrop-filter ile
           flulaştırır + hafif koyulaştırır (maske sağa doğru şeffaflaşır, logo net
           kalır). .login-rig: düzeneği panelin SOL kısmına yaslar. Tüm hareket
           sayfa sonundaki rig script'inden (tek rAF) sürülür — CSS keyframe yok. */
        .login-hero-blur {
            position: absolute; inset: 0;
            /* 2026-08-05 kullanıcı geri bildirimi: "CALIBRAHUB"un C'si flu bölgede
               kalıyordu — blur şeridi 62%→52%'ye daraltıldı, maske daha erken söner,
               koyulaştırma hafifletildi → marka yazısı tamamen net bölgede. */
            width: 52%;
            backdrop-filter: blur(14px) brightness(.78) saturate(1.05);
            -webkit-backdrop-filter: blur(14px) brightness(.78) saturate(1.05);
            background: linear-gradient(90deg, rgba(7,10,20,.40), rgba(7,10,20,.14) 62%, transparent);
            -webkit-mask-image: linear-gradient(90deg, #000 48%, transparent);
            mask-image: linear-gradient(90deg, #000 48%, transparent);
            pointer-events: none;
            z-index: 1;
        }
        .login-rig {
            position: absolute;
            left: clamp(16px, 4%, 56px);
            top: 50%;
            transform: translateY(-50%);
            width: min(464px, 50%);
            z-index: 2;
            display: flex; align-items: center; gap: 10px;
            /* Kap pointer-events:none kalır (login formunu asla engellemesin);
               yalnız etkileşimli öğeler (cihaz rayı + hit alanları + hız barı) auto ile açılır. */
            pointer-events: none;
            filter: drop-shadow(0 22px 40px rgba(2, 6, 23, .55));
        }
        .rig-main { flex: 1; min-width: 0; }
        .login-rig-svg { display: block; width: 100%; height: auto; }
        .rig-scene { display: none; }
        .rig-scene.is-active { display: block; }

        /* ── Cihaz seçici ray (sol) — üç kalibrasyon düzeneği arasında geçiş ── */
        .rig-devices {
            display: flex; flex-direction: column; gap: 8px;
            flex-shrink: 0;
            pointer-events: auto;
        }
        .rig-dev-btn {
            width: 60px; padding: 8px 4px 6px;
            border-radius: 12px;
            background: rgba(15, 23, 42, .62);
            border: 1px solid rgba(148, 163, 184, .3);
            color: #94a3b8;
            cursor: pointer;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
            transition: border-color .18s, color .18s, background-color .18s, transform .18s, box-shadow .18s;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .rig-dev-btn svg { width: 22px; height: 22px; }
        .rig-dev-btn span {
            font-size: .58rem; font-weight: 600; letter-spacing: .2px;
            line-height: 1.1; text-align: center;
        }
        .rig-dev-btn:hover { color: #e2e8f0; transform: translateX(2px); }
        .rig-dev-btn.is-active {
            color: #e0e7ff;
            border-color: rgba(99, 102, 241, .65);
            background: rgba(49, 46, 129, .45);
            box-shadow: 0 0 12px rgba(99, 102, 241, .35);
        }

        /* Mikrometre sahnesine özgü çentik stilleri */
        .rig-mik-thticks line { stroke: rgba(15, 23, 42, .45); stroke-width: 1.4; }
        .rig-mik-sltick { stroke: #1e293b; stroke-width: 1; }
        .rig-mik-slnum {
            fill: #1e293b; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 6px; font-weight: 600; text-anchor: middle;
        }
        .rig-mik-thnum {
            fill: rgba(15, 23, 42, .62); font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 6.5px; font-weight: 600;
        }

        /* Ortak: ekipman etiketleri, LCD, HUD alt notu */
        .rig-tag {
            fill: rgba(148, 163, 184, .7); font-size: 8px; font-weight: 600;
            text-anchor: middle; letter-spacing: .3px;
        }
        .rig-lcd {
            fill: #7dd3fc; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 18px; font-weight: 700; text-anchor: end; letter-spacing: .5px;
        }
        .rig-lcd-unit {
            fill: rgba(125, 211, 252, .62); font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 7px; font-weight: 600;
        }
        .rig-hud-note { fill: rgba(148, 163, 184, .6); font-size: 8px; font-weight: 500; }
        .rig-hud-note.ok  { fill: #34d399; }
        .rig-hud-note.bad { fill: #fbbf24; }

        /* Mikrometre: tolerans barı + geçmiş noktalar */
        .rig-tol-track  { fill: rgba(148, 163, 184, .18); }
        .rig-tol-zone   { fill: rgba(16, 185, 129, .28); }
        .rig-tol-center { stroke: rgba(226, 232, 240, .45); stroke-width: 1; }
        .rig-tol-mark   { fill: #22d3ee; }
        .rig-tol-dot    { fill: rgba(165, 180, 252, .5); }

        /* Manometre: kalibrasyon nokta işaretleri, sürüklenen (max) ibre, hata grafiği */
        .rig-calmark { fill: rgba(99, 102, 241, .4); transition: fill .25s; }
        .rig-calmark.is-active { fill: #e11d48; }
        .rig-drag-needle { stroke: #334155; stroke-width: 1.5; stroke-linecap: round; opacity: .5; }
        .rig-ref-needle  { stroke: #6366f1; stroke-width: 1.8; stroke-linecap: round; }
        .rig-err-slot { fill: rgba(148, 163, 184, .07); }
        .rig-err-slot.is-active { fill: rgba(99, 102, 241, .2); }
        .rig-err-zero { stroke: rgba(148, 163, 184, .32); stroke-width: 1; stroke-dasharray: 2 2; }
        .rig-errbar { fill: #34d399; }
        .rig-errbar.warn { fill: #fbbf24; }

        /* ── Etkileşim: parçayı fareyle çevirme + devir barı ── */
        .rig-part-hit { pointer-events: auto; cursor: grab; }
        .rig-part-hit:active { cursor: grabbing; }
        .login-rig-controls {
            margin-top: 10px;
            display: flex; align-items: center; gap: 10px;
            padding: 8px 14px; border-radius: 10px;
            background: rgba(15, 23, 42, .62);
            border: 1px solid rgba(148, 163, 184, .3);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            pointer-events: auto;
        }
        .rig-ctl-label {
            color: #94a3b8; font-size: .72rem; font-weight: 600; letter-spacing: .4px;
            flex-shrink: 0;
        }
        .rig-ctl-value {
            color: #7dd3fc; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: .74rem; font-weight: 600; min-width: 66px; text-align: right;
            flex-shrink: 0;
        }
        #rigSpeed {
            flex: 1; min-width: 0;
            -webkit-appearance: none; appearance: none;
            height: 4px; border-radius: 2px;
            background: linear-gradient(90deg, #6366f1, #22d3ee);
            outline: none; cursor: pointer;
        }
        #rigSpeed::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none;
            width: 14px; height: 14px; border-radius: 50%;
            background: #e2e8f0; border: 2px solid #6366f1;
            box-shadow: 0 0 6px rgba(99, 102, 241, .6);
            cursor: grab;
        }
        #rigSpeed::-webkit-slider-thumb:active { cursor: grabbing; }
        #rigSpeed::-moz-range-thumb {
            width: 14px; height: 14px; border-radius: 50%;
            background: #e2e8f0; border: 2px solid #6366f1;
            box-shadow: 0 0 6px rgba(99, 102, 241, .6);
            cursor: grab;
        }
        .rig-ctl-hint {
            margin-top: 6px; text-align: center;
            color: rgba(148, 163, 184, .65);
            font-size: .68rem; letter-spacing: .3px;
        }

        .rig-badge rect {
            fill: rgba(15, 23, 42, .62); stroke: rgba(148, 163, 184, .3); stroke-width: 1;
        }
        .rig-badge-dot { fill: #34d399; animation: rigBlink 1.6s ease-in-out infinite; }
        .rig-badge-text {
            fill: #e2e8f0; font-size: 12.5px; font-weight: 600;
            letter-spacing: .3px; dominant-baseline: middle;
        }
        .rig-caption {
            fill: rgba(148, 163, 184, .85); font-size: 10.5px; font-weight: 500; letter-spacing: .4px;
        }
        .rig-vblock { fill: #1d2940; stroke: rgba(148, 163, 184, .25); stroke-width: 1; }
        .rig-col-tick { stroke: rgba(15, 23, 42, .5); stroke-width: 1; }
        .rig-col-tick.maj { stroke-width: 1.6; }
        .rig-part-notch { stroke: rgba(15, 23, 42, .4); stroke-width: 1.6; stroke-linecap: round; }
        .rig-dial-tick { stroke: #64748b; stroke-width: 1; }
        .rig-dial-tick.maj { stroke: #334155; stroke-width: 1.8; }
        .rig-dial-num {
            fill: #334155; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 8.5px; font-weight: 600; text-anchor: middle; dominant-baseline: middle;
        }
        .rig-face-brand {
            fill: #64748b; font-size: 8px; font-weight: 700; letter-spacing: 2px; text-anchor: middle;
        }
        .rig-face-unit {
            fill: #94a3b8; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 7.5px; font-weight: 600; text-anchor: middle;
        }
        /* Tolerans yayları: alt %80 yeşil (uygun), üstteki dar dilim amber (tolerans dışı) */
        .rig-tol-ok  { fill: none; stroke: rgba(16, 185, 129, .3);  stroke-width: 4; }
        .rig-tol-out { fill: none; stroke: rgba(245, 158, 11, .38); stroke-width: 4; }
        .rig-needle { stroke: #e11d48; stroke-width: 2.4; stroke-linecap: round; }
        .rig-needle-tail { fill: #e11d48; }
        .rig-counter-needle { stroke: #6366f1; stroke-width: 1.6; stroke-linecap: round; }
        .rig-counter-tick { stroke: #94a3b8; stroke-width: 1; }
        .rig-glass { fill: rgba(255, 255, 255, .3); }
        /* Yalnız DOĞRUDAN çocuklar: panel çerçevesi + ayraç çizgileri. İç gruplardaki
           (tolerans barı, hata grafiği) rect/line'lar bu kurallardan etkilenmemeli. */
        .rig-hud > rect {
            fill: rgba(10, 15, 28, .78); stroke: rgba(99, 102, 241, .3); stroke-width: 1;
        }
        .rig-hud > line { stroke: rgba(148, 163, 184, .18); stroke-width: 1; }
        .rig-hud-label {
            fill: rgba(148, 163, 184, .8); font-size: 9.5px; font-weight: 600;
            letter-spacing: 1.1px;
        }
        .rig-hud-value {
            fill: #7dd3fc; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 17px; font-weight: 600; letter-spacing: .4px;
        }
        .rig-hud-sub {
            fill: #a5b4fc; font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 14px; font-weight: 600;
        }
        .rig-trace-axis { stroke: rgba(148, 163, 184, .28) !important; stroke-dasharray: 3 3; }
        .rig-trace {
            fill: none; stroke: #22d3ee; stroke-width: 1.6;
            stroke-linejoin: round; stroke-linecap: round;
            filter: drop-shadow(0 0 3px rgba(34, 211, 238, .55));
        }
        @@keyframes rigBlink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

        /* Dar hero'da (tek kolon mobil düzen) düzenek kartla çakışır — gizle */
        @@media (max-width: 900px) {
            .login-rig, .login-hero-blur { display: none; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .rig-badge-dot { animation: none; }
        }
    </style>
</head>
<body class="login-page app-theme-@runtime.ThemeCode"
      data-reset-workspace-tabs="1">
<!-- Tema toggle — sag ust kose -->
<button type="button" id="btnThemeToggle" class="login-theme-toggle" title="Tema değiştir" aria-label="Tema değiştir">
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
</button>
<script>
    (function () {
        var TK = 'calibra_theme';
        var body = document.body;
        var btn  = document.getElementById('btnThemeToggle');
        var themeInput = document.getElementById('loginThemeInput');
        var form = document.getElementById('loginForm');

        // localStorage tercihini hem UI'a hem hidden input'a uygula
        function applyTheme(t) {
            body.classList.remove('app-theme-light', 'app-theme-dark');
            body.classList.add('app-theme-' + t);
            if (themeInput) themeInput.value = t;
            try { localStorage.setItem(TK, t); } catch (e) {}
        }

        var saved = null;
        try { saved = localStorage.getItem(TK); } catch (e) {}
        if (saved === 'dark' || saved === 'light') { applyTheme(saved); }
        else if (themeInput) { themeInput.value = body.classList.contains('app-theme-dark') ? 'dark' : 'light'; }

        function currentTheme() {
            return body.classList.contains('app-theme-dark') ? 'dark' : 'light';
        }
        btn.addEventListener('click', function () {
            applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
        });
    })();
</script>
<div class="login-shell">
    <section class="login-hero" aria-hidden="true">
        @* CalibraHub Software marka görseli. Frame overflow:hidden + img object-fit:cover
           ile panel tamamen kaplanır, sağ-alt sparkle filigranı doğal olarak kırpılır. *@
        <div class="login-hero-frame">
            <img src="~/Document/CalibraHubLoginLogo.png" alt="CalibraHub Software" />
        </div>

        @* Görselin SOL bölgesini flulaştıran/koyulaştıran katman — maske sağa doğru
           şeffaflaşır, böylece marka logosu ve sloganı net kalır. *@
        <div class="login-hero-blur"></div>

        @* ── Canlı kalibrasyon düzenekleri — CİHAZ SEÇİMLİ (2026-08-05 kullanıcı isteği).
              Soldaki ray (rig-devices) üç sahne arasında geçiş yapar:
              (1) Komparatör — salgı (runout) ölçümü: dönen eksantrik parça, temas ucu,
                  ibre, TIR + kayan trend.
              (2) Mikrometre — dış çap ölçümü: tambur döner, mil parçaya iner, okuma
                  oturur, sapma raporlanır; parça değişir, çevrim yinelenir.
              (3) Manometre — basınç kalibrasyonu: el pompası basıncı kalibrasyon
                  noktalarında (0/25/50/75/100 bar) gezdirir, Ref/Cihaz/Hata izlenir.
              Her sahnenin kendi fizik state'i var; yalnız AKTİF sahne tick alır (sayfa
              sonundaki rig script'i, tek rAF). Salt dekoratif: login akışına bağı yok. ── *@
        <div class="login-rig">
            <div class="rig-devices" id="rigDevices">
                <button type="button" class="rig-dev-btn is-active" data-rig="komp" title="Komparatör — salgı ölçümü">
                    <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="11" y1="11" x2="14.2" y2="5.8" />
                        <line x1="11" y1="19" x2="11" y2="21" />
                        <circle cx="11" cy="11" r="1" fill="currentColor" stroke="none" />
                    </svg>
                    <span>Komparatör</span>
                </button>
                <button type="button" class="rig-dev-btn" data-rig="mik" title="Mikrometre — dış çap ölçümü">
                    <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                        <path d="M13.5 6.5 A6.8 6.8 0 1 0 13.5 15.5" />
                        <line x1="4.5" y1="8" x2="20" y2="8" />
                        <line x1="16" y1="5.6" x2="16" y2="10.4" />
                        <line x1="19" y1="5.6" x2="19" y2="10.4" />
                    </svg>
                    <span>Mikrometre</span>
                </button>
                <button type="button" class="rig-dev-btn" data-rig="man" title="Manometre — basınç kalibrasyonu">
                    <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 14.5 A7.6 7.6 0 0 1 18 14.5" />
                        <line x1="11" y1="14" x2="14.4" y2="9.2" />
                        <line x1="7" y1="18" x2="15" y2="18" />
                        <circle cx="11" cy="14" r="1" fill="currentColor" stroke="none" />
                    </svg>
                    <span>Manometre</span>
                </button>
            </div>

            <div class="rig-main">
            @* Ortak gradient/clip tanımları — üç sahne de url(#...) ile buradan besleniyor
               (inline SVG'de paint server'lar belge genelinde çözülür; id'ler tekildir). *@
            <svg class="rig-defs" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
                <defs>
                    <linearGradient id="rigSteel" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0" stop-color="#42506a" />
                        <stop offset=".22" stop-color="#cbd5e1" />
                        <stop offset=".5" stop-color="#94a3b8" />
                        <stop offset="1" stop-color="#2f3b4f" />
                    </linearGradient>
                    <linearGradient id="rigSteelV" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#cbd5e1" />
                        <stop offset=".55" stop-color="#8b98ab" />
                        <stop offset="1" stop-color="#3a4658" />
                    </linearGradient>
                    <linearGradient id="rigGranite" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#26334a" />
                        <stop offset="1" stop-color="#0a111e" />
                    </linearGradient>
                    <radialGradient id="rigBezel" cx=".34" cy=".24" r=".95">
                        <stop offset="0" stop-color="#eef2f7" />
                        <stop offset=".52" stop-color="#94a1b4" />
                        <stop offset="1" stop-color="#2f3b4f" />
                    </radialGradient>
                    <radialGradient id="rigFace" cx=".36" cy=".26" r=".92">
                        <stop offset="0" stop-color="#ffffff" />
                        <stop offset="1" stop-color="#dde5ef" />
                    </radialGradient>
                    <linearGradient id="rigPartG" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#8f9db1" />
                        <stop offset=".42" stop-color="#e6ecf4" />
                        <stop offset="1" stop-color="#5b697f" />
                    </linearGradient>
                    <radialGradient id="rigFloor" cx=".5" cy=".5" r=".5">
                        <stop offset="0" stop-color="rgba(99,102,241,.38)" />
                        <stop offset="1" stop-color="rgba(99,102,241,0)" />
                    </radialGradient>
                    <clipPath id="mikThimbleClip">
                        <rect x="312" y="220" width="46" height="60" rx="7" />
                    </clipPath>
                </defs>
            </svg>

            @* ── Sahne 1: Komparatör — salgı (runout) ölçümü ── *@
            <svg id="rigSvg" class="login-rig-svg rig-scene is-active" viewBox="0 0 420 520" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                @* Durum şeridi *@
                <g class="rig-badge">
                    <rect x="28" y="20" width="204" height="28" rx="14" />
