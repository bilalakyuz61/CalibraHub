@*
    Loglar — TEK ekran, TEK liste (2026-08-25).

    Geçmiş: önce "İşlem Logları" (/AuditLog) ve "Hata Logları" (/Admin/ErrorLog) iki ayrı
    menü maddesiydi. 2026-08-24'te tek sayfada iki sekme oldu. 2026-08-25'te kullanıcı
    kararıyla sekme de kalktı: hata kayıtları artık aynı listede bir İŞLEM TÜRÜ
    ("Hata" / "Kritik Hata"), kayıt türü kolonunda exception türüyle görünür.

    Yetki DEĞİŞMEDİ: hata satırları yalnız SetupDefinitions (SystemAdmin) yetkisi olan
    kullanıcıya döner ve bu kontrol tek noktada — AuditLogController.Search içinde —
    hem satırlara hem açılır liste seçeneklerine uygulanır. Yetkisi olmayan kullanıcı
    yalnızca iş kaydı loglarını görür; hata satırının varlığını dahi sezemez.

    Kayda-kilitli mod (?entity=&recordId= ile açılan "Değişiklik Geçmişi" bağlantısı)
    /AuditLog/Record üzerinden çalışır — hata satırı içermez, değişmedi.
*@
@{
    ViewData["Title"] = "Loglar";
    ViewData["FormCode"] = "AUDIT_LOG";
    ViewData["HelpKey"] = "audit-log";
    ViewData["BodyClass"] = "page-audit-log";

    var canViewErrorLog = ViewData["CanViewErrorLog"] is bool cve && cve;

    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>App_Data/AuditLogs</td><td style='padding:6px 8px;'>Günlük JSONL log dosyaları (DB'de tutulmaz) — company-{id}/yyyy-MM/audit-yyyy-MM-dd.jsonl</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>WidgetTraLog</td><td style='padding:6px 8px;'>Ek Alanlar (EAV) değişiklik geçmişi — kayıt çizelgesine merge edilir</td></tr>"
        + (canViewErrorLog
            ? "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>App_Data/ErrorLogs</td><td style='padding:6px 8px;'>Dosya tabanlı hata logu (sunucu geneli, DB'de tutulmaz) — aynı listeye \"Hata\" işlem türü olarak karışır.</td></tr>"
            : "")
        + "</table>";
}

@section Styles {
<style>
    .workspace-frame-body.page-audit-log .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }
    .lg-shell { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; }
</style>
}

<div class="lg-shell">
    <div id="auditMonitorRoot" style="flex:1 1 auto;min-height:0;display:flex;flex-direction:column;height:100%;"></div>
</div>

@section Scripts {
<script>
(function () {
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';

    var auditEl = document.getElementById('auditMonitorRoot');
    var mounted = false;

    function showError(el, msg) {
        if (el) el.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:13px;">' + msg + '</div>';
    }
    function loadCss() {
        if (document.querySelector('link[data-al-css]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL; link.setAttribute('data-al-css', '1');
        document.head.appendChild(link);
    }
    function loadScript(cb) {
        var prev = document.querySelector('script[data-al-js]');
        if (prev) { prev.addEventListener('load', cb); return; }
        var s = document.createElement('script');
        s.src = BUNDLE_URL; s.setAttribute('data-al-js', '1');
        s.onload = function () { setTimeout(cb, 0); };
        s.onerror = function () { showError(auditEl, 'React bundle yüklenemedi.'); };
        document.head.appendChild(s);
    }

    function mount() {
        if (mounted || !auditEl) return;
        if (!window.CalibraHub || !window.CalibraHub.mountAuditMonitor) { showError(auditEl, 'mountAuditMonitor bulunamadı.'); return; }
        mounted = true;
        window.CalibraHub.mountAuditMonitor(auditEl, { apiBase: '/AuditLog' });
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountAuditMonitor) mount();
    else loadScript(mount);
})();
</script>
}
