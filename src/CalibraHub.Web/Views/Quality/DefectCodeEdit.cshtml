@using System.ComponentModel
@using System.Reflection
@using CalibraHub.Domain.Enums
@model CalibraHub.Application.Contracts.QualityDefectCodeDto?
@{
    ViewData["Title"] = Model is null ? "Yeni Hata Kodu" : $"Hata Kodu: {Model.Name}";
    ViewData["BodyClass"] = "page-quality-defect-edit workspace-frame-body";
    ViewData["FormCode"] = "QUALITY_DEFECT_CODE";
    var isNew = Model is null;
    string CatLabel(DefectCategory c)
    {
        var m = typeof(DefectCategory).GetMember(c.ToString()).FirstOrDefault();
        return m?.GetCustomAttribute<DescriptionAttribute>()?.Description ?? c.ToString();
    }
}

<div class="ux-edit-shell">
  @await Html.PartialAsync("_CalibraActionBar", new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
  {
      ["Title"]       = isNew ? "Yeni Hata Kodu" : ((Model!.Name ?? "Hata Kodu") + (Model!.IsActive ? "" : " (Pasif)")),
      ["ListUrl"]     = "/Quality/DefectCodes",
      ["NewUrl"]      = "/Quality/DefectCodeEdit",
      ["SaveBtnId"]   = "dc-save",
      ["DeleteBtnId"] = "dc-delete",
      ["ShowDelete"]  = !isNew,
  })

  <div class="ux-edit-body">
    <aside class="ux-edit-nav" id="dcNav">
      <button type="button" class="ux-edit-nav__tab is-active" data-tab="general">
        <svg class="ux-edit-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
        <span>Genel Bilgiler</span>
      </button>
    </aside>

    <section class="ux-edit-content">
      <div class="ux-edit-pane is-active" data-tab="general">
        <h2>Genel Bilgiler</h2>
        <div class="ux-edit-hint">Uygunsuz ölçüm satırlarında seçilecek hata kodları. Kod otomatik türetilir; siz yalnız kategori ve ad girersiniz.</div>

        <input type="hidden" id="f-id" value="@(Model?.Id ?? 0)" />

        <div class="ux-field ux-field--wide">
          <label for="f-cat">Kategori *</label>
          <select id="f-cat">
            @foreach (var c in Enum.GetValues<DefectCategory>())
            {
              <option value="@((byte)c)" selected="@(Model != null && Model.Category == (byte)c)">@CatLabel(c)</option>
            }
          </select>
        </div>

        <div class="ux-field ux-field--wide">
          <label for="f-name">Hata Adı *</label>
          <input type="text" id="f-name" maxlength="200" value="@Model?.Name" placeholder="Örn: Çapak, Ölçü dışı, Yüzey kusuru" />
        </div>

        <div class="ux-field ux-field--wide">
          <label for="f-desc">Açıklama</label>
          <textarea id="f-desc" maxlength="1000" placeholder="Opsiyonel açıklama">@Model?.Description</textarea>
        </div>

        <div class="ux-row2">
          <div class="ux-field">
            <label for="f-color">Renk</label>
            <div style="display:flex; gap:8px; align-items:center;">
              <input type="color" id="f-color" value="@(Model?.ColorHex ?? "#ef4444")" style="width:48px; height:36px; padding:2px; cursor:pointer;" />
              <input type="text" id="f-color-hex" maxlength="9" value="@Model?.ColorHex" placeholder="#RRGGBB" style="width:120px;" />
            </div>
          </div>
          <div class="ux-field">
            <label for="f-sort">Sıra</label>
            <input type="number" id="f-sort" min="0" step="1" value="@(Model?.SortOrder ?? 0)" />
          </div>
        </div>

        <div class="ux-field">
          <label>Durum</label>
          <div class="ux-switch-row">
            <label class="ux-switch">
              <input type="checkbox" id="f-active" @(Model?.IsActive ?? true ? "checked" : "") />
              <span class="ux-switch-track"></span>
            </label>
            <span class="ux-switch-label" id="f-active-label">@(Model?.IsActive ?? true ? "Aktif" : "Pasif")</span>
          </div>
        </div>

        <div id="dc-err" style="display:none;" class="ux-err"></div>
      </div>
    </section>
  </div>
</div>

@Html.AntiForgeryToken()

<script>
(function () {
    function token() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
    function notify(text, ok) {
        var el = document.getElementById('dc-err'); if (!el) return;
        if (!text) { el.style.display = 'none'; return; }
        el.textContent = text; el.style.display = '';
        el.style.color = ok ? '#059669' : '#dc2626';
        if (ok) setTimeout(function () { el.style.display = 'none'; }, 2000);
    }
    var activeEl = document.getElementById('f-active'), activeLabel = document.getElementById('f-active-label');
    activeEl.addEventListener('change', function () { activeLabel.textContent = activeEl.checked ? 'Aktif' : 'Pasif'; });
    var colorEl = document.getElementById('f-color'), colorHexEl = document.getElementById('f-color-hex');
    colorEl.addEventListener('input', function () { colorHexEl.value = colorEl.value; });
    colorHexEl.addEventListener('input', function () { var v = colorHexEl.value.trim(); if (/^#[0-9a-fA-F]{6}$/.test(v)) colorEl.value = v; });

    document.getElementById('dc-save').addEventListener('click', async function () {
        var name = document.getElementById('f-name').value.trim();
        if (!name) { notify('Hata adı zorunlu.', false); return; }
        var payload = {
            id: parseInt(document.getElementById('f-id').value, 10) || null,
            category: parseInt(document.getElementById('f-cat').value, 10),
            name: name,
            description: document.getElementById('f-desc').value.trim() || null,
            colorHex: colorHexEl.value.trim() || null,
            sortOrder: parseInt(document.getElementById('f-sort').value, 10) || 0,
            isActive: activeEl.checked,
        };
        try {
            var r = await fetch('/Quality/SaveDefectCode', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() }, body: JSON.stringify(payload) });
            var d = await r.json();
            if (!d.ok) { notify(d.error || 'Kaydedilemedi.', false); return; }
            location.href = '/Quality/DefectCodes';
        } catch (e) { notify('Hata: ' + e.message, false); }
    });

    var btnDel = document.getElementById('dc-delete');
    if (btnDel) btnDel.addEventListener('click', async function () {
        var ok = (typeof showConfirm === 'function')
            ? await showConfirm({ title: 'Hata Kodu Sil', message: 'Bu hata kodunu silmek istediğinize emin misiniz?', okLabel: 'Sil' })
            : confirm('Silmek istediğinize emin misiniz?');
        if (!ok) return;
        var id = parseInt(document.getElementById('f-id').value, 10);
        try {
            var r = await fetch('/Quality/DeleteDefectCodeJson?id=' + id, { method: 'POST', credentials: 'same-origin', headers: { 'RequestVerificationToken': token() } });
            var d = await r.json();
            if (!d.ok) { notify(d.error || 'Silinemedi.', false); return; }
            location.href = '/Quality/DefectCodes';
        } catch (e) { notify('Hata: ' + e.message, false); }
    });
})();
</script>
