@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = "DÖF Panosu";
    ViewData["FormCode"] = "QUALITY_CAPA";
    ViewData["BodyClass"] = "page-capa-dashboard";
}

<style>
    .page-capa-dashboard .app-content-area--workspace-frame { height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0; }
</style>

<section style="display:flex;flex-direction:column;flex:1 1 auto;min-height:0;height:100%;overflow:hidden;">
    <div id="reactCapaDashboard" style="flex:1 1 auto;min-height:0;overflow:hidden;"></div>
</section>

<script>
(function () {
    var KPI_URL = '/Quality/CapaKpi';
    var BUNDLE_URL = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('reactCapaDashboard');
    if (!el) return;

    function showError(msg) {
        el.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:400px;color:#f87171;font-size:14px;gap:12px;"><div>' + msg + '</div><button onclick="location.reload()" style="padding:8px 20px;border-radius:8px;border:1px solid #4f46e5;background:#6366f1;color:#fff;cursor:pointer;font-size:13px;">Sayfayı Yenile</button></div>';
    }
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountCapaDashboard) { showError('DÖF Panosu mount fonksiyonu bulunamadı'); return; }
        try { window.CalibraHub.mountCapaDashboard(el, { kpiUrl: KPI_URL }); } catch (ex) { showError('Mount hatası: ' + (ex.message || ex)); }
    }
    function loadCss() {
        if (document.querySelector('link[data-capa-dash]')) return;
        var link = document.createElement('link'); link.rel = 'stylesheet'; link.href = CSS_URL;
        link.setAttribute('data-capa-dash', '1'); document.head.appendChild(link);
    }
    function loadScript(cb) {
        if (document.querySelector('script[data-capa-dash]')) { cb(); return; }
        var s = document.createElement('script'); s.src = BUNDLE_URL; s.setAttribute('data-capa-dash', '1');
        s.onload = function () { setTimeout(cb, 0); }; s.onerror = function () { showError('Bundle yüklenemedi'); };
        document.head.appendChild(s);
    }
    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountCapaDashboard) doMount(); else loadScript(doMount);
})();
</script>
