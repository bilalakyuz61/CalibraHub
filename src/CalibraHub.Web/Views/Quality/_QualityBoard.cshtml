@using System.Text.Json
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    // Paylaşılan SmartBoard mount partial'ı — ViewBag.BoardConfig'i mount eder.
    var jsonOpts = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    };
    var boardConfigJson = ViewBag.BoardConfig != null
        ? JsonSerializer.Serialize(ViewBag.BoardConfig, jsonOpts) : "null";
}

<style>
    .page-quality-board .app-content-area--workspace-frame { height:100dvh; display:flex; flex-direction:column; overflow:hidden; padding:0; }
</style>

<section style="display:flex;flex-direction:column;flex:1 1 auto;min-height:0;height:100%;overflow:hidden;">
    <div id="reactSmartBoard" style="flex:1 1 auto;min-height:0;overflow:hidden;"></div>
</section>

<script>
(function () {
    var BOARD_CONFIG = @Html.Raw(boardConfigJson);
    var BUNDLE_URL = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('reactSmartBoard');
    if (!el) return;
    function showError(msg) {
        el.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:400px;color:#f87171;font-size:14px;gap:12px;"><div>' + msg + '</div><button onclick="location.reload()" style="padding:8px 20px;border-radius:8px;border:1px solid #4f46e5;background:#6366f1;color:#fff;cursor:pointer;font-size:13px;">Sayfayı Yenile</button></div>';
    }
    function doMount() {
        if (!BOARD_CONFIG) { showError('Board config bulunamadı'); return; }
        if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) { showError('SmartBoard mount fonksiyonu bulunamadı'); return; }
        try { window.CalibraHub.mountSmartBoard(el, BOARD_CONFIG); } catch (ex) { showError('Mount hatası: ' + (ex.message || ex)); }
    }
    function loadCss() {
        if (document.querySelector('link[data-q-sb]')) return;
        var link = document.createElement('link'); link.rel = 'stylesheet'; link.href = CSS_URL;
        link.setAttribute('data-q-sb', '1'); document.head.appendChild(link);
    }
    function loadScript(cb) {
        if (document.querySelector('script[data-q-sb]')) { cb(); return; }
        var s = document.createElement('script'); s.src = BUNDLE_URL; s.setAttribute('data-q-sb', '1');
        s.onload = function () { setTimeout(cb, 0); }; s.onerror = function () { showError('Bundle yüklenemedi'); };
        document.head.appendChild(s);
    }
    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountSmartBoard) doMount(); else loadScript(doMount);
})();
</script>
