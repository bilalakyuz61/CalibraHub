@*
    Hesaplanan Kolonlar — liste ekranlarına SQL VIEW'dan beslenen salt-okunur kolon tanımı.

    Ekranda SQL YAZILMAZ. Kaynak view ve kolonlar açılır listeden seçilir; sorgunun kendisi
    view'ın içindedir (/ViewBuilder). Tanımda tek serbest metin başlıktır.

    SystemAdmin-only — /ViewBuilder ile aynı kapı, aynı bağlam (ikisi birlikte kullanılır).
*@
@{
    ViewData["Title"] = "Hesaplanan Kolonlar";
    ViewData["FormCode"] = "SETUP_DEFINITIONS";
    ViewData["HelpKey"] = "computed-column";
    ViewData["BodyClass"] = "page-computed-column";
    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>BoardComputedColumn</td><td style='padding:6px 8px;'>Kolon tanımları — SQL taşımaz, yalnız view/kolon adları (sys kataloğuna karşı doğrulanır)</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>sys.views / sys.columns</td><td style='padding:6px 8px;'>Kaynak keşfi ve ad doğrulaması</td></tr>"
        + "</table>";
}

@section Styles {
<style>
    .cc-wrap { padding: 16px 20px; max-width: 1180px; }
    .cc-head { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
    .cc-title { font-size:1.05rem; font-weight:700; }
    .cc-sub { font-size:.78rem; color: var(--app-text-muted, #64748b); }
    .cc-btn {
        appearance:none; cursor:pointer; border:1px solid var(--app-border, #e2e8f0);
        background: var(--app-surface, #fff); color: var(--bs-body-color, #0f172a);
        border-radius:8px; padding:7px 13px; font-size:.82rem; font-weight:600;
    }
    .cc-btn:hover { border-color:#4f46e5; color:#4f46e5; }
    .cc-btn--primary { background:#4f46e5; border-color:#4f46e5; color:#fff; }
    .cc-btn--danger { color:#dc2626; }
    .cc-grid { display:grid; grid-template-columns: 1fr 380px; gap:16px; align-items:start; }
    .cc-card {
        border:1px solid var(--app-border, #e2e8f0); border-radius:12px;
        background: var(--app-surface, #fff); padding:14px 16px;
    }
    .cc-table { width:100%; border-collapse:collapse; font-size:.83rem; }
    .cc-table th { text-align:left; padding:7px 8px; color: var(--app-text-muted,#64748b); font-weight:600; border-bottom:1px solid var(--app-border,#e2e8f0); }
    .cc-table td { padding:8px; border-bottom:1px solid var(--app-border,#e2e8f0); }
    .cc-mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size:.78rem; }
    .cc-row { display:grid; grid-template-columns:120px 1fr; gap:9px 10px; align-items:center; margin-bottom:9px; }
    .cc-row label { font-size:.79rem; color: var(--app-text-muted,#64748b); }
    .cc-row input, .cc-row select {
        width:100%; padding:7px 9px; border-radius:8px; font-size:.82rem;
        border:1px solid var(--app-border,#e2e8f0);
        background: var(--app-surface,#fff); color: var(--bs-body-color,#0f172a);
    }
    .cc-msg { margin-top:10px; padding:9px 11px; border-radius:8px; font-size:.79rem; display:none; }
    .cc-msg--ok { background:#dcfce7; color:#166534; }
    .cc-msg--err { background:#fee2e2; color:#991b1b; }
    body.app-theme-dark .cc-msg--ok { background:#052e1a; color:#4ade80; }
    body.app-theme-dark .cc-msg--err { background:#3f1010; color:#fca5a5; }
    .cc-empty { padding:16px; font-size:.82rem; color: var(--app-text-muted,#64748b); }
</style>
}

<div class="cc-wrap">
    <div class="cc-head">
        <div>
            <div class="cc-title">Hesaplanan Kolonlar</div>
            <div class="cc-sub">Kaynak bir SQL view; tanımda sorgu yazılmaz. Görünürlük her kullanıcının Sütun Ayarları panelinden.</div>
        </div>
        <span style="flex:1"></span>
        <button type="button" class="cc-btn" id="ccNew">Yeni Tanım</button>
    </div>

    <div class="cc-grid">
        <div class="cc-card">
            <table class="cc-table">
                <thead>
                    <tr><th>Başlık</th><th>Varlık</th><th>Kaynak</th><th>Tip</th><th style="width:110px;"></th></tr>
                </thead>
                <tbody id="ccList">
                    <tr><td colspan="5" class="cc-empty">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>

        <div class="cc-card">
            <div style="font-weight:600; font-size:.88rem; margin-bottom:10px;" id="ccFormTitle">Yeni Tanım</div>

            <div class="cc-row"><label>Başlık</label><input id="ccLabel" placeholder="Açık Satış Siparişi" /></div>
            <div class="cc-row"><label>Varlık</label>
                <select id="ccEntity">
                    <option value="Item">Malzeme</option>
                    <option value="Contact">Cari</option>
                    <option value="Document">Belge</option>
                </select>
            </div>
            <div class="cc-row"><label>Kaynak view</label><select id="ccView"></select></div>
            <div class="cc-row"><label>Anahtar kolon</label><select id="ccKey"></select></div>
            <div class="cc-row"><label>Değer kolonu</label><select id="ccValue"></select></div>
            <div class="cc-row"><label>Birim kolonu</label><select id="ccUnit"></select></div>
            <div class="cc-row"><label>Veri tipi</label>
                <select id="ccType">
                    <option value="number">Sayı</option>
                    <option value="decimal">Ondalık</option>
                    <option value="money">Para</option>
                    <option value="date">Tarih</option>
                    <option value="duration">Süre (saniye)</option>
                    <option value="text">Metin</option>
                    <option value="bool">Evet / Hayır</option>
                </select>
            </div>
            <div class="cc-row"><label>Değer yoksa</label>
                <select id="ccNull">
                    <option value="dash">— göster</option>
                    <option value="zero">0 göster</option>
                    <option value="empty">Boş bırak</option>
                </select>
            </div>
            <div class="cc-row"><label>Zaman aşımı</label><input id="ccTimeout" type="number" min="1" max="30" value="3" /></div>
            <div class="cc-row"><label>Aktif</label>
                <select id="ccActive"><option value="true">Açık</option><option value="false">Kapalı</option></select>
            </div>

            <div style="display:flex; gap:8px; margin-top:12px;">
                <button type="button" class="cc-btn" id="ccPreview">Önizle</button>
                <span style="flex:1"></span>
                <button type="button" class="cc-btn cc-btn--primary" id="ccSave">Kaydet</button>
            </div>

            <div class="cc-msg" id="ccMsg"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var sources = [];
    var editingId = 0;

    function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
    function el(id) { return document.getElementById(id); }
    function msg(text, ok) {
        var m = el('ccMsg');
        m.textContent = text;
        m.className = 'cc-msg ' + (ok ? 'cc-msg--ok' : 'cc-msg--err');
        m.style.display = 'block';
    }
    function clearMsg() { el('ccMsg').style.display = 'none'; }

    function fillOptions(select, values, includeBlank) {
        select.innerHTML = '';
        if (includeBlank) {
            var b = document.createElement('option');
            b.value = ''; b.textContent = '(yok)';
            select.appendChild(b);
        }
        values.forEach(function (v) {
            var o = document.createElement('option');
            o.value = v.value; o.textContent = v.label;
            select.appendChild(o);
        });
    }

    // Kolon listeleri SEÇİLEN VIEW'dan gelir — elle yazılmaz. Böylece kaydedilen her ad
    // gerçekten var olan bir kolondur; sunucu ayrıca sys kataloğuna karşı doğrular.
    function onViewChange() {
        var name = el('ccView').value;
        var src = sources.filter(function (s) { return s.viewName === name; })[0];
        var cols = (src ? src.columns : []).map(function (c) {
            return { value: c.name, label: c.name + '  ·  ' + c.sqlType };
        });
        fillOptions(el('ccKey'), cols, false);
        fillOptions(el('ccValue'), cols, false);
        fillOptions(el('ccUnit'), cols, true);
    }

    function payload() {
        return {
            id: editingId,
            label: el('ccLabel').value,
            entityKind: el('ccEntity').value,
            viewName: el('ccView').value,
            keyColumn: el('ccKey').value,
            valueColumn: el('ccValue').value,
            unitColumn: el('ccUnit').value || null,
            dataType: el('ccType').value,
            formatJson: null,
            nullDisplay: el('ccNull').value,
            boardKeys: null,
            timeoutSec: parseInt(el('ccTimeout').value, 10) || 3,
            sortOrder: 0,
            isActive: el('ccActive').value === 'true'
        };
    }

    function post(url, body) {
        return fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: body ? JSON.stringify(body) : null
        }).then(function (r) { return r.json(); });
    }

    function loadList() {
        fetch('/ComputedColumn/api/list', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var tb = el('ccList');
                if (!d || !d.ok) { tb.innerHTML = '<tr><td colspan="5" class="cc-empty">Liste okunamadı.</td></tr>'; return; }
                if (!d.items.length) { tb.innerHTML = '<tr><td colspan="5" class="cc-empty">Henüz tanım yok.</td></tr>'; return; }
                tb.innerHTML = d.items.map(function (i) {
                    return '<tr>'
                        + '<td>' + i.label + (i.isActive ? '' : ' <span style="opacity:.6">(kapalı)</span>') + '</td>'
                        + '<td>' + i.entityKind + '</td>'
                        + '<td class="cc-mono">' + i.viewName + '.' + i.valueColumn + '</td>'
                        + '<td>' + i.dataType + '</td>'
                        + '<td style="text-align:right;">'
                        + '<button type="button" class="cc-btn" data-edit="' + i.id + '">Düzenle</button> '
                        + '<button type="button" class="cc-btn cc-btn--danger" data-del="' + i.id + '">Sil</button>'
                        + '</td></tr>';
                }).join('');
                tb.querySelectorAll('[data-edit]').forEach(function (b) {
                    b.addEventListener('click', function () { edit(d.items.filter(function (x) { return x.id == b.getAttribute('data-edit'); })[0]); });
                });
                tb.querySelectorAll('[data-del]').forEach(function (b) {
                    b.addEventListener('click', function () { del(b.getAttribute('data-del')); });
                });
            });
    }

    function edit(item) {
        if (!item) return;
        editingId = item.id;
        el('ccFormTitle').textContent = 'Tanımı Düzenle';
        el('ccLabel').value = item.label;
        el('ccEntity').value = item.entityKind;
        el('ccView').value = item.viewName;
        onViewChange();
        el('ccKey').value = item.keyColumn;
        el('ccValue').value = item.valueColumn;
        el('ccUnit').value = item.unitColumn || '';
        el('ccType').value = item.dataType;
        el('ccNull').value = item.nullDisplay;
        el('ccTimeout').value = item.timeoutSec;
        el('ccActive').value = item.isActive ? 'true' : 'false';
        clearMsg();
    }

    function del(id) {
        post('/ComputedColumn/api/delete?id=' + id, null).then(function (d) {
            if (d && d.ok) { loadList(); msg('Silindi.', true); }
            else msg((d && d.error) || 'Silinemedi.', false);
        });
    }

    el('ccNew').addEventListener('click', function () {
        editingId = 0;
        el('ccFormTitle').textContent = 'Yeni Tanım';
        el('ccLabel').value = '';
        el('ccUnit').value = '';
        el('ccTimeout').value = '3';
        el('ccActive').value = 'true';
        clearMsg();
    });

    el('ccView').addEventListener('change', onViewChange);

    el('ccPreview').addEventListener('click', function () {
        clearMsg();
        post('/ComputedColumn/api/preview', payload()).then(function (d) {
            if (!d || !d.ok) { msg((d && d.error) || 'Önizleme başarısız.', false); return; }
            var sample = (d.rows || []).map(function (r) {
                return r.key + ' → ' + (r.value === null ? '(boş)' : r.value) + (r.unit ? ' ' + r.unit : '');
            }).join('  ·  ');
            msg(d.rows.length + ' örnek satır okundu · ' + d.elapsedMs + ' ms' + (sample ? '  |  ' + sample : ''), true);
        });
    });

    el('ccSave').addEventListener('click', function () {
        clearMsg();
        post('/ComputedColumn/api/save', payload()).then(function (d) {
            if (d && d.ok) { editingId = d.id; loadList(); msg('Kaydedildi.', true); }
            else msg((d && d.error) || 'Kaydedilemedi.', false);
        });
    });

    fetch('/ComputedColumn/api/sources', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            sources = (d && d.ok) ? (d.sources || []) : [];
            fillOptions(el('ccView'), sources.map(function (s) { return { value: s.viewName, label: s.viewName }; }), false);
            onViewChange();
            loadList();
        });
})();
</script>
}
