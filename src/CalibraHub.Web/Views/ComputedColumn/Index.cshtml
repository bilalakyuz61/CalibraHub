@*
    Hesaplanan Kolonlar — liste (CalibraSmartBoard / C-Grid standardı).

    Kartlar tanımları gösterir; düzenleme ayrı ekranda (/ComputedColumn/Edit).
    Silme in-place refresh ile listeyi tazeler — sayfa yeniden yüklenmez.

    SystemAdmin-only; /ViewBuilder ile aynı kapı.
*@
@model object
@{
    ViewData["Title"] = "Hesaplanan Kolonlar";
    ViewData["FormCode"] = "SETUP_DEFINITIONS";
    ViewData["HelpKey"] = "computed-column";
    ViewData["BodyClass"] = "page-computed-column";
    ViewData["DbInfo"] =
        "<table style='width:100%;border-collapse:collapse;font-size:0.78rem;'>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>BoardComputedColumn</td><td style='padding:6px 8px;'>Kolon tanımları — SQL taşımaz, yalnız view/kolon adları (sys kataloğuna karşı doğrulanır)</td></tr>"
        + "<tr><td style='padding:6px 8px;font-weight:600;color:#2563eb;'>sys.views / sys.columns</td><td style='padding:6px 8px;'>Kaynak keşfi ve ad doğrulaması</td></tr>"
        + "</table>";

    var boardConfigJson = System.Text.Json.JsonSerializer.Serialize(Model,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@section Styles {
<style>
    .workspace-frame-body.page-computed-column .app-content-area--workspace-frame {
        height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding: 0;
    }
    #ccBoardRoot { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; }
</style>
}

<div id="ccBoardRoot"></div>

@section Scripts {
<script>
(function () {
    var BOARD_CONFIG = @Html.Raw(boardConfigJson);
    var BUNDLE_URL = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.js")';
    var CSS_URL    = '@FileVersioner.AddFileVersionToPath(Context.Request.PathBase, "/react/calibrahub-widgets.css")';
    var el = document.getElementById('ccBoardRoot');

    function showError(msg) {
        if (el) el.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:13px;">' + msg + '</div>';
    }
    function loadCss() {
        if (document.querySelector('link[data-cc-css]')) return;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = CSS_URL; link.setAttribute('data-cc-css', '1');
        document.head.appendChild(link);
    }
    function loadScript(cb) {
        var prev = document.querySelector('script[data-cc-js]');
        if (prev) { prev.addEventListener('load', cb); return; }
        var s = document.createElement('script');
        s.src = BUNDLE_URL; s.setAttribute('data-cc-js', '1');
        s.onload = function () { setTimeout(cb, 0); };
        s.onerror = function () { showError('React bundle yüklenemedi.'); };
        document.head.appendChild(s);
    }
    function doMount() {
        if (!window.CalibraHub || !window.CalibraHub.mountSmartBoard) { showError('mountSmartBoard bulunamadı.'); return; }
        window.CalibraHub.mountSmartBoard(el, BOARD_CONFIG);
    }

    loadCss();
    if (window.CalibraHub && window.CalibraHub.mountSmartBoard) doMount();
    else loadScript(doMount);
})();
</script>
}
