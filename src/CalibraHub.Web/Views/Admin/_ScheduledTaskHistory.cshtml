@model IReadOnlyCollection<CalibraHub.Domain.Entities.ScheduledTaskRun>
@{
    Layout = null;
}
<style>
/* Tema: acik varsayilan + body.app-theme-dark override (CLAUDE.md). Onceki surum yalnizca
   koyu temaya gore yazilmisti — acik temada satir cizgileri gorunmuyordu. */
.sth { font-family: inherit; --sth-line: var(--app-border, #e2e8f0); --sth-muted: #64748b; --sth-head: #64748b; }
body.app-theme-dark .sth { --sth-line: rgba(255,255,255,.08); --sth-muted: #94a3b8; --sth-head: #94a3b8; }
.sth-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.sth-table th { padding: 8px 10px; text-align: left; font-size: 11px; font-weight: 600; letter-spacing: .04em; color: var(--sth-head); border-bottom: 1px solid var(--sth-line); }
.sth-table td { padding: 8px 10px; border-bottom: 1px solid var(--sth-line); vertical-align: top; }
.sth-table tr:last-child td { border-bottom: none; }
.sth-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 5px; font-size: 11px; font-weight: 600; white-space: nowrap; }
.sth-ok   { background: rgba(34,197,94,.14);  color: #16a34a; }
.sth-err  { background: rgba(239,68,68,.14);  color: #dc2626; }
.sth-run  { background: rgba(59,130,246,.14); color: #2563eb; }
body.app-theme-dark .sth-ok  { color: #4ade80; }
body.app-theme-dark .sth-err { color: #f87171; }
body.app-theme-dark .sth-run { color: #60a5fa; }
.sth-dur  { color: var(--sth-muted); font-size: 12px; }
.sth-msg  { color: var(--sth-muted); font-size: 12px; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sth-trig { color: var(--sth-muted); font-size: 11px; }
.sth-empty { padding: 28px 24px; text-align: center; color: var(--sth-muted); font-size: 13px; line-height: 1.6; }
.sth-empty strong { display: block; margin-bottom: 4px; color: var(--bs-body-color, #0f172a); font-weight: 600; }
body.app-theme-dark .sth-empty strong { color: #e2e8f0; }
</style>
<div class="sth">
@if (!Model.Any())
{
    var lastRunAt  = ViewData["LastRunAt"] as DateTime?;
    var lastStatus = ViewData["LastRunStatus"] as int?;
    var lastMsg    = ViewData["LastRunMessage"] as string;
    <div class="sth-empty">
        <strong>Ayrıntılı Çalıştırma Kaydı Yok</strong>
        @if (lastRunAt.HasValue)
        {
            <text>
                Bu görev en son
                <b>@lastRunAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</b> tarihinde
                @(lastStatus == 0 ? "başarıyla" : lastStatus is null ? "" : "hata ile") çalışmış.
                @if (!string.IsNullOrWhiteSpace(lastMsg)) { <text>(@lastMsg)</text> }
                <br />
                Ayrıntılı geçmiş kaydı yalnızca bu tarihten sonraki çalışmalar için tutulur.
            </text>
        }
        else
        {
            <text>
                Bu görev henüz hiç çalışmamış. Sistem görevlerinde geçmiş, arka plan
                servisi her çalıştığında yazılır.
            </text>
        }
    </div>
}
else
{
    <table class="sth-table">
        <thead>
            <tr>
                <th>Zaman</th>
                <th>Durum</th>
                <th>Süre</th>
                <th>Mesaj</th>
                <th>Tetikleyen</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            var badgeCls = r.Status == 0 ? "sth-ok" : r.Status == 2 ? "sth-run" : "sth-err";
            var badgeLbl = r.Status == 0 ? "Başarılı" : r.Status == 2 ? "Çalışıyor" : "Hata";
            var trigLbl  = r.Trigger == CalibraHub.Domain.Enums.RunTrigger.Manual   ? "Manuel"
                         : r.Trigger == CalibraHub.Domain.Enums.RunTrigger.System   ? "Sistem"
                         : "Zamanlama";
            var durText  = r.DurationMs.HasValue ? (r.DurationMs.Value < 1000
                               ? $"{r.DurationMs.Value} ms"
                               : $"{r.DurationMs.Value / 1000.0:F1} s") : "—";
            <tr>
                <td style="white-space:nowrap;">@r.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td><span class="sth-badge @badgeCls">@badgeLbl</span></td>
                <td class="sth-dur">@durText</td>
                <td class="sth-msg" title="@(r.Message ?? "")">@(r.Message ?? "—")</td>
                <td class="sth-trig">@trigLbl</td>
            </tr>
        }
        </tbody>
    </table>
}
</div>
