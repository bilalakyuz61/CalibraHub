                <script>
                // Hiyerarşi zinciri: Stok Rez. → Seri Takibi → Seri Rez.
                // Üst kademe kapanınca alttakiler devre dışı + görsel kapalı (cascade).
                (function () {
                    var so    = document.getElementById('ap-so-affects');   // stok rez.
                    var track = document.getElementById('ap-so-track');     // seri takibi
                    var ser   = document.getElementById('ap-so-serial');    // seri rez.
                    var trackRow = document.getElementById('ap-so-track-row');
                    var serRow   = document.getElementById('ap-so-serial-row');
                    if (!so || !track || !ser) {
                        // Sessiz return YASAK (CLAUDE.md) — id degisirse zincir sessizce
                        // devre disi kalir ve alt kademeler yanlis gorunur.
                        try { console.warn('[Parametreler] hiyerarsi zinciri kurulamadi — eksik id:',
                            { affects: !!so, track: !!track, serial: !!ser }); } catch (e) {}
                        return;
                    }
                    /* 2026-08-22 DUZELTME — "ust parametre kapaliyken alttaki
                       isaretlenememeli": Onceden alt switch yalnizca GORSEL olarak
                       kapatiliyor, `checked` DEGERI dokunulmadan birakiliyordu.
                       Sonuc: ekranda "Kapali" gorunen ayar, Kaydet'e basildiginda
                       `checked` hala true oldugu icin `true` olarak KAYDEDILIYORDU
                       (imkansiz durum: ust kademe kapali, alt kademe acik) ve bir
                       sonraki etkilesimde "Acik" olarak geri geliyordu.
                       Artik devre disi birakilan kademe ayni anda isaretsizlenir —
                       deger, gorunum ve kaydedilen sey birbirini tutar. */
                    function visualOff(input, labelId) {
                        input.checked = false;
                        var trk = input.closest('.ap-switch').querySelector('.ap-switch-track');
                        var lbl = document.getElementById(labelId);
                        if (trk) trk.classList.remove('is-on');
                        if (lbl) { lbl.classList.remove('is-active'); lbl.textContent = 'Kapalı'; }
                    }
                    function sync() {
                        var soOn = so.checked;
                        // Kademe 2: seri takibi — stok rez.'e bağlı
                        track.disabled = !soOn;
                        if (trackRow) trackRow.style.opacity = soOn ? '' : '.5';
                        if (!soOn) visualOff(track, 'ap-so-track-label');
                        // Kademe 3: seri rez. — (stok rez. && seri takibi)'ne bağlı
                        var trackOn = soOn && track.checked;
                        ser.disabled = !trackOn;
                        if (serRow) serRow.style.opacity = trackOn ? '' : '.5';
                        if (!trackOn) visualOff(ser, 'ap-so-serial-label');
                    }
                    so.addEventListener('change', sync);
                    track.addEventListener('change', sync);
                    sync();
                })();
                </script>

