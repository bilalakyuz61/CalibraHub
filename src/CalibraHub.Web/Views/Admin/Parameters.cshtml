@Html.AntiForgeryToken()

@section Scripts {
<script>
(function () {
    'use strict';

    var activePane = 'general';
    var saveBtn   = document.getElementById('ap-save-btn');
    var metaLabel = document.getElementById('ap-active-label');
    var actionBar = document.getElementById('ap-action-bar');

    // ── Tab gecisi + Kaydet butonunun aktif/pasif durumu ────
    // Sekme adi listesi TUTULMAZ (eskiden elle whitelist vardi ve yeni sekme eklenince
    // Kaydet pasif kaliyordu — "satissiparis regresyonu"). Artik pane'in icinde
    // kaydedilebilir bir kontrol var mi diye DOM'a bakilir.
    function syncSaveButton() {
        var paneEl = document.getElementById('ap-pane-' + activePane);
        var hasParams = !!(paneEl && paneEl.querySelector('input, select, textarea'));
        saveBtn.disabled = !hasParams;
        saveBtn.title = hasParams ? '' : 'Bu sekmede henüz kaydedilebilir parametre yok.';
    }

    // Aktif sekmenin yardim dokumani — F1 (ve Islemler > Yardim) her cagrilista
    // #calibra-help'i CANLI okur, bu yuzden sekme degisince attribute'lari guncellemek
    // yeterli: her sekme kendi yardim sayfasini acar (App_Data/Help/{tr,en}/parameters-<pane>.html).
    function syncHelpKey(t) {
        var div = document.getElementById('calibra-help');
        if (!div || !t) return;
        div.setAttribute('data-help-key', 'parameters-' + t.dataset.pane);
        div.setAttribute('data-page-title', 'Şirket Parametreleri — ' + (t.dataset.label || t.textContent.trim()));
    }

    var tabs = document.querySelectorAll('.ap-tab');
    tabs.forEach(function (t) {
        t.addEventListener('click', function () {
            activePane = t.dataset.pane;
            tabs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
            document.querySelectorAll('.ap-pane').forEach(function (p) {
                p.classList.toggle('is-active', p.id === 'ap-pane-' + activePane);
            });
            metaLabel.textContent = t.dataset.label || t.textContent.trim();
            syncSaveButton();
            syncHelpKey(t);
        });
    });
    syncSaveButton();
    // Ilk senkron DOM hazir olunca: #calibra-help div'i layout'ta bu script'ten SONRA
    // render ediliyor — burada dogrudan cagrilirsa element henuz yok (sessizce kacirilir).
    (function initHelpKey() {
        var apply = function () { syncHelpKey(document.querySelector('.ap-tab.is-active')); };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
        else apply();
    })();

    // ── Flash + helpers ────────────────────────────────────
    function flash(msg, ok) {
        var el = document.getElementById('ap-flash');
        el.textContent = msg;
        el.className = ok ? 'ok' : 'err';
        el.style.display = 'block';
        clearTimeout(window.__apFlashTm);
        window.__apFlashTm = setTimeout(function () { el.style.display = 'none'; }, 3000);
    }
    function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    // Belge türü onay switch'leri artık ait olduğu modül sekmesinde kaydedilir; hepsi aynı
    // /Admin/SaveApprovalParametersJson uç noktasını (kinds:[{kind, enabled}]) paylaşır.
    async function saveApprovalKinds(kinds) {
        var r = await fetch('/Admin/SaveApprovalParametersJson', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify({ kinds: kinds })
        });
        return await r.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
    }

    // ── KITT animasyonu — basari aninda aksiyon seridi alti ─
    function flashSuccess() {
        actionBar.classList.remove('is-save-flash');
        void actionBar.offsetWidth;          // reflow → animasyonu yeniden tetikle
        actionBar.classList.add('is-save-flash');
        setTimeout(function () { actionBar.classList.remove('is-save-flash'); }, 1850);
    }

    // ── Switch visual sync helper ────────────────────────
    function wireSwitch(checkboxId, labelId) {
        var cb = document.getElementById(checkboxId);
        if (!cb) return;
        cb.addEventListener('change', function () {
            var on = cb.checked;
            cb.closest('.ap-switch').querySelector('.ap-switch-track').classList.toggle('is-on', on);
            var lbl = document.getElementById(labelId);
            if (lbl) { lbl.textContent = on ? 'Aktif' : 'Pasif'; lbl.classList.toggle('is-active', on); }
        });
    }
    wireSwitch('ap-edoc-approval', 'ap-edoc-approval-label');
    wireSwitch('ap-bom-allow-dup', 'ap-bom-allow-dup-label');
    wireSwitch('ap-wo-recipe-edit', 'ap-wo-recipe-edit-label');
    wireSwitch('ap-fc-min-stock', 'ap-fc-min-stock-label');
    wireSwitch('ap-fc-consolidate', 'ap-fc-consolidate-label');
    wireSwitch('ap-contact-capa-enabled', 'ap-contact-capa-enabled-label');
    // Belge türü onay switch'leri + TL müdahale — her biri kendi modül sekmesinde,
    // markup _ApprovalParamRows / _TlPriceEditRow partial'larından gelir. Id yerine
    // SINIF üzerinden bağlanır (yeni sekme eklendiğinde JS'e dokunmak gerekmez).
    document.querySelectorAll('.ap-approval-use, .ap-approval-auto, .ap-tl-edit').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var on = cb.checked;
            cb.closest('.ap-switch').querySelector('.ap-switch-track').classList.toggle('is-on', on);
            var lbl = document.getElementById(cb.id + '-label');
            if (lbl) { lbl.textContent = on ? 'Aktif' : 'Pasif'; lbl.classList.toggle('is-active', on); }
        });
    });

    // Kademe: "Onay Sistemi Kullanılsın" kapalıyken otomatik başlatma satırı GİZLENİR
    // (kapalı sistemde sorulmasının anlamı yok — kullanıcı isteği 2026-08-22).
    document.querySelectorAll('.ap-approval-use').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var kind = cb.getAttribute('data-kind');
            var row = document.querySelector('.ap-approval-auto-row[data-kind="' + kind + '"]');
            if (row) row.style.display = cb.checked ? '' : 'none';
        });
    });
    // Eksi bakiye switch'leri — etiket data-on / data-off'tan alınır
    document.querySelectorAll('.ap-neg-switch').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var on = cb.checked;
            cb.closest('.ap-switch').querySelector('.ap-switch-track').classList.toggle('is-on', on);
            var lbl = document.getElementById(cb.id + '-label');
            if (lbl) { lbl.textContent = on ? (cb.dataset.on || 'Açık') : (cb.dataset.off || 'Kapalı'); lbl.classList.toggle('is-active', on); }
        });
    });

    // ── Stok anahtarları (sekmeden BAĞIMSIZ) ───────────────────────────────
    // 2026-08-25: bu altı anahtarın markup'ı ilgili belge sekmelerine dağıtıldı
    // (FIFO bağlama → irsaliye sekmeleri, sipariş zorunluluğu → sipariş sekmeleri).
    // Kaydetme eskiden YALNIZ Stok sekmesi aktifken çalışıyordu; markup taşınınca
    // kullanıcı Alış İrsaliyesi sekmesinde anahtarı değiştirip Kaydet'e bastığında
    // değişiklik SESSİZCE kaybolurdu — istek gider, o anahtar hiç gönderilmezdi.
    //
    // Hepsi TEK uçla (SaveStockParametersJson) yazıldığı ve değerler ekrandaki güncel
    // durumdan okunduğu için her kaydetmede göndermek güvenli/idempotenttir: gizli
    // sekmedeki anahtar da DOM'da durur (pane display:none, kaldırılmış değil).
    async function saveStockSwitches() {
        var negCtrlEl = document.getElementById('ap-neg-control');
        if (!negCtrlEl) return { ok: true, error: null };   // ekran bu bölümü hiç basmadıysa
        var pFifoEl  = document.getElementById('ap-purchase-fifo');
        var sFifoEl  = document.getElementById('ap-sales-fifo');
        var pReqEl   = document.getElementById('ap-purchase-require-order');
        var sReqEl   = document.getElementById('ap-sales-require-order');
        var sSerOvEl = document.getElementById('ap-sales-serial-override');
        try {
            var rs = await fetch('/Admin/SaveStockParametersJson', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify({
                    negControl: !!(negCtrlEl && negCtrlEl.checked),
                    purchaseDeliveryFifoBind: !!(pFifoEl && pFifoEl.checked),
                    salesDeliveryFifoBind: !!(sFifoEl && sFifoEl.checked),
                    purchaseDeliveryRequireOrder: !!(pReqEl && pReqEl.checked),
                    salesDeliveryRequireOrder: !!(sReqEl && sReqEl.checked),
                    salesDeliverySerialOverride: !!(sSerOvEl && sSerOvEl.checked)
                })
            });
            var d = await rs.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
            return { ok: !!d.ok, error: d.error || null };
        } catch (e) {
            return { ok: false, error: 'Ag hatasi: ' + e.message };
        }
    }

    // ── Aktif sekmedeki ORTAK parametreler (onay + TL müdahale) ────────────
    // Bu iki grup artık birçok sekmede tekrar ettiği için sekme başına ayrı dal
    // yazılmaz; aktif pane'in içindekiler toplanıp kaydedilir.
    async function saveCommonPaneParams(pane) {
        var scope = document.getElementById('ap-pane-' + pane);
        if (!scope) return { handled: false, ok: true };

        var kinds = [];
        scope.querySelectorAll('.ap-approval-auto').forEach(function (autoEl) {
            var kind = autoEl.getAttribute('data-kind');
            var useEl = scope.querySelector('.ap-approval-use[data-kind="' + kind + '"]');
            kinds.push({
                kind: kind,
                enabled: !!autoEl.checked,
                use: useEl ? !!useEl.checked : true
            });
        });

        var tlEls = scope.querySelectorAll('.ap-tl-edit');
        if (kinds.length === 0 && tlEls.length === 0) return { handled: false, ok: true };

        var allOk = true;
        if (kinds.length) {
            var dk = await saveApprovalKinds(kinds);
            if (!dk.ok) allOk = false;
        }
        for (var i = 0; i < tlEls.length; i++) {
            var el = tlEls[i];
            var rr = await fetch('/Admin/SaveParameter', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify({
                    formCode: 'SALES_QUOTE',
                    paramKey: 'TL_PRICE_EDIT_' + el.getAttribute('data-doctype'),
                    paramValue: el.checked ? 'true' : 'false',
                    // CompanyParameterDataType.Bool = 3 (String=1, Int=2, Bool=3).
                    // Ilk surumde 0 yazilmisti — enum'da tanimsiz deger, kaydetme
                    // "basarisiz" donuyordu (ekrandaki diger bool'lar zaten 3 kullaniyor).
                    dataType: 3
                })
            });
            var dd = await rr.json().catch(function () { return { ok: false }; });
            if (!dd.ok) allOk = false;
        }
        return { handled: true, ok: allOk };
    }

    // Kendi kaydetme dalı OLAN sekmeler — bunlarda başarı/hata mesajını dal verir,
    // ortak kaydedici yalnızca sonucu AND'ler. Listede olmayan sekmede mesajı
    // ortak kaydedici verir.
    var PANES_WITH_BRANCH = ['general', 'production', 'ihtiyac', 'stok', 'satissiparis', 'salesquote', 'guvenlik', 'kalite'];

    // ── Aksiyon seridi Kaydet handler ──────────────────────
    saveBtn.addEventListener('click', async function () {
        if (saveBtn.disabled) return;
        saveBtn.disabled = true;
        try {
            // Onay + TL parametreleri sekmeye bakılmaksızın burada kaydedilir.
            var common = await saveCommonPaneParams(activePane);
            // Stok anahtarları da sekmeden bağımsız (bkz. saveStockSwitches).
            var stockRes = await saveStockSwitches();
            var hasBranch = PANES_WITH_BRANCH.indexOf(activePane) >= 0;
            var ok = false;
            if (activePane === 'general') {
                var edocCheckbox = document.getElementById('ap-edoc-approval');
                var r = await fetch('/Admin/SaveGeneralParametersJson', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({
                        isEDocumentApprovalEnabled: edocCheckbox.checked,
                        publicBaseUrl: (document.getElementById('ap-public-base-url') || {}).value || ''
                    })
                });
                var data = await r.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!data.ok;
                if (ok) flash('Kaydedildi.', true);
                else    flash(data.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'production') {
                var pinEl = document.getElementById('ap-shopfloor-max-pin');
                var raw = pinEl ? parseInt(pinEl.value, 10) : NaN;
                if (isNaN(raw) || raw < 0 || raw > 50) {
                    flash('Hatalı PIN limiti 0 ile 50 arasında olmalı.', false);
                    return;
                }
                var dupEl = document.getElementById('ap-bom-allow-dup');
                var woEditEl = document.getElementById('ap-wo-recipe-edit');
                var rp = await fetch('/Admin/SaveProductionParametersJson', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({
                        shopFloorMaxPinAttempts: raw,
                        bomAllowDuplicateComponents: !!(dupEl && dupEl.checked),
                        allowStartedWoRecipeEdit: !!(woEditEl && woEditEl.checked)
                    })
                });
                var datap = await rp.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!datap.ok;
                if (ok) flash('Kaydedildi.', true);
                else    flash(datap.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'ihtiyac') {
                var mode = document.querySelector('input[name="apFcLocMode"]:checked')?.value || 'SPECIFIC';
                var ids  = [];
                if (mode === 'SPECIFIC') {
                    document.querySelectorAll('#apFcLocList input[type="checkbox"]:checked').forEach(function(cb) {
                        ids.push(parseInt(cb.value, 10));
                    });
                }
                // PageComment Seq 34: mode + id listesi artık bu parametreye özel, sunucu tarafında
                // raf/hücre tipine karşı doğrulayan tek bir uçtan kaydedilir (genel /Admin/SaveParameter
                // yerine — bkz. PurchaseController.SaveFulfillmentLocationConfig).
                var r1 = await fetch('/Purchase/SaveFulfillmentLocationConfig', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ mode: mode, locationIds: ids })
                });
                var d1 = await r1.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                var minEl = document.getElementById('ap-fc-min-stock');
                var r3 = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'PURCHASE_FULFILLMENT', paramKey: 'FULFILLMENT_RESPECT_MIN_STOCK', paramValue: (minEl && minEl.checked) ? 'true' : 'false', dataType: 3 })
                });
                var d3 = await r3.json();
                var conEl = document.getElementById('ap-fc-consolidate');
                var r4 = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'PURCHASE_FULFILLMENT', paramKey: 'STOCK_DOC_CONSOLIDATE', paramValue: (conEl && conEl.checked) ? 'true' : 'false', dataType: 3 })
                });
                var d4 = await r4.json();
                ok = !!d1.ok && !!d3.ok && !!d4.ok;   // onay: ortak kaydedicide
                if (ok) { flash('Kaydedildi.', true); fcRenderWarning(null); }  // basarili kayitta gecersiz-id uyarisi artik gecersiz
                else    flash((d1.error || d3.error || d4.error || 'Kaydetme basarisiz.'), false);
            } else if (activePane === 'stok') {
                // Stok anahtarlarinin POST'u yukari tasindi (saveStockSwitches) — her
                // sekmeden calisiyor; burada yalniz izlenebilirlik parametreleri kaldi.
                // Seq 1100: Seri No Benzersizligi (izlenebilirlik) artik Stok sekmesinde —
                // ayni parametre kodu/ucu (TRACEABILITY / SERIAL_UNIQUE_SCOPE), Stok kaydiyla birlikte gider.
                var scEl = document.getElementById('ap-trace-serial-scope');
                var scVal = (scEl && scEl.value === 'Global') ? 'Global' : 'Item';
                var rtr = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'TRACEABILITY', paramKey: 'SERIAL_UNIQUE_SCOPE', paramValue: scVal, dataType: 1 })
                });
                var dtr = await rtr.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                // Seq 1099: izlenebilirlik ANA anahtari — kapaliyken malzeme kartinda lot/seri secilemez.
                var teEl = document.getElementById('ap-trace-enabled');
                var rte = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'TRACEABILITY', paramKey: 'ENABLED', paramValue: (teEl && teEl.checked) ? 'true' : 'false', dataType: 3 })
                });
                var dte = await rte.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = stockRes.ok && !!dtr.ok && !!dte.ok;
                if (ok) flash('Kaydedildi.', true);
                else    flash(stockRes.error || dtr.error || dte.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'satissiparis') {
                var soEl = document.getElementById('ap-so-affects');
                var soOn = !!(soEl && soEl.checked);
                var rso = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'STOCK', paramKey: 'SALES_ORDER_AFFECTS_STOCK', paramValue: soOn ? 'true' : 'false', dataType: 3 })
                });
                var dso = await rso.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                // Hiyerarşik: seri takibi stok rez.'e, seri rez. seri takibine bağlı; üst kapalıysa alt false.
                var trackEl = document.getElementById('ap-so-track');
                var trackOn = soOn && !!(trackEl && trackEl.checked);
                var rtrack = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'STOCK', paramKey: 'ORDER_SERIAL_TRACKING', paramValue: trackOn ? 'true' : 'false', dataType: 3 })
                });
                var dtrack = await rtrack.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                var serEl = document.getElementById('ap-so-serial');
                var serOn = trackOn && !!(serEl && serEl.checked);
                var rser = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'STOCK', paramKey: 'ORDER_SERIAL_RESERVATION', paramValue: serOn ? 'true' : 'false', dataType: 3 })
                });
                var dser = await rser.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!dso.ok && !!dtrack.ok && !!dser.ok;   // onay: ortak kaydedicide
                if (ok) flash('Kaydedildi.', true);
                else    flash(dso.error || dtrack.error || dser.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'salesquote') {
                var rtEl = document.getElementById('ap-sq-rate-type');
                var allowed = ['Selling', 'Buying', 'EffectiveSelling', 'EffectiveBuying'];
                var rtVal = (rtEl && allowed.indexOf(rtEl.value) >= 0) ? rtEl.value : 'Selling';
                var rrt = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'SALES_QUOTE', paramKey: 'RATE_TYPE', paramValue: rtVal, dataType: 1 })
                });
                var drt = await rrt.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!drt.ok;   // onay + TL: ortak kaydedicide
                if (ok) flash('Kaydedildi.', true);
                else    flash(drt.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'ebelge') {
                var mEl = document.getElementById('ap-edoc-method');
                var pEl = document.getElementById('ap-edoc-provider');
                var redoc = await fetch('/Admin/SaveEDocumentParametersJson', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ method: mEl ? mEl.value : '', provider: pEl ? pEl.value : '' })
                });
                var dedoc = await redoc.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!dedoc.ok;
                if (ok) flash('Kaydedildi.', true);
                else    flash(dedoc.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'guvenlik') {
                var idleEl = document.getElementById('ap-session-idle');
                var idleVal = parseInt(idleEl && idleEl.value, 10);
                if (isNaN(idleVal) || idleVal < 0) idleVal = 0;
                var retEl = document.getElementById('ap-audit-retention');
                var retVal = parseInt(retEl && retEl.value, 10);
                if (isNaN(retVal) || retVal < 0) retVal = 365;
                var rsec = await fetch('/Admin/SaveSecurityParametersJson', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ sessionIdleMinutes: idleVal, auditRetentionDays: retVal })
                });
                var dsec = await rsec.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!dsec.ok;
                if (ok) flash('Kaydedildi. Yeni süre bir sonraki oturum yenilemesinde geçerli olur.', true);
                else    flash(dsec.error || 'Kaydetme basarisiz.', false);
            } else if (activePane === 'kalite') {
                var capaEl = document.getElementById('ap-contact-capa-enabled');
                var rq = await fetch('/Admin/SaveParameter', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                    body: JSON.stringify({ formCode: 'QUALITY', paramKey: 'CONTACT_CAPA_ENABLED', paramValue: (capaEl && capaEl.checked) ? 'true' : 'false', dataType: 3 })
                });
                var dq = await rq.json().catch(function () { return { ok: false, error: 'Yanit JSON degil' }; });
                ok = !!dq.ok;
                if (ok) flash('Kaydedildi.', true);
                else    flash(dq.error || 'Kaydetme basarisiz.', false);
            }

            // Ortak parametrelerin sonucu: kendi dalı olmayan sekmede mesajı da bu verir.
            if (common.handled) {
                if (!common.ok) { ok = false; flash('Kaydetme basarisiz.', false); }
                else if (!hasBranch) { ok = true; flash('Kaydedildi.', true); }
            }
            // Stok anahtarları: hata varsa her sekmede bildirilir. Başarı mesajını yalnız
            // başka kimsenin vermediği sekmede verir (çift mesaj olmasın).
            if (!stockRes.ok) { ok = false; flash(stockRes.error || 'Kaydetme basarisiz.', false); }
            else if (!hasBranch && !common.handled) { ok = true; flash('Kaydedildi.', true); }
            // Yeni sekmeler eklendiginde buraya else if blogu ile bagla
            if (ok) flashSuccess();
        } catch (e) {
            flash('Ag hatasi: ' + e.message, false);
        } finally {
            syncSaveButton();
        }
    });

    // ── İhtiyaç Kayıtları: depo listesi yönetimi (seçim modali, PageComment Seq 38 —
    //    Seq 35'teki açılır panel ekran-ortası modal'a taşındı) ──
    var _fcLoadPromise    = null;
    var _fcLocs           = [];
    var _fcCheckedIds     = [];
    var _fcModalSnapshot  = [];   // modal açılış anındaki seçim — Vazgeç/Esc/backdrop bunu geri yükler

    function fcModeChange() {
        var mode = document.querySelector('input[name="apFcLocMode"]:checked')?.value;
        var row  = document.getElementById('apFcLocListRow');
        if (row) row.style.display = (mode === 'SPECIFIC') ? '' : 'none';
    }

    function fcEscapeHtml(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    function fcRenderLocList() {
        var el = document.getElementById('apFcLocList');
        if (!el) return;
        if (_fcLocs.length === 0) {
            el.innerHTML = '<span class="ap-fc-panel-empty">Aktif depo bulunamadı.</span>';
            fcSyncRowSummary();
            fcUpdateModalCount();
            return;
        }
        el.innerHTML = _fcLocs.map(function(l) {
            var checked = _fcCheckedIds.indexOf(l.id) !== -1;
            var label = l.locationName || l.locationCode || ('Depo ' + l.id);
            return '<label class="ap-fc-option" data-loc-search="' + fcEscapeHtml(label.toLowerCase()) + '">'
                 + '<input type="checkbox" value="' + l.id + '"' + (checked ? ' checked' : '') + '>'
                 + fcEscapeHtml(label)
                 + '</label>';
        }).join('');
        fcFilterLocList();  // arama kutusunda zaten yazılmış bir terim varsa yeni render'a uygula
        fcSyncRowSummary();
        fcUpdateModalCount();
    }

    // Depo sayısı çok olabileceğinden aranabilir liste — DOM node'ları YENİDEN OLUŞTURMAZ
    // (yalnız görünürlük toggle eder), checkbox işaretli durumu bu yüzden bozulmaz.
    function fcFilterLocList() {
        var q = (document.getElementById('apFcLocSearch')?.value || '').trim().toLowerCase();
        document.querySelectorAll('#apFcLocList > label[data-loc-search]').forEach(function(lbl) {
            lbl.style.display = (!q || lbl.dataset.locSearch.indexOf(q) !== -1) ? '' : 'none';
        });
    }

    function fcCheckedIdsFromDom() {
        var ids = [];
        document.querySelectorAll('#apFcLocList input[type="checkbox"]:checked').forEach(function(cb) {
            ids.push(parseInt(cb.value, 10));
        });
        return ids;
    }

    function fcApplyCheckedIds(ids) {
        document.querySelectorAll('#apFcLocList input[type="checkbox"]').forEach(function(cb) {
            cb.checked = ids.indexOf(parseInt(cb.value, 10)) !== -1;
        });
    }

    // Satırdaki "N depo seçili" özeti + buton tooltip'i (ilk birkaç depo adı) — yalnız ilk config
    // yüklemesinde ve modal "Tamam" ile kapanınca güncellenir. Modalin içindeki geçici tikleme
    // (Vazgeç ile iptal edilebilir) satırı ANINDA etkilemez — bkz. fcUpdateModalCount.
    function fcSyncRowSummary() {
        var ids = fcCheckedIdsFromDom();
        var countEl = document.getElementById('apFcLocCount');
        if (countEl) countEl.textContent = ids.length + ' depo seçili';

        var btn = document.getElementById('apFcLocOpenBtn');
        if (btn) {
            if (ids.length === 0) {
                btn.title = 'Depo Ekle / Gör';
            } else {
                var names = ids.slice(0, 3).map(function(id) {
                    var loc = _fcLocs.find(function(l) { return l.id === id; });
                    return loc ? (loc.locationName || loc.locationCode || ('Depo ' + id)) : ('Depo ' + id);
                });
                var extra = ids.length - names.length;
                btn.title = names.join(', ') + (extra > 0 ? ' +' + extra + ' diğer' : '');
            }
        }
    }

    // Modal içindeki anlık sayaç — her checkbox değişiminde güncellenir (satır özetinden bağımsız,
    // Tamam'a basılana kadar dışarı yansımaz).
    function fcUpdateModalCount() {
        var el = document.getElementById('apFcModalCount');
        if (el) el.textContent = fcCheckedIdsFromDom().length + ' depo seçili';
    }

    // Kayıtlı seçimde artık geçersiz (raf/hücre tipine dönmüş, pasifleşmiş veya silinmiş) id
    // varsa uyarı göster — DEĞERİ SESSİZCE DEĞİŞTİRMEZ, yalnız admin'i bilgilendirir.
    function fcRenderWarning(invalidLocations) {
        var el = document.getElementById('apFcLocWarning');
        if (!el) return;
        if (!invalidLocations || invalidLocations.length === 0) {
            el.classList.remove('is-visible');
            el.textContent = '';
            return;
        }
        var labels = invalidLocations.map(function(x) { return x.label || ('#' + x.id); }).join(', ');
        el.textContent = '⚠ Kayıtlı seçimde artık geçerli olmayan ' + invalidLocations.length
            + ' lokasyon var (raf/hücre veya silinmiş depo): ' + labels
            + '. Aşağıdan yeniden seçip kaydedin.';
        el.classList.add('is-visible');
    }

    // Promise cache: tab tıklaması fire-and-forget çağırır, modal açılışı await eder — ikisi de
    // AYNI istek/promise'i paylaşır (yarış durumu yok, çift fetch atılmaz).
    function fcLoadConfig() {
        if (_fcLoadPromise) return _fcLoadPromise;
        _fcLoadPromise = (async function() {
            try {
                var cfg = await (await fetch('/Purchase/FulfillmentLocationConfig')).json();
                _fcCheckedIds = cfg.locationIds || [];
                var modeEl = document.getElementById(cfg.mode === 'ITEM_DEFAULT' ? 'apFcLocDefault' : 'apFcLocSpecific');
                if (modeEl) modeEl.checked = true;
                fcModeChange();
                fcRenderWarning(cfg.invalidLocations);

                // Asgari stok switch'i (default: kapalı)
                var msOn = cfg.respectMinStock === true;
                var msEl = document.getElementById('ap-fc-min-stock');
                if (msEl) {
                    msEl.checked = msOn;
                    msEl.closest('.ap-switch').querySelector('.ap-switch-track').classList.toggle('is-on', msOn);
                    var msLbl = document.getElementById('ap-fc-min-stock-label');
                    if (msLbl) { msLbl.textContent = msOn ? 'Aktif' : 'Pasif'; msLbl.classList.toggle('is-active', msOn); }
                }
                // Kumule switch'i (default: kapalı)
                var conOn = cfg.consolidateLines === true;
                var conEl2 = document.getElementById('ap-fc-consolidate');
                if (conEl2) {
                    conEl2.checked = conOn;
                    conEl2.closest('.ap-switch').querySelector('.ap-switch-track').classList.toggle('is-on', conOn);
                    var conLbl = document.getElementById('ap-fc-consolidate-label');
                    if (conLbl) { conLbl.textContent = conOn ? 'Aktif' : 'Pasif'; conLbl.classList.toggle('is-active', conOn); }
                }

                // PageComment Seq 34: raf/hücre tipli lokasyonlar seçilebilir listede gösterilmez —
                // genel /Warehouse/GetLocationsJson yerine bu parametreye özel, sunucu-filtreli uç.
                var locs = await (await fetch('/Purchase/FulfillmentLocationOptions')).json();
                _fcLocs = locs || [];
                fcRenderLocList();
            } catch(e) {
                var el = document.getElementById('apFcLocList');
                if (el) el.innerHTML = '<span class="ap-fc-panel-empty">Yüklenirken hata oluştu.</span>';
            }
        })();
        return _fcLoadPromise;
    }

    // ── Seçim modali yaşam döngüsü (PageComment Seq 38: açılır panel → ekran-ortası modal) ──
    async function fcOpenModal() {
        await fcLoadConfig();   // zaten yüklüyse (tab tıklamasından) aynı promise'i bekler, no-op
        _fcModalSnapshot = fcCheckedIdsFromDom();
        fcUpdateModalCount();
        var bd = document.getElementById('apFcModalBackdrop');
        if (bd) bd.hidden = false;
        document.getElementById('apFcLocSearch')?.focus();
    }

    // applyChanges=true (Tamam): DOM'daki mevcut tik durumu kalır + satır özetine yansır.
    // applyChanges=false (Vazgeç/Esc/backdrop): modal açılış anındaki seçime geri döner (değişiklik uygulanmaz).
    function fcCloseModal(applyChanges) {
        var bd = document.getElementById('apFcModalBackdrop');
        if (!bd || bd.hidden) return;
        if (applyChanges) {
            fcSyncRowSummary();
        } else {
            fcApplyCheckedIds(_fcModalSnapshot);
        }
        // Kapanışta arama terimini temizle — bir sonraki açılışta filtrelenmemiş liste görünsün.
        var search = document.getElementById('apFcLocSearch');
        if (search && search.value) { search.value = ''; fcFilterLocList(); }
        bd.hidden = true;
    }

    document.getElementById('apFcLocOpenBtn')?.addEventListener('click', function() { fcOpenModal(); });
    document.getElementById('apFcModalOkBtn')?.addEventListener('click', function() { fcCloseModal(true); });
    document.getElementById('apFcModalCancelBtn')?.addEventListener('click', function() { fcCloseModal(false); });
    // Backdrop'un kendisine (karta değil) tıklama → Vazgeç
    document.getElementById('apFcModalBackdrop')?.addEventListener('click', function(ev) {
        if (ev.target && ev.target.id === 'apFcModalBackdrop') fcCloseModal(false);
    });
    // Esc → Vazgeç (yalnız modal açıkken; arama kutusu odaktayken de çalışır, event bubbling engellenmiyor)
    document.addEventListener('keydown', function(ev) {
        if (ev.key !== 'Escape') return;
        var bd = document.getElementById('apFcModalBackdrop');
        if (bd && !bd.hidden) fcCloseModal(false);
    });

    // Radio değişiklik olayları
    document.querySelectorAll('input[name="apFcLocMode"]').forEach(function(r) {
        r.addEventListener('change', fcModeChange);
    });

    // Arama kutusu — anlık filtre (DOM'u yeniden oluşturmadan yalnız görünürlük toggle eder)
    document.getElementById('apFcLocSearch')?.addEventListener('input', fcFilterLocList);

    // "Temizle" — tüm seçimi kaldırır (depo sayısı çok olduğunda tek tek işaret kaldırmak yerine).
    // Yalnız modal içi anlık sayacı günceller — satır özeti Tamam'a basılana kadar değişmez.
    document.getElementById('apFcLocClearAll')?.addEventListener('click', function(ev) {
        ev.preventDefault();
        document.querySelectorAll('#apFcLocList input[type="checkbox"]:checked').forEach(function(cb) { cb.checked = false; });
        fcUpdateModalCount();
    });

    // Seçim değişince: modal içi anlık sayaç (event delegation, dinamik render sonrası da çalışır)
    document.getElementById('apFcLocList')?.addEventListener('change', function(ev) {
        if (ev.target && ev.target.type === 'checkbox') fcUpdateModalCount();
    });

    // Tab tıklamasında config'i yükle (fire-and-forget — modal açılışında aynı promise beklenir)
    tabs.forEach(function(t) {
        if (t.dataset.pane === 'ihtiyac') {
            t.addEventListener('click', function() { fcLoadConfig(); });
        }
    });
})();
</script>
<script>
// ── E-Belge sekmesi: yontem -> saglayici filtreleme ─────────────────────────────
// Saglayici listesi SUNUCUDAN gelir (EDocumentSourceCatalog). Listeyi burada sabit
// yazmak, yeni bir ERP eklendiginde ekranin sessizce eski listeyi gostermesine yol
// acardi — katalog TEK kayit yeridir.
(function () {
    var PROFILES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((IEnumerable<CalibraHub.Application.Constants.EDocumentSourceProfile>)ViewData["EDocProfiles"]
            ?? Array.Empty<CalibraHub.Application.Constants.EDocumentSourceProfile>())
        .Select(p => new { provider = p.Provider.ToString(), method = p.Method.ToString(), label = p.Label, description = p.Description })));

    var CURRENT_METHOD   = '@(ViewData["EDocIngestMethod"] ?? "Online")';
    var CURRENT_PROVIDER = '@(ViewData["EDocIngestProvider"] ?? "Logo")';

    var methodEl = document.getElementById('ap-edoc-method');
    var provEl   = document.getElementById('ap-edoc-provider');
    var descEl   = document.getElementById('ap-edoc-provider-desc');
    if (!methodEl || !provEl) return;

    function renderProviders(method, preferred) {
        var list = PROFILES.filter(function (p) { return p.method === method; });
        provEl.innerHTML = '';
        list.forEach(function (p) {
            var o = document.createElement('option');
            o.value = p.provider;
            o.textContent = p.label;
            provEl.appendChild(o);
        });
        // Yontem degisince onceki saglayici artik gecerli olmayabilir -> ilkine dus.
        var match = list.some(function (p) { return p.provider === preferred; });
        provEl.value = match ? preferred : (list.length ? list[0].provider : '');
        updateDesc();
    }

    function updateDesc() {
        var sel = PROFILES.filter(function (p) { return p.provider === provEl.value; })[0];
        if (descEl && sel) descEl.textContent = sel.description;
    }

    methodEl.value = CURRENT_METHOD;
    renderProviders(CURRENT_METHOD, CURRENT_PROVIDER);

    methodEl.addEventListener('change', function () { renderProviders(methodEl.value, provEl.value); });
    provEl.addEventListener('change', updateDesc);
})();
</script>
}