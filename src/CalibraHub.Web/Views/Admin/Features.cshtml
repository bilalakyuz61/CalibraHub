    // ── Ekran görüntüleri ────────────────────────────────────────────────
    // Dosya konumu: wwwroot/img/features/{grupSlug}/{ozellikSlug}.(png|jpg|jpeg|webp)
    // Grup kapak görseli: wwwroot/img/features/{grupSlug}/_hero.(png|jpg|jpeg|webp)
    // Dosya yoksa kart görselsiz çıkar; "Eksik görselleri göster" anahtarı
    // beklenen dosya adını yerinde gösterir (görsel toplama kontrol listesi).
    string Slug(string s)
    {
        var map = new Dictionary<char, char>
        {
            ['ı'] = 'i', ['İ'] = 'i', ['ş'] = 's', ['Ş'] = 's', ['ğ'] = 'g', ['Ğ'] = 'g',
            ['ü'] = 'u', ['Ü'] = 'u', ['ö'] = 'o', ['Ö'] = 'o', ['ç'] = 'c', ['Ç'] = 'c',
        };
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var ch in s)
        {
            var c = map.TryGetValue(ch, out var m) ? m : char.ToLowerInvariant(ch);
            if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) sb.Append(c);
            else if (sb.Length > 0 && sb[sb.Length - 1] != '-') sb.Append('-');
        }
        return sb.ToString().Trim('-');
    }

    var shotRoot = System.IO.Path.Combine(HostEnv.WebRootPath ?? "", "img", "features");
    // Var olan görselleri tek seferde tara — kart başına ayrı dosya sistemi sorgusu yapma.
    var shotFiles = System.IO.Directory.Exists(shotRoot)
        ? System.IO.Directory.GetFiles(shotRoot, "*.*", System.IO.SearchOption.AllDirectories)
        : Array.Empty<string>();

    // relPath ("satis/kismi-teslimat") → bulunan dosyanın url'i (cache-bust damgalı) veya null
    string? ShotUrl(string relPath)
    {
        foreach (var ext in new[] { ".png", ".jpg", ".jpeg", ".webp" })
        {
            var full = System.IO.Path.Combine(shotRoot, relPath.Replace('/', System.IO.Path.DirectorySeparatorChar) + ext);
            var hit = shotFiles.FirstOrDefault(f => string.Equals(f, full, StringComparison.OrdinalIgnoreCase));
            if (hit != null)
                return $"/img/features/{relPath}{ext}?v={System.IO.File.GetLastWriteTimeUtc(hit).Ticks}";
        }
        return null;
