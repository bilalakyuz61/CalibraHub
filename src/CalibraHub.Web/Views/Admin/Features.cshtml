@section Styles {
<style>
    .ftr-root {
        color-scheme: light;
        --ftr-bg:      #f6f7fb;
        --ftr-surface: #ffffff;
        --ftr-border:  #e4e8f0;
        --ftr-text:    #0f172a;
        --ftr-muted:   #64748b;
        --ftr-accent:  #6366f1;
        --ftr-hero-1:  #4f46e5;
        --ftr-hero-2:  #7c3aed;
        --ftr-chip-bg: #eef1f8;
        background: var(--ftr-bg);
        color: var(--ftr-text);
        padding: 20px 22px 48px;
        /* Sayfa workspace iframe'inde açılır: .app-content-area--workspace-frame
           height:100dvh + overflow:hidden'dır, yani kaydırmayı İÇERİK kendi yapmalı.
           min-height:100% yeterli değil — taşan içerik kırpılır ve sayfa aşağı
           kaydırılamaz. Kendi flex satırımızı kurup dikey kaydırmayı burada açıyoruz. */
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
    body.app-theme-dark .ftr-root {
        color-scheme: dark;
        --ftr-bg:      #0b1220;
        --ftr-surface: #131c2e;
        --ftr-border:  #24304a;
        --ftr-text:    #e2e8f0;
        --ftr-muted:   #94a3b8;
        --ftr-accent:  #818cf8;
        --ftr-hero-1:  #3730a3;
        --ftr-hero-2:  #5b21b6;
        --ftr-chip-bg: #1c2740;
    }

    /* ── Hero ───────────────────────────────────────── */
    .ftr-hero {
        border-radius: 18px;
        padding: 30px 32px;
        background: linear-gradient(135deg, var(--ftr-hero-1), var(--ftr-hero-2));
        color: #fff;
        display: flex; flex-wrap: wrap; gap: 24px;
        align-items: center; justify-content: space-between;
    }
    .ftr-hero__brand { font-size: 12px; font-weight: 600; letter-spacing: .14em; opacity: .8; }
    .ftr-hero h1 { font-size: 30px; font-weight: 700; margin: 6px 0 8px; line-height: 1.15; color: #fff; }
    .ftr-hero p  { font-size: 15px; margin: 0; max-width: 640px; opacity: .92; line-height: 1.55; }
    .ftr-stats { display: flex; gap: 14px; flex-wrap: wrap; }
    .ftr-stat {
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 14px; padding: 14px 20px; min-width: 116px; text-align: center;
    }
    .ftr-stat b { display: block; font-size: 26px; font-weight: 700; line-height: 1.1; }
    .ftr-stat span { font-size: 12px; opacity: .85; }

    /* ── Araç çubuğu ────────────────────────────────── */
    .ftr-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 22px 0 18px; }
    .ftr-search { flex: 1 1 260px; max-width: 380px; position: relative; }
    .ftr-search input {
        width: 100%; padding: 9px 12px 9px 34px;
        border-radius: 10px; border: 1px solid var(--ftr-border);
        background: var(--ftr-surface); color: var(--ftr-text);
        font-size: 13px; outline: none;
    }
    .ftr-search input:focus { border-color: var(--ftr-accent); }
    .ftr-search > svg {
        position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
        width: 15px; height: 15px; color: var(--ftr-muted);
    }
    .ftr-btn {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 15px; border-radius: 10px; cursor: pointer;
        border: 1px solid var(--ftr-border); background: var(--ftr-surface);
        color: var(--ftr-text); font-size: 13px; font-weight: 600;
    }
    .ftr-btn:hover { border-color: var(--ftr-accent); color: var(--ftr-accent); }
    .ftr-btn svg { width: 15px; height: 15px; }

    /* ── Grup ve kartlar ────────────────────────────── */
    .ftr-group { margin-bottom: 26px; }
    .ftr-group__head { display: flex; align-items: flex-start; gap: 13px; margin-bottom: 13px; }
    .ftr-group__icon {
        width: 40px; height: 40px; border-radius: 11px; flex: 0 0 auto;
        display: flex; align-items: center; justify-content: center;
        background: var(--tone-soft); color: var(--tone);
    }
    .ftr-group__icon svg {
        width: 20px; height: 20px; fill: none; stroke: currentColor;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    }
    .ftr-group__title { font-size: 17px; font-weight: 700; margin: 0; }
    .ftr-group__lead  { font-size: 13px; color: var(--ftr-muted); margin: 3px 0 0; }
    .ftr-group__count {
        margin-left: auto; flex: 0 0 auto; white-space: nowrap;
        font-size: 11px; font-weight: 600; color: var(--ftr-muted);
        background: var(--ftr-chip-bg); border-radius: 20px; padding: 4px 11px;
    }

    .ftr-cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .ftr-card {
        background: var(--ftr-surface);
        border: 1px solid var(--ftr-border);
        border-left: 3px solid var(--tone);
        border-radius: 12px; padding: 14px 16px;
        transition: transform .12s ease, box-shadow .12s ease;
    }
    .ftr-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(15,23,42,.09); }
    body.app-theme-dark .ftr-card:hover { box-shadow: 0 6px 18px rgba(0,0,0,.4); }
    .ftr-card h3 { font-size: 14px; font-weight: 600; margin: 0 0 5px; }
    .ftr-card p  { font-size: 12.5px; line-height: 1.55; color: var(--ftr-muted); margin: 0; }

    /* Grup rengi */
    .tone-indigo  { --tone: #6366f1; --tone-soft: rgba(99,102,241,.14); }
    .tone-violet  { --tone: #8b5cf6; --tone-soft: rgba(139,92,246,.14); }
    .tone-emerald { --tone: #10b981; --tone-soft: rgba(16,185,129,.14); }
    .tone-amber   { --tone: #f59e0b; --tone-soft: rgba(245,158,11,.14); }
    .tone-rose    { --tone: #f43f5e; --tone-soft: rgba(244,63,94,.14); }
    .tone-blue    { --tone: #3b82f6; --tone-soft: rgba(59,130,246,.14); }

    /* ── Ekran görüntüleri ──────────────────────────── */
    .ftr-hero-shot { margin: 0 0 14px; }
    .ftr-hero-shot img {
        display: block; width: 100%; max-height: 460px; object-fit: contain;
        object-position: top center;
        border: 1px solid var(--ftr-border); border-radius: 12px;
        background: var(--ftr-surface); cursor: zoom-in;
    }
    .ftr-hero-shot figcaption { font-size: 11.5px; color: var(--ftr-muted); margin-top: 6px; }

    .ftr-card__shot {
        display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
        object-position: top left;
        border: 1px solid var(--ftr-border); border-radius: 8px;
        background: var(--ftr-bg); margin-bottom: 10px; cursor: zoom-in;
    }

    /* Eksik görsel yer tutucusu — varsayılan gizli, anahtar açınca görünür. */
    .ftr-shot-missing { display: none; }
    .ftr-root.show-missing .ftr-shot-missing {
        display: block;
        border: 1px dashed var(--ftr-border); border-radius: 8px;
        padding: 10px 12px; margin-bottom: 10px;
        font-size: 11px; color: var(--ftr-muted); text-align: center;
    }
    .ftr-root.show-missing .ftr-shot-missing--hero { margin-bottom: 14px; text-align: left; }
    .ftr-shot-missing code {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 11px; color: var(--ftr-accent); word-break: break-all;
    }

    /* Büyütme katmanı */
    .ftr-lightbox {
        position: fixed; inset: 0; z-index: 2000; display: none;
        align-items: center; justify-content: center; padding: 32px;
        background: rgba(2, 6, 23, .82); backdrop-filter: blur(3px);
        cursor: zoom-out;
    }
    .ftr-lightbox.is-open { display: flex; }
    .ftr-lightbox img {
        max-width: 100%; max-height: 100%;
        border-radius: 10px; box-shadow: 0 24px 60px rgba(0,0,0,.5);
    }

    /* ── Anahtar (switch) ───────────────────────────── */
    .ftr-switch { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
    .ftr-switch input { position: absolute; opacity: 0; width: 0; height: 0; }
    .ftr-switch__track {
        position: relative; width: 36px; height: 20px; flex: 0 0 auto;
        border-radius: 10px; background: var(--ftr-border); transition: background .18s;
    }
    .ftr-switch__thumb {
        position: absolute; top: 3px; left: 3px; width: 14px; height: 14px;
        border-radius: 50%; background: #fff; transition: transform .18s;
        box-shadow: 0 1px 3px rgba(0,0,0,.25);
    }
    .ftr-switch input:checked ~ .ftr-switch__track { background: var(--ftr-accent); }
    .ftr-switch input:checked ~ .ftr-switch__track .ftr-switch__thumb { transform: translateX(16px); }
    .ftr-switch__text { font-size: 13px; color: var(--ftr-muted); }

    .ftr-empty { display: none; text-align: center; padding: 46px 0; color: var(--ftr-muted); font-size: 14px; }
    .ftr-root.is-empty .ftr-empty { display: block; }

    .ftr-foot {
        margin-top: 30px; padding-top: 18px;
        border-top: 1px solid var(--ftr-border);
        font-size: 12px; color: var(--ftr-muted);
    }

    /* ── Yazdırma ───────────────────────────────────── */
    @@media print {
        .ftr-toolbar { display: none !important; }
        /* Ekranda kaydırılabilir kutu olan kök, yazdırmada tüm içeriği aksın
           diye taşmayı serbest bırakır — yoksa yalnız ilk ekran basılır. */
        .ftr-root { background: #fff; color: #000; padding: 0; overflow: visible; height: auto; }
        .ftr-hero { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .ftr-card { break-inside: avoid; box-shadow: none; }
        .ftr-group { break-inside: avoid-page; }
        /* Görseller PDF'e girer; eksik yer tutucuları ve büyütme katmanı girmez. */
        .ftr-shot-missing, .ftr-lightbox { display: none !important; }
        .ftr-hero-shot img { max-height: 300px; }
        .ftr-hero-shot, .ftr-card__shot { break-inside: avoid; }
    }
</style>
}

<div class="ftr-root" id="ftrRoot">

    <div class="ftr-hero">
        <div>
            <div class="ftr-hero__brand">CALIBRAHUB</div>
            <h1>Tek Sistemde Üretim, Lojistik ve Kalite</h1>
            <p>
                Teklif almaktan sevkiyata, reçeteden makine çizelgesine, kalite muayenesinden
                düzeltici faaliyete kadar tüm süreçleriniz aynı veritabanında ve aynı arayüzde.
                Aşağıda CalibraHub'ın öne çıkan yetenekleri yer alıyor.
            </p>
        </div>
        <div class="ftr-stats">
            <div class="ftr-stat"><b>@groups.Length</b><span>Ana Modül</span></div>
            <div class="ftr-stat"><b>@totalFeatures</b><span>Öne Çıkan Özellik</span></div>
            <div class="ftr-stat"><b>TR / EN</b><span>Arayüz Dili</span></div>
        </div>
    </div>

    <div class="ftr-toolbar">
        <div class="ftr-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="ftrSearch" placeholder="Özellik ara… (ör. seri takibi, onay, Gantt)" autocomplete="off" />
        </div>
        <label class="ftr-switch" title="Henüz ekran görüntüsü eklenmemiş kartlarda beklenen dosya adını gösterir">
            <input type="checkbox" id="ftrShowMissing" />
            <span class="ftr-switch__track"><span class="ftr-switch__thumb"></span></span>
            <span class="ftr-switch__text">Eksik görselleri göster</span>
        </label>
        <button type="button" class="ftr-btn" id="ftrPrint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Yazdır / PDF
        </button>
    </div>

    <div id="ftrList">
        @foreach (var g in groups)
        {
            var gSlug   = Slug(g.Title);
            var heroUrl = ShotUrl($"{gSlug}/_hero");
            <section class="ftr-group tone-@g.Tone" data-ftr-group>
                <div class="ftr-group__head">
                    <div class="ftr-group__icon">
                        <svg viewBox="0 0 24 24">@Html.Raw(icons.TryGetValue(g.Icon, out var iconPath) ? iconPath : "")</svg>
                    </div>
                    <div>
                        <h2 class="ftr-group__title">@g.Title</h2>
                        <p class="ftr-group__lead">@g.Lead</p>
                    </div>
                    <span class="ftr-group__count">@g.Items.Length özellik</span>
                </div>

                @if (heroUrl != null)
                {
                    <figure class="ftr-hero-shot">
                        <img src="@heroUrl" alt="@g.Title ekran görüntüsü" loading="lazy" data-ftr-zoom />
                        <figcaption>@g.Title</figcaption>
                    </figure>
                }
                else
                {
                    <div class="ftr-shot-missing ftr-shot-missing--hero" data-ftr-missing>
                        Kapak görseli: <code>wwwroot/img/features/@gSlug/_hero.png</code>
                    </div>
                }

                <div class="ftr-cards">
                    @foreach (var it in g.Items)
                    {
                        var iSlug   = Slug(it.T);
                        var shotUrl = ShotUrl($"{gSlug}/{iSlug}");
                        <article class="ftr-card @(shotUrl != null ? "has-shot" : "")" data-ftr-card data-ftr-text="@($"{g.Title} {it.T} {it.D}")">
                            @if (shotUrl != null)
                            {
                                <img class="ftr-card__shot" src="@shotUrl" alt="@it.T ekran görüntüsü" loading="lazy" data-ftr-zoom />
                            }
                            else
                            {
                                <div class="ftr-shot-missing" data-ftr-missing>
                                    <code>@gSlug/@(iSlug).png</code>
                                </div>
                            }
                            <h3>@it.T</h3>
                            <p>@it.D</p>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    <div class="ftr-empty">Aramanızla eşleşen özellik bulunamadı.</div>

    <div class="ftr-lightbox" id="ftrLightbox" aria-hidden="true"><img alt="" /></div>

    <div class="ftr-foot">
        Bu sayfa tanıtım ve bilgilendirme amaçlıdır. Modüllerin kullanıma açılması
        lisans ve yetkilendirme ayarlarınıza bağlıdır.
    </div>
</div>

@section Scripts {
<script>
(function () {
    var root   = document.getElementById('ftrRoot');
    var input  = document.getElementById('ftrSearch');
    var cards  = Array.prototype.slice.call(document.querySelectorAll('[data-ftr-card]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-ftr-group]'));

    // Turkce arama: kucuk harfe cevir + aksanli harfleri sadelestir
    // (kullanici "sayim" yazinca "sayım" karti da eslessin).
    function normalize(s) {
        return (s || '').toLocaleLowerCase('tr-TR')
            .replace(/ı/g, 'i').replace(/ş/g, 's').replace(/ğ/g, 'g')
            .replace(/ü/g, 'u').replace(/ö/g, 'o').replace(/ç/g, 'c').replace(/î/g, 'i');
    }

    cards.forEach(function (c) { c.dataset.ftrNorm = normalize(c.getAttribute('data-ftr-text')); });

    function applyFilter() {
        var q = normalize(input.value.trim());
        var anyVisible = false;

        groups.forEach(function (g) {
            var visible = 0;
            g.querySelectorAll('[data-ftr-card]').forEach(function (c) {
                var hit = !q || c.dataset.ftrNorm.indexOf(q) !== -1;
                c.style.display = hit ? '' : 'none';
                if (hit) visible++;
            });
            g.style.display = visible ? '' : 'none';
            if (visible) anyVisible = true;
        });

        root.classList.toggle('is-empty', !anyVisible);
    }

    input.addEventListener('input', applyFilter);
    document.getElementById('ftrPrint').addEventListener('click', function () { window.print(); });

    // Eksik görsel yer tutucuları — tercih kullanıcıda kalsın diye localStorage'da.
    var missingBox = document.getElementById('ftrShowMissing');
    missingBox.checked = localStorage.getItem('ftrShowMissing') === '1';
    function applyMissing() {
        root.classList.toggle('show-missing', missingBox.checked);
        localStorage.setItem('ftrShowMissing', missingBox.checked ? '1' : '0');
    }
    missingBox.addEventListener('change', applyMissing);
    applyMissing();

    // Görsele tıklayınca tam ekran büyüt (Esc veya tıklama ile kapanır).
    var lightbox = document.getElementById('ftrLightbox');
    var lightImg = lightbox.querySelector('img');
    document.addEventListener('click', function (e) {
        var img = e.target.closest ? e.target.closest('[data-ftr-zoom]') : null;
        if (img) {
            lightImg.src = img.getAttribute('src');
            lightImg.alt = img.getAttribute('alt') || '';
            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');
        } else if (e.target === lightbox || lightbox.contains(e.target)) {
            close();
        }
    });
    function close() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        lightImg.removeAttribute('src');
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();
</script>
}
