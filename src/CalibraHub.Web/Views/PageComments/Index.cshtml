@{
    ViewData["Title"] = "Sayfa Yorumları";
    ViewData["HelpKey"] = "page-comments";
}

@*
    /PageComments — merkezi yönetim ekranı (admin-only: DepartmentManager|SystemAdmin).
    NOT (backend koordinasyonu gerekli — bkz. rapor): bu view'ı sunacak controller action
    henüz yok. Beklenen: [HttpGet("/PageComments")] + inline rol kontrolü (AuditLogController
    ile aynı desen — [Authorize] + SystemAdmin|DepartmentManager kontrolü + return View()).
    BESPOKE liste — CalibraSmartBoard/C-Grid BİLEŞENLERİ KULLANILMAZ (başka oturum düzenliyor).
    Header düzeni CLAUDE.md C-Grid konvansiyonunu elle taklit eder (ikon+başlık, arama, filtre).
*@

@section Styles {
    <link rel="stylesheet" href="~/css/page-comments.css" asp-append-version="true" />
}

<div class="pcm-shell">
    <div class="pcm-header">
        <div class="pcm-header__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
        </div>
        <div class="pcm-header__text">
            <div class="pcm-header__title">Sayfa Yorumları</div>
            <div class="pcm-header__subtitle" id="pcmSummary">Yükleniyor…</div>
        </div>

        <input type="search" id="pcmSearch" class="pcm-search" placeholder="#Seq veya metin ara…" autocomplete="off" />

        <select id="pcmStatusFilter" class="pcm-filter-select">
            <option value="">— Tüm Durumlar —</option>
        </select>

        <button type="button" id="pcmRefreshBtn" class="pcm-refresh-btn" title="Yenile">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6" /><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M3 22v-6h6" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /></svg>
            Yenile
        </button>
    </div>

    <div class="pcm-body">
        <div class="pcm-activity" id="pcmActivityPanel" hidden>
            <div class="pcm-activity__title">Son Aktiviteler</div>
            <div id="pcmActivityBody"></div>
        </div>

        <div id="pcmGroups">
            <div class="pcm-empty">Yükleniyor…</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/page-comments-common.js" asp-append-version="true"></script>
    <script src="~/js/page-comments-admin.js" asp-append-version="true"></script>
}
